#
# The Chocolatey install script. Rendered by build/make-package-manifests.ps1,
# which substitutes @VERSION@, @INSTALLER_URL@ and @INSTALLER_SHA256@.
#
# The installer is downloaded from the release rather than embedded: it is 76 MB,
# it is Authenticode-signed, and Chocolatey checks the SHA-256 below before it is
# run - so the bytes that execute are the bytes the release published, and a
# package that has been tampered with fails before anything is installed.

$ErrorActionPreference = 'Stop'

# The installer's log, so that a failed install - a database step that failed, or,
# from the release after 6.3.7, an installation of the original hMailServer's 5.7,
# which setup then refuses before it changes anything - says why: Chocolatey
# reports the exit code alone, and the message boxes are suppressed. In the
# temporary folder of the account Chocolatey runs as. The log records setup's
# command line, so give the administrator password in HM_ADMIN_PASSWORD rather
# than in --install-arguments.
$installLog = Join-Path $env:TEMP "$($env:ChocolateyPackageName).@VERSION@.install.log"
# The file setup also writes a refusal to (RefusalFileName in the installer).
$refusalFile = Join-Path $env:TEMP 'hMailServer-setup-refused.txt'

$packageArgs = @{
    # hmailserver, or hmailserver-progressiverobot: the id this package was packed as.
    packageName    = $env:ChocolateyPackageName
    fileType       = 'exe'
    url64bit       = '@INSTALLER_URL@'
    checksum64     = '@INSTALLER_SHA256@'
    checksumType64 = 'sha256'

    # The installer smoke test's switches. /SUPPRESSMSGBOXES is not optional:
    # without it a database-setup failure shows a message box, silent mode answers
    # it with the default button, and a broken install reports success. /TYPE is
    # deliberately not passed - on a first install Inno's default type is the full
    # one, and on an upgrade Inno preselects the components already there, so
    # forcing the full type would add the Control Panel back to a server where the
    # administrator had left it out.
    silentArgs     = "/VERYSILENT /SUPPRESSMSGBOXES /NORESTART /LOG=`"$installLog`""
    validExitCodes = @(0)
    softwareName   = 'hMailServer*'
}

$started = Get-Date
try {
    Install-ChocolateyPackage @packageArgs
}
catch {
    Write-Warning "The installer did not finish. Its log: $installLog"
    $refusal = Get-Item -LiteralPath $refusalFile -ErrorAction SilentlyContinue
    if ($refusal -and $refusal.LastWriteTime -ge $started.AddSeconds(-5)) {
        Write-Warning "Setup's refusal, from $($refusalFile):"
        Get-Content -LiteralPath $refusalFile -Encoding UTF8 | ForEach-Object { Write-Warning $_ }
    }
    throw
}

Write-Host ''
Write-Host 'hMailServer @VERSION@ is installed. The administrator password is NOT set by an'
Write-Host 'unattended install - the wizard page that asks for one is skipped. Set one before'
Write-Host 'the server is reachable from anywhere but this machine: open the Control Panel'
Write-Host 'from the Start menu. Documentation:'
Write-Host 'https://gitlab.com/hmailserver/hmailserver/-/wikis/home'
