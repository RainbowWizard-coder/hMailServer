# The live update's apply step on Linux: what hMailServer.Updater.exe is on Windows.
#
# Installed as /usr/lib/hmailserver/hmailserver-update, and carried inside the
# AppImage at the same relative path. The server cannot replace itself: it runs
# as the hmailserver user, under a unit that leaves /usr read-only and grants no
# capability but the one that binds port 25, and the package manager and
# systemctl both need root. So the server, having checked the package against
# its Sigstore bundle, writes a REQUEST - one key=value line each for the kind
# of installation, the version, the package, the rollback image, the unit and
# where the outcome goes - and this program, started as root OUTSIDE the
# server's unit, does the rest:
#
#   1. reads and removes the request, so that it is acted on once;
#   2. checks every line of it, because the request came from an unprivileged
#      process and this one is root: every path must lie inside the Updates
#      directory named by root's own configuration, nothing may be a symlink,
#      and the unit must be the server's. A request that fails here is refused
#      in the journal and NOWHERE ELSE: the Updates directory belongs to the
#      service user, a process of theirs may still be running, and root writes
#      nothing into a directory whose owner is alive to swap a file for a
#      symlink between the check and the write. The server notices a request
#      that was taken and never answered, and reports that;
#   3. stops the unit, so that nothing runs as the service user while root reads
#      the files it named or writes beside them. From here on the directory is
#      quiet (the unit's control group is empty, and the service user has no
#      session, no cron and no way out of the group), and every file root makes
#      in it is made under a name nobody could have planted - mktemp, O_EXCL -
#      and renamed into place, which replaces a symlink and never follows one;
#   4. verifies the package - and the rollback image - against their Sigstore
#      bundles AGAIN, as root, with `hmailserver --verify-update`: the same check
#      the server made, made by a process the server could not have influenced.
#      A service that has been taken over could write any request it likes; it
#      cannot forge the release workflow's signature. And a signature is not
#      enough: every past release is signed too, so the package's own version -
#      read from the package, not from the request - must be NEWER than the
#      version the package database says is installed, and a rollback image
#      must be exactly that installed version. A taken-over service cannot
#      have root put a signed but superseded release back;
#   5. installs the package (apt-get or dpkg, dnf or rpm) or swaps the AppImage
#      file under the unit, starts the unit, and waits for it to stay up and,
#      where the metrics listener is on, for /readyz to answer;
#   6. if it does not come back, reinstalls the previous version the same way and
#      waits again;
#   7. writes ONE line to the outcome file - "<status> <version> <detail>", the
#      line hMailServer.Updater.exe writes, with the same five statuses: ok,
#      failed, rolled-back, rollback-failed, no-rollback - which the server reads
#      and reports the next time its update task runs, and the Control Deck and
#      GET /api/v1/update show unchanged.
#
# How it is started. The packaged unit gives the server /run/hmailserver
# (RuntimeDirectory=), the server writes the request there, and
# hmailserver-update.path - a root path unit the package enables - starts
# hmailserver-update.service, which runs this. That is the least privilege the
# job can be done with: the service user can ask for exactly this and nothing
# else, and what it asks for is checked. An AppImage that runs as root under a
# unit of its own reaches the same script through `systemd-run`, which the
# server tries when no path unit takes the request.
#
# The request. One key=value per line, no quoting, no continuation:
#
#   kind=deb|rpm|appimage        how this server was installed
#   version=<new>                the version being applied
#   package=/var/lib/hmailserver/Updates/hmailserver_<new>_amd64.deb
#   rollback=/var/lib/hmailserver/Updates/rollback/hmailserver_<running>_amd64.deb
#   rollback_version=<running>   (both optional: without them there is no rollback)
#   unit=hmailserver.service     the unit to stop and start
#   outcome=/var/lib/hmailserver/Updates/last-apply.txt
#   log=/var/lib/hmailserver/Updates/apply-<new>.log
#   wait=180                     seconds to wait for the service to come back
#   ready_url=http://127.0.0.1:9090/readyz   (optional) the metrics listener's probe
#   image=/opt/hmailserver/hMailServer.AppImage   (appimage only) the file to swap
#
# A key not in this list is said in the journal and skipped, so that a newer
# server never strands an older copy of this script (see read_request).
#
# Usage:
#   hmailserver-update apply --request FILE [--updates-dir DIR] [--dry-run]
#   hmailserver-update check
#
# --updates-dir is for the systemd-run route, where the caller is already root:
# the path unit's route reads DataFolder out of /etc/hmailserver/hMailServer.ini,
# which is root's file, and takes nothing about WHERE from the request.
# --dry-run says what would be done and does none of it. `check` says whether
# this machine can apply an update at all, and what is missing if not.
#
# POSIX sh, because /bin/sh is dash on Debian. Every external command it runs is
# named in full at the top so that a reader can see the whole of what root does.
# build/test-hmailserver-update.sh runs it against fakes for every outcome.

set -u

PROGRAM=/usr/bin/hmailserver
CONFIG=/etc/hmailserver/hMailServer.ini
UNIT_DEFAULT=hmailserver.service
PATH_UNIT=hmailserver-update.path

# How long the unit must stay active before it counts as back, how often it is
# looked at, and the pause before the stop. The three environment variables
# exist for build/test-hmailserver-update.sh, which cannot wait ten seconds per
# case; under the path unit and under systemd-run the environment is systemd's,
# and nothing sets them. HMAILSERVER_UPDATE_PROGRAM is the same test's way of
# standing a fake in for /usr/bin/hmailserver.
SETTLE_SECONDS=${HMAILSERVER_UPDATE_SETTLE_SECONDS:-10}
POLL_SECONDS=${HMAILSERVER_UPDATE_POLL_SECONDS:-2}
PAUSE_SECONDS=${HMAILSERVER_UPDATE_PAUSE_SECONDS:-3}
PROGRAM=${HMAILSERVER_UPDATE_PROGRAM:-$PROGRAM}

REQUEST=""
UPDATES_DIR=""
DRY_RUN=0

# ------------------------------------------------------------------ output

now() { date '+%Y-%m-%d %H:%M:%S'; }

LOG_FILE=""
LOG_TMP=""

# To standard output always - under the path unit that is the journal,
# journalctl -u hmailserver-update - and to the log file once open_log has made
# one. That happens after the unit is stopped and not before: until then a
# process running as the service user could put a symlink where root is about
# to write, and root would append to whatever it pointed at. After the stop
# there is no such process, and the file written is one this program made
# under a name nobody could have planted; it takes the requested name, by
# rename, when this program is done.
say()
{
   # Its own variable name: shell variables are global, and a caller that has a
   # $line of its own would find it replaced by this one.
   said="$(now)  $*"
   printf '%s\n' "$said"
   if [ -n "$LOG_TMP" ]; then
      printf '%s\n' "$said" >> "$LOG_TMP" 2>/dev/null || true
   fi
}

open_log()
{
   [ -n "$LOG_FILE" ] || return 0
   [ "$DRY_RUN" = 1 ] && return 0
   LOG_TMP="$(mktemp "$UPDATES_DIR/apply.XXXXXX" 2>/dev/null)" || { LOG_TMP=""; say "no log file could be made in $UPDATES_DIR; the journal has everything"; return 0; }
   trap finish_log EXIT
}

# The log takes the name the request asked for. mv renames: a symlink at that
# name is replaced, not followed. Owned like the Updates directory, so that the
# server can read it and remove it.
finish_log()
{
   [ -n "$LOG_TMP" ] || return 0
   chown --reference="$UPDATES_DIR" -- "$LOG_TMP" 2>/dev/null || true
   chmod 0640 -- "$LOG_TMP" 2>/dev/null || true
   mv -f -- "$LOG_TMP" "$LOG_FILE" 2>/dev/null || true
   LOG_TMP=""
}

die()
{
   status=$1
   shift
   say "hmailserver-update: $*"
   exit "$status"
}

# ------------------------------------------------------------------ the request

KIND=""
VERSION=""
PACKAGE=""
ROLLBACK=""
ROLLBACK_VERSION=""
UNIT="$UNIT_DEFAULT"
OUTCOME=""
WAIT=180
READY_URL=""
IMAGE=""

read_request()
{
   # Read the whole file first and remove it second: under the path unit the
   # file is in /run/hmailserver, which systemd removes when the unit stops, and
   # a request that is still there when this program finishes would start it
   # again. A key this program does not know is said and skipped, not refused:
   # on an AppImage host this script is placed once and the swap refreshes only
   # the image, so a newer server writing a key an older script does not know
   # would otherwise be refused at its next update with nothing telling it why
   # (the outcome file is written only after a stop). Every key that matters is
   # checked for presence and shape below, whatever else the request carries.
   [ ! -L "$REQUEST" ] || { rm -f "$REQUEST"; die 3 "the request at $REQUEST is a symbolic link, and is not read."; }
   [ -f "$REQUEST" ] || die 3 "there is no request at $REQUEST."
   # Bounded: a request is a few hundred bytes, and this is root reading a file
   # somebody else wrote.
   text="$(head -c 65536 -- "$REQUEST")"
   rm -f "$REQUEST" 2>/dev/null || true

   # Split into lines by an unquoted expansion with IFS a newline - and with
   # pathname expansion off while that is done (set -f), so that a line is read
   # as written: otherwise root would expand a line holding *, ? or [ against
   # its working directory, and read whatever names matched as request lines.
   old_ifs=$IFS
   IFS='
'
   set -f
   for line in $text; do
      IFS=$old_ifs
      case "$line" in
         "") continue ;;
         *=*) ;;
         *) refuse "the request has a line that is not key=value" ;;
      esac
      key=${line%%=*}
      value=${line#*=}
      case "$key" in
         kind)             KIND=$value ;;
         version)          VERSION=$value ;;
         package)          PACKAGE=$value ;;
         rollback)         ROLLBACK=$value ;;
         rollback_version) ROLLBACK_VERSION=$value ;;
         unit)             UNIT=$value ;;
         outcome)          OUTCOME=$value ;;
         log)              LOG_FILE=$value ;;
         wait)             WAIT=$value ;;
         ready_url)        READY_URL=$value ;;
         image)            IMAGE=$value ;;
         *) say "ignoring a key this program does not know: $key" ;;
      esac
   done
   set +f
   IFS=$old_ifs
}

# A refused request is reported to the journal and nowhere else. Nothing has
# been stopped, so a process may still be running as the owner of the Updates
# directory, and root does not write into a directory whose owner is alive to
# swap a file for a symlink between the check and the write - not even the one
# line that would say why. The server sees a request that was taken and never
# answered within its wait, and reports that with a pointer to this journal.
refuse()
{
   say "hmailserver-update: the request was refused: $*"
   exit 4
}

is_version()
{
   case "$1" in
      ""|*[!0-9A-Za-z._-]*|.*|-*) return 1 ;;
   esac
   [ ${#1} -le 64 ]
}

is_number()
{
   case "$1" in
      ""|*[!0-9]*) return 1 ;;
   esac
   return 0
}

# The path, resolved, lies inside the directory: no symlink anywhere in it
# leads out. $1 is a path that exists; $2 the directory, already resolved.
inside()
{
   resolved="$(realpath -e -- "$1" 2>/dev/null)" || return 1
   case "$resolved" in
      "$2"/*) return 0 ;;
   esac
   return 1
}

# A file this program will READ as root: it exists, it is a regular file, it is
# not a symlink itself and it resolves to somewhere under the Updates directory.
check_input_file()
{
   what=$1
   path=$2
   case "$path" in
      /*) ;;
      *) refuse "$what is not an absolute path: $path" ;;
   esac
   [ ! -L "$path" ] || refuse "$what is a symbolic link: $path"
   [ -f "$path" ] || refuse "$what is not a file: $path"
   inside "$path" "$UPDATES_DIR" || refuse "$what is not inside $UPDATES_DIR: $path"
}

# A file this program will WRITE as root: its directory IS the Updates
# directory (not merely under it), and the file, if it is there, is a regular
# file and not a symlink.
check_output_file()
{
   what=$1
   path=$2
   case "$path" in
      /*) ;;
      *) refuse "$what is not an absolute path: $path" ;;
   esac
   parent="$(realpath -e -- "$(dirname -- "$path")" 2>/dev/null)" || refuse "$what is in a directory that does not exist: $path"
   [ "$parent" = "$UPDATES_DIR" ] || refuse "$what is not directly inside $UPDATES_DIR: $path"
   [ ! -L "$path" ] || refuse "$what is a symbolic link: $path"
   [ ! -e "$path" ] || [ -f "$path" ] || refuse "$what exists and is not a regular file: $path"
}

# Where the Updates directory is. From --updates-dir when the caller gave one;
# otherwise from DataFolder in root's own configuration file, which the service
# cannot write - so the answer is root's and not the requester's.
find_updates_dir()
{
   if [ -z "$UPDATES_DIR" ]; then
      [ -r "$CONFIG" ] || die 3 "$CONFIG cannot be read, so the Updates directory is not known; give --updates-dir."
      data="$(sed -n 's/^[[:space:]]*DataFolder[[:space:]]*=[[:space:]]*//p' "$CONFIG" | head -n 1 | tr -d '\r')"
      [ -n "$data" ] || die 3 "$CONFIG has no DataFolder line, so the Updates directory is not known."
      UPDATES_DIR="${data%/}/Updates"
   fi
   case "$UPDATES_DIR" in
      /*) ;;
      *) die 3 "the Updates directory is not an absolute path: $UPDATES_DIR" ;;
   esac
   resolved="$(realpath -e -- "$UPDATES_DIR" 2>/dev/null)" || die 3 "the Updates directory does not exist: $UPDATES_DIR"
   UPDATES_DIR=$resolved
}

check_request()
{
   case "$KIND" in
      deb|rpm|appimage) ;;
      *) refuse "kind must be deb, rpm or appimage: '$KIND'" ;;
   esac
   is_version "$VERSION" || refuse "version is not a version: '$VERSION'"

   case "$UNIT" in
      hmailserver.service|hmailserver[0-9A-Za-z@._-]*.service) ;;
      *) refuse "unit must be the server's own unit: '$UNIT'" ;;
   esac

   [ -n "$OUTCOME" ] || refuse "the request names no outcome file"
   check_output_file "outcome" "$OUTCOME"

   if [ -n "$LOG_FILE" ]; then
      check_output_file "log" "$LOG_FILE"
   fi

   [ -n "$PACKAGE" ] || refuse "the request names no package"
   check_input_file "package" "$PACKAGE"

   if [ -n "$ROLLBACK" ] || [ -n "$ROLLBACK_VERSION" ]; then
      [ -n "$ROLLBACK" ] && [ -n "$ROLLBACK_VERSION" ] || refuse "rollback and rollback_version go together"
      is_version "$ROLLBACK_VERSION" || refuse "rollback_version is not a version: '$ROLLBACK_VERSION'"
      check_input_file "rollback" "$ROLLBACK"
   fi

   if ! is_number "$WAIT" || [ "$WAIT" -lt 1 ] || [ "$WAIT" -gt 3600 ]; then
      WAIT=180
   fi

   # Only a loopback /readyz is probed. Anything else is ignored rather than
   # refused: the probe is a courtesy, and root fetching an arbitrary URL is not.
   case "$READY_URL" in
      "") ;;
      http://127.0.0.1:[0-9]*/readyz|http://localhost:[0-9]*/readyz|http://\[::1\]:[0-9]*/readyz) ;;
      *) say "ready_url is not a loopback /readyz and is ignored: $READY_URL"; READY_URL="" ;;
   esac

   if [ "$KIND" = appimage ]; then
      # The image is executed (to verify the new one) and replaced, by whoever
      # runs this - root, under the units. It has to be that user's already: a
      # regular file, owned by them, writable by nobody else, in a directory of
      # the same standing. A path the requester could write to would let it
      # choose what root runs.
      [ -n "$IMAGE" ] || refuse "an appimage request names no image"
      case "$IMAGE" in
         /*) ;;
         *) refuse "image is not an absolute path: $IMAGE" ;;
      esac
      [ ! -L "$IMAGE" ] || refuse "image is a symbolic link: $IMAGE"
      [ -f "$IMAGE" ] || refuse "image is not a file: $IMAGE"
      me="$(id -u)"
      owner="$(stat -c '%u' -- "$IMAGE")"
      mode="$(stat -c '%a' -- "$IMAGE")"
      [ "$owner" = "$me" ] || refuse "image is not owned by the user applying the update (uid $me): $IMAGE"
      # Three or four octal digits; the last two - group and others - must not
      # carry the write bit, which is the 2 in 2, 3, 6 and 7: 0, 1, 4 and 5 are
      # the digits without it.
      case "$mode" in
         ?[0145][0145]|??[0145][0145]) ;;
         *) refuse "image is writable by its group or by others (mode $mode): $IMAGE" ;;
      esac
      image_dir="$(dirname -- "$IMAGE")"
      dir_mode="$(stat -c '%a' -- "$image_dir")"
      [ "$(stat -c '%u' -- "$image_dir")" = "$me" ] || refuse "the image's directory is not owned by the user applying the update (uid $me): $image_dir"
      case "$dir_mode" in
         ?[0145][0145]|??[0145][0145]) ;;
         *) refuse "the image's directory is writable by its group or by others (mode $dir_mode): $image_dir" ;;
      esac
   else
      [ -z "$IMAGE" ] || refuse "image is only for an appimage request"
   fi
}

# ------------------------------------------------------------------ doing

# Every command that changes the machine goes through here, which is what
# --dry-run switches off.
run()
{
   if [ "$DRY_RUN" = 1 ]; then
      say "would run: $*"
      return 0
   fi
   say "running: $*"
   "$@"
}

stop_unit()
{
   # The server has already closed its listeners and paused its queue before it
   # handed over this request (its own log says so); the stop finishes the
   # sessions and deliveries in flight, up to its ShutdownDrainSeconds.
   run systemctl stop "$UNIT"
}

start_unit()
{
   run systemctl start "$UNIT"
}

unit_state()
{
   systemctl show -p ActiveState --value "$UNIT" 2>/dev/null || echo unknown
}

unit_restarts()
{
   systemctl show -p NRestarts --value "$UNIT" 2>/dev/null || echo 0
}

probe_ready()
{
   [ -n "$READY_URL" ] || return 0
   if command -v curl >/dev/null 2>&1; then
      curl -fsS -m 5 -o /dev/null "$READY_URL" 2>/dev/null
   elif command -v wget >/dev/null 2>&1; then
      wget -q -T 5 -O /dev/null "$READY_URL" 2>/dev/null
   else
      # Nothing to probe with: the unit's own state is the answer.
      return 0
   fi
}

# True when the unit has been active, unrestarted, for SETTLE_SECONDS in a row -
# and /readyz answers, when there is one - within WAIT seconds of now. A unit
# under Restart=on-failure that keeps dying reads active for a moment at a time,
# which is why "active once" is not the test. WAIT_WHY says, when this answers
# false, what was seen: the unit's state, that it kept restarting, or that it
# was active and the probe never answered - a server up without its database
# reads as the last of those.
WAIT_WHY=""

wait_for_service()
{
   [ "$DRY_RUN" = 1 ] && return 0
   deadline=$(( $(date +%s) + WAIT ))
   first_restarts="$(unit_restarts)"
   base_restarts=$first_restarts
   steady=0
   probed=0
   state=unknown
   while [ "$(date +%s)" -lt "$deadline" ]; do
      state="$(unit_state)"
      restarts="$(unit_restarts)"
      probed=0
      if [ "$state" = active ] && [ "$restarts" = "$base_restarts" ]; then
         if probe_ready; then
            probed=1
         fi
      fi
      if [ "$probed" = 1 ]; then
         steady=$((steady + POLL_SECONDS))
         [ "$steady" -ge "$SETTLE_SECONDS" ] && return 0
      else
         steady=0
         [ "$restarts" = "$base_restarts" ] || base_restarts=$restarts
      fi
      sleep "$POLL_SECONDS"
   done
   restarts="$(unit_restarts)"
   if [ "$restarts" != "$first_restarts" ]; then
      WAIT_WHY="restarted $((restarts - first_restarts)) time(s) in ${WAIT}s"
   elif [ "$state" = active ] && [ -n "$READY_URL" ]; then
      WAIT_WHY="active, but $READY_URL did not answer 200"
   else
      WAIT_WHY="$state"
   fi
   return 1
}

# hmailserver --verify-update: the file's SHA-256 is the one the bundle signs
# and the log recorded, the certificate chains to Fulcio at the time the log
# recorded it, it names this repository's release workflow, and the log vouches
# for the entry - with the trust the ROOT-OWNED configuration names, or the
# public Sigstore instance when it names none. For an AppImage the running image
# is the verifier, with a scratch home so that it reads nobody's configuration
# and takes the built-in trust.
verify_file()
{
   what=$1
   file=$2
   if [ "$DRY_RUN" = 1 ]; then
      say "would verify $what $file against $file.cosign.bundle"
      return 0
   fi
   say "verifying $what $file against its Sigstore bundle"
   if [ "$KIND" = appimage ]; then
      scratch="$(mktemp -d)"
      HMAILSERVER_HOME="$scratch" "$IMAGE" --verify-update "$file"
      result=$?
      rm -rf "$scratch"
   else
      "$PROGRAM" --verify-update "$file"
      result=$?
   fi
   return $result
}

# The upstream version a package carries, read from the package itself - the
# deb's control file, the rpm's header, the AppImage's own --version - and never
# from the request or the file name. Empty when it cannot be read.
package_version()
{
   file=$1
   case "$KIND" in
      deb)
         v="$(dpkg-deb -f "$file" Version 2>/dev/null)" || v=""
         # A Debian revision, if a package ever carries one, is not the version.
         v=${v%-*}
         ;;
      rpm)
         v="$(rpm -qp --qf '%{VERSION}' "$file" 2>/dev/null)" || v=""
         ;;
      appimage)
         # A verified image only: this runs it.
         v="$("$file" --version 2>/dev/null | sed -n 's/^hMailServer \([^ ]*\).*/\1/p' | head -n 1)"
         ;;
   esac
   printf '%s' "$v"
}

# The version installed now, from the package database - or, for an AppImage,
# from the running image. Empty when there is none, or it cannot be read.
installed_version()
{
   case "$KIND" in
      deb)
         v="$(dpkg-query -W -f='${Version}' hmailserver 2>/dev/null)" || v=""
         v=${v%-*}
         ;;
      rpm)
         v="$(rpm -q --qf '%{VERSION}' hmailserver 2>/dev/null)" || v=""
         ;;
      appimage)
         v="$("$IMAGE" --version 2>/dev/null | sed -n 's/^hMailServer \([^ ]*\).*/\1/p' | head -n 1)"
         ;;
   esac
   printf '%s' "$v"
}

# True when $1 is a newer version than $2: dpkg's own comparison where dpkg is,
# GNU version sort otherwise. Equal is not newer.
is_newer()
{
   [ "$1" != "$2" ] || return 1
   if [ "$KIND" = deb ] && command -v dpkg >/dev/null 2>&1; then
      dpkg --compare-versions "$1" gt "$2"
      return $?
   fi
   [ "$(printf '%s\n%s\n' "$2" "$1" | sort -V | tail -n 1)" = "$1" ]
}

install_package()
{
   file=$1
   downgrade=$2      # 1 for the rollback: an older version over a newer one
   case "$KIND" in
      deb)
         # apt-get where it is, for the dependencies a newer package may add;
         # dpkg on a machine without it. Both wait for the lock rather than fail
         # on an unattended-upgrades run that happens to be under way. Only the
         # rollback is allowed to be a downgrade.
         #
         # Quietly, for the journal this runs into: -q leaves out apt's progress
         # indicators, and Dpkg::Use-Pty=0 runs dpkg without the terminal apt
         # otherwise gives it, under which dpkg rewrites its "Reading database"
         # line in place with carriage returns - which journald stored as
         # "[614B blob data]" in the first real Linux live update (29 September
         # 2026). Progress-Fancy=0 is the status bar's own switch, off with it.
         # What was installed and every message is still there.
         export DEBIAN_FRONTEND=noninteractive
         if command -v apt-get >/dev/null 2>&1; then
            if [ "$downgrade" = 1 ]; then
               run apt-get install -y -q --no-install-recommends --allow-downgrades \
                  -o DPkg::Lock::Timeout=300 -o Dpkg::Use-Pty=0 -o Dpkg::Progress-Fancy=0 "$file"
            else
               run apt-get install -y -q --no-install-recommends \
                  -o DPkg::Lock::Timeout=300 -o Dpkg::Use-Pty=0 -o Dpkg::Progress-Fancy=0 "$file"
            fi
         else
            run dpkg -i "$file"
         fi
         ;;
      rpm)
         if [ "$downgrade" = 1 ]; then
            # rpm itself, and --oldpackage: the one operation dnf makes hard
            # is putting an older local file over a newer installed one.
            run rpm -Uvh --oldpackage "$file"
         elif command -v dnf >/dev/null 2>&1; then
            run dnf install -y "$file"
         else
            run rpm -Uvh "$file"
         fi
         ;;
      appimage)
         swap_image "$file"
         ;;
   esac
}

# The AppImage swap. The new file is copied beside the old one first, so that
# the rename that puts it in place is atomic and on one file system; the old one
# is kept as <image>.previous, which is what a rollback puts back. Owner and mode
# follow the file being replaced.
swap_image()
{
   file=$1
   if [ "$DRY_RUN" = 1 ]; then
      say "would copy $file to $IMAGE.new, keep $IMAGE as $IMAGE.previous and rename $IMAGE.new to $IMAGE"
      return 0
   fi
   say "swapping $IMAGE for $file"
   cp -f -- "$file" "$IMAGE.new" || return 1
   chown --reference="$IMAGE" -- "$IMAGE.new" || return 1
   chmod --reference="$IMAGE" -- "$IMAGE.new" || return 1
   rm -f -- "$IMAGE.previous"
   ln -- "$IMAGE" "$IMAGE.previous" 2>/dev/null || cp -p -- "$IMAGE" "$IMAGE.previous" || return 1
   mv -f -- "$IMAGE.new" "$IMAGE"
}

restore_image()
{
   if [ "$DRY_RUN" = 1 ]; then
      say "would rename $IMAGE.previous back to $IMAGE"
      return 0
   fi
   [ -f "$IMAGE.previous" ] || return 1
   say "putting $IMAGE.previous back as $IMAGE"
   mv -f -- "$IMAGE.previous" "$IMAGE"
}

# One line: "<status> <version> <detail>", written whole to a file this program
# makes under a name nobody could have planted (mktemp: a random name, opened
# O_EXCL, so no symlink waiting under a guessable name is ever followed) and
# renamed into place - which replaces whatever is at the outcome path, symlink
# included, without following it. Owned by whoever owns the Updates directory
# so that the server can move it aside once it has reported it. A newline
# inside the detail would make a second line the server never reads, so there
# is none. Only called after the unit is stopped, never on a refusal.
write_outcome()
{
   status=$1
   version=$2
   detail="$(printf '%s' "$3" | tr '\n\r' '  ')"
   line="$status $version $detail"
   say "outcome: $line"
   if [ "$DRY_RUN" = 1 ]; then
      return 0
   fi
   [ -n "$OUTCOME" ] || return 0
   tmp="$(mktemp "$UPDATES_DIR/last-apply.XXXXXX" 2>/dev/null)" || { say "no file could be made in $UPDATES_DIR for the outcome"; return 1; }
   printf '%s\n' "$line" > "$tmp" || { say "the outcome could not be written to $tmp"; rm -f -- "$tmp"; return 1; }
   chown --reference="$UPDATES_DIR" -- "$tmp" 2>/dev/null || true
   chmod 0640 -- "$tmp" 2>/dev/null || true
   mv -f -- "$tmp" "$OUTCOME"
}

# ------------------------------------------------------------------ apply

apply()
{
   read_request
   find_updates_dir
   check_request

   if [ -n "$ROLLBACK" ]; then
      say "hmailserver-update: applying hMailServer $VERSION from $PACKAGE ($KIND); rollback image $ROLLBACK ($ROLLBACK_VERSION); unit $UNIT; waiting up to ${WAIT}s"
   else
      say "hmailserver-update: applying hMailServer $VERSION from $PACKAGE ($KIND); no rollback image; unit $UNIT; waiting up to ${WAIT}s"
   fi

   # The server is answering the request that started this. A moment for that
   # answer to leave before its listener goes.
   [ "$DRY_RUN" = 1 ] || sleep "$PAUSE_SECONDS"

   if ! stop_unit; then
      say "hmailserver-update: $UNIT could not be stopped, so nothing was installed and nothing is written."
      return 1
   fi
   # Nothing runs as the service user now; the Updates directory may be
   # written, and the log starts.
   open_log
   say "$UNIT is stopped."

   if ! verify_file "the package" "$PACKAGE"; then
      start_unit
      write_outcome "failed" "$VERSION" "the package did not verify against its Sigstore bundle when checked as root, so nothing was installed; the service was started again on the version it had"
      return 1
   fi

   # Signed is not enough: every release ever made is signed. The package must
   # be newer than what the package database says is installed - both read by
   # root, neither taken from the request - or a taken-over service could have
   # a superseded release put back.
   new_version="$(package_version "$PACKAGE")"
   old_version="$(installed_version)"
   if [ -z "$new_version" ]; then
      start_unit
      write_outcome "failed" "$VERSION" "the package's own version could not be read from it, so nothing was installed; the service was started again on the version it had"
      return 1
   fi
   if [ "$new_version" != "$VERSION" ]; then
      say "the request says version $VERSION and the package says $new_version; the package's word is the one reported."
      VERSION=$new_version
   fi
   if [ -n "$old_version" ] && ! is_newer "$new_version" "$old_version"; then
      start_unit
      write_outcome "failed" "$VERSION" "the package is version $new_version and the installed version is $old_version: not an upgrade, so nothing was installed; the service was started again on the version it had"
      return 1
   fi
   [ -n "$old_version" ] || say "no installed version is recorded for hmailserver; installing $new_version over whatever is here."

   if [ -n "$ROLLBACK" ] && ! verify_file "the rollback image" "$ROLLBACK"; then
      say "the rollback image did not verify; continuing without one."
      ROLLBACK=""
      ROLLBACK_VERSION=""
   fi
   # The rollback image, when there is one, must be the version installed now:
   # for a package, checked against the package database; an AppImage rolls
   # back to the file it replaced, whatever the request named.
   if [ -n "$ROLLBACK" ] && [ "$KIND" != appimage ]; then
      rollback_version="$(package_version "$ROLLBACK")"
      if [ -z "$old_version" ] || [ "$rollback_version" != "$old_version" ]; then
         say "the rollback image is version '${rollback_version:-unreadable}' and the installed version is '${old_version:-unknown}'; continuing without one."
         ROLLBACK=""
         ROLLBACK_VERSION=""
      else
         ROLLBACK_VERSION=$rollback_version
      fi
   fi

   install_package "$PACKAGE" 0
   code=$?
   say "the install step exited with $code."

   start_unit
   if wait_for_service; then
      running=1
   else
      running=0
   fi

   if [ "$code" = 0 ] && [ "$running" = 1 ]; then
      write_outcome "ok" "$VERSION" "the package was installed and the service is running"
      return 0
   fi

   if [ "$running" = 1 ]; then
      write_outcome "failed" "$VERSION" "the install step exited with $code but the service is running; see ${LOG_FILE:-the journal of hmailserver-update.service}"
      return 1
   fi

   if [ "$code" = 0 ]; then
      reason="the package was installed but the service was not back after ${WAIT} seconds ($WAIT_WHY)"
   else
      reason="the install step exited with $code and the service was not back ($WAIT_WHY)"
   fi

   if [ -z "$ROLLBACK" ]; then
      write_outcome "no-rollback" "$VERSION" "$reason; no rollback image was available; see ${LOG_FILE:-the journal of hmailserver-update.service}"
      return 1
   fi

   say "rolling back to hMailServer $ROLLBACK_VERSION: $reason"
   stop_unit
   if [ "$KIND" = appimage ]; then
      restore_image
      rollback_code=$?
   else
      install_package "$ROLLBACK" 1
      rollback_code=$?
   fi
   start_unit
   if wait_for_service; then
      write_outcome "rolled-back" "$VERSION" "$reason; hMailServer $ROLLBACK_VERSION was reinstalled and the service is running; see ${LOG_FILE:-the journal of hmailserver-update.service}"
      return 1
   fi

   write_outcome "rollback-failed" "$VERSION" "$reason; the rollback to $ROLLBACK_VERSION exited with $rollback_code and the service is not back ($WAIT_WHY); see ${LOG_FILE:-the journal of hmailserver-update.service}"
   return 1
}

# ------------------------------------------------------------------ check

check()
{
   problems=0
   if [ -x "$PROGRAM" ]; then
      echo "server:      $PROGRAM ($("$PROGRAM" --version 2>/dev/null || echo 'does not run'))"
   else
      echo "server:      $PROGRAM is not here; only an AppImage under a root unit can be updated from this machine"
   fi
   if [ -r "$CONFIG" ]; then
      data="$(sed -n 's/^[[:space:]]*DataFolder[[:space:]]*=[[:space:]]*//p' "$CONFIG" | head -n 1 | tr -d '\r')"
      echo "updates in:  ${data%/}/Updates"
   else
      echo "config:      $CONFIG is not readable (run this as root); the Updates directory comes from its DataFolder"
      problems=$((problems + 1))
   fi
   if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
      state="$(systemctl is-active "$PATH_UNIT" 2>/dev/null || true)"
      if [ "$state" = active ]; then
         echo "trigger:     $PATH_UNIT is active; a request in /run/hmailserver/apply-request starts hmailserver-update.service"
      else
         echo "trigger:     $PATH_UNIT is ${state:-not installed}; enable it: systemctl enable --now $PATH_UNIT"
         problems=$((problems + 1))
      fi
      if systemctl show -p RuntimeDirectory --value "$UNIT_DEFAULT" 2>/dev/null | grep -q hmailserver; then
         echo "runtime dir: $UNIT_DEFAULT has RuntimeDirectory=hmailserver, so the server can write the request"
      else
         echo "runtime dir: $UNIT_DEFAULT has no RuntimeDirectory=hmailserver; a server started under an older unit cannot write the request until it is restarted under this one"
         problems=$((problems + 1))
      fi
   else
      echo "systemd:     not running here; there is no unit to stop and start, so there is no live update on this machine"
      problems=$((problems + 1))
   fi
   if command -v apt-get >/dev/null 2>&1; then
      echo "installer:   apt-get"
   elif command -v dpkg >/dev/null 2>&1; then
      echo "installer:   dpkg"
   elif command -v dnf >/dev/null 2>&1; then
      echo "installer:   dnf (rpm --oldpackage for a rollback)"
   elif command -v rpm >/dev/null 2>&1; then
      echo "installer:   rpm"
   else
      echo "installer:   neither dpkg nor rpm; only an AppImage swap is possible"
   fi
   if command -v curl >/dev/null 2>&1 || command -v wget >/dev/null 2>&1; then
      echo "probe:       /readyz will be probed when the metrics listener is on"
   else
      echo "probe:       neither curl nor wget; the unit's own state decides whether the server came back"
   fi
   [ "$problems" -eq 0 ]
}

# ------------------------------------------------------------------ main

usage()
{
   echo "usage: hmailserver-update apply --request FILE [--updates-dir DIR] [--dry-run]" >&2
   echo "       hmailserver-update check" >&2
   exit 64
}

verb=${1:-}
[ $# -ge 1 ] && shift
case "$verb" in
   apply)
      while [ $# -gt 0 ]; do
         case "$1" in
            --request) [ $# -ge 2 ] || usage; REQUEST=$2; shift 2 ;;
            --updates-dir) [ $# -ge 2 ] || usage; UPDATES_DIR=$2; shift 2 ;;
            --dry-run) DRY_RUN=1; shift ;;
            *) usage ;;
         esac
      done
      [ -n "$REQUEST" ] || usage
      apply
      ;;
   check)
      check
      ;;
   *)
      usage
      ;;
esac
