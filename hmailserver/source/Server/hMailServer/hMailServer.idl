[
   object,
   uuid(C3E2DFFB-BE53-4BE6-BE57-7C5609938CEB),
   dual,
   nonextensible,
   helpstring("The Status object contains information on your system, such as uptime and basic statistics."),
   pointer_default(unique)
]
interface IInterfaceStatus : IDispatch {
   [propget, id(1), helpstring("Gets a list of undelivered messages.")] HRESULT UndeliveredMessages([out, retval] BSTR *pVal);
   [propget, id(2), helpstring("Gets the server start time")] HRESULT StartTime([out, retval] BSTR *pVal);
   [propget, id(3), helpstring("Gets the number of delivered messages")] HRESULT ProcessedMessages([out, retval] long *pVal);
   [propget, id(4), helpstring("Gets the number of removed virues")] HRESULT RemovedViruses([out, retval] long *pVal);
   [propget, id(5), helpstring("Gets the number of detected spam messages")] HRESULT RemovedSpamMessages([out, retval] long *pVal);
   [propget, id(6), helpstring("Gets the current number of sessions")] HRESULT SessionCount([in] eSessionType iType, [out, retval] long *pVal);
   [propget, id(7), helpstring("Gets the current thread number")] HRESULT ThreadID([out, retval] long *pVal);
   [propget, id(8), helpstring("The update check's verdict: 0 no check has completed since the service started, 1 this is the latest release, 2 a newer release is available (see AvailableVersion), 3 its installer is downloaded and verified, 4 it is being installed, 5 the last check failed (see UpdateLastError), 6 an administrator's install of it is being prepared and 7 it is ready for the administrator's install (see UpdatePreparation).")] HRESULT UpdateState([out, retval] long *pVal);
   [propget, id(9), helpstring("The newer release's version, when UpdateState says there is one; otherwise empty.")] HRESULT AvailableVersion([out, retval] BSTR *pVal);
   [propget, id(10), helpstring("When the newer release was published, as the feed gives it (ISO 8601, UTC).")] HRESULT AvailableVersionPublished([out, retval] BSTR *pVal);
   [propget, id(11), helpstring("The newer release's page.")] HRESULT AvailableVersionUrl([out, retval] BSTR *pVal);
   [propget, id(12), helpstring("When the release feed was last read, local time; empty until it has been.")] HRESULT UpdateLastChecked([out, retval] BSTR *pVal);
   [propget, id(13), helpstring("Why the last check failed; empty when it did not.")] HRESULT UpdateLastError([out, retval] BSTR *pVal);
   [id(14), helpstring("Reads the release feed now, whether or not the scheduled check (UpdateCheckEnabled) is on, and returns whether it could be read. The properties above then say what it said.")] HRESULT CheckForUpdate([out, retval] VARIANT_BOOL *pVal);
   [id(15), helpstring("Downloads the installer of the newer release the last check found, with its Sigstore bundle, into the data directory's Updates folder, and verifies it against the bundle: the file's digest, the signing certificate's chain to the Fulcio authority at the time the transparency log recorded the signature, the certificate's identity (one of this project's release signers: the GitHub workflow for a release up to 6.3.3, the GitLab CI pipeline of its tag after), the signature, and the log's own signature. Returns whether the installer is in place and verified; when it is not, the files are deleted and UpdateLastError says why. Nothing is run.")] HRESULT DownloadUpdate([out, retval] VARIANT_BOOL *pVal);
   [propget, id(16), helpstring("Where the verified installer is, once UpdateState is 3 or later; otherwise empty.")] HRESULT UpdateInstallerPath([out, retval] BSTR *pVal);
   [propget, id(17), helpstring("The identity the verified installer's signing certificate names: the release workflow and the ref it ran from.")] HRESULT UpdateSignerIdentity([out, retval] BSTR *pVal);
   [id(18), helpstring("Applies the verified installer: verifies it once more, fetches and verifies the running version's installer as the rollback image where the feed still offers it, issues the single-use token the database upgrade will present, and hands the installer to hMailServer.Updater, which runs it, waits for the service to come back, runs the rollback image if it does not, and writes an outcome the service reports when it next starts (UpdateApplyOutcome). Returns whether the helper was started; the update itself happens after this returns, and the service stops and starts during it.")] HRESULT InstallUpdate([out, retval] VARIANT_BOOL *pVal);
   [propget, id(19), helpstring("The last apply's outcome as reported at startup: \"<status> <version>: <detail>\", where status is ok, failed, rolled-back, rollback-failed or no-rollback; empty when no apply has been reported since the service started.")] HRESULT UpdateApplyOutcome([out, retval] BSTR *pVal);
   [propget, id(20), helpstring("Whether this service cannot run an installer, so that an update is installed by an administrator with Install update in the Control Panel on this server (docs/ServiceAccount.md): true on Windows under an account that is not an administrator, such as NT SERVICE\\hMailServer; false on LocalSystem, where InstallUpdate hands the installer to the update helper.")] HRESULT UpdateNeedsAdministrator([out, retval] VARIANT_BOOL *pVal);
   [propget, id(21), helpstring("The sentence that says who installs an update here and how, when an administrator does; empty when the service installs updates itself.")] HRESULT UpdateInstallAdvice([out, retval] BSTR *pVal);
   [id(22), helpstring("Asks this service to prepare an administrator's install of the downloaded release releaseVersion: it checks the installer again, takes the backup (unless skipBackup, or none is configured), fetches and verifies the rollback image, and moves UpdateState to 6 and then 7 (or 5, with UpdateLastError and UpdatePreparation saying where it failed). Returns at once. Refused - false, with UpdateLastError, and the state unchanged - unless UpdateNeedsAdministrator, the call comes from this computer, the installer is waiting, and nothing is draining. The Control Panel on the server calls it while its elevated stage checks the installer; nothing elevated takes anything from this service's answer.")] HRESULT PrepareUpdateForAdministrator([in] BSTR releaseVersion, [in, defaultvalue(0)] VARIANT_BOOL skipBackup, [out, retval] VARIANT_BOOL *pVal);
   [propget, id(23), helpstring("While an administrator's install is prepared (UpdateState 6 or 7, or 5 when the preparation failed): a JSON document - step (check, backup, rollback, ready or failed), backup (taken, running, skipped, failed, path), rollback (version, ready, reason) and error. Empty otherwise.")] HRESULT UpdatePreparation([out, retval] BSTR *pVal);
   [id(24), helpstring("Begins the administrator's install of releaseVersion, which must be prepared (UpdateState 7): issues the single-use token the new installer's database upgrade presents, drains the server and moves UpdateState to 4. From this computer only. Returns false, with UpdateLastError, when it is refused - the server is already draining, or the preparation is not ready.")] HRESULT BeginUpdateForAdministrator([in] BSTR releaseVersion, [out, retval] VARIANT_BOOL *pVal);
   [id(25), helpstring("Cancels an administrator's install before it has started: stops the preparation where it is, revokes the token, leaves the drain BeginUpdateForAdministrator entered, and puts UpdateState back to 3. cancelReason goes to the log and the audit trail. From this computer only.")] HRESULT CancelUpdateForAdministrator([in] BSTR cancelReason);
};

[
   object,
   uuid(A4C709A3-98B2-410D-84F4-EDA999BF0CB2),
   dual,
   nonextensible,
   helpstring("The Settings object is the root-object for all hMailServer settings which are not related to a specific domain."),
   pointer_default(unique)
]
interface IInterfaceSettings : IDispatch{
   [propget, id(5), helpstring("Gets or sets the maximum number of simultaneous SMTP connections.")] HRESULT MaxSMTPConnections([out, retval] long *pVal);
   [propput, id(5), helpstring("Gets or sets the maximum number of simultaneous SMTP connections.")] HRESULT MaxSMTPConnections([in] long newVal);
   [propget, id(6), helpstring("Gets or sets the maximum number of simultaneous POP3 connections.")] HRESULT MaxPOP3Connections([out, retval] long *pVal);
   [propput, id(6), helpstring("Gets or sets the maximum number of simultaneous POP3 connections.")] HRESULT MaxPOP3Connections([in] long newVal);
   [propget, id(7), helpstring("A copy of all e-mails are sent to the address.")] HRESULT MirrorEMailAddress([out, retval] BSTR *pVal);
   [propput, id(7), helpstring("A copy of all e-mails are sent to the address.")] HRESULT MirrorEMailAddress([in] BSTR newVal);
   [propget, id(8), helpstring("Allow plain SMTP authentication.")] HRESULT AllowSMTPAuthPlain([out, retval] VARIANT_BOOL *pVal);
   [propput, id(8), helpstring("Allow plain SMTP authentication.")] HRESULT AllowSMTPAuthPlain([in] VARIANT_BOOL newVal);
   [propget, id(11), helpstring("Deny mail with empty sender address.")] HRESULT DenyMailFromNull([out, retval] VARIANT_BOOL *pVal);
   [propput, id(11), helpstring("Deny mail with empty sender address.")] HRESULT DenyMailFromNull([in] VARIANT_BOOL newVal);
   [propget, id(13), helpstring("Gets the logging interface.")] HRESULT Logging([out, retval] IInterfaceLogging * *pVal);
