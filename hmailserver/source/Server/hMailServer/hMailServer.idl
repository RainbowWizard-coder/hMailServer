[
   object,
   uuid(E773E8FC-1C9A-4E96-A73C-CC02E7649637),
   dual,
   nonextensible,
   helpstring("The BackupManager is the object which starts and restores backups."),
   pointer_default(unique)
]
interface IInterfaceBackupManager : IDispatch
{
   [id(1), helpstring("Starts a backup.")] HRESULT StartBackup();
   [id(2), helpstring("Loads a backup from a file.")] HRESULT LoadBackup([in] BSTR sXMLFile, [out, retval] IInterfaceBackup ** pVal);
   [id(3), helpstring("Loads a backup from a file with the passphrase it was encrypted with, to be restored. Fails with the reason - the passphrase is missing, the passphrase is wrong or the archive is damaged, the archive is from a newer version - before anything on this server is touched. An archive that is not encrypted opens here too, with any passphrase or none.")] HRESULT LoadEncryptedBackup([in] BSTR File, [in] BSTR Passphrase, [out, retval] IInterfaceBackup ** pVal);
   [id(4), helpstring("Restores one account's mailbox from a backup archive in the backup destination - named as the archive listing names it, or by its path there - without touching the account's settings, rules, contacts or calendars, or any other account. Mode is merge (each archived folder that is missing is created and each archived message whose file is not in the live mailbox is added) or replace (every live folder is emptied first, then filled as merge would; mail that arrived since the backup is gone). Passphrase is an encrypted archive's, or empty. Fails with the reason - no such archive, the archive outside the destination, no such account in it or on this server - before anything is touched; otherwise the restore is queued under the backup manager's run slot and the job number is returned, for MailboxRestoreStatus.")] HRESULT RestoreMailbox([in] BSTR File, [in] BSTR Address, [in] BSTR Mode, [in] BSTR Passphrase, [out, retval] long *Job);
   [id(5), helpstring("Restores one message of an account from a backup archive: MessageID is the id DescribeMailbox lists it under, and Folder the live folder path to put it in, or empty for the folder it was in. A message whose file is still in the mailbox is not added twice. Passphrase is an encrypted archive's, or empty. Returns the job number, for MailboxRestoreStatus.")] HRESULT RestoreMessage([in] BSTR File, [in] BSTR Address, [in] hyper MessageID, [in] BSTR Folder, [in] BSTR Passphrase, [out, retval] long *Job);
   [id(6), helpstring("One account's folders and messages as a backup archive holds them, as the JSON document GET /api/v1/backup/{archive}/mailboxes/{address} answers: archive, address, folders (path, subscribed, special_use, messages with id, folder, subject, from, date, size, flags, keywords), messages, subjects and subjects_note. Subjects are read from the message files for a listing of at most 500 messages. Passphrase is an encrypted archive's, or empty.")] HRESULT DescribeMailbox([in] BSTR File, [in] BSTR Address, [in] BSTR Passphrase, [out, retval] BSTR *Json);
   [id(7), helpstring("What became of a mailbox restore, by its job number, as the JSON document GET /api/v1/backup/restore-mailbox/{job} answers: job, state (queued, running, done or failed), archive, address, mode, message, folders, added, skipped, failed, error, started and finished. The last fifty jobs are kept for the life of the process; an unknown job fails.")] HRESULT MailboxRestoreStatus([in] long Job, [out, retval] BSTR *Json);

};
