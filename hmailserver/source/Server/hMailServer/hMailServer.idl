   [propput, id(153), helpstring("Publish this server's accounts' OpenPGP public keys as a Web Key Directory. Off by default, and with it off nothing is served whatever a domain or an account says.")] HRESULT OpenPGPWebKeyDirectoryEnabled([in] VARIANT_BOOL newVal);
   [propget, id(154), helpstring("The largest OpenPGP key this server will accept, in bytes of the key itself. 1024 to 1048576; default 65536.")] HRESULT OpenPGPKeyMaximumBytes([out, retval] long *pVal);
   [propput, id(154), helpstring("The largest OpenPGP key this server will accept, in bytes of the key itself. 1024 to 1048576; default 65536.")] HRESULT OpenPGPKeyMaximumBytes([in] long newVal);
   [propget, id(155), helpstring("How many OpenPGP keys one account may hold at once, so that a key being rotated and the key replacing it are both published. 1 to 64; default 8.")] HRESULT OpenPGPKeysPerAccount([out, retval] long *pVal);
   [propput, id(155), helpstring("How many OpenPGP keys one account may hold at once, so that a key being rotated and the key replacing it are both published. 1 to 64; default 8.")] HRESULT OpenPGPKeysPerAccount([in] long newVal);
   [propget, id(156), helpstring("Refuse a key whose user ids do not carry the account's own address. On by default; an administrator can override it for one upload with Utilities.ImportOpenPGPKey.")] HRESULT OpenPGPRequireAddressInUserId([out, retval] VARIANT_BOOL *pVal);
   [propput, id(156), helpstring("Refuse a key whose user ids do not carry the account's own address. On by default; an administrator can override it for one upload with Utilities.ImportOpenPGPKey.")] HRESULT OpenPGPRequireAddressInUserId([in] VARIANT_BOOL newVal);

   // Outbound webhooks. The subscriptions themselves are rows in hm_webhooks,
   // reached over REST and through Utilities.GetWebhookSubscriptions rather
   // than as settings, exactly as the alert rules are.
   [propget, id(157), helpstring("The master switch for outbound webhooks (message.received, message.delivered, message.bounced, message.quarantined, account.locked). It opens nothing on its own: a server with no subscription raises no event and makes no request. Switch it off to silence every receiver at once without deleting what names them. On by default.")] HRESULT WebhooksEnabled([out, retval] VARIANT_BOOL *pVal);
   [propput, id(157), helpstring("The master switch for outbound webhooks (message.received, message.delivered, message.bounced, message.quarantined, account.locked). It opens nothing on its own: a server with no subscription raises no event and makes no request. Switch it off to silence every receiver at once without deleting what names them. On by default.")] HRESULT WebhooksEnabled([in] VARIANT_BOOL newVal);
   [propget, id(158), helpstring("How many times a webhook delivery is attempted before it is dead-lettered with its body and the reason kept. 1 to 20, 5 by default. The waits between them are none, then 1, 5, 15 and 60 minutes.")] HRESULT WebhookMaxAttempts([out, retval] long *pVal);
   [propput, id(158), helpstring("How many times a webhook delivery is attempted before it is dead-lettered with its body and the reason kept. 1 to 20, 5 by default. The waits between them are none, then 1, 5, 15 and 60 minutes.")] HRESULT WebhookMaxAttempts([in] long newVal);
   [propget, id(159), helpstring("The ceiling a webhook subscription that names no rate limit of its own is held to. Events past it in one minute are DROPPED and counted, not queued, so a busy hour cannot become a flood an hour later. 1 to 100000, 60 by default.")] HRESULT WebhookMaxPerMinute([out, retval] long *pVal);
   [propput, id(159), helpstring("The ceiling a webhook subscription that names no rate limit of its own is held to. Events past it in one minute are DROPPED and counted, not queued, so a busy hour cannot become a flood an hour later. 1 to 100000, 60 by default.")] HRESULT WebhookMaxPerMinute([in] long newVal);
   [propget, id(160), helpstring("Days of delivered and dead-lettered webhook rows to keep. 0 keeps everything, which for a per-message stream is a decision rather than a default. 7 by default, at most 3650.")] HRESULT WebhookRetentionDays([out, retval] long *pVal);
   [propput, id(160), helpstring("Days of delivered and dead-lettered webhook rows to keep. 0 keeps everything, which for a per-message stream is a decision rather than a default. 7 by default, at most 3650.")] HRESULT WebhookRetentionDays([in] long newVal);

   [propget, id(161), helpstring("The MaxMind database file (.mmdb) country blocking reads, such as C:\\GeoIP\\GeoLite2-Country.mmdb. The administrator supplies it; this server ships none and downloads none. Empty means no connection and no sign-in is judged by country, whatever the policies say.")] HRESULT GeoIpDatabaseFile([out, retval] BSTR *pVal);
   [propput, id(161), helpstring("The MaxMind database file (.mmdb) country blocking reads, such as C:\\GeoIP\\GeoLite2-Country.mmdb. The administrator supplies it; this server ships none and downloads none. Empty means no connection and no sign-in is judged by country, whatever the policies say.")] HRESULT GeoIpDatabaseFile([in] BSTR newVal);
   [propget, id(162), helpstring("How many days old the database may be before the application log says it is stale. 45 by default; 0 never says so. A stale database is still used - a stale answer beats no answer - because the addresses in it have mostly not moved.")] HRESULT GeoIpDatabaseMaxAgeDays([out, retval] long *pVal);
   [propput, id(162), helpstring("How many days old the database may be before the application log says it is stale. 45 by default; 0 never says so. A stale database is still used - a stale answer beats no answer - because the addresses in it have mostly not moved.")] HRESULT GeoIpDatabaseMaxAgeDays([in] long newVal);
   [propget, id(163), helpstring("Addresses and CIDR ranges no country policy ever judges, comma separated - the loopback address and the private networks by default. This is the whole of the exemption: emptying it means this server's own network is judged like anybody else's, which can lock the Deck and the webmail out on a strict allow list.")] HRESULT CountryBlockingExemptRanges([out, retval] BSTR *pVal);
   [propput, id(163), helpstring("Addresses and CIDR ranges no country policy ever judges, comma separated - the loopback address and the private networks by default. This is the whole of the exemption: emptying it means this server's own network is judged like anybody else's, which can lock the Deck and the webmail out on a strict allow list.")] HRESULT CountryBlockingExemptRanges([in] BSTR newVal);
   [propget, id(164), helpstring("The country policy of one listener family - Protocol is smtp, imap, pop3 or http (the REST API and the web services share one). Empty is off; otherwise allow:GB,IE or block:CN,RU. Applied when a connection is accepted, before the greeting. An allow list refuses an address whose country the database does not know; a block list allows it.")] HRESULT CountryPolicy([in] BSTR Protocol, [out, retval] BSTR *pVal);
   [propput, id(164), helpstring("The country policy of one listener family - Protocol is smtp, imap, pop3 or http (the REST API and the web services share one). Empty is off; otherwise allow:GB,IE or block:CN,RU. Applied when a connection is accepted, before the greeting. An allow list refuses an address whose country the database does not know; a block list allows it.")] HRESULT CountryPolicy([in] BSTR Protocol, [in] BSTR newVal);

   // The session policies, server-wide (schema 6050). A domain's own row
   // overrides each of them for the accounts of that domain; see
   // Utilities.GetSessionPolicy and Utilities.SetDomainSessionPolicy. 0 in either
   // of the numbers means the policy is not set, and the ceilings this server has
   // always enforced - 1800 seconds idle, 43200 in all - apply.
   [propget, id(165), helpstring("How long a signed-in browser session (the webmail, the self-service portal, the Control Deck) may go unused before it ends, in seconds. 0 leaves the server's own ceiling of 1800 in force; at most 2592000. A value under 60 is only useful for testing.")] HRESULT SessionIdleSeconds([out, retval] long *pVal);
   [propput, id(165), helpstring("How long a signed-in browser session may go unused before it ends, in seconds. 0 leaves the server's own ceiling of 1800 in force; at most 2592000.")] HRESULT SessionIdleSeconds([in] long newVal);
   [propget, id(166), helpstring("How long a signed-in browser session may live at all, however busy it is, in seconds. 0 leaves the server's own ceiling of 43200 - twelve hours - in force; at most 2592000.")] HRESULT SessionLifetimeSeconds([out, retval] long *pVal);
   [propput, id(166), helpstring("How long a signed-in browser session may live at all, in seconds. 0 leaves the server's own ceiling of 43200 in force; at most 2592000.")] HRESULT SessionLifetimeSeconds([in] long newVal);
   [propget, id(167), helpstring("Whether signing in from a client that already has a session for that account ends the earlier one. Off by default.")] HRESULT SessionOnePerDevice([out, retval] VARIANT_BOOL *pVal);
   [propput, id(167), helpstring("Whether signing in from a client that already has a session for that account ends the earlier one. Off by default.")] HRESULT SessionOnePerDevice([in] VARIANT_BOOL newVal);
   [propget, id(168), helpstring("Whether a session is refused from any address but the one it began on, so a stolen cookie is of no use away from the victim's network. Off by default: an address that changes underneath somebody ends their session while this is on.")] HRESULT SessionBindToAddress([out, retval] VARIANT_BOOL *pVal);
   [propput, id(168), helpstring("Whether a session is refused from any address but the one it began on. Off by default.")] HRESULT SessionBindToAddress([in] VARIANT_BOOL newVal);

   // Complaints, read: the feedback loops (SMTP/ComplaintTracker.h). Stored in
   // hm_settings, read at the moment they matter, so a change applies to the next
   // report. Off, with no mailbox, by default; with either of those so, nothing
   // here is read, counted or written.
   [propget, id(145), helpstring("Read the RFC 5965 abuse reports the providers post to the complaint mailbox: record them per domain and per account, count them per address, and list an address that complains on that domain's suppression list. Off by default.")] HRESULT ComplaintProcessingEnabled([out, retval] VARIANT_BOOL *pVal);
   [propput, id(145), helpstring("Read the RFC 5965 abuse reports the providers post to the complaint mailbox: record them per domain and per account, count them per address, and list an address that complains on that domain's suppression list. Off by default.")] HRESULT ComplaintProcessingEnabled([in] VARIANT_BOOL newVal);
   [propget, id(146), helpstring("The address (or addresses, separated by commas) this server's feedback loops are registered against, such as fbl@example.com. ONLY a report delivered here is read as a complaint, because arriving where the provider was told to send it is the only thing that distinguishes a report from a forgery. Empty, the default, means no complaint is ever read.")] HRESULT ComplaintMailbox([out, retval] BSTR *pVal);
   [propput, id(146), helpstring("The address (or addresses, separated by commas) this server's feedback loops are registered against, such as fbl@example.com. ONLY a report delivered here is read as a complaint, because arriving where the provider was told to send it is the only thing that distinguishes a report from a forgery. Empty, the default, means no complaint is ever read.")] HRESULT ComplaintMailbox([in] BSTR newVal);
   [propget, id(147), helpstring("Complaints about an address that put it on its sending domain's suppression list. 0 by default, which records and counts every report and lists nobody, because the only thing that tells a genuine report from a forged one is that it arrived at the mailbox; raise it to 1 once the entries have been read, a reader who pressed the spam button having received the message and not wanted it. At most 100.")] HRESULT ComplaintSuppressionThreshold([out, retval] long *pVal);
   [propput, id(147), helpstring("Complaints about an address that put it on its sending domain's suppression list. 0 by default, which records and counts every report and lists nobody, because the only thing that tells a genuine report from a forged one is that it arrived at the mailbox; raise it to 1 once the entries have been read, a reader who pressed the spam button having received the message and not wanted it. At most 100.")] HRESULT ComplaintSuppressionThreshold([in] long newVal);
   [propget, id(148), helpstring("Days a complaint is kept. 180 by default; 0 keeps them for ever; at most 3650. The daily tally behind the complaint rate is swept on the same clock but never below the seven days of the rate window, so a short retention cannot empty the window it is measured over. A suppression list entry a complaint made is not removed by this - it has its own expiry.")] HRESULT ComplaintRetentionDays([out, retval] long *pVal);
   [propput, id(148), helpstring("Days a complaint is kept. 180 by default; 0 keeps them for ever; at most 3650. The daily tally behind the complaint rate is swept on the same clock but never below the seven days of the rate window, so a short retention cannot empty the window it is measured over. A suppression list entry a complaint made is not removed by this - it has its own expiry.")] HRESULT ComplaintRetentionDays([in] long newVal);

   // What this server has changed from stock. Declared last, so that no member
   // already in the vtable moves; reads only, so neither carries an AuditScope.
   [id(149), helpstring("Every setting whose value is not the one this version ships with, with the shipped value beside it, as JSON: {changed, considered, settings:[{store, name, value, default, secret, known, overridden}]}. store is ini (the keys that were hMailServer.ini's [Settings] section) or database (hm_settings); considered is how many settings the two stores hold altogether, so that a count of 3 reads as 3 of 391. A setting whose name says its value is a secret is listed with value (set) when it has one and empty when it has none. known is false for a value this build ships no default for - a key stored for a script of the administrator's own - which is a difference from stock all the same. overridden is true where the [SettingsOverride] section of hMailServer.ini forces the value over what is stored, which no other page shows. The same document GET /api/v1/settings/changed answers. Server administrators only.")] HRESULT GetChangedFromDefault([out, retval] BSTR *Json);
   [id(150), helpstring("The value this version of the server ships with for one setting: the [Settings] key of that name if there is one, otherwise the hm_settings property. Raises an error for a name this build ships no default for. Server administrators only.")] HRESULT GetSettingDefault([in] BSTR Name, [out, retval] BSTR *Value);

   // The reputation watch (Common/Util/ReputationWatch.h): this server's own
   // outbound addresses, checked against the DNS block lists once a day. Stored
   // in hm_settings. The two strings are refused here in the same words the REST
   // settings use, because both go through ReputationWatch::Validate*.
   //
   // 134 to 136 rather than 133 to 135: the bounce suppression branch took this
   // interface up to 133, and two branches holding the same id produce a type
   // library in which one of them silently answers the other's calls.
   [propget, id(134), helpstring("Whether the server checks its own outbound addresses against the DNS block lists once a day and raises the reputation.listed alert when one of them is listed. On in a new installation and off after an upgrade, which may already have a bind address set; with no address to check it looks nothing up.")] HRESULT ReputationWatchEnabled([out, retval] VARIANT_BOOL *pVal);
   [propput, id(134), helpstring("Whether the server checks its own outbound addresses against the DNS block lists once a day and raises the reputation.listed alert when one of them is listed. On in a new installation and off after an upgrade, which may already have a bind address set; with no address to check it looks nothing up.")] HRESULT ReputationWatchEnabled([in] VARIANT_BOOL newVal);
   [propget, id(135), helpstring("The DNS block lists the reputation watch asks, one entry each as [ipv4:|ipv6:]zone[=codes], separated by commas or spaces - for example zen.spamhaus.org, ipv4:bl.spamcop.net. ipv4: or ipv6: says the list covers only that family, so an address of the other one is reported as not covered rather than as clean; =127.0.0.2|127.0.0.4-7 says which answers in 127.0.0.0/8 mean listed.")] HRESULT ReputationWatchLists([out, retval] BSTR *pVal);
   [propput, id(135), helpstring("The DNS block lists the reputation watch asks, one entry each as [ipv4:|ipv6:]zone[=codes], separated by commas or spaces - for example zen.spamhaus.org, ipv4:bl.spamcop.net. ipv4: or ipv6: says the list covers only that family, so an address of the other one is reported as not covered rather than as clean; =127.0.0.2|127.0.0.4-7 says which answers in 127.0.0.0/8 mean listed.")] HRESULT ReputationWatchLists([in] BSTR newVal);
   [propget, id(136), helpstring("The addresses other servers see this one as, beside the SMTP delivery bind address and the addresses the active global rules bind. This is where the public address of a server behind NAT goes: nothing on the machine can discover it, and it is not asked of a web service. Separated by commas or spaces.")] HRESULT ReputationWatchAddresses([out, retval] BSTR *pVal);
   [propput, id(136), helpstring("The addresses other servers see this one as, beside the SMTP delivery bind address and the addresses the active global rules bind. This is where the public address of a server behind NAT goes: nothing on the machine can discover it, and it is not asked of a web service. Separated by commas or spaces.")] HRESULT ReputationWatchAddresses([in] BSTR newVal);


   // Spam traps (Common/AntiSpam/SpamTrapMonitor.h). Stored in hm_settings.
   [propget, id(137), helpstring("How long the address that addressed a spam trap is banned, in minutes; 0 bans nobody. The ban is the expiring IP range a run of failed logons creates, lifted by the same sweep and mirrored into the firewall by the same reconciliation. An authenticated session, an IP range that does not run the spam tests, the anti-spam white list, an incoming relay and an address on AutoBanNeverBan are never banned. Between 0 and 525600; 1440 by default.")] HRESULT SpamTrapBanMinutes([out, retval] long *pVal);
   [propput, id(137), helpstring("How long the address that addressed a spam trap is banned, in minutes; 0 bans nobody. The ban is the expiring IP range a run of failed logons creates, lifted by the same sweep and mirrored into the firewall by the same reconciliation. An authenticated session, an IP range that does not run the spam tests, the anti-spam white list, an incoming relay and an address on AutoBanNeverBan are never banned. Between 0 and 525600; 1440 by default.")] HRESULT SpamTrapBanMinutes([in] long newVal);
   [propget, id(138), helpstring("How long the envelope sender of a message to a spam trap stays on the server's block list, in days; 0 blocks nobody. An ordinary block entry at server scope, so a nearer allow entry still overrules it; the null sender, a sender claiming a domain this server hosts, and a sender the server's own allow list names are never blocked. Between 0 and 3650; 30 by default.")] HRESULT SpamTrapBlockDays([out, retval] long *pVal);
   [propput, id(138), helpstring("How long the envelope sender of a message to a spam trap stays on the server's block list, in days; 0 blocks nobody. An ordinary block entry at server scope, so a nearer allow entry still overrules it; the null sender, a sender claiming a domain this server hosts, and a sender the server's own allow list names are never blocked. Between 0 and 3650; 30 by default.")] HRESULT SpamTrapBlockDays([in] long newVal);
   [propget, id(139), helpstring("How long the record of spam trap hits is kept, in days, swept hourly. What the hits made - a ban, a blocked sender - is not touched by the sweep. Between 1 and 3650; 90 by default.")] HRESULT SpamTrapHitRetentionDays([out, retval] long *pVal);
   [propput, id(139), helpstring("How long the record of spam trap hits is kept, in days, swept hourly. What the hits made - a ban, a blocked sender - is not touched by the sweep. Between 1 and 3650; 90 by default.")] HRESULT SpamTrapHitRetentionDays([in] long newVal);
   [propget, id(140), helpstring("Whether a message sent to a real mailbox by a session that addressed a spam trap is taught to SpamAssassin as spam (the spamc TELL command, into the store its verdicts come from). Off by default; does nothing unless SpamAssassin is enabled and its spamd allows TELL. A trap hit with no message after it teaches nothing, because the trap is refused at RCPT TO and its own message never arrives.")] HRESULT SpamTrapTeachSpamAssassin([out, retval] VARIANT_BOOL *pVal);
   [propput, id(140), helpstring("Whether a message sent to a real mailbox by a session that addressed a spam trap is taught to SpamAssassin as spam (the spamc TELL command, into the store its verdicts come from). Off by default; does nothing unless SpamAssassin is enabled and its spamd allows TELL. A trap hit with no message after it teaches nothing, because the trap is refused at RCPT TO and its own message never arrives.")] HRESULT SpamTrapTeachSpamAssassin([in] VARIANT_BOOL newVal);

   // The help panes (Common/Util/HelpPages.h). Stored in hm_settings. 175 is
   // the next free id on this interface; 141 to 174 are taken further up.
   [propget, id(175), helpstring("The wiki the help panes' Open on the wiki link points at, with the document's name as the page - https://gitlab.com/hmailserver/hmailserver/-/wikis/ as shipped. Absolute, beginning with http:// or https://; empty hides the link. The same value as help_wiki_base_url on GET and PUT /api/v1/settings.")] HRESULT HelpWikiBaseUrl([out, retval] BSTR *pVal);
   [propput, id(175), helpstring("The wiki the help panes' Open on the wiki link points at, with the document's name as the page - https://gitlab.com/hmailserver/hmailserver/-/wikis/ as shipped. Absolute, beginning with http:// or https://; empty hides the link. The same value as help_wiki_base_url on GET and PUT /api/v1/settings.")] HRESULT HelpWikiBaseUrl([in] BSTR newVal);

   // Outbound shaping (SMTP/DestinationBackoff.h, docs/OutboundShaping.md).
   // Stored in hm_settings. 176 to 179 are the next free ids on this interface.
   [propget, id(176), helpstring("How long deliveries to a destination are held after it answers a slow-down reply - a 421, an enhanced code of 4.7.0, 4.7.28, 4.7.500, 4.7.650, 4.7.652 or 4.3.2, or a 4xx whose English text says rate limit, too many messages, try again later and the like; never a 4.7.1, a 4.2.x, a 4.5.3 or a 4.4.x, and never a reply that says greylist: the first window, in minutes. When it ends one delivery probes the destination, and a second slow-down reply doubles the window up to OutboundBackoffMaxMinutes. A deferral this server chooses is not counted against the message's retries until the message has been queued longer than its retry schedule spans. Never above OutboundBackoffMaxMinutes: to move both past each other, move the ceiling first when raising and this one first when lowering. 0 turns the back-off off. 0 to 10080; 2 by default. The same value as outbound_backoff_minutes on GET and PUT /api/v1/settings.")] HRESULT OutboundBackoffMinutes([out, retval] long *pVal);
   [propput, id(176), helpstring("How long deliveries to a destination are held after it answers a slow-down reply - a 421, an enhanced code of 4.7.0, 4.7.28, 4.7.500, 4.7.650, 4.7.652 or 4.3.2, or a 4xx whose English text says rate limit, too many messages, try again later and the like; never a 4.7.1, a 4.2.x, a 4.5.3 or a 4.4.x, and never a reply that says greylist: the first window, in minutes. When it ends one delivery probes the destination, and a second slow-down reply doubles the window up to OutboundBackoffMaxMinutes. A deferral this server chooses is not counted against the message's retries until the message has been queued longer than its retry schedule spans. Never above OutboundBackoffMaxMinutes: to move both past each other, move the ceiling first when raising and this one first when lowering. 0 turns the back-off off. 0 to 10080; 2 by default. The same value as outbound_backoff_minutes on GET and PUT /api/v1/settings.")] HRESULT OutboundBackoffMinutes([in] long newVal);
   [propget, id(177), helpstring("The most a back-off window grows to by doubling, in minutes. Never below OutboundBackoffMinutes, which is never above it: to move both past each other, move this one first when raising and the base first when lowering. 1 to 10080; 60 by default. The same value as outbound_backoff_max_minutes on GET and PUT /api/v1/settings.")] HRESULT OutboundBackoffMaxMinutes([out, retval] long *pVal);
   [propput, id(177), helpstring("The most a back-off window grows to by doubling, in minutes. Never below OutboundBackoffMinutes, which is never above it: to move both past each other, move this one first when raising and the base first when lowering. 1 to 10080; 60 by default. The same value as outbound_backoff_max_minutes on GET and PUT /api/v1/settings.")] HRESULT OutboundBackoffMaxMinutes([in] long newVal);
   [propget, id(178), helpstring("The most sessions this server holds open at once to one destination - a recipient domain, or the host of a route - that no remote domain policy sets a connection ceiling for; a policy's own ceiling wins where there is one. Over it, a delivery is deferred for a minute without counting a retry. 0 is no ceiling. 0 to 1000; 0 by default. The same value as max_outbound_connections_per_destination on GET and PUT /api/v1/settings.")] HRESULT MaxOutboundConnectionsPerDestination([out, retval] long *pVal);
   [propput, id(178), helpstring("The most sessions this server holds open at once to one destination - a recipient domain, or the host of a route - that no remote domain policy sets a connection ceiling for; a policy's own ceiling wins where there is one. Over it, a delivery is deferred for a minute without counting a retry. 0 is no ceiling. 0 to 1000; 0 by default. The same value as max_outbound_connections_per_destination on GET and PUT /api/v1/settings.")] HRESULT MaxOutboundConnectionsPerDestination([in] long newVal);
   [propget, id(179), helpstring("The most deliveries one tenant may have in flight at once, where the tenant is the hosted domain of the envelope sender (an alias domain counts as its domain) and every sender this server does not host is the one tenant (external). A share of connections, never more than MaxDeliveryThreads; the per-account sending limit is the volume control. Over it, a delivery is deferred for a minute without counting a retry. 0 is no share. 0 to 1000; 0 by default. The same value as max_outbound_connections_per_tenant on GET and PUT /api/v1/settings.")] HRESULT MaxOutboundConnectionsPerTenant([out, retval] long *pVal);
   [propput, id(179), helpstring("The most deliveries one tenant may have in flight at once, where the tenant is the hosted domain of the envelope sender (an alias domain counts as its domain) and every sender this server does not host is the one tenant (external). A share of connections, never more than MaxDeliveryThreads; the per-account sending limit is the volume control. Over it, a delivery is deferred for a minute without counting a retry. 0 is no share. 0 to 1000; 0 by default. The same value as max_outbound_connections_per_tenant on GET and PUT /api/v1/settings.")] HRESULT MaxOutboundConnectionsPerTenant([in] long newVal);

   // When a saved [Settings] key reaches the running server, and which saved keys have
   // not yet: the mark build/ini-settings-baseline.txt carries for every key, and the
   // keys whose stored value differs from the running one. docs/SettingsApply.md.
   [id(180), helpstring("When a change to one [Settings] key reaches the running server: now (a save applies it), reinitialize (it waits for Application.Reinitialize or POST /api/v1/server/reinitialize) or restart (it waits for the service to be restarted) - the key's mark in the settings baseline, the same word GET /api/v1/settings/ini answers as applies. Raises an error for a name this build does not read through its settings loader - the sentence GET /api/v1/settings/ini/{name} answers as applies_refused - and the name is taken as spelled, not trimmed. Server administrators only.")] HRESULT IniSettingApplies([in] BSTR Name, [out, retval] BSTR *pVal);
   [propget, id(181), helpstring("The [Settings] keys saved since what applies them last happened - marked reinitialize or restart, with a stored value that is not the one the server is running on - one per line, as IniSettingNames lists names. Recomputed at every read, so a value put back is not listed; empty when nothing waits. GET /api/v1/server/settings/pending answers the same keys with both values. Server administrators only.")] HRESULT PendingIniSettings([out, retval] BSTR *pVal);
   [propget, id(182), helpstring("Every [Settings] key this build reads with its mark - now, reinitialize or restart - as one JSON object from name to mark, the applies map GET /api/v1/settings/ini answers: what a client reads once to label every field on a page, rather than asking IniSettingApplies once per field. Server administrators only.")] HRESULT IniSettingAppliesAll([out, retval] BSTR *pVal);


   // The setting profiles (docs/Profiles.md): the four listed, one profile's diff
   // against this server, applying one after a snapshot of what it changes, and
   // the way back. The same documents the REST routes under
   // /api/v1/settings/profiles answer, made by the same code (Profiles).
   [id(183), helpstring("The four setting profiles this server ships - office, gateway, relay and sender - as the JSON document GET /api/v1/settings/profiles answers: each with its title, paragraph and entry count, how many entries applying it here would change and how many of those ask for a confirmation, and the profile last applied and the way back from it. Server administrators only.")] HRESULT GetProfiles([out, retval] BSTR *Json);
   [id(184), helpstring("One profile's diff against this server, as the JSON document GET /api/v1/settings/profiles/{name} answers: every entry with the value the server holds now, whether applying would change it, the route it is written through, when the change takes effect, why it is there, and whether it closes a listener, trusts an address range, turns a filter or a check off or weakens it, or shortens a window of days in force - and the diff_token ApplyProfile takes. Raises an error for a name that is no profile. Server administrators only.")] HRESULT GetProfile([in] BSTR Name, [out, retval] BSTR *Json);
   [id(185), helpstring("Applies a profile: every entry checked first, the values it changes saved as the way back, then each written through the setter its REST settings row runs. DiffToken is the diff_token of the diff GetProfile answered and the caller showed: the apply is refused when the server would now make a different one. Confirmed must be true where an entry that closes a listener, trusts an address range, turns a filter or a check off or weakens it, or shortens a window of days would change something, and a confirmation needs DiffToken; without it nothing is applied and the error names those entries. Refused, with the sentence, while a way back from an earlier profile is held, and when an entry would be refused by its setting. Returns the JSON document the REST apply answers: what each entry did, and how many wait for a reinitialise or a restart; a write that failed part way raises an error naming what was written. Server administrators only.")] HRESULT ApplyProfile([in] BSTR Name, [in] VARIANT_BOOL Confirmed, [in] BSTR DiffToken, [out, retval] BSTR *Json);
   [id(186), helpstring("Puts back the value each setting had before the last profile was applied - a setting changed since is left as it is - and clears the way back. Returns the JSON document the REST revert answers. Raises an error when there is nothing to revert. Server administrators only.")] HRESULT RevertProfile([out, retval] BSTR *Json);
   [id(187), helpstring("Forgets the way back from the last profile applied, keeping its settings, so that another profile may be applied. Raises an error when there is none. Server administrators only.")] HRESULT DiscardProfileSnapshot();
   [propget, id(188), helpstring("The name of the profile whose settings are in effect - applied, kept, or applied in part - or empty when none is, one was reverted, or none is wanted.")] HRESULT AppliedProfile([out, retval] BSTR *pVal);
   [id(189), helpstring("Records that this server keeps the settings this version ships with and wants no profile, so that the setup checklist stops asking for one; no setting is written, and a profile can still be applied afterwards. Refused while a way back is held or a profile is in effect. Returns the JSON document POST /api/v1/settings/profiles/decline answers. Server administrators only.")] HRESULT DeclineProfiles([out, retval] BSTR *Json);

   // Attachments opened somewhere safe (Common/AntiVirus/Sandbox.h, docs/Sandbox.md).
   // Stored in hm_settings. 190 to 201 are the next free ids on this interface.
   [propget, id(190), helpstring("Whether a message that no signed-in user of this server submitted, with an attachment of a submitted type, is held, in no mailbox and not in the quarantine, until the sandbox has answered for each such file; a clean answer delivers it with a header, a malicious one quarantines it. Off by default, and refused on while either address is empty. The same value as sandbox_enabled on GET and PUT /api/v1/settings.")] HRESULT SandboxEnabled([out, retval] VARIANT_BOOL *pVal);
   [propput, id(190), helpstring("Whether a message that no signed-in user of this server submitted, with an attachment of a submitted type, is held, in no mailbox and not in the quarantine, until the sandbox has answered for each such file; a clean answer delivers it with a header, a malicious one quarantines it. Off by default, and refused on while either address is empty. The same value as sandbox_enabled on GET and PUT /api/v1/settings.")] HRESULT SandboxEnabled([in] VARIANT_BOOL newVal);
   [propget, id(191), helpstring("Where each file is POSTed as multipart/form-data with the fields file, filename, sha256 and message_id; the answer names the submission's id. https, or plain http to this machine only; empty submits nothing. The same value as sandbox_submit_url on GET and PUT /api/v1/settings.")] HRESULT SandboxSubmitUrl([out, retval] BSTR *pVal);
   [propput, id(191), helpstring("Where each file is POSTed as multipart/form-data with the fields file, filename, sha256 and message_id; the answer names the submission's id. https, or plain http to this machine only; empty submits nothing. The same value as sandbox_submit_url on GET and PUT /api/v1/settings.")] HRESULT SandboxSubmitUrl([in] BSTR newVal);
   [propget, id(192), helpstring("Where a file's verdict is asked for with a GET, with id= or sha256= added, or {id} and {sha256} replaced. The answer carries state, verdict, score and detail. https, or plain http to this machine only. The same value as sandbox_verdict_url on GET and PUT /api/v1/settings.")] HRESULT SandboxVerdictUrl([out, retval] BSTR *pVal);
   [propput, id(192), helpstring("Where a file's verdict is asked for with a GET, with id= or sha256= added, or {id} and {sha256} replaced. The answer carries state, verdict, score and detail. https, or plain http to this machine only. The same value as sandbox_verdict_url on GET and PUT /api/v1/settings.")] HRESULT SandboxVerdictUrl([in] BSTR newVal);
   [id(193), helpstring("Sets the bearer token sent to the sandbox's two addresses: visible ASCII only, at most 2048 characters (248 while ProtectStoredSecretsWithDPAPI is 0). Stored protected, never read back by any interface and left out of the backup archive; an empty token sends none. The same value as sandbox_token on PUT /api/v1/settings.")] HRESULT SetSandboxToken([in] BSTR newVal);
   [propget, id(194), helpstring("How long a held message waits, in minutes from the moment it was held; past it the hold ends by SandboxTimeoutAction. 1 to 1440; 15 by default. The same value as sandbox_timeout_minutes on GET and PUT /api/v1/settings.")] HRESULT SandboxTimeoutMinutes([out, retval] long *pVal);
   [propput, id(194), helpstring("How long a held message waits, in minutes from the moment it was held; past it the hold ends by SandboxTimeoutAction. 1 to 1440; 15 by default. The same value as sandbox_timeout_minutes on GET and PUT /api/v1/settings.")] HRESULT SandboxTimeoutMinutes([in] long newVal);
   [propget, id(195), helpstring("What a hold ends in when the wait is over or the sandbox answers error: 0 delivers the message with a header saying so, 1 returns it to its sender with 5.7.1. 0 by default. The same value as sandbox_timeout_action (deliver or bounce) on GET and PUT /api/v1/settings.")] HRESULT SandboxTimeoutAction([out, retval] long *pVal);
   [propput, id(195), helpstring("What a hold ends in when the wait is over or the sandbox answers error: 0 delivers the message with a header saying so, 1 returns it to its sender with 5.7.1. 0 by default. The same value as sandbox_timeout_action (deliver or bounce) on GET and PUT /api/v1/settings.")] HRESULT SandboxTimeoutAction([in] long newVal);
   [propget, id(196), helpstring("The largest attachment submitted, in KB; a larger one is not submitted and the header says so. 1 to 81920; 20480 by default. The same value as sandbox_max_size_kb on GET and PUT /api/v1/settings.")] HRESULT SandboxMaxSizeKB([out, retval] long *pVal);
   [propput, id(196), helpstring("The largest attachment submitted, in KB; a larger one is not submitted and the header says so. 1 to 81920; 20480 by default. The same value as sandbox_max_size_kb on GET and PUT /api/v1/settings.")] HRESULT SandboxMaxSizeKB([in] long newVal);
   [propget, id(197), helpstring("The attachments that are submitted: file extensions and media types, separated by commas, stored in lower case with each once. The executable and document set by default; empty submits nothing. The same value as sandbox_types on GET and PUT /api/v1/settings.")] HRESULT SandboxTypes([out, retval] BSTR *pVal);
   [propput, id(197), helpstring("The attachments that are submitted: file extensions and media types, separated by commas, stored in lower case with each once. The executable and document set by default; empty submits nothing. The same value as sandbox_types on GET and PUT /api/v1/settings.")] HRESULT SandboxTypes([in] BSTR newVal);
   [propget, id(198), helpstring("How often the verdicts of the held messages are asked for, in seconds. 5 to 3600; 30 by default. The same value as sandbox_poll_seconds on GET and PUT /api/v1/settings.")] HRESULT SandboxPollSeconds([out, retval] long *pVal);
   [propput, id(198), helpstring("How often the verdicts of the held messages are asked for, in seconds. 5 to 3600; 30 by default. The same value as sandbox_poll_seconds on GET and PUT /api/v1/settings.")] HRESULT SandboxPollSeconds([in] long newVal);
   [propget, id(199), helpstring("The score at or above which a suspicious verdict is treated as malicious; below it, as clean. 0 to 100; 70 by default. The same value as sandbox_score_threshold on GET and PUT /api/v1/settings.")] HRESULT SandboxScoreThreshold([out, retval] long *pVal);
   [propput, id(199), helpstring("The score at or above which a suspicious verdict is treated as malicious; below it, as clean. 0 to 100; 70 by default. The same value as sandbox_score_threshold on GET and PUT /api/v1/settings.")] HRESULT SandboxScoreThreshold([in] long newVal);
   [propget, id(200), helpstring("How long a clean or malicious verdict is remembered by the file's SHA-256, in hours; 0 remembers nothing. 0 to 720; 24 by default. The same value as sandbox_cache_hours on GET and PUT /api/v1/settings.")] HRESULT SandboxCacheHours([out, retval] long *pVal);
   [propput, id(200), helpstring("How long a clean or malicious verdict is remembered by the file's SHA-256, in hours; 0 remembers nothing. 0 to 720; 24 by default. The same value as sandbox_cache_hours on GET and PUT /api/v1/settings.")] HRESULT SandboxCacheHours([in] long newVal);
   [propget, id(201), helpstring("Whether what this server's own signed-in users submit - over authenticated SMTP or the webmail, to anyone - is held and its files uploaded to the sandbox as mail from outside is. Off by default. The same value as sandbox_internal_mail on GET and PUT /api/v1/settings.")] HRESULT SandboxInternalMail([out, retval] VARIANT_BOOL *pVal);
   [propput, id(201), helpstring("Whether what this server's own signed-in users submit - over authenticated SMTP or the webmail, to anyone - is held and its files uploaded to the sandbox as mail from outside is. Off by default. The same value as sandbox_internal_mail on GET and PUT /api/v1/settings.")] HRESULT SandboxInternalMail([in] VARIANT_BOOL newVal);
   [propget, id(202), helpstring("The most files one message may send to the sandbox; a message with more to submit is decided by SandboxTimeoutAction at once, with a header saying why. 1 to 100; 10 by default. The same value as sandbox_max_files on GET and PUT /api/v1/settings.")] HRESULT SandboxMaxFiles([out, retval] long *pVal);
   [propput, id(202), helpstring("The most files one message may send to the sandbox; a message with more to submit is decided by SandboxTimeoutAction at once, with a header saying why. 1 to 100; 10 by default. The same value as sandbox_max_files on GET and PUT /api/v1/settings.")] HRESULT SandboxMaxFiles([in] long newVal);
   [propget, id(203), helpstring("Whether a message placed in a mailbox - delivered, appended over IMAP, collected by the IMAP mirror or brought in by a migration or an import - is stored compressed (deflate), each MIME part of at least MessageStoreDedupMinKB once decoded held once as a blob. A message stored before is read as it is; hmailserver --compress-store rewrites the ones already there. Sizes, IMAP, POP3 and DKIM see the original message. Off by default. The same value as message_store_compression on GET and PUT /api/v1/settings.")] HRESULT MessageStoreCompression([out, retval] VARIANT_BOOL *pVal);
   [propput, id(203), helpstring("Whether a message placed in a mailbox - delivered, appended over IMAP, collected by the IMAP mirror or brought in by a migration or an import - is stored compressed (deflate), each MIME part of at least MessageStoreDedupMinKB once decoded held once as a blob. A message stored before is read as it is; hmailserver --compress-store rewrites the ones already there. Sizes, IMAP, POP3 and DKIM see the original message. Off by default. The same value as message_store_compression on GET and PUT /api/v1/settings.")] HRESULT MessageStoreCompression([in] VARIANT_BOOL newVal);
   [propget, id(204), helpstring("The smallest MIME part, in KB once decoded, that is held once as a blob while MessageStoreCompression is on; 0 holds nothing once. 0 to 65536; 256 by default. The same value as message_store_dedup_min_kb on GET and PUT /api/v1/settings.")] HRESULT MessageStoreDedupMinKB([out, retval] long *pVal);
   [propput, id(204), helpstring("The smallest MIME part, in KB once decoded, that is held once as a blob while MessageStoreCompression is on; 0 holds nothing once. 0 to 65536; 256 by default. The same value as message_store_dedup_min_kb on GET and PUT /api/v1/settings.")] HRESULT MessageStoreDedupMinKB([in] long newVal);
   [propget, id(205), helpstring("The message store's last measurement, as the JSON GET /api/v1/store answers: the messages' size, what their files take, how many are compressed, the blobs and what is saved. Measured on the server's own time, at most a quarter of an hour old; measuring is true while one is running.")] HRESULT MessageStoreStatus([out, retval] BSTR *pVal);

};


[
   object,
   uuid(3F50C3AF-67C0-4628-91D6-E2EAC7786830),
   dual,
   nonextensible,
   helpstring("The domain object represents one hMailServer domain."),
   pointer_default(unique)
]
interface IInterfaceDomain : IDispatch
{
      [propget, id(1), helpstring("Name of the domain.")] HRESULT Name([out, retval] BSTR *pVal);
      [propput, id(1), helpstring("Name of the domain.")] HRESULT Name([in] BSTR newVal);
      [id(2), helpstring("Saves changes of the object in the database.")] HRESULT Save();
      [propget, id(3), helpstring("The unique database identifier for the domain.")] HRESULT ID([out, retval] long *pVal);
      [propget, id(4), helpstring("The enabled-state of the domain.")] HRESULT Active([out, retval] VARIANT_BOOL *pVal);
      [propput, id(4), helpstring("The enabled-state of the domain.")] HRESULT Active([in] VARIANT_BOOL newVal);
      [propget, id(5), helpstring("The accounts collection for the domain.")] HRESULT Accounts([out, retval] IInterfaceAccounts** pVal);
      [id(6), helpstring("Deletes the domain from the database.")] HRESULT Delete();
      [propget, id(7), helpstring("The aliases collection for the domain.")] HRESULT Aliases([out, retval] IInterfaceAliases **pVal);
      [propget, id(9), helpstring("The distribution lists collection for the domain.")] HRESULT DistributionLists([out, retval] IInterfaceDistributionLists **pVal);
      [propget, id(10), helpstring("The postmaster for this domain. E-mail sent to an nonexistent address will be redirected to this address.")] HRESULT Postmaster([out, retval] BSTR *pVal);
      [propput, id(10), helpstring("The postmaster for this domain. E-mail sent to an nonexistent address will be redirected to this address.")] HRESULT Postmaster([in] BSTR newVal);
      [propget, id(11), helpstring("The aliases of the domain name.")] HRESULT DomainAliases([out, retval] IInterfaceDomainAliases **pVal);
      [propget, id(12), helpstring("The active directory domain this domain will be synchronised to.")] HRESULT ADDomainName([out, retval] BSTR *pVal);
      [propput, id(12), helpstring("The active directory domain this domain will be synchronised to.")] HRESULT ADDomainName([in] BSTR newVal);
      [id(13), helpstring("OBSOLETE. Only included to make all clients continue working.")] HRESULT SynchronizeDirectory();
      [propget, id(14), helpstring("Maximum message size when sending from this domain.")] HRESULT MaxMessageSize([out, retval] long *pVal);
      [propput, id(14), helpstring("Maximum message size when sending from this domain.")] HRESULT MaxMessageSize([in] long pVal);

      [propget, id(15), helpstring("Use plus addressing for this domain.")] HRESULT PlusAddressingEnabled([out, retval] VARIANT_BOOL *pVal);
      [propput, id(15), helpstring("Use plus addressing for this domain.")] HRESULT PlusAddressingEnabled([in] VARIANT_BOOL newVal);
      [propget, id(16), helpstring("Plus addressing character.")] HRESULT PlusAddressingCharacter([out, retval] BSTR *pVal);
      [propput, id(16), helpstring("Plus addressing character.")] HRESULT PlusAddressingCharacter([in] BSTR newVal);

      [propget, id(17), helpstring("Enable greylisting for this domain.")] HRESULT AntiSpamEnableGreylisting([out, retval] VARIANT_BOOL *pVal);
      [propput, id(17), helpstring("Enable greylisting for this domain.")] HRESULT AntiSpamEnableGreylisting([in] VARIANT_BOOL newVal);
