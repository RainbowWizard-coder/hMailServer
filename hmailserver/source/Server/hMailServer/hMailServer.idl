// The sender list: one address or one domain that somebody has said is
// wanted, or is not. The same row shape at three scopes - an account, a
// domain, the server - because it is the same question at three distances,
// and Scope says which this one came from.
//
// Read at LOCAL DELIVERY, not during the SMTP conversation, which is what
// lets it be per-recipient at all: a conversation shared by several
// recipients cannot be refused for one of them. The account's list is
// consulted first, then its domain's, then the server's, and the nearest
// scope that says anything is the only one that decides.
[
   object,
   uuid(7FD56286-DBE1-4E8D-A480-4704070ED8F1),
   dual,
   nonextensible,
   helpstring("The SenderListEntry object represents one address or domain on an allow or block list."),
   pointer_default(unique)
]
interface IInterfaceSenderListEntry : IDispatch
{
   [propget, id(1), helpstring("The unique database identifier for the object.")] HRESULT ID([out, retval] long *pVal);
   [propget, id(2), helpstring("The address (user@example.com) or domain (example.com, which also covers its subdomains). Stored lower-cased, with a leading @ dropped.")] HRESULT Value([out, retval] BSTR *pVal);
   [propput, id(2), helpstring("The address (user@example.com) or domain (example.com, which also covers its subdomains). Stored lower-cased, with a leading @ dropped.")] HRESULT Value([in] BSTR newVal);
   [propget, id(3), helpstring("False allows the sender - its mail skips the spam verdict for whoever this list belongs to. True blocks it - the message is held for review where the server holds spam, and marked as spam where it does not. Never destroyed either way.")] HRESULT Blocked([out, retval] VARIANT_BOOL *pVal);
   [propput, id(3), helpstring("False allows the sender - its mail skips the spam verdict for whoever this list belongs to. True blocks it - the message is held for review where the server holds spam, and marked as spam where it does not. Never destroyed either way.")] HRESULT Blocked([in] VARIANT_BOOL newVal);
   [propget, id(4), helpstring("Why the entry is there. Kept for whoever reads the list a year later.")] HRESULT Reason([out, retval] BSTR *pVal);
   [propput, id(4), helpstring("Why the entry is there. Kept for whoever reads the list a year later.")] HRESULT Reason([in] BSTR newVal);
   [propget, id(5), helpstring("Whether the entry stops mattering at ExpiresTime. An expired entry is ignored whether or not the sweep has removed it yet.")] HRESULT Expires([out, retval] VARIANT_BOOL *pVal);
   [propput, id(5), helpstring("Whether the entry stops mattering at ExpiresTime. An expired entry is ignored whether or not the sweep has removed it yet.")] HRESULT Expires([in] VARIANT_BOOL newVal);
   [propget, id(6), helpstring("When the entry expires, if Expires is set.")] HRESULT ExpiresTime([out, retval] VARIANT *pVal);
   [propput, id(6), helpstring("When the entry expires, if Expires is set.")] HRESULT ExpiresTime([in] VARIANT newVal);
   [propget, id(7), helpstring("Which list this entry came out of: 0 the server, 1 a domain, 2 an account. Read-only - a scope that could be written would move an entry between authorities.")] HRESULT Scope([out, retval] long *pVal);
   [id(8), helpstring("Saves changes of the object in the database.")] HRESULT Save();
   [id(9), helpstring("Deletes the object from the database.")] HRESULT Delete();
};

