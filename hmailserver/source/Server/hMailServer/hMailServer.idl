// What this server will do when it talks to one named remote domain.
//
// A route says WHERE mail for a domain goes and replaces MX discovery; this
// says what this server will and will not do when it gets there, whatever
// found the server. A domain may have both.
//
// The TLS requirement composes with MTA-STS and DANE as the STRONGEST of the
// three: nothing here can lower what a domain's own published policy demanded.
[
   object,
   uuid(C5FE061A-5AC7-4A22-A60C-5D64910A7D77),
   dual,
   nonextensible,
   helpstring("A remote domain policy: what this server will do when it talks to one named remote domain."),
   pointer_default(unique)
]
interface IInterfaceRemoteDomainPolicy : IDispatch{
   [propget, id(1), helpstring("Database identifier.")] HRESULT ID([out, retval] long *pVal);

   [propget, id(2), helpstring("The domain this policy governs. May carry a wildcard; the most specific match wins.")] HRESULT DomainName([out, retval] BSTR *pVal);
   [propput, id(2), helpstring("The domain this policy governs. May carry a wildcard; the most specific match wins.")] HRESULT DomainName([in] BSTR newVal);

   [propget, id(3), helpstring("Description.")] HRESULT Description([out, retval] BSTR *pVal);
   [propput, id(3), helpstring("Description.")] HRESULT Description([in] BSTR newVal);

   [propget, id(4), helpstring("Whether this policy is applied at all. An inactive policy is skipped, and the next most specific active policy governs instead.")] HRESULT Active([out, retval] VARIANT_BOOL *pVal);
   [propput, id(4), helpstring("Whether this policy is applied at all. An inactive policy is skipped, and the next most specific active policy governs instead.")] HRESULT Active([in] VARIANT_BOOL newVal);

   [propget, id(5), helpstring("The transport security demanded of outbound mail.")] HRESULT OutboundTls([out, retval] eRemoteTlsRequirement *pVal);
   [propput, id(5), helpstring("The transport security demanded of outbound mail.")] HRESULT OutboundTls([in] eRemoteTlsRequirement newVal);

   [propget, id(6), helpstring("Refuse mail FROM this domain that arrives on an unencrypted session.")] HRESULT RequireInboundTls([out, retval] VARIANT_BOOL *pVal);
   [propput, id(6), helpstring("Refuse mail FROM this domain that arrives on an unencrypted session.")] HRESULT RequireInboundTls([in] VARIANT_BOOL newVal);

   [propget, id(7), helpstring("The largest message this server will attempt to send there, in KB. 0 is no limit.")] HRESULT MaxMessageSizeKB([out, retval] long *pVal);
   [propput, id(7), helpstring("The largest message this server will attempt to send there, in KB. 0 is no limit.")] HRESULT MaxMessageSizeKB([in] long newVal);

   [propget, id(8), helpstring("Simultaneous SMTP connections this server will hold open to the destination. 0 is unlimited.")] HRESULT MaxConnections([out, retval] long *pVal);
   [propput, id(8), helpstring("Simultaneous SMTP connections this server will hold open to the destination. 0 is unlimited.")] HRESULT MaxConnections([in] long newVal);

   [propget, id(9), helpstring("Messages a minute this server will send to the destination. 0 is unlimited.")] HRESULT MaxMessagesPerMinute([out, retval] long *pVal);
   [propput, id(9), helpstring("Messages a minute this server will send to the destination. 0 is unlimited.")] HRESULT MaxMessagesPerMinute([in] long newVal);

