   // Web Push (Common/Util/WebPush.h). There is deliberately no getter for the
   // VAPID private key on this interface or on any other: the only way to put one
   // there is to generate it, and the only thing that reads it is the class that
   // signs with it. An administrator carrying an installation to another machine
   // uses PUT /api/v1/settings/push, whose vapid_private_key is write-only.
   [propget, id(169), helpstring("Whether Web Push notifications are sent at all. Off by default; with it off nothing is queued, nothing is signed and no push service is reached, whatever subscriptions exist.")] HRESULT WebPushEnabled([out, retval] VARIANT_BOOL *pVal);
   [propput, id(169), helpstring("Whether Web Push notifications are sent at all. Off by default; with it off nothing is queued, nothing is signed and no push service is reached, whatever subscriptions exist.")] HRESULT WebPushEnabled([in] VARIANT_BOOL newVal);
   [propget, id(170), helpstring("The contact a push service may use when this server's subscriptions are failing: a mailto: or https: address, sent as the sub claim of every VAPID token. Empty means mailto:postmaster@ the server's host name.")] HRESULT WebPushSubject([out, retval] BSTR *pVal);
   [propput, id(170), helpstring("The contact a push service may use when this server's subscriptions are failing: a mailto: or https: address. Empty means mailto:postmaster@ the server's host name.")] HRESULT WebPushSubject([in] BSTR newVal);
   [propget, id(171), helpstring("The public half of this server's VAPID key pair, base64url. Every page that subscribes needs it, so it is public by construction. Empty until GenerateWebPushKeys has been called.")] HRESULT WebPushVapidPublicKey([out, retval] BSTR *pVal);
   [id(172), helpstring("Generates a fresh VAPID key pair and stores both halves, returning the public one. Every subscription made under the previous pair stops working at once and each device must be asked again, so this is not routine: it is what to do when the private key may have been copied. Server administrators only.")] HRESULT GenerateWebPushKeys([out, retval] BSTR *PublicKey);
   [propget, id(173), helpstring("How far past its limit a mailbox still accepts incoming mail, as a percentage of the limit; 0 is not at all. A domain may set its own. 0 to 1000.")] HRESULT QuotaGracePercent([out, retval] long *pVal);
   [propput, id(173), helpstring("How far past its limit a mailbox still accepts incoming mail, as a percentage of the limit; 0 is not at all. A domain may set its own. 0 to 1000.")] HRESULT QuotaGracePercent([in] long newVal);
   [propget, id(174), helpstring("The percentage of its limit at which an account stops sending, before it stops receiving; 0 is never. A domain may set its own. 0 to 1000.")] HRESULT QuotaSendStopPercent([out, retval] long *pVal);
   [propput, id(174), helpstring("The percentage of its limit at which an account stops sending, before it stops receiving; 0 is never. A domain may set its own. 0 to 1000.")] HRESULT QuotaSendStopPercent([in] long newVal);

   // The Web Key Directory: this server publishing its users' OpenPGP public keys
