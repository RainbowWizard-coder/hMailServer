[
   object,
   uuid(310F1911-69A5-4696-B08F-D364598105E5),
   dual,
   nonextensible,
   helpstring("One message held in the spam quarantine. It was ACCEPTED rather than refused, so the sender believes it was delivered - releasing it delivers it, and deleting it is the only other outcome."),
   pointer_default(unique)
]
interface IInterfaceQuarantinedMessage : IDispatch{
   [propget, id(1), helpstring("The database identifier.")] HRESULT ID([out, retval] LONG* pVal);
   [propget, id(2), helpstring("The envelope sender.")] HRESULT Sender([out, retval] BSTR* pVal);
   [propget, id(3), helpstring("The envelope recipients, comma separated - who it would be released to.")] HRESULT Recipients([out, retval] BSTR* pVal);
   [propget, id(4), helpstring("The subject, read from the stored message.")] HRESULT Subject([out, retval] BSTR* pVal);
   [propget, id(5), helpstring("Why it was quarantined - the spam test that decided.")] HRESULT Reason([out, retval] BSTR* pVal);
   [propget, id(6), helpstring("The spam score it reached.")] HRESULT Score([out, retval] LONG* pVal);
   [propget, id(7), helpstring("Size in bytes.")] HRESULT Size([out, retval] LONG* pVal);
   [propget, id(8), helpstring("When it was quarantined.")] HRESULT CreatedTime([out, retval] BSTR* pVal);
   [id(9), helpstring("Delivers this message to its original recipients and removes it from the quarantine. Named ReleaseMessage rather than Release because every COM interface already inherits IUnknown::Release. Delivery re-enters at the queue rather than at SMTP, so the filters that quarantined it do not run again.")] HRESULT ReleaseMessage();
   [id(10), helpstring("Deletes this message and its stored file. There is no other copy.")] HRESULT Delete();
   [propget, id(11), helpstring("The HELO or EHLO name the client gave in the SMTP session that brought the message in, as it gave it. Empty for a message held before schema 6105 recorded it, and for one that did not arrive over SMTP. A message held at delivery - by a rule, a block list, an account's own threshold or the sandbox - has the name read from the Received header this server wrote for it. Named HeloName rather than Helo because a type library keeps one spelling of a name whatever its case, and Client.HELO has it.")] HRESULT HeloName([out, retval] BSTR* pVal);
   [propget, id(12), helpstring("The organization's domain of the envelope sender: the registrable domain by the Public Suffix List, lower-cased, so bounces.example.com and mail.example.com are both example.com. What the review pages group by sender domain. Empty for the null sender.")] HRESULT SenderDomain([out, retval] BSTR* pVal);
   [propget, id(13), helpstring("The organization's domain of the HELO name, the same way: what the review pages group by HELO domain. Empty when no HELO was recorded and for a HELO that is an address, bracketed or not.")] HRESULT HeloDomain([out, retval] BSTR* pVal);
   [id(14), helpstring("The message's header block as it is stored, read from the held file, at most 65536 characters: what a reviewer reads before deciding without releasing it. Refused when the file is missing.")] HRESULT ReadHeaders([out, retval] BSTR* pVal);
   [id(15), helpstring("A plain-text preview of the message, at most 16384 characters: its text part, decoded, or when it has none its HTML part with the markup, style sheets and scripts taken out. The HTML is never rendered. Empty for a message with neither. Refused when the file is missing or cannot be parsed.")] HRESULT ReadPreview([out, retval] BSTR* pVal);
};
