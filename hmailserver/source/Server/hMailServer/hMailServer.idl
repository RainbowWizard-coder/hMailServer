   [id(46), helpstring("Sends the quarantine digest now to every account of every domain that has the digest switched on and something newly held for it, ignoring the digest hour and the once-a-day rule. Not the opt-out, a missing QuarantineDigestBaseUrl or an empty digest: those still send nothing. Returns how many digests were sent.")] HRESULT SendQuarantineDigests([out, retval] long *pVal);

   // Greylisting, hardened (SMTP/GreyListing.h; discussions #281, #282, #284).
   // Every one of these leaves greylisting exactly as it was at its default.
   [propget, id(47), helpstring("The per-domain greylisting bypass list: envelope domains and HELO suffixes let past greylisting when the message carries the authentication results the entry requires (SPF, DKIM, DMARC, any combination). A privilege granted to a named domain, beside BypassGreylistingOnSPFSuccess, which every SPF pass enjoys. Empty by default, and then nothing changes.")] HRESULT GreyListingBypassEntries([out, retval] IInterfaceGreyListingBypassEntries** pVal);
   [propget, id(48), helpstring("Whether a retry before the greylisting window opens moves the window: each such retry sets the block end to now plus GreyListingInitialDelay again, so a sender that retries too soon never reaches it. Off by default, which is classic greylisting; a well-behaved server that retries once too quickly is delayed a little longer with it on.")] HRESULT GreyListingSlideOnEarlyRetry([out, retval] VARIANT_BOOL *pVal);
   [propput, id(48), helpstring("Whether a retry before the greylisting window opens moves the window: each such retry sets the block end to now plus GreyListingInitialDelay again, so a sender that retries too soon never reaches it. Off by default, which is classic greylisting; a well-behaved server that retries once too quickly is delayed a little longer with it on.")] HRESULT GreyListingSlideOnEarlyRetry([in] VARIANT_BOOL newVal);
   [propget, id(49), helpstring("The number of delivery ATTEMPTS before the window opens at which a pending triplet is refused with 550 instead of deferred with 451, for GreyListingAbuseLockMinutes. Attempts and not retries: the server counts every RCPT TO for the triplet, so a sender with twenty queued messages for one recipient reaches a threshold of twenty down one connection without having retried anything. 0, the default, never refuses; the operator who asked for it uses 20. What it stops is a sender that retries on a timer rather than from a queue; a misconfigured retry loop is stranded until the lock passes, after which the triplet starts over as a first attempt. Between 0 and 100000.")] HRESULT GreyListingAbuseThreshold([out, retval] long *pVal);
   [propput, id(49), helpstring("The number of delivery ATTEMPTS before the window opens at which a pending triplet is refused with 550 instead of deferred with 451, for GreyListingAbuseLockMinutes. Attempts and not retries: the server counts every RCPT TO for the triplet, so a sender with twenty queued messages for one recipient reaches a threshold of twenty down one connection without having retried anything. 0, the default, never refuses; the operator who asked for it uses 20. What it stops is a sender that retries on a timer rather than from a queue; a misconfigured retry loop is stranded until the lock passes, after which the triplet starts over as a first attempt. Between 0 and 100000.")] HRESULT GreyListingAbuseThreshold([in] long newVal);
   [propget, id(50), helpstring("How long the 550 of GreyListingAbuseThreshold lasts, in minutes; 60 by default, between 1 and 10080 (a week). Means nothing while the threshold is 0.")] HRESULT GreyListingAbuseLockMinutes([out, retval] long *pVal);
   [propput, id(50), helpstring("How long the 550 of GreyListingAbuseThreshold lasts, in minutes; 60 by default, between 1 and 10080 (a week). Means nothing while the threshold is 0.")] HRESULT GreyListingAbuseLockMinutes([in] long newVal);

   // SMTP policy the score cannot express (discussions #283, #285, #286).
   // Appended, as the note above says; every default leaves the server as it was.
   [propget, id(51), helpstring("The score an SPF softfail adds: the domain's policy names the client as probably unauthorised (~all) and asks that the message be accepted anyway. 0, the default, adds nothing; a score at or above SpamDeleteThreshold refuses the message during the SMTP conversation as a fail does. Never a pass for BypassGreylistingOnSPFSuccess.")] HRESULT UseSPFSoftFailScore([out, retval] long *pVal);
   [propput, id(51), helpstring("The score an SPF softfail adds: the domain's policy names the client as probably unauthorised (~all) and asks that the message be accepted anyway. 0, the default, adds nothing; a score at or above SpamDeleteThreshold refuses the message during the SMTP conversation as a fail does. Never a pass for BypassGreylistingOnSPFSuccess.")] HRESULT UseSPFSoftFailScore([in] long newVal);
   [propget, id(52), helpstring("The score an SPF temperror adds: the check did not finish (DNS timed out or answered SERVFAIL, or the lookup limit was reached) and the record may be fine. 0, the default, adds nothing. Ignored for a message SPFTempErrorDefer answers 451 to, because that message is never accepted.")] HRESULT UseSPFTempErrorScore([out, retval] long *pVal);
   [propput, id(52), helpstring("The score an SPF temperror adds: the check did not finish (DNS timed out or answered SERVFAIL, or the lookup limit was reached) and the record may be fine. 0, the default, adds nothing. Ignored for a message SPFTempErrorDefer answers 451 to, because that message is never accepted.")] HRESULT UseSPFTempErrorScore([in] long newVal);
   [propget, id(53), helpstring("The score an SPF permerror adds: the check finished and the domain's published record is unusable - two records, a bad mechanism, a redirect loop, too many lookups. 0, the default, adds nothing; a retry will not fix a permerror, so it is never deferred.")] HRESULT UseSPFPermErrorScore([out, retval] long *pVal);
   [propput, id(53), helpstring("The score an SPF permerror adds: the check finished and the domain's published record is unusable - two records, a bad mechanism, a redirect loop, too many lookups. 0, the default, adds nothing; a retry will not fix a permerror, so it is never deferred.")] HRESULT UseSPFPermErrorScore([in] long newVal);
   [propget, id(54), helpstring("Whether an SPF temperror answers 451 4.4.3 for the transaction - RFC 7208 section 8.6's own answer to a check that did not finish - so a resolver blip defers the message instead of accepting or refusing it on a guess. Off by default: a temperror is accepted and scored by UseSPFTempErrorScore. A sender the domain policy list marks white is never deferred.")] HRESULT SPFTempErrorDefer([out, retval] VARIANT_BOOL *pVal);
   [propput, id(54), helpstring("Whether an SPF temperror answers 451 4.4.3 for the transaction - RFC 7208 section 8.6's own answer to a check that did not finish - so a resolver blip defers the message instead of accepting or refusing it on a guess. Off by default: a temperror is accepted and scored by UseSPFTempErrorScore. A sender the domain policy list marks white is never deferred.")] HRESULT SPFTempErrorDefer([in] VARIANT_BOOL newVal);
   [propget, id(55), helpstring("Whether MAIL FROM:<> naming more than one recipient is refused: the second and every later RCPT TO answers 550 5.7.1 and the transaction's DATA is refused too, because a delivery status notification has exactly one recipient and a null sender with several is backscatter, a forged report or a probe. A single-recipient null sender is untouched. Off by default; unauthenticated sessions of an IP range that runs the spam tests only, and never a sender the anti-spam white list covers.")] HRESULT RejectMultiRcptNullSender([out, retval] VARIANT_BOOL *pVal);
   [propput, id(55), helpstring("Whether MAIL FROM:<> naming more than one recipient is refused: the second and every later RCPT TO answers 550 5.7.1 and the transaction's DATA is refused too, because a delivery status notification has exactly one recipient and a null sender with several is backscatter, a forged report or a probe. A single-recipient null sender is untouched. Off by default; unauthenticated sessions of an IP range that runs the spam tests only, and never a sender the anti-spam white list covers.")] HRESULT RejectMultiRcptNullSender([in] VARIANT_BOOL newVal);
   [propget, id(56), helpstring("Whether the connecting address of a refused multi-recipient null sender is also banned, for BanMultiRcptNullSenderHours, through the expiring IP range a run of failed logons creates - lifted by the same sweep, mirrored into the firewall by the same reconciliation, and never for an address on AutoBanNeverBan or an incoming relay. Off by default, so one mis-sent report with two recipients does not ban a real mail server; does nothing while RejectMultiRcptNullSender is off.")] HRESULT BanMultiRcptNullSender([out, retval] VARIANT_BOOL *pVal);
   [propput, id(56), helpstring("Whether the connecting address of a refused multi-recipient null sender is also banned, for BanMultiRcptNullSenderHours, through the expiring IP range a run of failed logons creates - lifted by the same sweep, mirrored into the firewall by the same reconciliation, and never for an address on AutoBanNeverBan or an incoming relay. Off by default, so one mis-sent report with two recipients does not ban a real mail server; does nothing while RejectMultiRcptNullSender is off.")] HRESULT BanMultiRcptNullSender([in] VARIANT_BOOL newVal);
   [propget, id(57), helpstring("How long that ban lasts, in hours, 1 to 8760. 24 by default.")] HRESULT BanMultiRcptNullSenderHours([out, retval] long *pVal);
   [propput, id(57), helpstring("How long that ban lasts, in hours, 1 to 8760. 24 by default.")] HRESULT BanMultiRcptNullSenderHours([in] long newVal);
   [propget, id(58), helpstring("The domain white and black list (Common/AntiSpam/DomainPolicyList.h) as a JSON document: items, each with id, pattern (example.com for that domain alone, .example.com for the domain and everything beneath it), match_on (envelope, helo or both), action (white: the session skips greylisting and the refusals the spam score would make while every test still runs and logs; black: 550 at MAIL FROM before greylisting, scoring or any lookup), note and created. Consulted for unauthenticated inbound sessions of an IP range that runs the spam tests only, never to override authentication, and distinct from the per-recipient allow and block lists, which act at delivery. The same rows the REST route /api/v1/domain-policy-list edits.")] HRESULT DomainPolicyList([out, retval] BSTR *pVal);
   [id(59), helpstring("Adds a row to the domain white and black list and answers its id. Pattern is a domain, or .domain for the domain and everything beneath it; MatchOn is envelope, helo or both; Action is white or black; Note is the operator's own text. Refused when the pattern is not a domain name, a word is not one of the choices, or the pair of pattern and MatchOn is already listed. In force for the next session.")] HRESULT AddDomainPolicyListEntry([in] BSTR Pattern, [in] BSTR MatchOn, [in] BSTR Action, [in] BSTR Note, [out, retval] long *ID);
   [id(60), helpstring("Removes a row of the domain white and black list by its id, and answers whether there was one. A black row removed stops refusing at once; a white row removed puts the domain back under greylisting and the score for the next session.")] HRESULT RemoveDomainPolicyListEntry([in] long ID, [out, retval] VARIANT_BOOL *Removed);
   [id(61), helpstring("Runs the quarantine digest pass as the scheduler would in the given hour of the day, 0 to 23: the digest switch and its hour are settings with levels, so an account with an hour of its own is sent at its hour and its domain's accounts at theirs. Like SendQuarantineDigests it spreads nothing and ignores the twenty-hour rule; the opt-out, a missing QuarantineDigestBaseUrl and an empty digest still send nothing. Returns how many digests were sent; an hour outside 0 to 23 sends none.")] HRESULT SendQuarantineDigestsAtHour([in] long Hour, [out, retval] long *pVal);
   [propget, id(80), helpstring("Whether a session whose HELO/EHLO name is not a fully qualified domain name is refused at MAIL FROM with 550 5.7.1: an address with or without brackets, a single label such as localhost, a public suffix such as co.uk, or anything that is not a host name. No DNS is asked; the suffix is the Public Suffix List's. MAIL FROM:<> does not excuse the HELO. Off by default; unauthenticated sessions of an IP range that runs the spam tests only, never a sender the anti-spam white list covers and never an incoming relay.")] HRESULT RefuseHeloNotFqdn([out, retval] VARIANT_BOOL *pVal);
   [propput, id(80), helpstring("Whether a session whose HELO/EHLO name is not a fully qualified domain name is refused at MAIL FROM with 550 5.7.1: an address with or without brackets, a single label such as localhost, a public suffix such as co.uk, or anything that is not a host name. No DNS is asked; the suffix is the Public Suffix List's. MAIL FROM:<> does not excuse the HELO. Off by default; unauthenticated sessions of an IP range that runs the spam tests only, never a sender the anti-spam white list covers and never an incoming relay.")] HRESULT RefuseHeloNotFqdn([in] VARIANT_BOOL newVal);
   [propget, id(81), helpstring("Whether a session whose envelope sender's domain is not a fully qualified domain name is refused at MAIL FROM with 550 5.7.1: user@192.0.2.7, user@[192.0.2.7], an IPv6 literal, a single label, a public suffix. MAIL FROM:<> has no domain and is not judged by this. Off by default; the same sessions as RefuseHeloNotFqdn, and independent of it.")] HRESULT RefuseMailFromDomainNotFqdn([out, retval] VARIANT_BOOL *pVal);
   [propput, id(81), helpstring("Whether a session whose envelope sender's domain is not a fully qualified domain name is refused at MAIL FROM with 550 5.7.1: user@192.0.2.7, user@[192.0.2.7], an IPv6 literal, a single label, a public suffix. MAIL FROM:<> has no domain and is not judged by this. Off by default; the same sessions as RefuseHeloNotFqdn, and independent of it.")] HRESULT RefuseMailFromDomainNotFqdn([in] VARIANT_BOOL newVal);
};


