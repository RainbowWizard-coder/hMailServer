      [propput, id(71), helpstring("The size of the RSA keys the rotation generates: 2048, 3072 or 4096. Default 2048.")] HRESULT DKIMRotationKeyBits([in] long newVal);
      [propget, id(72), helpstring("The state of this domain's key rotation as a JSON document: the policy, the phase, the current, next, retiring and retired selectors with the TXT records to publish, keep or remove and the last check of each, and what is waiting and until when. The same document GET /api/v1/domains/{domain}/dkim/rotation answers.")] HRESULT DKIMRotationStatus([out, retval] BSTR *pVal);
      [id(73), helpstring("Rotate now: generates a key under the given selector (empty for the suggestion, s and the UTC date) in the DKIM directory under the data directory and stages it as the secondary. Acts at once, whatever the schedule. Returns the status document.")] HRESULT DKIMRotationStart([in] BSTR Selector, [out, retval] BSTR *Status);
      [id(74), helpstring("Checks the next, current and retiring TXT records from the server's resolver now. Returns the status document.")] HRESULT DKIMRotationCheck([out, retval] BSTR *Status);
      [id(75), helpstring("Moves signing to the next key now. Refused unless its record matches in a check made by this call; Force skips the propagation period and never the check. Returns the status document.")] HRESULT DKIMRotationSwitch([in] VARIANT_BOOL Force, [out, retval] BSTR *Status);
      [id(76), helpstring("Retires the old selector now rather than at the end of the retention period; a key file the rotation generated is removed. Returns the status document.")] HRESULT DKIMRotationRetire([out, retval] BSTR *Status);
      [id(77), helpstring("Cancels the next key: the secondary selector is emptied and a key file the rotation generated for it is removed. Signing is unchanged. Returns the status document.")] HRESULT DKIMRotationCancel([out, retval] BSTR *Status);
      [propget, id(84), helpstring("The country policy applied when an account of this domain signs in, on any protocol. Empty is off; otherwise allow:GB,IE or block:CN,RU. A domain is not known when a connection is accepted, which is why this is about signing in and Settings.CountryPolicy is about connecting. A refused sign-in is the ordinary invalid-credentials answer and is never counted against the account or the address.")] HRESULT CountryPolicy([out, retval] BSTR *pVal);
      [propput, id(84), helpstring("The country policy applied when an account of this domain signs in, on any protocol. Empty is off; otherwise allow:GB,IE or block:CN,RU. A domain is not known when a connection is accepted, which is why this is about signing in and Settings.CountryPolicy is about connecting. A refused sign-in is the ordinary invalid-credentials answer and is never counted against the account or the address.")] HRESULT CountryPolicy([in] BSTR newVal);

      // The domain's half of the Web Key Directory. Off on every domain, and with
      // it off no account of this domain is published whatever the account says.
      [propget, id(81), helpstring("Publish this domain's accounts' OpenPGP public keys in the Web Key Directory. Off by default. The server setting and the account's own switch have to be on as well.")] HRESULT OpenPGPPublishKeys([out, retval] VARIANT_BOOL *pVal);
      [propput, id(81), helpstring("Publish this domain's accounts' OpenPGP public keys in the Web Key Directory. Off by default. The server setting and the account's own switch have to be on as well.")] HRESULT OpenPGPPublishKeys([in] VARIANT_BOOL newVal);
      [propget, id(82), helpstring("Whether an account CREATED in this domain from now on starts with publishing switched on. Off by default, and it never changes an account that already exists.")] HRESULT OpenPGPPublishNewAccounts([out, retval] VARIANT_BOOL *pVal);
      [propput, id(82), helpstring("Whether an account CREATED in this domain from now on starts with publishing switched on. Off by default, and it never changes an account that already exists.")] HRESULT OpenPGPPublishNewAccounts([in] VARIANT_BOOL newVal);

      // Outbound webhooks, per domain. See Common/Util/WebhookManager.h.
      [propget, id(86), helpstring("Whether anything this domain's mail or accounts do raises an outbound webhook event at all. On by default, because a subscription that names no domain is already the administrator saying every domain, and an installation with no subscription raises nothing either way. Off is a domain administrator taking their domain out of it whatever the subscriptions ask for. Saved by Save.")] HRESULT WebhooksEnabled([out, retval] VARIANT_BOOL *pVal);
      [propput, id(86), helpstring("Whether anything this domain's mail or accounts do raises an outbound webhook event at all. On by default, because a subscription that names no domain is already the administrator saying every domain, and an installation with no subscription raises nothing either way. Off is a domain administrator taking their domain out of it whatever the subscriptions ask for. Saved by Save.")] HRESULT WebhooksEnabled([in] VARIANT_BOOL newVal);
      [propget, id(87), helpstring("Whether a webhook body about this domain may carry a message subject. OFF by default on every domain, because a subject line is what a message is about and a stream of them to a third-party endpoint is a disclosure nobody asked for. A subject travels only where this and the subscription's own include_subject both say so, and only on message.received and message.quarantined. Saved by Save.")] HRESULT WebhookSubjects([out, retval] VARIANT_BOOL *pVal);
      [propput, id(87), helpstring("Whether a webhook body about this domain may carry a message subject. OFF by default on every domain, because a subject line is what a message is about and a stream of them to a third-party endpoint is a disclosure nobody asked for. A subject travels only where this and the subscription's own include_subject both say so, and only on message.received and message.quarantined. Saved by Save.")] HRESULT WebhookSubjects([in] VARIANT_BOOL newVal);

      // The reports the domain receives, read. See Common/Util/DomainReports.h.
      [propget, id(175), helpstring("The address this domain's DMARC aggregate and TLS-RPT reports are posted to - what its rua= tags name - and the one address this server reads such reports from. One address in a domain this server hosts, or empty, which is the default and reads nothing. The account or alias at it is the administrator's to make. Saved by Save.")] HRESULT ReportMailbox([out, retval] BSTR *pVal);
      [propput, id(175), helpstring("The address this domain's DMARC aggregate and TLS-RPT reports are posted to - what its rua= tags name - and the one address this server reads such reports from. One address in a domain this server hosts, or empty, which is the default and reads nothing. The account or alias at it is the administrator's to make. Saved by Save.")] HRESULT ReportMailbox([in] BSTR newVal);

      // Restricted delivery. See Common/Util/RestrictedDelivery.h.
      [propget, id(176), helpstring("Restricted delivery: the domains this domain's accounts may exchange mail with, as stored - lower-cased names separated by commas, each a domain (partner.example) or a suffix (.example, the domain and everything beneath it), ASCII, at most 2,000 characters. Empty, the default, restricts nothing. With a list, an outside sender not in a named domain is answered 550 at RCPT TO for a restricted account, and a restricted account may send only to the named domains, its own domain and the postmaster; other domains this server hosts must be named too, while an alias or a distribution list in the own domain that reaches outside is the administrator's and stays open. Each account follows this unless its RestrictedDelivery says restricted or exempt.")] HRESULT RestrictedDomains([out, retval] BSTR *pVal);
      [propput, id(176), helpstring("Restricted delivery: the domains this domain's accounts may exchange mail with - domain names separated by commas or spaces, each partner.example or .example for the domain and everything beneath it, ASCII, at most 2,000 characters; lower-cased on save. Empty restricts nothing. An address, a path or an address literal is refused with a sentence. Saved by Save.")] HRESULT RestrictedDomains([in] BSTR newVal);

      // Impersonation protection. See Common/Util/ImpersonationCheck.h.
      [propget, id(177), helpstring("Impersonation protection: what is done with a message from outside whose From display name is an active account's person name or a protected person's, or whose sender domain is one edit or one look-alike character from a domain this server hosts or a protected partner. 0 is off (the default; nothing is read), 1 flags the recipient's copy with X-hMailServer-Impersonation, which the webmail shows as a warning, and 2 holds the copy in the quarantine as a spam verdict would - the digest and the administrator's release then work as for spam, and a release does not re-check. A sender the recipient's own safe-sender list allows is exempt, and so is a sender domain that is itself hosted here or a protected partner. Saved by Save.")] HRESULT ImpersonationAction([out, retval] long *pVal);
      [propput, id(177), helpstring("Impersonation protection: 0 off, 1 flag, 2 quarantine; anything else is refused. Saved by Save.")] HRESULT ImpersonationAction([in] long newVal);
      [propget, id(178), helpstring("Impersonation protection: the protected persons, as stored - one per line, each Name <address>, Name, or address. A person outside this domain's accounts whose name must not be borrowed: the chairman who has no mailbox here, or an address at another hosted domain (whose account's name is then protected too). At most 2,000 characters. Saved by Save.")] HRESULT ProtectedPersons([out, retval] BSTR *pVal);
      [propput, id(178), helpstring("Impersonation protection: the protected persons - names and addresses, one per line or separated by commas, each Name <address>, Name, or address; canonicalised on save. An entry whose address is not an address is refused with a sentence. Saved by Save.")] HRESULT ProtectedPersons([in] BSTR newVal);
      [propget, id(179), helpstring("Impersonation protection: the protected partners, as stored - lower-cased ASCII domain names separated by commas, whose look-alikes are judged exactly as this server's own domains' are. At most 2,000 characters. Saved by Save.")] HRESULT ProtectedPartners([out, retval] BSTR *pVal);
      [propput, id(179), helpstring("Impersonation protection: the protected partners - domain names separated by commas or spaces, ASCII (an internationalised name in its IDNA xn-- form), lower-cased on save. An address, a suffix or an address literal is refused with a sentence. Saved by Save.")] HRESULT ProtectedPartners([in] BSTR newVal);


      // Spam traps: addresses of this domain that were never real. See
      // Common/AntiSpam/SpamTrapMonitor.h.
      [propget, id(78), helpstring("This domain's spam traps, one address a line. An address here is refused at RCPT TO exactly as an address this server does not have, and the session that addressed it is banned and its sender blocked. Read by a domain administrator; the REST listing at /api/v1/domains/{domain}/spam-traps carries the id and the time as well.")] HRESULT SpamTraps([out, retval] BSTR *pVal);
      [id(79), helpstring("Declares an address of this domain a spam trap. Address is a whole address in this domain or just the part before the @, which is taken to be in it. Refused when an account, an alias or a distribution list already has the address - and an account, alias or list given a trap's address is refused in the same way. An address that is already a trap is not an error and makes no second trap.")] HRESULT AddSpamTrap([in] BSTR Address);
      [id(80), helpstring("Stops trapping an address, and answers whether it was one. What its hits already did - a banned address, a blocked sender - stays until it expires or is removed by hand, and so does the record of the hits.")] HRESULT RemoveSpamTrap([in] BSTR Address, [out, retval] VARIANT_BOOL *Removed);

      // One value, three levels. See Common/Application/EffectiveSetting.h and
      // docs/SettingLevels.md.
      [propget, id(180), helpstring("This domain's own value of a setting that may be set below the server - Name as REST, hmctl and GET /api/v1/settings/levels spell it, recall_days or max_message_size_kb - in its text form (a number, 1 or 0, or the text), or an empty string when the domain inherits the server's. A name that is not one of those is refused with a sentence.")] HRESULT SettingOverride([in] BSTR Name, [out, retval] BSTR *pVal);
      [propput, id(180), helpstring("Sets this domain's own value of a setting that may be set below the server, or - with an empty string - makes it inherit the server's. Written at once, not by Save, and in effect for the next reader. Refused with a sentence: a name that is not one of those settings, a level held in one of the domain's own properties (MaxMessageSize, QuarantineDigestHour and the rest set those), a gate (zero-access, the OpenPGP portal, the self-edited directory, plus addressing) to anybody but the server administrator, a value the setting refuses, a limit looser than the server's value, a domain not saved yet, and a domain the credential's grant does not reach.")] HRESULT SettingOverride([in] BSTR Name, [in] BSTR newVal);
      [propget, id(181), helpstring("The value of the setting in effect for this domain's accounts that hold none of their own: the domain's own value, or the server's. In its text form.")] HRESULT EffectiveSetting([in] BSTR Name, [out, retval] BSTR *pVal);
      [propget, id(182), helpstring("Where EffectiveSetting came from: domain or server.")] HRESULT EffectiveSettingSource([in] BSTR Name, [out, retval] BSTR *pVal);

};
[
