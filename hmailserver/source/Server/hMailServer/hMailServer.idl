[
   object,
   uuid(2C1A3EF1-115F-4029-BB33-D9CCA4BB0DE8),
   dual,
   nonextensible,
   helpstring("The application object is the root object in the hMailServer API. It's the first object you should create when you want to access the hMailServer API"),
   pointer_default(unique)
]
interface IInterfaceApplication : IDispatch{
   [id(1), helpstring("Starts an hMailServer server.")] HRESULT Start();
   [id(2), helpstring("Stops an hMailServer server.")] HRESULT Stop();
   
   [propget, id(3), helpstring("Gets the Settings object.")] HRESULT Settings([out, retval] IInterfaceSettings** pVal);
   [propget, id(4), helpstring("Gets the Domains collection.")] HRESULT Domains([out, retval] IInterfaceDomains **pVal);
   [propget, id(5), helpstring("Gets the current state of the server.")] HRESULT ServerState([out, retval] eServerState *pVal);
   [propget, id(6), helpstring("Gets the database interface.")] HRESULT Database([out, retval] IInterfaceDatabase **pVal);
   [propget, id(7), helpstring("Gets the Utilities object.")] HRESULT Utilities([out, retval] IInterfaceUtilities * *pVal);
   [id(8), helpstring("Submits pending email messages. May be triggered if an email has been manually inserted into the database.")] HRESULT SubmitEMail();
   [propget, id(9), helpstring("Returns the Status object.")] HRESULT Status([out, retval] IInterfaceStatus** pVal);
   [propget, id(10), helpstring("Gets the current hMailServer version")] HRESULT Version([out, retval] BSTR *pVal);
   
   [id(11), helpstring("Opens a connection to the hMailServer database.")] HRESULT Connect();
   [propget, id(12), helpstring("The initialization file currently in use.")] HRESULT InitializationFile([out, retval] BSTR *pVal);
   [id(13), helpstring("Reloads all the server settinsg")] HRESULT Reinitialize();
   [propget, id(14), helpstring("Gets a colleciton of global rules.")] HRESULT Rules([out, retval] IInterfaceRules** pVal);
   [propget, id(15), helpstring("Gets the backup manager.")] HRESULT BackupManager([out, retval] IInterfaceBackupManager **pVal);
   [propget, id(16), helpstring("Gets the global objects object.")] HRESULT GlobalObjects([out, retval] IInterfaceGlobalObjects **pVal);
   [id(17), helpstring("Authenticate the client.")] HRESULT Authenticate([in] BSTR Username, [in] BSTR Password, [out, retval] IInterfaceAccount** pAccount);
   [propget, id(18), helpstring("Quick links to access objects")] HRESULT Links([out, retval] IInterfaceLinks **pVal);
   [propget, id(19), helpstring("Gets a diagnostics object.")] HRESULT Diagnostics([out, retval] IInterfaceDiagnostics **pVal);

   [propget, id(20), helpstring("Gets the current hMailServer architecture (x86/x64)")] HRESULT VersionArchitecture([out, retval] BSTR *pVal);

   // Appended - and anything added later must be appended here too, below this
   // note. A dual interface's vtable follows DECLARATION order, not id(), so a
   // member inserted higher up silently shifts every slot beneath it while the
   // IID stays the same. An early-bound client built against the older type
   // library then calls the wrong method rather than failing to bind. The id()
   // values are what keep late binding stable; position is what keeps early
   // binding stable, and only one of the two is visible in a diff.
   [id(21), helpstring("Authenticate the client, presenting a TOTP code. An account with a second factor enrolled cannot be authenticated by password alone - a mail client has nowhere to type a code, which is what app passwords exist for, and this is the one path that can.")] HRESULT AuthenticateWithCode([in] BSTR Username, [in] BSTR Password, [in] BSTR Code, [out, retval] IInterfaceAccount** pAccount);
   [propget, id(22), helpstring("True when the administrator credential has a second factor enrolled. While it does, Authenticate refuses the administrator and AuthenticateWithCode is the one way in; the REST API's Basic credential needs an X-hMailServer-OTP header carrying the code. Readable before authenticating, so a client knows to ask for the code.")] HRESULT AdministratorTOTPEnabled([out, retval] VARIANT_BOOL *pVal);
   [propget, id(23), helpstring("The roles this server has, one per line: name, a tab, 1 or 0 for built-in, a tab, the description, a tab, the permissions comma-separated. A line and not an object so that no new COM interface has to be registered for it.")] HRESULT Roles([out, retval] BSTR *pVal);
   [propget, id(24), helpstring("The name of the role the signed-in credential holds, or an empty string for an ordinary account. What a Control Panel reads in order to leave out a page its user may not use.")] HRESULT CurrentRole([out, retval] BSTR *pVal);
   [propget, id(25), helpstring("The permissions the signed-in credential holds, comma-separated. The vocabulary is the one /api/v1/roles answers with.")] HRESULT CurrentPermissions([out, retval] BSTR *pVal);
   [propget, id(26), helpstring("Who holds which role, one per line: the account address, a tab, the role name, a tab, the domains as stored, a tab, and 1 when the assignment reaches every domain - the list is *, or it is empty and the role is serveradmin or auditor - or 0 otherwise. An account that is not listed holds the authority its AdminLevel gives it.")] HRESULT RoleAssignments([out, retval] BSTR *pVal);
   [id(27), helpstring("Give an account a role, in named domains (comma-separated; * for every domain; empty means every domain for serveradmin and auditor, and the account's own domain for every other role). An empty role name takes the role away. A credential may not hand out a permission it does not itself hold.")] HRESULT AssignRole([in] BSTR Address, [in] BSTR Role, [in] BSTR Domains);
   [id(28), helpstring("Set an account's password, by address, and clear its failed-authentication lockout. The password policy, the reuse history and the configured hash apply as they do to Account.Password. Needs the reset_password permission in the account's domain - the one thing the help-desk role exists to do - and an account holding authority this credential does not, a domain administrator's to a help desk among them, is refused. An address this credential may not reach reads exactly as one that does not exist.")] HRESULT ResetPassword([in] BSTR Address, [in] BSTR Password);
   [id(29), helpstring("Let an account back in, by address: its failed-authentication lockout and its POP3 mailbox lock are both cleared. Needs the unlock_account permission in the account's domain. An address this credential may not reach reads exactly as one that does not exist.")] HRESULT UnlockAccount([in] BSTR Address);
};

