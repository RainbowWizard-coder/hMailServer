[
   object,
   uuid(FB8812B0-524A-4922-9E29-A7E9A9E9151D),
   dual,
   nonextensible,
   helpstring("IInterfaceDiagnostics Interface"),
   pointer_default(unique)
]
interface IInterfaceDiagnostics : IDispatch
{
   [id(1), helpstring("Performs diagnostics.")] HRESULT PerformTests([out, retval] IInterfaceDiagnosticResults **pVal);
   [propget, id(2), helpstring("Gets or sets the local domain name to perform tests on.")] HRESULT LocalDomainName([out, retval] BSTR *pVal);
   [propput, id(2), helpstring("Gets or sets the local domain name to perform tests on.")] HRESULT LocalDomainName([in] BSTR newVal);
   [propget, id(3), helpstring("Gets or sets the test domain name to perform tests on.")] HRESULT TestDomainName([out, retval] BSTR *pVal);
   [propput, id(3), helpstring("Gets or sets the test domain name to perform tests on.")] HRESULT TestDomainName([in] BSTR newVal);
   [propget, id(4), helpstring("True when this server binary keeps its assertions and reports a violated one as HM6364 (a Release build made with build.ps1 -Asserts). The shipped binary answers false.")] HRESULT AssertionsEnabled([out, retval] VARIANT_BOOL *pVal);
   [id(5), helpstring("Fails one assertion on purpose so the reporting path can be exercised: on a build that keeps assertions it writes HM6364 to the ERROR log and returns; on the shipped binary it does nothing. Server administrators only.")] HRESULT TriggerAssertion();
   [id(6), helpstring("The DNSSEC chain status of a name's records of a type - TXT, MX, or TLSA with the name given as host:port - as the validating resolver sees it: 0 secure, 1 insecure, 2 bogus. For tests that sign a zone of their own and point the trust anchors at it; not a lookup of anything a client would use.")] HRESULT DnssecChainStatus([in] BSTR sName, [in] BSTR sType, [out, retval] long *pVal);
   [id(7), helpstring("When an ACME certificate valid from notBefore to notAfter (Unix seconds) would be renewed by this server's own arithmetic, as Unix seconds: two thirds of the way through its lifetime, never later than a day before it expires, and at issue when it does not live a day. The CA's suggested renewal window (ARI) is not consulted. For tests.")] HRESULT AcmeRenewalTime([in] double notBefore, [in] double notAfter, [out, retval] double *pVal);

};

