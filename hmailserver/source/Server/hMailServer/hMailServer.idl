[
   object,
   uuid(F6BB0F43-EDEE-49A8-8166-672F3017426F),
   dual,
   nonextensible,
   helpstring("The utilities object contains misc. functions used by hMailServer Administrator."),
   pointer_default(unique)
]
interface IInterfaceUtilities : IDispatch{
   [id(1), helpstring("Returns the mail server handling e-mail for the specified email address.")] HRESULT GetMailServer([in] BSTR EMailAddress, [out, retval] BSTR *MailServer);
   [id(2), helpstring("Returns true if the given e-mail address is valid. false otherwise.")] HRESULT IsValidEmailAddress([in] BSTR EMailAddress, [out, retval] VARIANT_BOOL *bIsValid);

   // The server's own reputation: its outbound addresses against the DNS block
   // lists. The report reads what the last check found; the check makes the
   // lookups. See Common/Util/ReputationWatch.h.
   [id(38), helpstring("Checks this server's outbound addresses - the SMTP delivery bind address, the addresses the active global rules bind, and ReputationWatchAddresses - against the DNS block lists in ReputationWatchLists now, as the daily task does. Each list is asked about the two RFC 5782 test entries first, so a list that refuses this resolver, that is not answering it, or that answers for every address is told apart from one that says nothing is listed; a lookup that fails is never reported as clean and never clears a listing an earlier check found. Returns the report as JSON with a run member saying what this check did. A check that is already running is not waited for: this call fails at once, saying that a reputation check is already running, because a check makes a lookup per address per list and a caller queued behind one would hold this call open for the whole of it. Server administrators only.")] HRESULT RunReputationCheck([out, retval] BSTR *Report);
   [id(39), helpstring("What the last reputation check found, as JSON: every outbound address with each list's answer (status, listed as true, false or null, the answer, the list's reason, when it was checked and since when it has been listed), the addresses that are deliberately not looked up with the reason, and when the last check was. Looks nothing up and writes nothing. Server administrators only.")] HRESULT GetReputationReport([out, retval] BSTR *Report);
   [id(3), helpstring("Returns true if the given domain name is valid.")] HRESULT IsValidDomainName([in] BSTR sDomainName, [out, retval] VARIANT_BOOL *bIsValid);
   [id(4), helpstring("Returns the MD5 hex string for a string.")] HRESULT MD5([in] BSTR Input, [out, retval] BSTR *Output);
   [id(5), helpstring("Encrypts a string to blowfish.")] HRESULT BlowfishEncrypt([in] BSTR Input, [out, retval] BSTR *Output);
   [id(6), helpstring("Decrypts a string from blowfish.")] HRESULT BlowfishDecrypt([in] BSTR Input, [out, retval] BSTR *Output);
   [id(7), helpstring("Makes the hMailServer service dependent on another service.")] HRESULT MakeDependent([in] BSTR OtherService);
   [id(8), helpstring("Imports a message from a file on disk for delivery or to a specific account.")] HRESULT ImportMessageFromFile([in] BSTR sFilename, [in] long iAccountID, [out, retval] VARIANT_BOOL *bIsSuccessful);
   [id(9), helpstring("Sends an email message to accounts on the server.")] HRESULT EmailAllAccounts([in] BSTR sRecipientWildcard, [in] BSTR sFromAddress, [in] BSTR sFromName, [in] BSTR sSubject, [in] BSTR sBody, [out, retval] VARIANT_BOOL *bIsSuccessful);
   [id(10), helpstring("Returns a unique GUID")] HRESULT GenerateGUID([out, retval] BSTR *Output);
   [id(11), helpstring("Runs test suite. This will delete all objects on the server.")] HRESULT RunTestSuite([in] BSTR sTestPassword);
   [id(40), helpstring("What has addressed a spam trap, newest first, as a JSON document: items, each with id, time, address, domain, ip_address, sender, banned, blocked and note - the note says what was done, or why the address was not banned or the sender not blocked. Domain empty is every domain, and then hits_since_start is in the document too: the counter the metrics exposition publishes as hmailserver_spam_trap_hits_total. MaxRows is 1 to 1000. Server administrators only.")] HRESULT GetSpamTrapHits([in] BSTR Domain, [in] long MaxRows, [out, retval] BSTR *Json);
   [id(41), helpstring("Clears the record of spam trap hits and answers how many rows went; Domain empty is every domain. The bans and the blocked senders the hits made are untouched and the counter is not reset - this clears a record, it undoes nothing. Server administrators only.")] HRESULT ClearSpamTrapHits([in] BSTR Domain, [out, retval] long *Removed);
   [id(68), helpstring("Every journaling and dual-delivery rule as a JSON document: items, each with id, scope (domain or account), target (the domain name or the account address), journal_address, direction (inbound, outbound or both), mode (report or copy), enabled and note. A rule sends a copy of the mail it covers to one address - the Exchange envelope report with the original attached, or the message itself. Server administrators only.")] HRESULT GetJournalRules([out, retval] BSTR *Json);
   [id(69), helpstring("Writes a journaling rule and answers its id; Id 0 makes a new one and any other Id changes that rule. Scope is domain or account, Target the domain name or the account address, JournalAddress where the copy goes (local or anywhere else), Direction inbound, outbound or both, Mode report or copy. Inbound is a message with a local recipient the rule covers; outbound is a message from an authenticated sender it covers. Refused, with the reason, when a word is not one of those or the target is not hosted here; in force for the next accepted message. Server administrators only.")] HRESULT SaveJournalRule([in] long Id, [in] BSTR Scope, [in] BSTR Target, [in] BSTR JournalAddress, [in] BSTR Direction, [in] BSTR Mode, [in] VARIANT_BOOL Enabled, [in] BSTR Note, [out, retval] long *SavedId);
   [id(70), helpstring("Removes a journaling rule and answers whether there was one. The rule stops copying at once; what it already sent is wherever it was sent, because this server keeps no second copy and withdraws nothing. Server administrators only.")] HRESULT DeleteJournalRule([in] long Id, [out, retval] VARIANT_BOOL *Deleted);
   [id(12), helpstring("Checks if the given host name points at localhost.")] HRESULT IsLocalHost([in] BSTR sHostname, [out, retval] VARIANT_BOOL *bIsValid);
   [id(13), helpstring("Imports a message from a file on disk for delivery or to a specific account.")] HRESULT ImportMessageFromFileToIMAPFolder([in] BSTR sFilename, [in] long iAccountID, [in] BSTR sIMAPFolder, [out, retval] VARIANT_BOOL *bIsSuccessful);   
   [id(14), helpstring("Returns true if the given password is weak")] HRESULT IsStrongPassword([in] BSTR Username, [in] BSTR Password, [out, retval] VARIANT_BOOL *bIsValid);
   [id(15), helpstring("Returns a salted SHA256 hex string for a string.")] HRESULT SHA256([in] BSTR Input, [out, retval] BSTR *Output);
   [id(16), helpstring("Returns true if a rule criteria matches a value.")] HRESULT CriteriaMatch([in] BSTR MatchValue, [in] eRuleMatchType, [in] BSTR TestValue, [out, retval] VARIANT_BOOL *bMatch);
   [id(17), helpstring("Returns the ID of the message file")] HRESULT RetrieveMessageID([in] BSTR sFilename, [out, retval] hyper *messageID);
   [id(18), helpstring("Returns true if the given IP-address is parseable")] HRESULT IsValidIPAddress([in] BSTR IPAddress, [out, retval] VARIANT_BOOL *bIsValid);
   [id(19), helpstring("Performs maintenance operations in the database.")] HRESULT PerformMaintenance([in] eMaintenanceOperation operation);
   [id(20), helpstring("Checks the syntax of a Sieve (RFC 5228) script. Returns an empty string when valid, otherwise the error.")] HRESULT CheckSieveSyntax([in] BSTR Script, [out, retval] BSTR *Result);
   [id(21), helpstring("Evaluates a Sieve (RFC 5228) script against a raw message and returns the resulting action summary.")] HRESULT EvaluateSieveScript([in] BSTR Script, [in] BSTR RawMessage, [out, retval] BSTR *Result);
   // Added for issue #29. An administration tool that answers "where does mail to
   // this domain go" with the OPERATING SYSTEM's resolver answers the wrong
   // question whenever hMailServer.ini names a custom DNSServer: the server and
   // the tool can disagree, and it is the server's view that decides where mail
   // actually goes. This runs inside the server, on the same resolver delivery
   // uses.
   [id(22), helpstring("Resolves the MX records for a domain using the server's own resolver (honouring a configured custom DNS server), one 'hostname<TAB>ip-address' line per delivery target, ordered by MX preference as delivery orders them. Empty when the domain has no mail servers; raises an error when the lookup itself failed.")] HRESULT ResolveMXRecords([in] BSTR DomainName, [out, retval] BSTR *Result);
   // The RFC 8460 reporter runs hourly and only mails days that are over, so an
   // administrator who has just configured TlsRptFromAddress has nothing to look
   // at until tomorrow. This sends what has been collected right now - including
   // today's still-accumulating statistics when IncludeCurrentDay is set, which
   // RFC 8460 permits (a day may be covered by more than one report). Requires
   // server-admin rights, and refuses - preserving the collected statistics -
   // when TlsRptFromAddress is not configured, because running anyway could only

   // The per-domain half of the session policies, on this existing interface so
   // that the Control Panel and any script reach it without a new interface to
   // register. The server-wide half is four properties of Settings.
   [id(56), helpstring("The session policy in force for a domain as JSON: in_force (idle_seconds, lifetime_seconds, one_per_device, bind_to_address), server (the same four as stored server-wide), defaults (the ceilings that apply where nothing is set) and, when the name is a domain this server hosts, domain_policy - that domain's own row. An empty name answers the server-wide policy alone.")] HRESULT GetSessionPolicy([in] BSTR DomainName, [out, retval] BSTR *Json);
   [id(57), helpstring("Sets a domain's own session policy and saves the domain. IdleSeconds and LifetimeSeconds are seconds, 0 to take the server-wide value, at most 2592000; OnePerDevice and BindToAddress are 0 to take the server-wide answer, 1 for on and 2 for off, because a domain must be able to say 'not here' about a server-wide policy as well as 'here too'. Returns False for a domain this server does not host.")] HRESULT SetDomainSessionPolicy([in] BSTR DomainName, [in] long IdleSeconds, [in] long LifetimeSeconds, [in] long OnePerDevice, [in] long BindToAddress, [out, retval] VARIANT_BOOL *Saved);
   // discard the data it was asked to send.
   [id(23), helpstring("Sends the aggregate SMTP TLS reports (RFC 8460) collected so far to the domains that request them, rather than waiting for the hourly schedule. Set IncludeCurrentDay to also report today's still-accumulating statistics. Returns the number of reports submitted. Raises an error when TlsRptFromAddress is not configured; requires server administrator rights.")] HRESULT SendTlsRptReports([in] VARIANT_BOOL IncludeCurrentDay, [out, retval] long *ReportCount);
   // Country blocking, read-only: what the configured geographic database says
   // about one address, and what state that database is in. Both are questions
   // an administrator asks while writing a policy, and neither changes anything.
   [id(54), helpstring("The ISO 3166-1 country code the configured geographic database gives for an address, upper case, or an empty string when there is no database or it has no answer for that address. Reads and writes nothing.")] HRESULT LookupCountry([in] BSTR IPAddress, [out, retval] BSTR *Country);
   [id(55), helpstring("The state of the geographic database as JSON: configured, path, loaded, error, type, build_epoch, age_days, stale, bytes, ip_version, record_size, max_age_days, refusals_total, refusals_by_country and the four listener policies. Server administrators only.")] HRESULT GeoIpDatabaseStatus([out, retval] BSTR *Json);
   // The DMARC sibling of SendTlsRptReports, for the same reason: the hourly
   // reporter only mails days that are over, so an administrator who has just
   // configured DmarcRptFromAddress has nothing to look at until tomorrow.
   [id(24), helpstring("Sends the DMARC aggregate reports (RFC 7489) collected so far to the domains that request them, rather than waiting for the hourly schedule. Set IncludeCurrentDay to also report today's still-accumulating statistics. Returns the number of reports submitted. Raises an error when DmarcRptFromAddress is not configured; requires server administrator rights.")] HRESULT SendDmarcReports([in] VARIANT_BOOL IncludeCurrentDay, [out, retval] long *ReportCount);
   [id(25), helpstring("Erases the stored traces of an email address that account deletion leaves behind: quarantine entries, message-trace rows, greylisting triplets, distribution-list memberships, aliases, and (optionally) the per-user archive tree. Deliberately separate from deleting the account. Returns how many things were removed.")] HRESULT EraseAddressTraces([in] BSTR Address, [in] VARIANT_BOOL IncludeArchive, [out, retval] long *RemovedCount);
   [id(26), helpstring("Runs the message retention sweep now - every domain and account with a MessageRetentionDays policy - and returns how many messages it removed. The scheduled task runs the same sweep every six hours. Server administrators only.")] HRESULT RunMessageRetention([out, retval] long *DeletedCount);
   [id(27), helpstring("Records one sample of every metric into the metric history now, as the scheduled task does once a minute, and prunes samples older than MetricsHistoryDays. Returns the rows written, or -1 when MetricsHistoryDays is 0. Server administrators only.")] HRESULT SampleMetricsNow([out, retval] long *RowsWritten);
   [id(28), helpstring("The history of one metric as a JSON document: the samples of the last MinutesBack minutes averaged per BucketMinutes (0 returns every sample). Metric names are the exporter's without the hmailserver_ prefix, e.g. sessions_smtp, processed_messages_total. Server administrators only.")] HRESULT GetMetricHistory([in] BSTR Metric, [in] long MinutesBack, [in] long BucketMinutes, [out, retval] BSTR *Json);
   [id(29), helpstring("Searches the archive index (hm_archiveindex, schema 6029): Domain and Mailbox exact, Sender, Recipient and Subject as contains, Since and Until as YYYY-MM-DD HH:MM:SS bounds, HoldOnly, and at most MaxRows (1-1000) newest first. Returns a JSON array of {id, time, domain, mailbox, direction, sender, recipients, subject, message_id, path, size, hold}. Server administrators only.")] HRESULT SearchArchive([in] BSTR Domain, [in] BSTR Mailbox, [in] BSTR Sender, [in] BSTR Recipient, [in] BSTR Subject, [in] BSTR Since, [in] BSTR Until, [in] VARIANT_BOOL HoldOnly, [in] long MaxRows, [out, retval] BSTR *Json);
   [id(30), helpstring("Puts an archived copy on legal hold or lifts the hold: a held copy is never removed by the retention sweep or by an address erasure. Returns False when no such archive row exists. Server administrators only.")] HRESULT SetArchiveHold([in] long ArchiveID, [in] VARIANT_BOOL Hold, [out, retval] VARIANT_BOOL *Found);
   [id(31), helpstring("Runs one pass of the DKIM key rotation now, as the scheduled task does every fifteen minutes, with the clock moved SecondsAhead seconds forward (0 to 3660 days) - how the regression suite tests a propagation period or a retention period without waiting for it. The offset is this call's, but what the pass does is not: a switch or retire it makes happens now, early, and the times it records (a first sighting, a switch, the start of a retention period) are the moved clock's and stay recorded, so later passes on the real clock wait that much longer. Not for a production server. A non-zero offset is written to the application log. Returns a JSON summary: as_of, domains, generated, checked, switched, retired, errors. Server administrators only.")] HRESULT RunDkimRotation([in] long SecondsAhead, [out, retval] BSTR *Summary);
   // Bounces read, and the suppression list, as JSON documents on this existing
   // interface - the same documents GET /api/v1/domains/{domain}/suppressions and
   // The outbound webhook subscriptions as JSON documents on this existing
   // interface - the same documents GET /api/v1/webhooks and PUT /api/v1/webhooks/{name}
   // answer - so a Control Panel reaches them without a new interface to register.
   // The shared secret is never returned by either. Server administrators only.
   [id(52), helpstring("The outbound webhook subscriptions as JSON: {webhooks:[{name, url, secret_set, events, domains, addresses, enabled, include_subject, max_per_minute, created, pending, delivered, dead_lettered, dropped}], events:[the event names this build raises]}. Name empty for all of them, or one name for that one alone. The shared secret is never returned; secret_set says whether there is one.")] HRESULT GetWebhookSubscriptions([in] BSTR Name, [out, retval] BSTR *Json);
   [id(53), helpstring("Writes one outbound webhook subscription from a JSON object {name, url, secret, events, domains, addresses, enabled, include_subject, max_per_minute} - the same body POST /api/v1/webhooks takes, with remove:true to delete one instead. A field left out of a change keeps its value, and an empty secret keeps the one that is set rather than clearing it. Returns the subscription as it now stands, or {\"removed\":true}. Raises an error with the reason when it is refused.")] HRESULT SaveWebhookSubscription([in] BSTR Json, [out, retval] BSTR *Json2);
   // /bounces answer - so the Control Panel reaches them without a new interface to
   // register. The server administrator, or the domain administrator of that domain.
   [id(32), helpstring("The suppression list of a domain as JSON: domain, processing_enabled, action, total, offset and items of {address, source, category, status, diagnostic, remote_mta, created, expires, expired}, newest first. Search is a substring of the address; MaxRows 1 to 1000.")] HRESULT GetSuppressionList([in] BSTR DomainName, [in] BSTR Search, [in] long MaxRows, [out, retval] BSTR *Json);
   [id(33), helpstring("Puts an address on a domain's suppression list by hand, with a note and an expiry in days (0 for none, at most 3650). Returns False when it is listed already. Raises an error for an address that is not valid or that this server hosts.")] HRESULT AddSuppression([in] BSTR DomainName, [in] BSTR Address, [in] BSTR Note, [in] long ExpiresDays, [out, retval] VARIANT_BOOL *Added);
   [id(34), helpstring("Removes an address from a domain's suppression list, and starts its run of hard bounces again. Returns False when it was not listed.")] HRESULT RemoveSuppression([in] BSTR DomainName, [in] BSTR Address, [out, retval] VARIANT_BOOL *Removed);
   [id(35), helpstring("The bounce counts of a domain's recipients as JSON: domain, total, offset and items of {address, hard, soft, mailbox_full, policy, other, consecutive_hard, complaints, last_status, last_category, last_bounce, last_delivered, last_complaint, suppressed}, newest first.")] HRESULT GetBounceCounts([in] BSTR DomainName, [in] BSTR Search, [in] long MaxRows, [out, retval] BSTR *Json);
   [id(36), helpstring("How a status and a diagnostic would be classified, as JSON {category, suppresses, trusted, status}. A bare status reads as a delivery report's Status field; a reply beginning with its three digits reads as a refusal met while delivering. Reads and writes nothing.")] HRESULT ClassifyBounce([in] BSTR Status, [in] BSTR Diagnostic, [out, retval] BSTR *Json);
   [id(37), helpstring("Runs the suppression list's maintenance sweep now - expired entries, old counts, old report keys - and returns how many rows it removed. The scheduled task runs it hourly. Server administrators only.")] HRESULT RunBounceMaintenance([out, retval] long *Removed);
   // Complaints, read: the feedback loops, as JSON documents on this existing
   // interface - the same documents GET /api/v1/domains/{domain}/complaints and
   // /api/v1/complaints/rates answer. The server administrator, or the domain
   // administrator of that domain; the rates are every domain's and so are the
   // server administrator's alone.
   [id(44), helpstring("The abuse reports recorded for a domain as JSON: domain, processing_enabled, mailbox_configured, window_days, sent, complaints, rate_ppm, rate_judged, total, offset and items of {address, sender, account_id, feedback_type, counts, provider, source_ip, reported_domain, message_id, subject, arrival, received}, newest first. Search is a substring of the complained-of address, the sender, the subject or the provider; MaxRows 1 to 1000.")] HRESULT GetComplaints([in] BSTR DomainName, [in] BSTR Search, [in] long MaxRows, [out, retval] BSTR *Json);
   [id(45), helpstring("Every hosted domain's complaint rate over the last seven days as JSON: processing_enabled, mailbox, window_days, minimum_volume and domains of {domain, sent, complaints, rate_ppm, judged}, worst first. rate_ppm is complaints in a million messages delivered; judged is false for a domain that sent fewer than minimum_volume in the window, whose rate is reported as 0 because it would not mean anything. Read from the database at most once a minute. Server administrators only.")] HRESULT GetComplaintRates([out, retval] BSTR *Json);

   // An account's OpenPGP public keys, for an administrator. The account's own
   // switch and its key list are on IInterfaceAccount; these two are the upload and
   // the removal, which need the address rather than the account object.
   [id(50), helpstring("Stores an OpenPGP PUBLIC key for an account, given as an armoured PGP PUBLIC KEY BLOCK or as base64 of the key's bytes. A SECRET key is refused. A key the account already holds by that fingerprint is replaced. AllowAddressMismatch waives the rule that the key must name the account's own address, and is the server administrator's alone. Returns the stored key as JSON: fingerprint, version, algorithm, bits, user_id, created, expires, bytes, uploaded, uploaded_by, address, hashed_local_part and the two directory URLs.")] HRESULT ImportOpenPGPKey([in] BSTR AccountAddress, [in] BSTR Key, [in] VARIANT_BOOL AllowAddressMismatch, [out, retval] BSTR *Json);
   [id(51), helpstring("Removes one OpenPGP key from an account by its fingerprint. Returns False when the account does not hold that key.")] HRESULT RemoveOpenPGPKey([in] BSTR AccountAddress, [in] BSTR Fingerprint, [out, retval] VARIANT_BOOL *Removed);
   // Web Push, for a caller that has to stand in for a browser: a subscription key
   // pair, and the reverse of the encryption. Both exist because .NET Framework
   // has no AES-GCM, so the regression suite's fake push service cannot open a
   // push message for itself - and a test that asserts only that a push was SENT
   // asserts nothing about what it carried. Neither reads or writes anything.
   [id(58), helpstring("A fresh P-256 key pair of the kind a browser makes when it subscribes, as JSON {public_key, private_key} in base64url. For a caller that has to stand in for a browser; the server keeps nothing.")] HRESULT GenerateWebPushKeyPair([out, retval] BSTR *Json);
   [id(59), helpstring("Opens an RFC 8291 push message body (base64url of the aes128gcm bytes) with a subscription private key and auth secret, and returns the plain text. Raises an error when the body does not open. Reads and writes nothing.")] HRESULT WebPushDecrypt([in] BSTR BodyBase64Url, [in] BSTR PrivateKey, [in] BSTR AuthSecret, [out, retval] BSTR *PlainText);
   // The first-hour checklist (Common/Util/SetupChecklist.h): a domain, an
   // account, TLS on the submission port, SPF, DKIM, DMARC, a backup destination
   // and a second factor on the administrator password, each judged by the
   // server. The server administrator's, like the reputation report.
   // The audit trail for the Control Panel's page: what GET /api/v1/audit,
   // /api/v1/audit/verify and POST /api/v1/audit/{id}/revert answer.
   [id(61), helpstring("The audit trail as JSON - total, offset and entries, newest first, each with id, time, actor, actor_type, interface, address, object_type, object, action, detail, hash and previous_hash - filtered by a substring of the actor when Actor is not empty. MaxRows 1 to 1000, Offset from 0.")] HRESULT GetAuditTrail([in] BSTR Actor, [in] long MaxRows, [in] long Offset, [out, retval] BSTR *Json);
   [id(62), helpstring("Walks the audit trail's hash chain: JSON with intact, rows_checked, first_broken_id and reason.")] HRESULT VerifyAuditTrail([out, retval] BSTR *Json);
   // RevertAuditedChange writes the old value where the server reads the setting
   // (AuditRevert::PutBack): an hm_settings property into its column, by SetBool for
   // a switch, SetLong for a number and SetString for a text, and a [Settings] key
   // through IniFileSettings. It raises an error, with the reason, for an id no
   // row has, a row that is not a setting's change, a row whose detail does not
   // carry the two values, a secret's, a value the trail cut, a row whose values
   // hold " -> " themselves unless it is the setting's latest change in the trail
   // and exactly one place to divide it leaves the value the setting has now as
   // the new side (a [Settings] key's such row always), a number's row that holds
   // no number, a [Settings] value the store cannot hold, a setting this server no
   // longer has, and a write that failed; and, with the sentence every other way of
   // changing it is refused with, for one of the five [Settings] keys of the live
   // update's trust (UpdateSigningIdentity, UpdateSigningIssuer,
   // UpdateSourceRepository, UpdateTrustRootsFile and UpdateLogPublicKeyFile),
   // which only hMailServer.INI itself changes (IniSettingStore::
   // IsTrustAnchorName), and for a setting this server's environment sets
   // (hmailserver --apply-environment) - each unless the value put back is the one
   // the setting has already. The list is here and not in the helpstring because
   // MIDL keeps the first 260 characters of a helpstring in the type library and
   // drops the rest (measured with 10.0.26100.0): the helpstring is whole within
   // them, and says only that the call raises why it cannot.
   [id(63), helpstring("Puts a setting back to the value audit row AuditId says it had, by the setter of the column the server reads, and records the put-back. Answers the value written (true or false for a switch, (default) for a [Settings] key's default) or raises why it cannot.")] HRESULT RevertAuditedChange([in] long AuditId, [out, retval] BSTR *RestoredValue);
   [id(64), helpstring("Rewrites the server's own log files so that no line names the address: every occurrence becomes [erased]. Returns the number of occurrences rewritten. The half of an erasure that EraseAddressTraces leaves alone, because a rewritten log is a weaker record; asked for deliberately, as article 17 requires. Server administrator only.")] HRESULT EraseAddressLogLines([in] BSTR Address, [out, retval] long *LinesChanged);
   [id(60), helpstring("The first-hour checklist as JSON: eight items - domain, account, submission, spf, dkim, dmarc, backup, second_factor - each done, action_needed, cannot_tell or not_needed, with findings carrying a code, its arguments and an English sentence. With LookUpDns the SPF, DKIM and DMARC records of every active domain are looked up, which takes the resolver's timeout for each missing record; without it the record items say which host to look up.")] HRESULT GetSetupChecklist([in] VARIANT_BOOL LookUpDns, [out, retval] BSTR *Json);
   // The sample domain (Common/Application/SampleDomain.h): example.test with
   // three mailboxes, a distribution list, a rule and a handful of delivered
   // messages, made in one call and removed in one, so that every page of an
   // administration interface has something in it while somebody is learning.
   // The server administrator's, like the checklist above.
   [id(65), helpstring("Whether the sample domain is there, as JSON: state (present when example.test is here and this server made it, foreign when a domain of that name is here and it did not, absent when there is none), domain, domain_id, exists, accounts, list and password. The password is the same on every server and is printed in hmailserver/docs/SampleDomain.md, which is what makes the sample a throwaway one.")] HRESULT GetSampleDomain([out, retval] BSTR *Json);
   [id(66), helpstring("Creates the sample domain example.test - three accounts with one documented password, a public distribution list of the three, one rule on the first that files a subject carrying the word Invoice into a folder of that name, and eight messages queued through the server's own delivery path, so the list expands and the rule fires. Answers the report as JSON. Raises an error when a domain named example.test already exists, whoever made it: a domain this did not make is never taken over. The accounts must never be reachable from the Internet with that password - remove the sample before this server takes real mail.")] HRESULT CreateSampleDomain([out, retval] BSTR *Json);
   [id(67), helpstring("Removes the domain this server recorded as the sample, with its accounts, their mail and folders, its lists and its rules, and answers how many of each went as JSON. Raises an error when there is no sample, and when a domain named example.test is here that this did not make. Anything added to the domain in the meantime goes with it and is counted.")] HRESULT RemoveSampleDomain([out, retval] BSTR *Json);
   // A mailbox renamed or moved, reached by address rather than through an
   // Account object, and the journal of what has been moved - so a script, the
   // Control Panel and a support session can do and read the same thing without
   // first walking a domain's accounts.
   [id(46), helpstring("Renames the mailbox at Address, or moves it to another domain on this server, exactly as Account.MoveTo does - the same operation, reached by address. Returns the same JSON summary. Requires manage-accounts authority in the domain the mailbox is leaving and in the one it is going to.")] HRESULT MoveMailbox([in] BSTR Address, [in] BSTR NewAddress, [in] VARIANT_BOOL KeepOldAddressAsAlias, [out, retval] BSTR *Summary);
   [id(47), helpstring("The journal of mailbox moves as JSON {moves:[...]}, newest first: one entry per rename or move with both addresses, the stage it reached and what it carried. Address names one mailbox (its current address); an empty Address is every mailbox on the server and requires server administrator rights. MaxRows 1 to 1000, 100 by default.")] HRESULT GetMailboxMoves([in] BSTR Address, [in] long MaxRows, [out, retval] BSTR *Json);
   [id(42), helpstring("Whether a backup archive is encrypted: True when its headers - so the names of the files inside it - are encrypted, which is how every encrypted hMailServer backup is written. Read from the archive's own header, so it needs no passphrase and runs nothing. Raises an error when the file does not exist or is not a 7-Zip archive whose header can be read. Server administrators only.")] HRESULT BackupArchiveIsEncrypted([in] BSTR File, [out, retval] VARIANT_BOOL *Encrypted);
};

[
   object,
   uuid(9420A3E9-ED5C-4699-98BE-0CBF3B7D3714),
   dual,
   nonextensible,
   helpstring("The alias object represents one hMailServer alias."),
   pointer_default(unique)
]
interface IInterfaceAlias : IDispatch
{
   [propget, id(1), helpstring("The alias is active.")] HRESULT Active([out, retval] VARIANT_BOOL *pVal);
   [propput, id(1), helpstring("The alias is active.")] HRESULT Active([in] VARIANT_BOOL newVal);
   [propget, id(2), helpstring("The identifier of the domain in which the alias belong.")] HRESULT DomainID([out, retval] long *pVal);
   [propput, id(2), helpstring("The identifier of the domain in which the alias belong.")] HRESULT DomainID([in] long newVal);
   [propget, id(3), helpstring("The unique database identifier for the alias.")] HRESULT ID([out, retval] long *pVal);
   [propget, id(4), helpstring("The name of the alias.")] HRESULT Name([out, retval] BSTR *pVal);
   [propput, id(4), helpstring("The name of the alias.")] HRESULT Name([in] BSTR newVal);
   [propget, id(6), helpstring("The value of the alias.")] HRESULT Value([out, retval] BSTR *pVal);
   [propput, id(6), helpstring("The value of the alias.")] HRESULT Value([in] BSTR newVal);
   [id(7), helpstring("Deletes the alias from the database.")] HRESULT Delete();
   [id(8), helpstring("Saves the alias to the database.")] HRESULT Save();

};
[
   object,
   uuid(0CD0DDFF-2D30-41BE-9845-D37EADB1A007),
   dual,
   nonextensible,
   helpstring("The attachment object represents a single email attachment."),
   pointer_default(unique)
]
interface IInterfaceAttachment : IDispatch
{
   [propget, id(1), helpstring("The filename of the attachment.")] HRESULT Filename([out, retval] BSTR *pVal);
   [propget, id(2), helpstring("The size of the attachment.")] HRESULT Size([out, retval] long *pVal);
   [id(3), helpstring("Saves the attachment to a file with the given name.")] HRESULT SaveAs(BSTR sName);
   [id(4), helpstring("Removes this attachment from the message.")] HRESULT Delete();
};
[
   object,
