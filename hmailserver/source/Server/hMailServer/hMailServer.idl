   [propget, id(35), helpstring("First name of the account holder.")] HRESULT PersonFirstName([out, retval] BSTR *pVal);
   [propput, id(35), helpstring("First name of the account holder.")] HRESULT PersonFirstName([in] BSTR newVal);

   [propget, id(36), helpstring("Last name of the account holder.")] HRESULT PersonLastName([out, retval] BSTR *pVal);
   [propput, id(36), helpstring("Last name of the account holder.")] HRESULT PersonLastName([in] BSTR newVal);
   [id(37), helpstring("Deletes the account from the database.")] HRESULT Delete();
   
    [propget, id(38), helpstring("Vacation message is set to be aborted on messages marked as spam.")] HRESULT VacationMessageAbortSpamFlagged([out, retval] VARIANT_BOOL *pVal);
    [propput, id(38), helpstring("Vacation message is set to be aborted on messages marked as spam.")] HRESULT VacationMessageAbortSpamFlagged([in] VARIANT_BOOL newVal);
    // The out-of-office policy on the account: a window for the reply, a text
    // for colleagues, and a reply for colleagues only. The memory of who was
    // answered when is a table (hm_autoreplies), so a restart repeats nothing.
    [propget, id(63), helpstring("Days after which a sender who has been answered is answered again while the reply stays on; 0 answers each sender once per absence, which is what every account had before. 0 to 3650.")] HRESULT VacationMessageDays([out, retval] long *pVal);
    [propput, id(63), helpstring("Days after which a sender who has been answered is answered again while the reply stays on; 0 answers each sender once per absence, which is what every account had before. 0 to 3650.")] HRESULT VacationMessageDays([in] long newVal);
    [propget, id(64), helpstring("Subject sent to senders whose address belongs to this server. Empty means VacationSubject.")] HRESULT VacationInternalSubject([out, retval] BSTR *pVal);
    [propput, id(64), helpstring("Subject sent to senders whose address belongs to this server. Empty means VacationSubject.")] HRESULT VacationInternalSubject([in] BSTR newVal);
    [propget, id(65), helpstring("Text sent to senders whose address belongs to this server, in place of VacationMessage. Empty means VacationMessage. Never sent outside: the envelope sender is all that tells a colleague from a stranger, so it must not say anything that cannot be shown to one.")] HRESULT VacationInternalMessage([out, retval] BSTR *pVal);
    [propput, id(65), helpstring("Text sent to senders whose address belongs to this server, in place of VacationMessage. Empty means VacationMessage. Never sent outside: the envelope sender is all that tells a colleague from a stranger, so it must not say anything that cannot be shown to one.")] HRESULT VacationInternalMessage([in] BSTR newVal);
    [propget, id(66), helpstring("When on, the reply answers senders whose address belongs to this server and nobody else; the domain's VacationExternalOverride, when on, still answers strangers with the domain's text.")] HRESULT VacationMessageInternalOnly([out, retval] VARIANT_BOOL *pVal);
    [propput, id(66), helpstring("When on, the reply answers senders whose address belongs to this server and nobody else; the domain's VacationExternalOverride, when on, still answers strangers with the domain's text.")] HRESULT VacationMessageInternalOnly([in] VARIANT_BOOL newVal);
    [propget, id(39), helpstring("Forwarding is set to be aborted on messages marked as spam.")] HRESULT ForwardAbortSpamFlagged([out, retval] VARIANT_BOOL *pVal);
    [propput, id(39), helpstring("Forwarding is set to be aborted on messages marked as spam.")] HRESULT ForwardAbortSpamFlagged([in] VARIANT_BOOL newVal);
    [propget, id(40), helpstring("The account's active Sieve (RFC 5228) filter script.")] HRESULT SieveScript([out, retval] BSTR *pVal);
    [propput, id(40), helpstring("The account's active Sieve (RFC 5228) filter script.")] HRESULT SieveScript([in] BSTR newVal);
    [propget, id(42), helpstring("Application-specific passwords for this account: separately revocable credentials for clients that cannot present a second factor.")] HRESULT AppPasswords([out, retval] IInterfaceAppPasswords** pVal);
    [propget, id(43), helpstring("True when this account has a second factor enrolled. While it is, the account password no longer authenticates a mail client and an app password is the only credential that does.")] HRESULT TOTPEnabled([out, retval] VARIANT_BOOL* pVal);
    [id(44), helpstring("Enrols a second factor and returns the otpauth:// URI to show as a QR code. The secret is inside that URI and is not retrievable afterwards. Call Save to keep it.")] HRESULT EnrolTOTP([out, retval] BSTR* pVal);
    [id(45), helpstring("Removes this account's second factor. Call Save to keep the change.")] HRESULT DisableTOTP();
   [id(46), helpstring("Copies every message in the account to .eml files under the given directory, mirroring the folder structure. Returns the number exported; fails rather than reporting a partial export as success.")] HRESULT ExportMessages(BSTR Directory, [out, retval] long *ExportedCount);
   [id(67), helpstring("Writes everything the server holds on the account to one .zip archive at the given path on the server's disk: every folder with mail as an mbox, the address book as vCard, the calendars, the webmail's preferences, the active Sieve script, the log lines naming the address, and an account.xml in the backup's form with the rest. Returns the number of messages; fails rather than reporting a partial archive. Server administrator only.")] HRESULT ExportArchive(BSTR File, [out, retval] long *ExportedCount);

   [propget, id(47), helpstring("Whether the server's spam filtering applies to this account. When False, a message the server classified as spam is still delivered to this account, unmarked: the spam flag, the X-hMailServer spam headers and the subject tag are removed from this account's copy at delivery. Does not affect the SMTP conversation - a message the global settings refuse, quarantine or greylist is stopped for every recipient before any per-account setting can run.")] HRESULT AntiSpamEnabled([out, retval] VARIANT_BOOL *pVal);
   [propput, id(47), helpstring("Whether the server's spam filtering applies to this account.")] HRESULT AntiSpamEnabled([in] VARIANT_BOOL newVal);
   [propget, id(48), helpstring("Per-account override of the spam mark threshold, applied to this account's copy at delivery. -1 uses the global behaviour; 0 means this account's copies are never marked. A value above the global mark threshold unmarks a copy whose recorded score (the X-hMailServer-Reason-Score header, present when add-reason-to-header is on) is below it; without that header the classification stands. A value at or below the global threshold changes nothing: a message below the global threshold carries no score at delivery, so there is nothing to re-judge.")] HRESULT SpamMarkThreshold([out, retval] long *pVal);
   [propput, id(48), helpstring("Per-account override of the spam mark threshold.")] HRESULT SpamMarkThreshold([in] long newVal);
   [propget, id(49), helpstring("Per-account spam delete threshold, applied at delivery to this account's copy only. -1 or 0 disables it. The copy is removed (quarantined instead when the quarantine store is enabled) only when its score provably reached the value, which means the score header this server recorded - never a guess. Requires 'add reason to header' to be on; with it off no score is provable and this override does nothing. The global delete threshold continues to govern refusal during the SMTP conversation, for all recipients alike.")] HRESULT SpamDeleteThreshold([out, retval] long *pVal);
   [propput, id(49), helpstring("Per-account spam delete threshold.")] HRESULT SpamDeleteThreshold([in] long newVal);

   // The clients that have signed in to this account (hm_signins, schema 6050),
   // as a JSON document rather than a collection: a collection would be two new
   // interfaces and two new coclasses to register, and what a caller does with
   // this is read it or hand it to a page. The same document the REST routes
   // answer, built by SignInStore, so the two cannot describe a client
   // differently.
   [id(59), helpstring("The clients that have signed in to this account as a JSON array, most recently used first: {id, protocol, address, agent, credential, credential_name, first_seen, last_seen, sign_ins, revoked, revoked_at}. id is the thirty-two hex characters RevokeDevice takes. Never a password and never anything derived from one.")] HRESULT GetDevices([out, retval] BSTR *Json);
   [id(60), helpstring("Ends every session a client of this account holds now: its browser session's token is invalidated and its live IMAP, POP3 and SMTP connections are dropped. RevokeCredential also deactivates the app password it signed in with, where it used one - which is what stops a stolen client signing in again. Not a ban: the entry stays, marked, and a later sign-in with a credential that still works clears the mark. Returns False when this account has no client with that id. Recorded in the audit trail.")] HRESULT RevokeDevice([in] BSTR DeviceID, [in] VARIANT_BOOL RevokeCredential, [out, retval] VARIANT_BOOL *Revoked);

   // Appended - and anything added later must be appended here too, below this
   // note. A dual interface's vtable follows DECLARATION order, not id(), so a
   // member inserted higher up silently shifts every slot beneath it while the
   // IID stays the same. An early-bound client built against the older type
   // library then calls the wrong method rather than failing to bind. The id()
   // values are what keep late binding stable; position is what keeps early
   // binding stable, and only one of the two is visible in a diff.
   [propget, id(41), helpstring("The vacation message does not activate before this date, so an absence can be scheduled in advance")] HRESULT VacationMessageBeginDate([out, retval] BSTR *pVal);
   [propput, id(41), helpstring("The vacation message does not activate before this date, so an absence can be scheduled in advance")] HRESULT VacationMessageBeginDate([in] BSTR pVal);
   [propget, id(51), helpstring("The named role this account holds, or an empty string when it holds none and its authority is the one AdminLevel has always given it. One of serveradmin, domainadmin, helpdesk, auditor, or a role an administrator made.")] HRESULT RoleName([out, retval] BSTR *pVal);
   [propput, id(51), helpstring("Give this account a role, or clear it with an empty string. Saved at once - there is no Save() for this - because an assignment is a row of its own and not a property of the account. A credential may not hand out a permission it does not itself hold.")] HRESULT RoleName([in] BSTR newVal);
   [propget, id(52), helpstring("The domains the account's role reaches, comma-separated. * is every domain; empty means every domain for serveradmin and auditor, and the account's own domain for every other role.")] HRESULT RoleDomains([out, retval] BSTR *pVal);
   [propput, id(52), helpstring("The domains the account's role reaches, comma-separated. Saved at once, with the role.")] HRESULT RoleDomains([in] BSTR newVal);
   [propget, id(53), helpstring("The permissions this account's role holds, comma-separated, as the server resolves them - the role's, or the ones AdminLevel gives it when it holds no role. Read-only: a permission is a property of a role, never of an account.")] HRESULT RolePermissions([out, retval] BSTR *pVal);

   // The account's half of the Web Key Directory. Holding a key so that a mail
   // client can find it is not the same decision as telling the whole internet
   // about it, which is why this switch is the person's own and is off until it
   // is set. Saved with the account, like every other property here.
   [propget, id(57), helpstring("Publish this account's OpenPGP public keys in the Web Key Directory. Off by default; the server setting and the domain's switch have to be on as well. Saved by Save().")] HRESULT OpenPGPPublish([out, retval] VARIANT_BOOL *pVal);
   [propput, id(57), helpstring("Publish this account's OpenPGP public keys in the Web Key Directory. Off by default; the server setting and the domain's switch have to be on as well. Saved by Save().")] HRESULT OpenPGPPublish([in] VARIANT_BOOL newVal);
   [propget, id(58), helpstring("The OpenPGP public keys this account holds, as a JSON document: publish, published (whether anything is actually served, all three switches together), address, hashed_local_part, advanced_url, direct_url, limit, and keys of {id, fingerprint, version, algorithm, bits, user_id, created, expires, bytes, uploaded, uploaded_by}. Read-only; Utilities.ImportOpenPGPKey and RemoveOpenPGPKey change it. No secret key is ever held, so none is ever reported.")] HRESULT OpenPGPKeys([out, retval] BSTR *pVal);

   // The account's recovery address and its one-time recovery codes
   // (Util/AccountRecovery.h). Read-only, and the address MASKED: the address
   // itself is another mailbox belonging to the person, nothing an
   // administrator does needs to read it, and no interface answers it once it
   // has been set. What an administrator can do about it is take it away, which
   // is what somebody ringing up to say "that address is not mine any more"
   // needs; setting one and making codes are the account holder's own, proved
   // with the account's own password in the webmail.
   [propget, id(68), helpstring("The account's recovery address, masked - the first letter of the local part, the first letter of each domain label, and the top-level label whole. Empty when none is set. The address itself is answered by no interface: it is enough to recognise an address the account holder chose and not enough to write to one they did not.")] HRESULT RecoveryAddress([out, retval] BSTR *pVal);
   [propget, id(69), helpstring("Whether the recovery address has been confirmed by following the link the server posted to it. An address that has not been confirmed is used for nothing: no password-reset link is ever sent to it.")] HRESULT RecoveryAddressVerified([out, retval] VARIANT_BOOL *pVal);
   [propget, id(70), helpstring("How many of the account's ten one-time recovery codes have not been used. 0 when it has never made a set.")] HRESULT RecoveryCodesUnused([out, retval] long *pVal);
   [id(71), helpstring("Removes the account's recovery address, and with it every confirmation and password-reset link in flight for it. The recovery codes are not touched - ClearRecoveryCodes() is the act for those. Recorded in the audit trail. Takes effect at once; there is no Save() for it.")] HRESULT ClearRecoveryAddress();
   [id(72), helpstring("Removes every one-time recovery code the account holds. The remedy for a code card somebody else has seen: a code stands in for the account's second factor, so a leaked set is a standing way past it. The recovery address is not touched - ClearRecoveryAddress() is the act for that. The account holder makes a fresh set from the webmail. Recorded in the audit trail. Takes effect at once; there is no Save() for it.")] HRESULT ClearRecoveryCodes();

   // The account's entry in the organisation's directory (DirectoryStore.h). A
   // row of hm_directory rather than a column of hm_accounts, but saved by this
   // object's Save() like every other property here, so an administrator sets a
   // title and a telephone number in the same breath as a name.
   [propget, id(73), helpstring("The account's job title in the organisation's directory. At most 100 characters, one line. Saved by Save().")] HRESULT DirectoryTitle([out, retval] BSTR *pVal);
   [propput, id(73), helpstring("The account's job title in the organisation's directory. At most 100 characters, one line. Saved by Save().")] HRESULT DirectoryTitle([in] BSTR newVal);
   [propget, id(74), helpstring("The account's department in the organisation's directory. At most 100 characters, one line. Saved by Save().")] HRESULT DirectoryDepartment([out, retval] BSTR *pVal);
   [propput, id(74), helpstring("The account's department in the organisation's directory. At most 100 characters, one line. Saved by Save().")] HRESULT DirectoryDepartment([in] BSTR newVal);
   [propget, id(75), helpstring("The account's work telephone number in the organisation's directory. At most 60 characters, one line. Saved by Save().")] HRESULT DirectoryPhone([out, retval] BSTR *pVal);
   [propput, id(75), helpstring("The account's work telephone number in the organisation's directory. At most 60 characters, one line. Saved by Save().")] HRESULT DirectoryPhone([in] BSTR newVal);
   [propget, id(76), helpstring("The account's mobile telephone number in the organisation's directory. At most 60 characters, one line. Saved by Save().")] HRESULT DirectoryMobile([out, retval] BSTR *pVal);
   [propput, id(76), helpstring("The account's mobile telephone number in the organisation's directory. At most 60 characters, one line. Saved by Save().")] HRESULT DirectoryMobile([in] BSTR newVal);
   [propget, id(77), helpstring("Where the account sits - a building, a floor, a room - in the organisation's directory. At most 100 characters, one line. Saved by Save().")] HRESULT DirectoryOffice([out, retval] BSTR *pVal);
   [propput, id(77), helpstring("Where the account sits - a building, a floor, a room - in the organisation's directory. At most 100 characters, one line. Saved by Save().")] HRESULT DirectoryOffice([in] BSTR newVal);
   [propget, id(78), helpstring("True when this account is left out of the organisation's directory: out of the listing, out of the webmail's completion, out of the directory page and out of the read-only CardDAV collection. The person sets this themselves in the webmail whatever DirectoryUserEditable says; an administrator can set it here. It hides nobody's mailbox - mail still arrives and the address still works.")] HRESULT DirectoryOptOut([out, retval] VARIANT_BOOL *pVal);
   [propput, id(78), helpstring("Leave this account out of the organisation's directory. Saved by Save().")] HRESULT DirectoryOptOut([in] VARIANT_BOOL newVal);
   [propget, id(79), helpstring("The administrator's note about this account's directory entry. At most 255 characters, one line. Never answered to a reader: it is not in the directory listing, the webmail or the CardDAV cards. Saved by Save().")] HRESULT DirectoryNote([out, retval] BSTR *pVal);
   [propput, id(79), helpstring("The administrator's note about this account's directory entry. Saved by Save().")] HRESULT DirectoryNote([in] BSTR newVal);
   [propget, id(80), helpstring("The account's directory photo as base64, or an empty string when it has none. Saved by Save().")] HRESULT DirectoryPhoto([out, retval] BSTR *pVal);
   [propput, id(80), helpstring("The account's directory photo as base64 - a JPEG, a PNG or a GIF of at most 100 KB decoded, judged by the bytes themselves - or an empty string to remove it. Saved by Save().")] HRESULT DirectoryPhoto([in] BSTR newVal);
   [propget, id(81), helpstring("The media type of the directory photo this account holds - image/jpeg, image/png or image/gif - or an empty string when it has none. Read-only: it is read from the bytes, never from what a caller said they were.")] HRESULT DirectoryPhotoType([out, retval] BSTR *pVal);
   [propget, id(82), helpstring("Whether this is a zero-access mailbox: every message delivered to it is encrypted, after the filters have run, to the account's own OpenPGP key, and this server cannot read, search, export or recover its mail. Read-only: the person switches it on and off from the webmail's Security page, once the ZeroAccessAllowed setting permits it, and an administrator cannot - a switch an administrator could throw would not be a promise about what an administrator cannot read.")] HRESULT ZeroAccess([out, retval] VARIANT_BOOL *pVal);
   [propget, id(83), helpstring("Restricted delivery: 0 follows the domain's RestrictedDomains list (the default), 1 is restricted - the account may exchange mail with the named domains, its own domain and the postmaster only, and when the domain names nothing, with its own domain alone - and 2 is exempt, an account in a restricted domain that may exchange mail with anyone. See Domain.RestrictedDomains.")] HRESULT RestrictedDelivery([out, retval] long *pVal);
   [propput, id(83), helpstring("Restricted delivery: 0 follows the domain, 1 restricted, 2 exempt; anything else is refused. Saved by Save.")] HRESULT RestrictedDelivery([in] long newVal);

   // One value, three levels. See Common/Application/EffectiveSetting.h and
   // docs/SettingLevels.md.
   [propget, id(84), helpstring("This account's own value of a setting that may be set below the server - Name as REST, hmctl and GET /api/v1/settings/levels spell it - in its text form, or an empty string when the account inherits its domain's. A name that is not one of those is refused with a sentence.")] HRESULT SettingOverride([in] BSTR Name, [out, retval] BSTR *pVal);
   [propput, id(84), helpstring("Sets this account's own value of a setting that may be set below the server, or - with an empty string - makes it inherit its domain's. Written at once, not by Save, and in effect for the next reader. Refused with a sentence: a name that is not one of those settings, a level held in one of the account's own properties (MessageRetentionDays), a gate to anybody but the server administrator, a value the setting refuses, a limit looser than its domain's value, an account not saved yet, a server administrator's account to anybody but a server administrator, and an account whose authority the credential does not take in.")] HRESULT SettingOverride([in] BSTR Name, [in] BSTR newVal);
   [propget, id(85), helpstring("The value of the setting in effect for this account: its own, else its domain's, else the server's. In its text form.")] HRESULT EffectiveSetting([in] BSTR Name, [out, retval] BSTR *pVal);
   [propget, id(86), helpstring("Where EffectiveSetting came from: account, domain or server.")] HRESULT EffectiveSettingSource([in] BSTR Name, [out, retval] BSTR *pVal);

   // SCIM provisioning. See Common/Util/RestApiScim.cpp and docs/Scim.md.
   [propget, id(87), helpstring("The organisation's identity provider's own id for the person this account is - SCIM's externalId, which an identity provider matches its users by (Entra's object id, Okta's user id). Empty on an account nothing provisioned. See docs/Scim.md.")] HRESULT ExternalId([out, retval] BSTR *pVal);
   [propput, id(87), helpstring("The identity provider's id for the person this account is: at most 255 characters, on one line, compared exactly. Saved by Save.")] HRESULT ExternalId([in] BSTR newVal);

   // Rooms and equipment. See Common/Util/ResourceBooking.h and
   // docs/RoomsAndEquipment.md. The booking policy is on REST and the Deck.
   [propget, id(88), helpstring("What the account is: 0 a person (the default), 1 a meeting room, 2 a piece of equipment. A room or a piece of equipment answers the invitations it is sent by its booking policy (GET and PUT /api/v1/accounts/{address}/booking-policy), is in the directory as what it is, and cannot be signed into by any protocol.")] HRESULT Kind([out, retval] long *pVal);
   [propput, id(88), helpstring("What the account is: 0 a person, 1 a room, 2 a piece of equipment; anything else is refused. Saved by Save.")] HRESULT Kind([in] long newVal);
};


[
   object,
   uuid(90471F47-FE77-46C7-ADDB-F800B7ED0F66),
   dual,
   nonextensible,
   helpstring("The database object contains information on current database set-up and basic methods to run SQL towards the database."),
   pointer_default(unique)
]
interface IInterfaceDatabase : IDispatch
{
   [propget, id(1), helpstring("Required database version.")] HRESULT RequiredVersion([out, retval] long *pVal);
   [propget, id(2), helpstring("Current databaseversion.")] HRESULT CurrentVersion([out, retval] long *pVal);
   [id(3), helpstring("Executes an SQL statement.")] HRESULT ExecuteSQL(BSTR sSQLStatement);
   [propget, id(4), helpstring("The type of the database.")] HRESULT DatabaseType([out, retval] eDBtype *pVal);
   [id(5), helpstring("Returns the filename for a given message id.")] HRESULT UtilGetFileNameByMessageID([in ] hyper MessageID, [out, retval] BSTR *Output);
   [propget, id(6), helpstring("Database needs to be upgraded.")] HRESULT RequiresUpgrade([out, retval] VARIANT_BOOL *pVal);
   [id(7), helpstring("Create internal database")] HRESULT CreateInternalDatabase();
   [id(8), helpstring("Create external database")] HRESULT CreateExternalDatabase(eDBtype ServerType, BSTR ServerName, long lPort, BSTR DatabaseName, BSTR Username, BSTR Password);
   [propget, id(9), helpstring("Checks whether an existing database exists.")] HRESULT DatabaseExists([out, retval] VARIANT_BOOL *pVal);

   [id(10), helpstring("Starts a new SQL transaction. Only affects ExecuteSQL().")] HRESULT BeginTransaction();
   [id(11), helpstring("Commits a SQL transaction. Only affects ExecuteSQL().")] HRESULT CommitTransaction();
   [id(12), helpstring("Rollbacks a SQL transaction. Only affects ExecuteSQL().")] HRESULT RollbackTransaction();
   [id(13), helpstring("Executes an script file containing SQL statements.")] HRESULT ExecuteSQLScript(BSTR sFilename);
   [id(14), helpstring("Set default database")] HRESULT SetDefaultDatabase(eDBtype ServerType, BSTR ServerName, long lPort, BSTR DatabaseName, BSTR Username, BSTR Password);
   [propget, id(15), helpstring("Returns true if there is a database available.")] HRESULT IsConnected([out, retval] VARIANT_BOOL *pVal);

   [propget, id(16), helpstring("Server name.")] HRESULT ServerName([out, retval] BSTR *pVal);
   [propget, id(17), helpstring("Database name.")] HRESULT DatabaseName([out, retval] BSTR *pVal);
   [id(18), helpstring("Executes an SQL statement and returns the unique ID.")] HRESULT ExecuteSQLWithReturn(BSTR sSQLStatement, [out, retval] long *uniqueID);
   [id(19), helpstring("Ensures that the prerequisites for a specific build is fulfilled.")] HRESULT EnsurePrerequisites(long DBVersion);
};


[
   object,
   uuid(8C054031-7B42-485C-BF79-3D94A7B9605F),
   dual,
