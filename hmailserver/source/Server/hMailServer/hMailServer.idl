      [propput, id(59), helpstring("The text put at the front of the subject. Empty means the shipped tag, EXTERNAL in square brackets. At most 100 characters. Per domain, so a domain whose readers do not read English can say it in the language they do.")] HRESULT ExternalTagText([in] BSTR newVal);
