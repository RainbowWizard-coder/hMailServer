      [propget, id(57), helpstring("Put the tag text at the front of the Subject of mail this domain receives from outside. Breaks any DKIM signature the sender made over their Subject, exactly as the anti-spam subject prefix does; ExternalTagHeader costs the sender's signature nothing.")] HRESULT ExternalTagSubject([out, retval] VARIANT_BOOL *pVal);
      [propput, id(57), helpstring("Put the tag text at the front of the Subject of mail this domain receives from outside. Breaks any DKIM signature the sender made over their Subject, exactly as the anti-spam subject prefix does; ExternalTagHeader costs the sender's signature nothing.")] HRESULT ExternalTagSubject([in] VARIANT_BOOL newVal);
      [propget, id(58), helpstring("Stamp X-hMailServer-External on mail this domain receives from outside, which the webmail shows as a banner. Prepending a field is signature-safe.")] HRESULT ExternalTagHeader([out, retval] VARIANT_BOOL *pVal);
