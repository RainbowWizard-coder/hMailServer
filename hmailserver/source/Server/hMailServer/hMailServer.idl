} eSessionType;

typedef
[uuid(122C5B58-9A23-40f5-83C0-7B683D156522),
   helpstring("Connection security")] 
   enum 
{
   [helpstring("None.")] 
   eCSNone = 0,
   [helpstring("SSL")] 
   eCSTLS = 1,
   [helpstring("STARTTLS (Optional).")] 
   eCSSTARTTLSOptional = 2,
   [helpstring("STARTTLS (Required).")] 
   eCSSTARTTLSRequired = 3,
} eConnectionSecurity;

// How much transport security this server demands of a named remote domain.
//
// Ordered permissive to strict, and compared as a number, so composing this
// with MTA-STS and DANE is a maximum. Zero is the permissive value because
// zero is what an unfilled record produces: a policy nobody has configured
// cannot start refusing a domain's mail.
typedef
[uuid(4DBB5C61-0D74-4A25-9C35-2C3F2F1E7A18),
   helpstring("Remote domain TLS requirement")]
   enum
{
   [helpstring("Whatever the server would do anyway, including any MTA-STS or DANE policy the domain publishes.")]
   eRTNone = 0,
   [helpstring("The session must be encrypted; the certificate is not judged.")]
   eRTEncrypted = 1,
   [helpstring("Encrypted, and the certificate must verify and name the host.")]
   eRTVerified = 2,
   [helpstring("Encrypted, and the certificate must match a DNSSEC-validated TLSA record.")]
   eRTDane = 3,
} eRemoteTlsRequirement;

// Gateway encryption to a partner domain: the message itself encrypted at this
// server to the partner's key (Common/Util/GatewayEncryption.h). The numbers
// are the ones hm_remotedomainpolicies.policyencrypt holds; zero rewrites no
// message, and is what every upgraded policy holds.
typedef
[uuid(9CB04D7C-7B8A-4D36-BA3F-42ACBCAA9E11),
   helpstring("Remote domain gateway encryption")]
   enum
{
   [helpstring("No gateway encryption: the message is sent as it was written.")]
   eREEncryptNone = 0,
   [helpstring("PGP/MIME to the partner's OpenPGP public key.")]
   eREEncryptOpenPgp = 1,
   [helpstring("S/MIME enveloped-data to the partner's certificate.")]
   eREEncryptSmime = 2,
} eRemoteEncryption;

typedef
[uuid(90745436-4C3F-11D9-AD17-A0BCEA20CD08),
   helpstring("Signature method")] 
   enum 
{
   [helpstring("Unknown method.")] 
   eSMUnknown = 0,
   [helpstring("Use domain signature if no signature specified in account.")] 
   eSMSetIfNotSpecifiedInAccount = 1,
   [helpstring("Overwrite account signature with domain signature.")] 
   eSMOverwriteAccountSignature = 2,
   [helpstring("Append account signature with domain signature.")] 
   eSMAppendToAccountSignature = 3,   
} eDomainSignatureMethod;

