   [id(62), helpstring("Stops notifying every device of this account and returns how many were removed. What to do about a lost phone; the person turns notifications on again on the devices they still have.")] HRESULT RemovePushSubscriptions([out, retval] long *RemovedCount);

   [propget, id(26), helpstring("Forwarding for this account is enabled.")] HRESULT ForwardEnabled([out, retval] VARIANT_BOOL *pVal);
   [propput, id(26), helpstring("Forwarding for this account is enabled.")] HRESULT ForwardEnabled([in] VARIANT_BOOL newVal);
