   [propget, id(130), helpstring("Days after which an entry made by a bounce or a report stops applying and is removed. 0 keeps entries until removed by hand; at most 3650.")] HRESULT BounceSuppressionExpiryDays([out, retval] long *pVal);
   [propput, id(130), helpstring("Days after which an entry made by a bounce or a report stops applying and is removed. 0 keeps entries until removed by hand; at most 3650.")] HRESULT BounceSuppressionExpiryDays([in] long newVal);
