      /*
         DKIM KEYS THAT ROTATE. The policy is saved with the domain; the operations act at once. See hmailserver/docs/DkimKeyRotation.md.
      */
      [propget, id(67), helpstring("Whether the server rotates this domain's DKIM key on a schedule: a new key and selector generated, its TXT record checked from the server's resolver, signing moved to it once the record has resolved for the propagation period, and the old selector retired after the retention period. Off by default. Saved by Save.")] HRESULT DKIMRotationEnabled([out, retval] VARIANT_BOOL *pVal);
      [propput, id(67), helpstring("Whether the server rotates this domain's DKIM key on a schedule: a new key and selector generated, its TXT record checked from the server's resolver, signing moved to it once the record has resolved for the propagation period, and the old selector retired after the retention period. Off by default. Saved by Save.")] HRESULT DKIMRotationEnabled([in] VARIANT_BOOL newVal);
      [propget, id(68), helpstring("Days between rotations, 1 to 3650. Default 180.")] HRESULT DKIMRotationIntervalDays([out, retval] long *pVal);
      [propput, id(68), helpstring("Days between rotations, 1 to 3650. Default 180.")] HRESULT DKIMRotationIntervalDays([in] long newVal);
      [propget, id(69), helpstring("Hours the next key's record must have resolved with the right key before signing moves to it, 1 to 720. Default 72.")] HRESULT DKIMRotationPropagationHours([out, retval] long *pVal);
      [propput, id(69), helpstring("Hours the next key's record must have resolved with the right key before signing moves to it, 1 to 720. Default 72.")] HRESULT DKIMRotationPropagationHours([in] long newVal);
      [propget, id(70), helpstring("Days the old selector is kept published after a switch, for verifiers and reports that arrive late, 1 to 365. Default 7.")] HRESULT DKIMRotationRetentionDays([out, retval] long *pVal);
      [propput, id(70), helpstring("Days the old selector is kept published after a switch, for verifiers and reports that arrive late, 1 to 365. Default 7.")] HRESULT DKIMRotationRetentionDays([in] long newVal);
