   // Renaming a mailbox, and moving one to another domain on this server, as
   // one operation. Appended below the note above, as everything added later
   // must be.
   [id(54), helpstring("Renames this account, or moves it to another domain on this server - NewAddress carries the domain, so the two are one call. Everything keyed on the account follows it: its rules, folders, subscriptions, folder permissions, application passwords, second factor, contacts, calendars, preferences, known senders, password history, sender lists, group memberships and role. The message store and the Sieve tree are moved, and the aliases pointing at the account, its distribution list memberships, the recipients of mail still in the queue and its quarantined messages are rewritten. With KeepOldAddressAsAlias the old address is left behind as an alias to the new one, which is what keeps mail to it flowing. Refuses, changing nothing, an address that already exists as an account, alias or list, a domain this server does not hold or that is not active, and a mailbox in use (see InUseReason). Returns a JSON summary: old_address, new_address, old_domain, new_domain, account_id, alias_kept, store_moved, messages, folders, aliases_repointed, list_memberships, queued_recipients, quarantine_entries, journal_id. Requires manage-accounts authority in both domains. There is no Save() for this - it is done when it returns.")] HRESULT MoveTo([in] BSTR NewAddress, [in] VARIANT_BOOL KeepOldAddressAsAlias, [out, retval] BSTR *Summary);
   [propget, id(55), helpstring("Why this mailbox cannot be moved at this moment, in a sentence, or an empty string when nothing holds it. A POP3 session holds the mailbox from authentication until its socket closes; an IMAP session holds it while it has one of the account's folders selected. Reads and changes nothing.")] HRESULT InUseReason([out, retval] BSTR *pVal);
   [propget, id(56), helpstring("The most recent move of this mailbox as JSON - id, account_id, old_address, new_address, stage, stage_name, complete, keep_alias, messages, started, finished, detail - or an empty string when it has never been moved. A record whose complete is false is a move that was interrupted; hmailserver/docs/MailboxMove.md says what each stage leaves behind.")] HRESULT LastMove([out, retval] BSTR *pVal);
   [propget, id(8), helpstring("The size of the account.")] HRESULT Size([out, retval] float *pVal);
   [id(9), helpstring("Saves the account in the database.")] HRESULT Save();
   [propget, id(10), helpstring("Name of the active directory user account.")] HRESULT ADUsername([out, retval] BSTR *pVal);
   [propput, id(10), helpstring("Name of the active directory user account.")] HRESULT ADUsername([in] BSTR newVal);
   [id(11), helpstring("Deletes all IMAP folders and messages that exists in the account.")] HRESULT DeleteMessages();
   [propget, id(13), helpstring("Messages in the accounts mailbox.")] HRESULT Messages([out, retval] IInterfaceMessages** pVal);
   [propget, id(15), helpstring("Maximum size in of the account (MB).")] HRESULT MaxSize([out, retval] long *pVal);
   [propput, id(15), helpstring("Maximum size in of the account (MB).")] HRESULT MaxSize([in] long pVal);
   [propget, id(50), helpstring("Days delivered messages are kept before the retention sweep removes them: 0 = the domain's policy, -1 = keep forever, else the number of days.")] HRESULT MessageRetentionDays([out, retval] long *pVal);
   [propput, id(50), helpstring("Days delivered messages are kept before the retention sweep removes them: 0 = the domain's policy, -1 = keep forever, else the number of days.")] HRESULT MessageRetentionDays([in] long pVal);
