   [propget, id(7), helpstring("Backup log file")] HRESULT LogFile([out, retval] BSTR *pVal);

   [propput, id(8), helpstring("The passphrase the backup archive is encrypted with: 7-Zip AES-256, with the file names encrypted too, so that an archive without it cannot even be listed. Write-only - it is never read back here or anywhere else, and a restore asks whoever runs it for the passphrase they hold. An empty string clears it and the next backup is written unencrypted. At least 12 and at most 256 printable ASCII characters, not beginning or ending with a space. Kept in the database protected by the machine's secret store, and never written into the archive it protects: if it is lost, nothing in any archive it was used on can be recovered, by anybody.")] HRESULT EncryptionPassphrase([in] BSTR newVal);

   [propget, id(9), helpstring("Whether a backup passphrase is set, and so whether the next backup will be encrypted. The passphrase itself is never returned.")] HRESULT EncryptionPassphraseSet([out, retval] VARIANT_BOOL *pVal);

};
