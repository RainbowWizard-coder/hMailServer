]
interface IInterfaceQuarantine : IDispatch{
   [propget, id(1), helpstring("The number of messages currently held.")] HRESULT Count([out, retval] LONG* pVal);
   [propget, id(2), helpstring("ItemByDBID")] HRESULT ItemByDBID([in] long DBID, [out, retval] IInterfaceQuarantinedMessage** pVal);
   [propget, id(0), defaultbind, helpstring("Item")] HRESULT Item([in] long Index, [out, retval] IInterfaceQuarantinedMessage** pVal);
   [id(5), helpstring("Reloads the list, newest first.")] HRESULT Refresh(void);
   [id(6), helpstring("Releases the message with this identifier.")] HRESULT ReleaseByDBID(long DBID);
   [id(7), helpstring("Deletes the message with this identifier.")] HRESULT DeleteByDBID(long DBID);
   [id(8), helpstring("Deletes everything older than QuarantineRetentionDays and returns how many were removed. The scheduled sweep calls this; it is exposed so an administrator can run it now.")] HRESULT DeleteExpired([out, retval] LONG* pVal);
   [id(9), helpstring("One review action over many held messages, as JSON in and JSON out: the body and the answer of POST /api/v1/quarantine/bulk (AntiSpam/QuarantineReview.h). The request names ids (1 to 1000), action (release, delete, allow or block), and for allow and block list (address: the sender on the server's allow and block list; domain: the organization's domain, of the sender or with domain_from helo of the HELO name, on the domain white and black list), dry_run and confirm_public_suffix. Allow writes the entry and then releases; block writes it and then deletes; one entry is written per distinct sender or domain. The answer lists the entries and, per id, whether it was acted on and why not. Refused, with nothing done, for a request that is not one, and for an entry naming a public suffix without confirm_public_suffix.")] HRESULT Bulk([in] BSTR Request, [out, retval] BSTR* Result);
};
