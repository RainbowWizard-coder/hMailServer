   // The [Settings] section of hMailServer.INI, over COM.
   //
   // These settings decide whether the optional listeners run at all, and until now
   // they could only be administered by opening a file on the server - so a Control
   // Panel connected from another machine could not touch them, and they were absent
   // from configuration-as-code. Reading and writing them here is the whole of what
   // makes them remotely administrable.
   //
   // Server administrator only, like the rest of this interface: the section holds
   // OAuth2HmacSecret, SRSSecret, BATVSecret and PasswordPepper. That is the same
   // treatment Account.Password, FetchAccount.Password and
   // SSLCertificate.PrivateKeyPassword already get.
   //
   // A write PUBLISHES (22 September 2026, docs/SettingsApply.md): the value is stored
   // and the server's settings are rebuilt from the store, so a key marked now in
   // build/ini-settings-baseline.txt - most of them - is in effect when the call
   // returns. A key marked reinitialize waits for Application.Reinitialize, one marked
   // restart for the service to start again, and until then it is PENDING:
   // IniSettingApplies says which a key is, PendingIniSettings which keys wait.
   [id(108), helpstring("Reads a value from the [Settings] section of hMailServer.INI. Empty when the setting is not present.")]
      HRESULT GetIniSetting([in] BSTR Name, [out, retval] BSTR *pVal);
   [id(109), helpstring("Stores a value for a [Settings] key in the database and writes the file's copy. Applies at once for a key IniSettingApplies calls now; a key it calls reinitialize or restart is pending, listed by PendingIniSettings, until a reinitialise or a restart takes it.")]
      HRESULT SetIniSetting([in] BSTR Name, [in] BSTR Value);
   [id(110), helpstring("Removes a key from the [Settings] section, returning the setting to its default. Not the same as writing an empty value.")]
      HRESULT DeleteIniSetting([in] BSTR Name);
   [propget, id(111), helpstring("Every name currently in the [Settings] section, one per line.")]
      HRESULT IniSettingNames([out, retval] BSTR *pVal);

   // Reads the directory the way an account source would, and reports what it found.
   //
   // Runs ON THE SERVER, which is the point of it. The Control Panel's existing LDAP
   // test card runs from the machine the Control Panel is on and says so - a firewall
   // that treats that machine and the hMailServer service differently makes the two
   // disagree, and it is the service's view that decides whether mail works.
   //
   // Read-only. It creates nothing, changes nothing and is safe to run against a live
   // directory; it exists so an administrator can see which people the configured
   // search base and filter actually select before anything is provisioned from them.
   [id(112), helpstring("Reads the LDAP directory using the [LDAP] settings and reports the users an account source would see. Read-only.")]
      HRESULT TestLdapDirectory([in] long MaxUsers, [out] BSTR *ResultText, [out, retval] VARIANT_BOOL *pResult);

   // The directory as an account source.
   //
   // Preview changes nothing and reports what Apply would do; they share one decider,
   // so a preview cannot describe an action the apply would not take. Run the preview
   // first - always - because the shape of a directory is rarely what anyone expects
   // and the skip reasons are where the surprises are.
   //
   // DomainName restricts the run to one hMailServer domain; empty means every domain
   // that has an Active Directory domain name set. Only such domains take part at all:
   // that field is what links a mail domain to a directory, and requiring it keeps a
   // search base pointed one level too high from provisioning into unrelated hosted
   // domains.
   //
   // NEITHER OF THESE TWO METHODS DELETES AN ACCOUNT OR ANY MAIL. The most either does
   // is clear Active, which leaves every message in place and is undone by setting it
   // back. That is a statement about these two calls, not a protection: Accounts.Delete
   // and everything else on this interface work on a directory-provisioned account
   // exactly as they do on any other.
   //
   // DisableMissing marks accounts whose directory entry has gone as inactive, and
   // nothing is disabled at all when the enumeration was truncated or returned nothing,
   // because in both of those an account that still exists is indistinguishable from
   // one that was deleted.
   // DisableMissing is on the PREVIEW too, and must be passed the same value the apply
   // will be given. Without it a preview could never show a disable - it would report
   // every missing account as "left alone because disabling was not requested" and the
   // apply would then disable them, which is exactly the preview/apply disagreement the
   // shared decider exists to make impossible.
   [id(113), helpstring("Reports which accounts the LDAP directory says should exist, changing nothing. Pass the same DisableMissing the apply will use, or the preview will not show what it is going to do.")]
      HRESULT PreviewDirectorySync([in] BSTR DomainName, [in] VARIANT_BOOL DisableMissing, [out] BSTR *ResultText, [out, retval] VARIANT_BOOL *pResult);
   [id(114), helpstring("Creates and updates accounts to match the LDAP directory. This call never deletes an account or its mail; the most it does is mark one inactive.")]
      HRESULT ApplyDirectorySync([in] BSTR DomainName, [in] VARIANT_BOOL DisableMissing, [out] BSTR *ResultText, [out, retval] VARIANT_BOOL *pResult);

   // Off by default. An account created while this is off gets an inbox only, as it
   // always has; a client then creates Drafts, Sent, Trash and Junk itself under
   // whatever names it prefers. With it on, the four are created at account creation
   // and designated for RFC 6154 (\Drafts \Sent \Trash \Junk), which is what
   // Thunderbird and Apple Mail look for on first connect. The designated folders
   // survive Account.DeleteMessages - they are emptied, like the inbox - and go with
   // the account when it is deleted.
   [propget, id(115), helpstring("Create Drafts, Sent, Trash and Junk, designated for RFC 6154 SPECIAL-USE, when an account is created. Off by default.")] HRESULT CreateDefaultSpecialUseFoldersEnabled([out, retval] VARIANT_BOOL *pVal);
   [propput, id(115), helpstring("Create Drafts, Sent, Trash and Junk, designated for RFC 6154 SPECIAL-USE, when an account is created. Off by default.")] HRESULT CreateDefaultSpecialUseFoldersEnabled([in] VARIANT_BOOL newVal);
   [id(116), helpstring("Enrols a second factor on the administrator credential and returns the otpauth:// URI to show as a QR code. The secret is inside that URI and is not retrievable afterwards; it is enforced at once, on the COM API and the REST API alike. Server administrators only, and the administrator password must be set.")] HRESULT EnrolAdministratorTOTP([out, retval] BSTR *pVal);
   [id(117), helpstring("Removes the administrator credential's second factor; the password alone authenticates again at once. Server administrators only.")] HRESULT DisableAdministratorTOTP();

   // What this server will do for a named remote domain: the TLS it demands of
   // it outbound and inbound, the message size and the concurrency it will
   // attempt, and whether a recipient is verified with the domain's own server
   // before mail for it is accepted. See RemoteDomainPolicy.h.
   //
   // The dispatch id deliberately leaves a gap above DisableAdministratorTOTP.
   // Several branches were adding members to this interface in the same week and
   // a gap costs nothing - a dispatch id is a name, not a position - whereas two
   // branches that both took 118 would produce a type library in which one of
   // them silently answers the other's calls.
   [propget, id(125), helpstring("Remote domain policies: per-domain TLS requirements, limits and recipient verification.")] HRESULT RemoteDomainPolicies([out, retval] IInterfaceRemoteDomainPolicies* *pVal);

   // The check of a new password against the published breach corpus. Off by
   // default, because it sends the first five hexadecimal characters of the
   // password's SHA-1 to the endpoint - and nothing else: the answer is every
   // suffix sharing that prefix, compared on this machine. Applied wherever a
   // password is chosen (Account.Password, AppPassword.SetPassword,
   // SetAdministratorPassword and the REST routes that do the same), never at
   // logon. Stored in hm_settings.
   [propget, id(120), helpstring("Refuse a new password that appears in the published breach corpus. Off by default: it sends five characters of the password's SHA-1 to BreachCheckUrl.")] HRESULT BreachCheckEnabled([out, retval] VARIANT_BOOL *pVal);
   [propput, id(120), helpstring("Refuse a new password that appears in the published breach corpus. Off by default: it sends five characters of the password's SHA-1 to BreachCheckUrl.")] HRESULT BreachCheckEnabled([in] VARIANT_BOOL newVal);
   [propget, id(121), helpstring("The range endpoint the breach check asks: https, or plain http to this machine only. The prefix is appended, or put where {prefix} is. Defaults to https://api.pwnedpasswords.com/range/.")] HRESULT BreachCheckUrl([out, retval] BSTR *pVal);
   [propput, id(121), helpstring("The range endpoint the breach check asks: https, or plain http to this machine only. The prefix is appended, or put where {prefix} is. Defaults to https://api.pwnedpasswords.com/range/.")] HRESULT BreachCheckUrl([in] BSTR newVal);
