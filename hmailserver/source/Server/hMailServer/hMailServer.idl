[
   object,
   uuid(0EFF2E44-4758-4751-97BA-0BC5C1AFD989),
   dual,
   nonextensible,
   helpstring("The GreyListingBypassEntry object is one entry of the greylisting bypass list: a pattern, what it is matched against, and the authentication results a message must carry before greylisting is skipped for it."),
   pointer_default(unique)
]
interface IInterfaceGreyListingBypassEntry : IDispatch
{
   [propget, id(1), helpstring("The unique database identifier for the object.")] HRESULT ID([out, retval] long *pVal);
   [propget, id(2), helpstring("A domain, such as example.com, matched exactly; or a suffix with a leading dot, such as .mail.example.com, which covers that name and every name under it. Stored lower-cased.")] HRESULT Pattern([out, retval] BSTR *pVal);
   [propput, id(2), helpstring("A domain, such as example.com, matched exactly; or a suffix with a leading dot, such as .mail.example.com, which covers that name and every name under it. Stored lower-cased.")] HRESULT Pattern([in] BSTR newVal);
   [propget, id(3), helpstring("What the pattern is compared with: 1 the domain of the envelope sender (MAIL FROM), 2 the HELO/EHLO host, 3 either.")] HRESULT MatchOn([out, retval] long *pVal);
   [propput, id(3), helpstring("What the pattern is compared with: 1 the domain of the envelope sender (MAIL FROM), 2 the HELO/EHLO host, 3 either.")] HRESULT MatchOn([in] long newVal);
   [propget, id(4), helpstring("Whether the message must pass SPF for this entry to skip greylisting, for an identity this entry covers: the envelope sender's domain, or - for an entry matched on the HELO - the HELO name itself, checked as RFC 7208 section 2.3 asks. SPF is known at RCPT TO, so an entry requiring SPF alone decides there.")] HRESULT RequireSPF([out, retval] VARIANT_BOOL *pVal);
   [propput, id(4), helpstring("Whether the message must pass SPF for this entry to skip greylisting, for an identity this entry covers: the envelope sender's domain, or - for an entry matched on the HELO - the HELO name itself, checked as RFC 7208 section 2.3 asks. SPF is known at RCPT TO, so an entry requiring SPF alone decides there.")] HRESULT RequireSPF([in] VARIANT_BOOL newVal);
   [propget, id(5), helpstring("Whether the message must carry a DKIM signature that verifies FOR A DOMAIN THIS ENTRY COVERS - anybody may sign a message with a key they publish themselves, so whose signature it is decides. Known only after DATA, so the message is received first and greylisted after if it does not; needs DKIM verification switched on, or the entry can never be satisfied.")] HRESULT RequireDKIM([out, retval] VARIANT_BOOL *pVal);
   [propput, id(5), helpstring("Whether the message must carry a DKIM signature that verifies FOR A DOMAIN THIS ENTRY COVERS - anybody may sign a message with a key they publish themselves, so whose signature it is decides. Known only after DATA, so the message is received first and greylisted after if it does not; needs DKIM verification switched on, or the entry can never be satisfied.")] HRESULT RequireDKIM([in] VARIANT_BOOL newVal);
   [propget, id(6), helpstring("Whether the message must pass DMARC for a From domain this entry covers - DMARC judges the RFC5322.From, which the envelope need not agree with. Known only after DATA, as DKIM is; needs DMARC switched on, or the entry can never be satisfied.")] HRESULT RequireDMARC([out, retval] VARIANT_BOOL *pVal);
   [propput, id(6), helpstring("Whether the message must pass DMARC for a From domain this entry covers - DMARC judges the RFC5322.From, which the envelope need not agree with. Known only after DATA, as DKIM is; needs DMARC switched on, or the entry can never be satisfied.")] HRESULT RequireDMARC([in] VARIANT_BOOL newVal);
   [propget, id(7), helpstring("A note: why the entry is there.")] HRESULT Note([out, retval] BSTR *pVal);
   [propput, id(7), helpstring("A note: why the entry is there.")] HRESULT Note([in] BSTR newVal);
   [id(8), helpstring("Saves changes of the object in the database. Refused, with the reason, for an empty pattern, a pattern that is not a domain name or a dotted suffix, a MatchOn outside 1 to 3, a Note longer than 255 characters, and an entry that requires none of the three results.")] HRESULT Save();
   [id(9), helpstring("Deletes the object from the database.")] HRESULT Delete();
};
