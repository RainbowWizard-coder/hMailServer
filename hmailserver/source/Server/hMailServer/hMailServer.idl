   [propput, id(21), helpstring("The partner's key: an armoured OpenPGP public key, or PEM certificates of which the first is encrypted to. Judged when the policy is saved: private-key material is refused whatever the method, and a changed key must be one a message can be encrypted to. White space alone removes the key.")] HRESULT EncryptKey([in] BSTR newVal);

   [propget, id(22), helpstring("What happens to a message that cannot be encrypted: 0 it is refused and the sender told (5.7.10), 1 it is sent unencrypted and logged.")] HRESULT EncryptFallback([out, retval] long *pVal);
