def level_set_command(client, arguments):
    """hmctl domain set <domain> <name> <value|inherit>, and the same for an account.

    One value, three levels (docs/SettingLevels.md): the domain's or the account's
    own value of a setting that may be set below the server - the names GET
    /api/v1/settings/levels lists - or, with the word inherit, none of its own,
    so that it takes the level above. The value is read as --set reads one:
    true, false and numbers as such, anything else as a string. Where the level
    is a field the domain or the account already had, inherit is sent as that
    field's own "take the level above" (0 or -1), true and false as a domain
    session switch's 1 and 2, and inherit is refused for a field that has none.
    The domain's route requires active in every body, so it is read first and
    sent back as it is. What is in effect afterwards, and where it came from, is
    what is printed.
    """
    name = arguments.setting
    raw = arguments.value
    inherit = raw.strip().lower() == "inherit"

    # Where the level is held. A server from before the levels list answers
    # nothing here, and every name is taken as the overlay's, as it always was.
    storage = "overlay"
    try:
        levels = client.request("GET", "/api/v1/settings/levels") or {}
        for entry in levels.get("settings", []) if isinstance(levels, dict) else []:
            if entry.get("name") == name:
                storage = entry.get("domain_storage" if arguments.resource == "domain" else "account_storage", "overlay")
                break
    except ApiError as error:
        if error.status not in (403, 404):
            raise

    if storage == "column":
        if inherit:
            if name not in COLUMN_INHERIT:
                raise ApiError(400, "%s is the %s's own field and always holds a value of its own; there is no level above "
                               "for it to take. Set it to the value you want." % (name, arguments.resource))
            value = COLUMN_INHERIT[name]
        else:
            value = parse_set([name + "=" + raw])[name]
            if arguments.resource == "domain" and name in SWITCH_COLUMNS and isinstance(value, bool):
                value = 1 if value else 2
    else:
        value = None if inherit else parse_set([name + "=" + raw])[name]

    if arguments.resource == "domain":
        path = "/api/v1/domains/%s" % urllib.parse.quote(arguments.id, safe="")
        current = client.request("GET", path) or {}
        answer = client.request("PUT", path, body={"active": bool(current.get("active", True)), name: value}) or {}
    else:
        path = "/api/v1/accounts/%s" % urllib.parse.quote(arguments.id, safe="@")
        answer = client.request("PUT", path, body={name: value}) or {}
    if arguments.json:
        render(answer, True)
        return EXIT_OK
    effective = answer.get(name + "_effective")
    source = answer.get(name + "_source", "")
    print("%s is %s for %s, from the %s." % (name, json.dumps(effective), arguments.id, source or "server"))
    return EXIT_OK


