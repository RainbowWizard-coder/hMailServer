def rule_match_command(client, arguments):
    body = {"match_value": arguments.value, "match_type": arguments.type, "test_value": arguments.against}
    answer = client.request("POST", "/api/v1/rules/match", body=body)
    if arguments.json:
        render(answer, True)
    else:
        matched = answer.get("match") if isinstance(answer, dict) else answer
        print("match" if matched else "no match")
    return EXIT_OK if (not isinstance(answer, dict) or answer.get("match")) else EXIT_OK


def apppassword_command(client, arguments):
    base = "/api/v1/accounts/%s/app-passwords" % urllib.parse.quote(arguments.address, safe="@")
    if arguments.verb == "list":
        render(collection(client.request("GET", base), "app_passwords"), arguments.json,
               ["id", "name", "created", "last_used"])
    elif arguments.verb == "create":
        answer = client.request("POST", base, body={"name": arguments.name})
        render(answer, arguments.json)
        if not arguments.json and isinstance(answer, dict) and answer.get("password"):
            print("")
            print("This is the only time the server will show it.")
    elif arguments.verb == "delete":
        client.request("DELETE", "%s/%s" % (base, arguments.id))
        print("revoked.")
    return EXIT_OK


def member_command(client, arguments):
    base = "/api/v1/groups/%s/members" % arguments.group
    if arguments.verb == "list":
        render(collection(client.request("GET", base), "members"), arguments.json, ["id", "account_id", "address"])
    elif arguments.verb == "add":
        key = "address" if "@" in arguments.account else "account_id"
        value = arguments.account if key == "address" else int(arguments.account)
        render(client.request("POST", base, body={key: value}), arguments.json)
    elif arguments.verb == "remove":
        client.request("DELETE", "%s/%s" % (base, arguments.account))
        print("removed from the group.")
    return EXIT_OK


