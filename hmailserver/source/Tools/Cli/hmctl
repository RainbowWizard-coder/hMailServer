class ApiError(Exception):
    def __init__(self, status, message, body=None):
        Exception.__init__(self, message)
        self.status = status
        self.message = message
        self.body = body


class Client:
    """Everything that talks to the server. Nothing else in this file does."""

    def __init__(self, url, api_key=None, password=None, insecure=False, timeout=30):
        self.url = url.rstrip("/")
        self.api_key = api_key
        self.password = password
        self.timeout = timeout

        parsed = urllib.parse.urlparse(self.url)
        self.host = parsed.hostname or ""
        self.scheme = parsed.scheme

        if insecure:
            # A credential travelling to a host whose certificate nobody checked
            # is the mistake this tool must not make convenient. On loopback the
            # certificate is beside the point - nothing is on the wire - and a
            # self-signed one there is the ordinary case.
            if self.host not in ("localhost", "127.0.0.1", "::1", "[::1]"):
                raise ApiError(0, "--insecure is refused for %s: it is only allowed for the loopback address, "
                                  "because it would send the administrator password to a host nobody verified. "
                                  "Give the server a certificate the client trusts." % self.host)
            self.context = ssl._create_unverified_context()
        elif self.scheme == "https":
            self.context = ssl.create_default_context()
        else:
            self.context = None

    def authorization(self):
        if self.api_key:
            return "Bearer " + self.api_key
        if self.password is not None:
            raw = ("Administrator:" + self.password).encode("utf-8")
            return "Basic " + base64.b64encode(raw).decode("ascii")
        return None

    def request(self, method, path, body=None, query=None):
        url = self.url + path
        if query:
            pairs = [(k, v) for k, v in query.items() if v is not None]
            if pairs:
                url += "?" + urllib.parse.urlencode(pairs)

        data = None
        headers = {"Accept": "application/json", "User-Agent": "hmctl/" + VERSION}
        if body is not None:
            data = json.dumps(body).encode("utf-8")
            headers["Content-Type"] = "application/json"

        authorization = self.authorization()
        if authorization:
            headers["Authorization"] = authorization

        request = urllib.request.Request(url, data=data, headers=headers, method=method)

        try:
            if self.context is not None:
                response = urllib.request.urlopen(request, timeout=self.timeout, context=self.context)
            else:
                response = urllib.request.urlopen(request, timeout=self.timeout)
        except urllib.error.HTTPError as error:
            raw = error.read()
            message = None
            parsed = None
            try:
                parsed = json.loads(raw.decode("utf-8"))
                if isinstance(parsed, dict):
                    message = parsed.get("error") or parsed.get("message")
            except Exception:
                message = raw.decode("utf-8", "replace").strip() or None
            raise ApiError(error.code, message or ("HTTP %d" % error.code), parsed)
        except urllib.error.URLError as error:
            reason = getattr(error, "reason", error)
            if isinstance(reason, ssl.SSLError):
                raise ApiError(0, "TLS refused the server's certificate: %s. On loopback, --insecure accepts a "
                                  "self-signed one." % reason)
            raise ApiError(0, "cannot reach %s: %s" % (self.url, reason))

        with response:
            raw = response.read()
            if not raw:
                return None
            try:
                return json.loads(raw.decode("utf-8"))
            except ValueError:
                return raw.decode("utf-8", "replace")


