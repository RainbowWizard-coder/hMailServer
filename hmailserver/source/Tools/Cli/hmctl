def build_parser():
    parser = argparse.ArgumentParser(
        prog="hmctl",
        description="Administer an hMailServer over its REST API.",
        epilog="Environment: HMAIL_URL, HMAIL_API_KEY, HMAIL_PASSWORD, HMAIL_PASSWORD_FILE.",
    )
    parser.add_argument("--url", default=os.environ.get("HMAIL_URL", DEFAULT_URL),
                        help="the server's REST address (default %s)" % DEFAULT_URL)
    parser.add_argument("--api-key", default=os.environ.get("HMAIL_API_KEY"))
    parser.add_argument("--password", default=os.environ.get("HMAIL_PASSWORD"))
    parser.add_argument("--password-file", default=os.environ.get("HMAIL_PASSWORD_FILE"))
    parser.add_argument("--insecure", action="store_true",
                        help="accept a self-signed certificate; loopback only")
    parser.add_argument("--json", action="store_true", help="the server's JSON, unformatted by this tool")
    parser.add_argument("--timeout", type=int, default=30)
    parser.add_argument("--version", action="version", version="hmctl " + VERSION)

    # The same flags again, for every parser below, because `hmctl domain list
    # --json` is where a person types it and argparse takes the main parser's
    # options only before the subcommand. SUPPRESS is what makes that safe: an
    # inherited flag that was not given leaves no attribute, so it cannot
    # overwrite the value the main parser already read from the command line or
    # from the environment with its own default.
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--url", default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    common.add_argument("--api-key", default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    common.add_argument("--password", default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    common.add_argument("--password-file", default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    common.add_argument("--insecure", action="store_true", default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    common.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                        help="the server's JSON, unformatted by this tool")
    common.add_argument("--timeout", type=int, default=argparse.SUPPRESS, help=argparse.SUPPRESS)

    commands = parser.add_subparsers(dest="command")

    status = commands.add_parser("status", parents=[common], help="what the server says about itself")
    status.set_defaults(handler=status_command)

    resource_verbs = {}
    for name in sorted(RESOURCES):
        resource = RESOURCES[name]
        sub = commands.add_parser(name, help=resource["help"])
        sub.set_defaults(handler=resource_command, resource=name)
        verbs = sub.add_subparsers(dest="verb")
        resource_verbs[name] = verbs
        for verb in resource["verbs"]:
            verb_parser = verbs.add_parser(verb, parents=[common])
            if verb in ("get", "update", "delete"):
                verb_parser.add_argument("id", help="the %s" % resource["id"])
            if verb in ("create", "update"):
                verb_parser.add_argument("--set", action="append", metavar="NAME=VALUE",
                                         help="a field; true, false, null, numbers and JSON are read as such")
                verb_parser.add_argument("--set-string", action="append", metavar="NAME=VALUE",
                                         help="a field whose value stays a string")
                verb_parser.add_argument("--from-json", metavar="FILE", help="a JSON object, or - for stdin")
            if resource.get("parent"):
                verb_parser.add_argument("--" + resource["parent"],
                                         help="the %s these belong to" % resource["parent"])
            if verb == "list" and resource.get("search"):
                verb_parser.add_argument("--search", help="only the addresses containing this")

    # One value, three levels: a domain's or an account's own value of a setting
    # that may be set below the server, or inherit to take the level above.
    for name, what in (("domain", "the domain's name"), ("account", "the account's address")):
        level = resource_verbs[name].add_parser(
            "set", parents=[common],
            help="its own value of a setting that may be set below the server, or inherit (GET /api/v1/settings/levels lists them)")
        level.add_argument("id", help=what)
        level.add_argument("setting", help="the setting's name, as REST spells it: recall_days, max_message_size_kb, ...")
        level.add_argument("value", help="the value (true, false and numbers are read as such), or inherit")
        level.set_defaults(handler=level_set_command)

    queue = commands.add_parser("queue", help="the delivery queue")
    queue.set_defaults(handler=queue_command)
    queue_verbs = queue.add_subparsers(dest="verb")
    queue_verbs.add_parser("list", parents=[common])
    for verb in ("retry", "delete"):
        p = queue_verbs.add_parser(verb, parents=[common])
        p.add_argument("id")

    quarantine = commands.add_parser("quarantine", help="held mail")
    quarantine.set_defaults(handler=quarantine_command)
    quarantine_verbs = quarantine.add_subparsers(dest="verb")
    quarantine_verbs.add_parser("list", parents=[common])
    for verb in ("release", "delete"):
        p = quarantine_verbs.add_parser(verb, parents=[common])
        p.add_argument("id")

    reputation = commands.add_parser("reputation",
                                     help="this server's own addresses against the DNS block lists")
    reputation.set_defaults(handler=reputation_command)
    reputation_verbs = reputation.add_subparsers(dest="verb")
    reputation_verbs.add_parser("status", parents=[common],
                                help="what the last check found; exits 1 when an address is listed, when a list could not be asked, and - while the watch is on - when a pair has not been checked yet")
    reputation_verbs.add_parser("check", parents=[common],
                                help="check now rather than waiting for the daily check; server administrators")

    privacy = commands.add_parser("privacy", help="a person's data: everything the server holds as one archive, and every trace erased")
    privacy.set_defaults(handler=privacy_command)
    privacy_verbs = privacy.add_subparsers(dest="verb")
    export_parser = privacy_verbs.add_parser("export", parents=[common],
                                             help="write everything the server holds on the account to one .zip on the server's disk")
    export_parser.add_argument("address")
    export_parser.add_argument("--archive", required=True, metavar="FILE", help="the path of the .zip to write, on the server")
    erase_parser = privacy_verbs.add_parser("erase", parents=[common],
                                            help="erase every stored trace of an address that deleting its account leaves")
    erase_parser.add_argument("address")
    erase_parser.add_argument("--archive", action="store_true", help="the address's archive tree too, copies under hold excepted")
    erase_parser.add_argument("--logs", action="store_true", help="rewrite the log files so no line names the address")

    settings = commands.add_parser("settings", help="the server settings, by group")
    settings.set_defaults(handler=settings_command)
    settings_verbs = settings.add_subparsers(dest="verb")
    get = settings_verbs.add_parser("get", parents=[common])
    get.add_argument("group", nargs="?", choices=SETTING_GROUPS, default="settings")
    get.add_argument("name", nargs="?", help="one setting rather than the group")
    set_parser = settings_verbs.add_parser("set", parents=[common])
    set_parser.add_argument("group", nargs="?", choices=SETTING_GROUPS, default="settings")
    set_parser.add_argument("--set", action="append", metavar="NAME=VALUE", required=False)
    set_parser.add_argument("--set-string", action="append", metavar="NAME=VALUE")
    set_parser.add_argument("--from-json", metavar="FILE")
    set_parser.set_defaults(name=None)
    breach_test = settings_verbs.add_parser("breach-test", parents=[common],
                                            help="ask the password breach check's endpoint for a range, changing nothing")
    breach_test.add_argument("--endpoint", metavar="URL", help="the endpoint to test; the configured breach_check_url when left out")
    breach_test.set_defaults(group=None, name=None)
    # The setting profiles (docs/Profiles.md).
    profiles_parser = settings_verbs.add_parser("profiles", parents=[common],
                                                help="the four setting profiles, how much of each would change here, and the one applied")
    profiles_parser.set_defaults(group=None, name=None)
    profile_parser = settings_verbs.add_parser("profile", parents=[common],
                                               help="one profile's diff: every setting beside the value this server holds")
    profile_parser.add_argument("name", help="office, gateway, relay or sender")
    profile_parser.set_defaults(group=None)
    apply_profile_parser = settings_verbs.add_parser("apply-profile", parents=[common],
                                                     help="apply a profile; what it replaces is kept so that it can be put back")
    apply_profile_parser.add_argument("name", help="office, gateway, relay or sender")
    apply_profile_parser.add_argument("--confirm", metavar="TOKEN",
                                      help="apply an entry that closes a listener, trusts an address range, turns a filter or a check off, or shortens how long data is kept, confirming the diff whose token hmctl settings profile NAME printed; refused without it")
    apply_profile_parser.add_argument("--token", metavar="TOKEN",
                                      help="the diff's token, for an apply that needs no confirmation: refused when the settings moved since the diff was read")
    apply_profile_parser.set_defaults(group=None)
    revert_profile_parser = settings_verbs.add_parser("revert-profile", parents=[common],
                                                      help="put back what the last profile changed")
    revert_profile_parser.set_defaults(group=None, name=None)
    discard_profile_parser = settings_verbs.add_parser("discard-profile", parents=[common],
                                                       help="keep the last profile's settings and forget the way back")
    discard_profile_parser.set_defaults(group=None, name=None)
    decline_profile_parser = settings_verbs.add_parser("decline-profile", parents=[common],
                                                       help="keep the settings this version ships with: record that no profile is wanted")
    decline_profile_parser.set_defaults(group=None, name=None)

    ini = commands.add_parser("ini", help="the server settings that were hMailServer.ini's [Settings] keys, stored in the database")
    ini.set_defaults(handler=ini_command)
    ini_verbs = ini.add_subparsers(dest="verb")
    ini_verbs.add_parser("list", parents=[common])
    for verb in ("get", "delete"):
        p = ini_verbs.add_parser(verb, parents=[common])
        p.add_argument("name")
    p = ini_verbs.add_parser("set", parents=[common])
    p.add_argument("name")
    p.add_argument("value")

    log = commands.add_parser("log", help="the log files")
    log.set_defaults(handler=log_command)
    log_verbs = log.add_subparsers(dest="verb")
    log_verbs.add_parser("list", parents=[common])
    tail = log_verbs.add_parser("tail", parents=[common])
    tail.add_argument("name")
    tail.add_argument("--lines", type=int, default=50)

    backup = commands.add_parser("backup", help="the server's own backup, and putting one back")
    backup.set_defaults(handler=backup_command)
    backup_verbs = backup.add_subparsers(dest="verb")
    backup_verbs.add_parser("status", parents=[common])
    backup_verbs.add_parser("start", parents=[common])

    backup_restore = backup_verbs.add_parser(
        "restore", parents=[common],
        help="put an archive back - destructive: it replaces what it restores")
    backup_restore.add_argument("file", help="the archive's path ON THE SERVER")
    backup_restore.add_argument("--settings", action="store_true", help="restore the server settings")
    backup_restore.add_argument("--domains", action="store_true", help="restore the domains, accounts and aliases")
    backup_restore.add_argument("--messages", action="store_true", help="restore the message files (with --domains)")
    backup_restore.add_argument("--passphrase-file", metavar="FILE",
                                help="a file holding the archive's passphrase, or - for standard input")
    backup_restore.add_argument("--ask", dest="ask_passphrase", action="store_true",
                                help="ask for the archive's passphrase here, not echoed")

    backup_passphrase = backup_verbs.add_parser(
        "passphrase", parents=[common],
        help="the passphrase the backup archive is encrypted with")
    backup_passphrase.add_argument("action", choices=["set", "clear"])
    backup_passphrase.add_argument("--passphrase-file", metavar="FILE",
