def render(value, as_json, columns=None):
    if as_json:
        print(json.dumps(value, indent=2, sort_keys=True))
        return

    if value is None:
        return

    if isinstance(value, list):
        if not value:
            print("(none)")
            return
        if all(isinstance(row, dict) for row in value):
            print_table(value, columns)
            return
        for row in value:
            print(row)
        return

    if isinstance(value, dict):
        width = max(len(str(k)) for k in value)
        for key in sorted(value):
            item = value[key]
            if isinstance(item, (dict, list)):
                item = json.dumps(item, sort_keys=True)
            print("%-*s  %s" % (width, key, item))
        return

    print(value)


def print_table(rows, columns=None):
    if columns:
        present = [c for c in columns if any(c in row for row in rows)]
        extra = []
    else:
        present = []
        extra = []
    if not present:
        seen = []
        for row in rows:
            for key in row:
                if key not in seen:
                    seen.append(key)
        present = seen[:8]

    def cell(row, column):
        value = row.get(column, "")
        if isinstance(value, bool):
            return "yes" if value else "no"
        if value is None:
            return ""
        if isinstance(value, (dict, list)):
            return json.dumps(value, sort_keys=True)
        return str(value)

    widths = [len(c) for c in present]
    for row in rows:
        for index, column in enumerate(present):
            widths[index] = max(widths[index], len(cell(row, column)))

    print("  ".join(c.upper().ljust(widths[i]) for i, c in enumerate(present)).rstrip())
    print("  ".join("-" * widths[i] for i in range(len(present))))
    for row in rows:
        print("  ".join(cell(row, c).ljust(widths[i]) for i, c in enumerate(present)).rstrip())
    if extra:
        print("")


def collection(answer, key):
    """The rows out of an answer, whether it is a list or an object holding one."""
    if isinstance(answer, list):
        return answer
    if isinstance(answer, dict):
        if key in answer and isinstance(answer[key], list):
            return answer[key]
        for value in answer.values():
            if isinstance(value, list):
                return value
    return answer


def ini_rows(answer):
    """The rows of GET /api/v1/settings/ini: settings, each {name, value, secret}.

    The route answers names as well - the list alone, for the Linux test shim -
    and a server from before 15 September 2026 answered ONLY names. Until then
    this file read a settings array the route never sent, collection() fell
    through to the names, and `ini list` and `config export` were silently
    empty against every real server. A names-only answer is now turned into
    rows with no value, so that a list is a list of names rather than nothing.
    """
    rows = collection(answer, "settings")
    if not isinstance(rows, list):
        return []
    if rows and all(isinstance(row, str) for row in rows):
        return [{"name": row} for row in rows]
    return [row for row in rows if isinstance(row, dict)]


def parse_set(pairs):
    """--set name=value, with a value read as JSON when it looks like JSON.

    So --set active=true is a boolean and --set name=true is not a problem
    either: a string that must stay a string is written --set name:=true... no.
    Simpler and unambiguous: true, false, null, numbers and anything starting
    with { or [ are JSON; everything else is a string. A string that must hold
    the four letters t-r-u-e is written --set-string.
    """
    body = {}
    for pair in pairs or []:
        if "=" not in pair:
            raise ApiError(0, "--set takes name=value, not %r" % pair)
        name, _, value = pair.partition("=")
        name = name.strip()
        stripped = value.strip()
        if stripped in ("true", "false", "null") or stripped[:1] in "{[" or _is_number(stripped):
            try:
                body[name] = json.loads(stripped)
                continue
            except ValueError:
                pass
        body[name] = value
    return body


def _is_number(text):
    if not text:
        return False
    try:
        float(text)
        return True
    except ValueError:
        return False


def body_from(arguments):
    body = {}
    if getattr(arguments, "from_json", None):
        if arguments.from_json == "-":
            body.update(json.load(sys.stdin))
        else:
            with io.open(arguments.from_json, encoding="utf-8") as handle:
                body.update(json.load(handle))
    body.update(parse_set(getattr(arguments, "set", None)))
    for pair in getattr(arguments, "set_string", None) or []:
        name, _, value = pair.partition("=")
        body[name.strip()] = value
    return body


