def resource_command(client, arguments):
    resource = RESOURCES[arguments.resource]
    verb = arguments.verb

    def collection_path():
        path = resource["collection"]
        if "{parent}" in path:
            parent = getattr(arguments, resource["parent"], None)
            if not parent:
                raise ApiError(0, "%s %s needs --%s: the API lists and creates them under it.%s" %
                               (arguments.resource, verb, resource["parent"],
                                ("\n  " + resource["create_example"]) if resource.get("create_example") else ""))
            path = path.replace("{parent}", urllib.parse.quote(parent, safe="@"))
        return path

    def item_path():
        path = resource["item"]
        if "{parent}" in path:
            parent = getattr(arguments, resource["parent"], None)
            if not parent:
                raise ApiError(0, "%s %s needs --%s" % (arguments.resource, verb, resource["parent"]))
            path = path.replace("{parent}", urllib.parse.quote(parent, safe="@"))
        return path.replace("{id}", urllib.parse.quote(str(arguments.id), safe="@"))

    if verb == "list":
        path = collection_path()
        if resource.get("search") and getattr(arguments, "search", None):
            path += "?search=" + urllib.parse.quote(arguments.search, safe="@")
        answer = client.request("GET", path)
        render(collection(answer, resource["key"]), arguments.json, resource["columns"])
        return EXIT_OK

    if verb == "get":
        render(client.request("GET", item_path()), arguments.json)
        return EXIT_OK

    if verb == "create":
        body = body_from(arguments)
        if not body:
            raise ApiError(0, "nothing to create: give --set name=value or --from-json FILE.%s" %
                           (("\n  " + resource["create_example"]) if resource.get("create_example") else ""))
        render(client.request("POST", collection_path(), body=body), arguments.json)
        return EXIT_OK

    if verb == "update":
        body = body_from(arguments)
        if not body:
            raise ApiError(0, "nothing to change: give --set name=value or --from-json FILE")
        render(client.request("PUT", item_path(), body=body), arguments.json)
        return EXIT_OK

    if verb == "delete":
        client.request("DELETE", item_path())
        if not arguments.json:
            print("%s %s deleted." % (arguments.resource, arguments.id))
        return EXIT_OK

    raise ApiError(0, "%s cannot %s" % (arguments.resource, verb))


