def settings_command(client, arguments):
    if arguments.verb == "breach-test":
        # The password breach check's endpoint, asked for the prefix 00000, which is
        # no password's; nothing is changed. Exit 1 when it could not be used, so a
        # monitoring job can alert on the exit code alone.
        body = {"url": arguments.endpoint} if arguments.endpoint else {}
        answer = client.request("POST", "/api/v1/settings/breach-check/test", body=body) or {}
        if arguments.json:
            render(answer, True)
        elif answer.get("reachable"):
            print("reachable: %s entries, %s, in %s ms" % (
                answer.get("entries"), "padded" if answer.get("padded") else "not padded", answer.get("milliseconds")))
        else:
            print("not reachable: %s" % answer.get("error", "no answer"))
        return EXIT_OK if answer.get("reachable") else EXIT_ERROR

    group = arguments.group or "settings"
    if group not in SETTING_GROUPS:
        raise ApiError(0, "unknown settings group %r; the groups are: %s" % (group, ", ".join(SETTING_GROUPS)))
    path = "/api/v1/settings" if group == "settings" else "/api/v1/settings/" + group

    if arguments.verb == "get":
        answer = client.request("GET", path)
        if arguments.name:
            if not isinstance(answer, dict) or arguments.name not in answer:
                raise ApiError(404, "no setting %r in the %s group" % (arguments.name, group))
            value = answer[arguments.name]
            print(json.dumps(value) if arguments.json else value)
            return EXIT_OK
        render(answer, arguments.json)
        return EXIT_OK

    body = body_from(arguments)
    if not body:
        raise ApiError(0, "nothing to set: give --set name=value")
    answer = client.request("PUT", path, body=body)
    render(answer if answer is not None else {"changed": sorted(body)}, arguments.json)
    return EXIT_OK


def ini_command(client, arguments):
    if arguments.verb == "list":
        answer = client.request("GET", "/api/v1/settings/ini")
        render(collection(answer, "settings"), arguments.json, ["name", "value"])
    elif arguments.verb == "get":
        render(client.request("GET", "/api/v1/settings/ini/%s" % arguments.name), arguments.json)
    elif arguments.verb == "set":
        answer = client.request("PUT", "/api/v1/settings/ini/%s" % arguments.name, body={"value": arguments.value})
        render(answer if answer is not None else {"name": arguments.name, "value": arguments.value}, arguments.json)
    elif arguments.verb == "delete":
        client.request("DELETE", "/api/v1/settings/ini/%s" % arguments.name)
        print("%s removed; the server's built-in default applies." % arguments.name)
    return EXIT_OK


def log_command(client, arguments):
    if arguments.verb == "list":
        render(collection(client.request("GET", "/api/v1/logs"), "logs"), arguments.json, ["name", "size", "modified"])
    else:
        answer = client.request("GET", "/api/v1/logs/%s" % arguments.name, query={"lines": arguments.lines})
        if isinstance(answer, dict) and "lines" in answer:
            for line in answer["lines"]:
                print(line)
        else:
            render(answer, arguments.json)
