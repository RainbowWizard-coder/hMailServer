# Renaming a mailbox, and moving one to another domain


def print_mailbox_move(status):
    """What GET /api/v1/accounts/<address>/move answers, as sentences."""
    print("address       %s" % status.get("address", ""))
    if status.get("in_use"):
        print("in use        yes: %s" % status.get("in_use_reason", ""))
    else:
        print("in use        no")

    last = status.get("last_move")
    if not isinstance(last, dict):
        print("last move     never moved")
        return

    print("last move     %s -> %s" % (last.get("old_address", ""), last.get("new_address", "")))
    print("              %s, %s" % (last.get("stage_name", ""), last.get("finished") or last.get("started") or ""))
    if not last.get("complete"):
        # A row short of the last stage is a move that was interrupted, and the
        # server's application log says which half of the store to look at.
        print("              this move did not finish; see the server's application log")


def mailbox_command(client, arguments):
    base = "/api/v1/accounts/%s/move" % urllib.parse.quote(arguments.address, safe="@")

    if arguments.verb == "status":
        answer = client.request("GET", base)
        if arguments.json:
            render(answer, True)
        else:
            print_mailbox_move(answer)
        return EXIT_OK

    body = {"new_address": arguments.new_address, "keep_alias": not arguments.drop_alias}
    answer = client.request("POST", base, body=body)

    if arguments.json:
        render(answer, True)
        return EXIT_OK

    print("%s moved to %s." % (answer.get("old_address", arguments.address), answer.get("new_address", arguments.new_address)))
    print("  %s message(s) in %s folder(s)." % (answer.get("messages", 0), answer.get("folders", 0)))
    print("  %s alias(es) re-pointed, %s list membership(s), %s queued recipient(s), %s quarantined message(s)."
          % (answer.get("aliases_repointed", 0), answer.get("list_memberships", 0),
             answer.get("queued_recipients", 0), answer.get("quarantine_entries", 0)))
    if answer.get("alias_kept"):
        print("  The old address is kept as an alias.")
    else:
        print("  The old address is not kept: mail to it will be refused.")

    # A rewrite that failed writes nothing and so counts nothing: without this
    # line, "0 alias(es) re-pointed" reads as a move that had no aliases to
    # re-point rather than one whose aliases are still naming the old address.
    if answer.get("references_incomplete"):
        print("  Some references to the old address could not be rewritten. The server's application log says which.")
    return EXIT_OK


# ---------------------------------------------------------------------------
# Accounts from a spreadsheet
# ---------------------------------------------------------------------------

# The columns, in the order the export writes them. Each is a field of
# POST /api/v1/domains/<domain>/accounts under the create's own name, and the
# export reads the same names from the domain's listing, so a file exported and
# given a password column goes back in as it came out. The create refuses any
# other field by name, so a column not in this list is refused here, before a
# request is made - which is what lets a dry run say so as well.
CSV_FIELDS = ["address", "password", "first_name", "last_name", "active", "max_size_mb", "admin_level"]

# How a cell is sent. active is a boolean and max_size_mb a number; every other
# column is text, whatever it looks like - a password of digits alone, or a
# surname of "True", is a string. Those two, admin_level, a missing password and
# a name past its column are checked here in the server's own words, so a dry
# run refuses what the create would refuse. What only the server can judge - the
# password policy, the domain's limits - is refused when the row is sent.
CSV_TRUE = ("true", "yes", "on", "1")
CSV_FALSE = ("false", "no", "off", "0")
CSV_ADMIN_LEVELS = ("user", "domain", "server")

# The width of accountpersonfirstname and accountpersonlastname, counted as the
# Windows server counts it and as SQL Server's nvarchar(60) holds it: in UTF-16
# code units, so a character outside the Basic Multilingual Plane counts two.
# PowerShell's String.Length counts the same way, so the two clients refuse
# the same names.
CSV_NAME_WIDTH = 60


def utf16_length(text):
    return len(text.encode("utf-16-le")) // 2


def account_csv_columns(path, fieldnames, rows):
    """The header's columns, lower-cased and trimmed, or a refusal naming the
    ones the create does not take."""
    columns = [(name or "").strip().lower() for name in (fieldnames or [])]

    if "address" not in columns:
        raise ApiError(0, "%s has no 'address' column; its columns are: %s" %
                       (path, ", ".join(name for name in (fieldnames or []) if name)))

    unknown = []
    for original, column in zip(fieldnames or [], columns):
        if column in CSV_FIELDS or column in unknown:
            continue
        # A header cell left blank over cells left blank is a spreadsheet's
        # trailing comma, not a column.
        if column == "" and not any((row.get(original) or "").strip() for row in rows):
            continue
        unknown.append(column)

    if unknown:
        hint = ""
        if "name" in unknown:
            hint = " A person's name goes in two columns, first_name and last_name."
        raise ApiError(0, "%s has a column the server does not take: %s. The columns are %s.%s" %
                       (path, ", ".join(repr(column) for column in unknown), ", ".join(CSV_FIELDS), hint))

    return columns


def account_csv_body(row):
    """One row as the create's body, or (None, reason) when the create would
    refuse it. An empty cell is not sent, so the server's default applies."""
    if None in row:
        return None, "more cells than the header has columns (a comma inside a value needs the value in quotes)"

    body = {}
    for original, value in row.items():
        column = (original or "").strip().lower()
        if value is None or column == "":
            continue

        # Every cell is trimmed but the password's: a space at either end of a
        # spreadsheet cell is far more often a slip than part of a name, and
        # trimming one out of a password would make an account whose password
        # is not the one in the file, without a word. So a password with white
        # space at an edge is refused instead, and a dry run shows it. The two
        # clients send the same body for one file.
        text = value.strip()
        if text == "":
            continue

        if column == "password" and text != value:
            return None, ("the password begins or ends with white space, which a spreadsheet cell rarely means; "
                          "take it out of the cell, or set that password after the import")

        if column == "active":
            word = text.lower()
            if word in CSV_TRUE:
                body[column] = True
            elif word in CSV_FALSE:
                body[column] = False
            else:
                return None, "active must be true or false, not %r" % text
        elif column == "max_size_mb":
            if not (text.isascii() and text.isdigit()) or len(text) > 10 or int(text) > 2147483647:
                return None, "max_size_mb must be a whole number of megabytes, 0 for no limit, not %r" % text
            body[column] = int(text)
        elif column == "admin_level":
            if text.lower() not in CSV_ADMIN_LEVELS:
                return None, "admin_level must be user, domain or server, not %r" % text
            body[column] = text.lower()
        elif column in ("first_name", "last_name"):
            if utf16_length(text) > CSV_NAME_WIDTH:
                return None, ("first_name and last_name are at most 60 characters each; this %s has %d"
                              % (column, utf16_length(text)))
            body[column] = text
        else:
            body[column] = text

    if not body.get("password"):
        return None, "address and password are required; this row has no password"

    return body, None


def accounts_import(client, arguments):
    """A CSV of accounts into their domains, with a dry run that says what would happen.

    The header row names the columns, which are CSV_FIELDS in any order: address
    and password are required on every row, and the rest may be left out or left
    empty. A row whose address already exists is left alone and counted, because
    an import that silently overwrote a password would be a way to lock a hundred
    people out with one command.
    """
    try:
        with io.open(arguments.file, encoding="utf-8-sig", newline="") as handle:
            reader = csv.DictReader(handle)
            rows = list(reader)
            fieldnames = reader.fieldnames
    except UnicodeDecodeError:
        # A spreadsheet's plain "CSV" is often the ANSI code page. Guessing
        # which one would import a name wrong without a word.
        raise ApiError(0, "%s is not UTF-8. Save it as CSV UTF-8 and import it again." % arguments.file)

    if not rows:
        raise ApiError(0, "%s has no rows under its header" % arguments.file)

    account_csv_columns(arguments.file, fieldnames, rows)
    address_key = [name for name in fieldnames if (name or "").strip().lower() == "address"][0]

    # The domains to read the existing addresses from: the ones named, or the
    # ones the file's own addresses are in. Accounts are listed UNDER their
    # domain (/api/v1/domains/<domain>/accounts); asking /api/v1/accounts with a
    # query is not a route, and the 404 it answers would make every address in
    # the file look new.
    domains = [d.lower() for d in (arguments.domain or [])]
    if not domains:
        seen = set()
        for row in rows:
            address = (row.get(address_key) or "").strip()
            if "@" in address:
                seen.add(address.split("@", 1)[1].lower())
        domains = sorted(seen)

    existing = set()
    for domain in domains:
        try:
            answer = client.request("GET", "/api/v1/domains/%s/accounts" % urllib.parse.quote(domain, safe=""))
        except ApiError as error:
            # A domain in the file that the server does not have: every address
            # in it is new, which is what an empty answer means here. The create
            # will fail with the server's own words if the domain is missing.
            if error.status == 404:
                continue
            raise
        for account in collection(answer, "accounts"):
            existing.add(str(account.get("address", "")).lower())

    made, skipped, failed = [], [], []
    for number, row in enumerate(rows, start=2):
        address = (row.get(address_key) or "").strip()
        if not address:
            failed.append((number, "(blank)", "no address"))
            continue
        if address.lower() in existing:
            skipped.append(address)
            continue
        if "@" not in address:
            failed.append((number, address, "not an e-mail address"))
            continue

        body, reason = account_csv_body(row)
        if body is None:
            failed.append((number, address, reason))
            continue

        if arguments.dry_run:
            made.append(address)
            continue

        try:
            client.request("POST", "/api/v1/domains/%s/accounts"
                           % urllib.parse.quote(address.split("@", 1)[1], safe=""), body=body)
            made.append(address)
        except ApiError as error:
            failed.append((number, address, error.message))

    if arguments.json:
        render({"made": made, "skipped": skipped,
                "failed": [{"row": r, "address": a, "error": e} for r, a, e in failed],
                "dry_run": bool(arguments.dry_run)}, True)
    else:
        verb = "would be made" if arguments.dry_run else "made"
        print("%d %s, %d already there, %d refused." % (len(made), verb, len(skipped), len(failed)))
        for address in made:
            print("  + %s" % address)
        for address in skipped:
            print("  = %s (exists; left alone)" % address)
        for number, address, message in failed:
            print("  ! line %d %s: %s" % (number, address, message))

    return EXIT_ERROR if failed else EXIT_OK


def accounts_export(client, arguments):
    """A domain's accounts as the import reads them, less the password column:
    the server does not have the passwords to give."""
    answer = client.request("GET", "/api/v1/domains/%s/accounts"
                            % urllib.parse.quote(arguments.domain, safe=""))
    accounts = collection(answer, "accounts")

    fields = [f for f in CSV_FIELDS if f != "password"]
    handle = sys.stdout if arguments.file == "-" else io.open(arguments.file, "w", encoding="utf-8", newline="")
    try:
        writer = csv.DictWriter(handle, fieldnames=fields, extrasaction="ignore")
        writer.writeheader()
        for account in accounts:
            cells = {}
            for field in fields:
                value = account.get(field, "")
                # The JSON words, so the file reads the same whichever client wrote it.
                cells[field] = ("true" if value else "false") if isinstance(value, bool) else value
            writer.writerow(cells)
    finally:
        if handle is not sys.stdout:
            handle.close()
            print("%d accounts written to %s." % (len(accounts), arguments.file))
    return EXIT_OK


# ---------------------------------------------------------------------------
# The whole configuration as one document
# ---------------------------------------------------------------------------

# What a configuration document holds, in the order it is applied: a domain
# before the accounts in it, a rule after the accounts it names. Each entry is
# the resource's key in RESOURCES, the field that identifies one, and whether it
# is listed under a parent.
CONFIG_SECTIONS = [
    {"name": "settings", "kind": "settings"},
    {"name": "ini", "kind": "ini"},
    {"name": "domains", "kind": "resource", "resource": "domain"},
    {"name": "accounts", "kind": "resource", "resource": "account"},
    {"name": "aliases", "kind": "resource", "resource": "alias"},
    {"name": "lists", "kind": "resource", "resource": "list"},
    {"name": "spam_traps", "kind": "resource", "resource": "spamtrap"},
    {"name": "groups", "kind": "resource", "resource": "group"},
    {"name": "rules", "kind": "resource", "resource": "rule"},
    {"name": "routes", "kind": "resource", "resource": "route"},
    {"name": "ports", "kind": "resource", "resource": "port"},
    {"name": "ipranges", "kind": "resource", "resource": "iprange"},
]

# Fields the server answers with that describe the world rather than the
# configuration, and that must not travel into a document or be compared: an
# identifier the server allocates, a count it computes, a time it recorded, or a
# piece of another field it splits out for a reader (a spam trap's local_part,
# which is its address up to the @). A field here that reached a create would be
# refused - the write routes take the fields they own and nothing else - so the
# document would not apply to the server it was exported from.
NOT_CONFIGURATION = {
    "id", "account_id", "domain_id", "rule_id", "route_id", "parent_id",
    "account_count", "alias_count", "member_count", "size_mb", "size",
    "created", "modified", "last_used", "last_login", "last_logon",
    "local_part",
}

# A domain's selector and key files while its DKIM key rotation is on. The rotation
# moves them on its own schedule, so they are the server's state and not the
# document's: an export taken before a switch would otherwise differ from the
# server after it, and applying it would ask for the old key back - which the
# server refuses with 409. Left out of the document and out of the comparison,
# and not sent, whenever the domain (on the server or in the document) has the
# rotation on.
#
# The server holds them for a while with the schedule off too: while a rotation
# started by hand has a next key staged or an old selector still being kept, it
# refuses a change to them just the same. The document keeps them then - they are
# the domain's configuration once that rotation is over - but a comparison that
# finds them different asks the server (rotation_in_flight), and an update leaves
# them out while the server says it holds them.
ROTATION_OWNED = ("dkim_selector", "dkim_private_key_file", "dkim_secondary_selector", "dkim_secondary_private_key_file")

CONFIG_VERSION = 1

# The live update's trust: the five [Settings] keys a server from 6.3.6 reads
# from its own hMailServer.ini alone and refuses to change over the REST API
# (docs/UpdateFeed.md, "Where the trust is read from"). They say what that
# machine's updates are checked against, which is the machine's and not the
# configuration's, so they are left out of the document as the keys the
# server's environment sets are. A document an earlier hmctl exported can
# carry them: diff and apply leave them out and say so, rather than plan a
# write the server refuses and fail the whole apply for it.
TRUST_ANCHOR_KEYS = ("UpdateSigningIdentity", "UpdateSigningIssuer", "UpdateSourceRepository",
                     "UpdateTrustRootsFile", "UpdateLogPublicKeyFile")


def is_trust_anchor(name):
    """Whether an ini key is one of the live update's trust, matched without case
    as the server matches it."""
    return str(name).lower() in set(key.lower() for key in TRUST_ANCHOR_KEYS)


def trust_anchors_in(document):
    """The trust keys a document's ini section carries, which diff and apply
    leave out: an export from before they were left out of it."""
    ini = (document.get("sections") or {}).get("ini") or {}
    return sorted(key for key in ini if is_trust_anchor(key))


def say_trust_anchors_skipped(document, as_json):
    """One line naming the trust keys a document carries and diff or apply left
    out, on the standard error under --json so that the JSON stays JSON."""
    skipped = trust_anchors_in(document)
    if not skipped:
        return
    line = ("Skipped %s: the live update's trust, which a server reads from its own hMailServer.ini "
            "and does not take over the REST API (docs/UpdateFeed.md, \"Where the trust is read from\"). "
            "Set it in that server's file. An export from this hmctl leaves it out." % ", ".join(skipped))
    print(line, file=sys.stderr if as_json else sys.stdout)


def without_rotation_owned(row, rotation_on=None):
    if rotation_on is None:
        rotation_on = row.get("dkim_rotation_enabled") is True
    if not rotation_on:
        return row
    return dict((k, v) for k, v in row.items() if k not in ROTATION_OWNED)


def rotation_in_flight(client, domain):
    """Whether the server's DKIM key rotation holds a domain's selector and key
    files right now - its schedule on, a next key staged, or an old selector still
    being kept - which is when the server refuses a change to them with 409. A
    server without the route, or a key that may not read it, answers no, and the
    update is sent as before."""
    try:
        answer = client.request("GET", "/api/v1/domains/" + urllib.parse.quote(domain, safe="") + "/dkim/rotation")
    except ApiError as error:
        if error.status in (403, 404):
            return False
        raise
    if not isinstance(answer, dict):
        return False
    policy = answer.get("policy") if isinstance(answer.get("policy"), dict) else {}
    return policy.get("enabled") is True or answer.get("next") is not None or answer.get("retiring") is not None


def configuration_key(section, row):
    """The field that identifies one entry of a section, as a person names it."""
    if section["kind"] != "resource":
        return None
    resource = RESOURCES[section["resource"]]
    identifier = resource["id"]
    if identifier in row:
        return str(row[identifier])
    # An alias is identified by the address it answers for, which the listing
    # calls "name"; a resource whose id field is not in the row falls back to
    # whatever unique text it does carry.
    for candidate in ("address", "name", "value"):
        if candidate in row:
            return str(row[candidate])
    return None


def strip_configuration(row):
    # <key>_levels is what the server says about a key - how deep it may be set
    # (docs/SettingLevels.md) - not configuration: a document carrying it would
    # have it applied back, and the server refuses it.
    return dict((k, v) for k, v in row.items()
                if k not in NOT_CONFIGURATION and not str(k).endswith("_id") and not str(k).endswith("_levels"))


def strip_environment(row):
    # <key>_environment says the server's environment sets <key>
    # (docs/EnvironmentConfiguration.md). Neither is the configuration's: the
    # value is the deployment's, stored again at every start, and a value a file
    # supplied is answered as (set) or null - applied back, either would be
    # refused (409, 400). Both are left out of the document.
    managed = set(str(k)[:-len("_environment")] for k in row if str(k).endswith("_environment"))
    return dict((k, v) for k, v in row.items() if k not in managed and not str(k).endswith("_environment"))


def read_configuration(client, domains=None):
    """The live configuration as a document. Deterministic: sorted throughout,
    no time of day in it, nothing the server allocates - so two exports of an
    unchanged server are the same bytes and a diff means a change."""
    document = {"version": CONFIG_VERSION, "sections": {}}

    for section in CONFIG_SECTIONS:
        if section["kind"] == "settings":
            groups = {}
            for group in SETTING_GROUPS:
                if group == "directories":
                    continue          # paths of this machine, not configuration to copy
                path = "/api/v1/settings" if group == "settings" else "/api/v1/settings/" + group
                try:
                    answer = client.request("GET", path)
                except ApiError as error:
                    if error.status in (403, 404):
                        continue
                    raise
                if isinstance(answer, dict):
                    groups[group] = dict(sorted(strip_configuration(strip_environment(answer)).items()))
            document["sections"]["settings"] = groups
            continue

        if section["kind"] == "ini":
            try:
                answer = client.request("GET", "/api/v1/settings/ini")
            except ApiError as error:
                if error.status in (403, 404):
                    continue
                raise
            # The keys the server's environment sets, whatever it sets them from:
            # the route's environment map, {key: "variable" | "file"}. As in the
            # groups (strip_environment), such a value is the deployment's, stored
            # again at every start, and applied to a server whose environment sets
            # it the PUT would be refused (409) - so it is not in the document.
            environment = answer.get("environment") if isinstance(answer, dict) else None
            managed = set(str(k).lower() for k in (environment or {}))
            values = {}
            for row in ini_rows(answer):
                if "name" not in row or "value" not in row:
                    continue
                # A secret is listed as "(set)", never as its value. It stays out of
                # the document: a document is for a repository, and one that carried
                # the placeholder would write "(set)" over the real secret on apply.
                if row.get("secret"):
                    continue
                if str(row["name"]).lower() in managed:
                    continue
                # The live update's trust, which is the machine's: see
                # TRUST_ANCHOR_KEYS.
                if is_trust_anchor(row["name"]):
                    continue
                values[str(row["name"])] = row.get("value")
            document["sections"]["ini"] = dict(sorted(values.items()))
            continue

        resource = RESOURCES[section["resource"]]
        rows = []
        if resource.get("parent") == "domain":
            for domain in (domains or []):
                path = resource["collection"].replace("{parent}", urllib.parse.quote(domain, safe=""))
                try:
                    answer = client.request("GET", path)
                except ApiError as error:
                    if error.status == 404:
                        continue
                    raise
                for row in collection(answer, resource["key"]):
                    if isinstance(row, dict):
                        entry = strip_configuration(row)
                        entry["domain"] = domain
                        rows.append(entry)
        elif resource.get("parent"):
            continue                  # a resource under an account: not in the document yet
        else:
            try:
                answer = client.request("GET", resource["collection"])
            except ApiError as error:
                # A server older than this file does not carry every resource,
                # and a read-only key may be refused one. Either way the
                # document says nothing about that section rather than the
                # export failing whole.
                if error.status in (403, 404):
                    continue
                raise
            for row in collection(answer, resource["key"]):
                if isinstance(row, dict):
                    entry = strip_configuration(row)
                    if section["name"] == "domains":
                        entry = without_rotation_owned(entry)
                    rows.append(entry)

        rows.sort(key=lambda r: json.dumps(r, sort_keys=True))
        document["sections"][section["name"]] = rows

        if section["name"] == "domains":
            domains = sorted(str(r.get("name")) for r in rows if r.get("name"))

    return document


def configuration_plan(live, wanted, in_flight=None):
    """What would have to happen to make the server match the document: a list
    of (section, verb, key, detail). Nothing is decided here about whether it
    may happen - that is apply's business. in_flight, when given, answers for a
    domain name whether the server's key rotation holds its selectors; it is
    asked only about a domain whose selectors differ and whose schedule is off."""
    plan = []

    live_sections = live.get("sections", {})
    wanted_sections = wanted.get("sections", {})

    for name in ("settings",):
        for group in sorted(set(list(live_sections.get(name, {}).keys()) + list(wanted_sections.get(name, {}).keys()))):
            here = (live_sections.get(name) or {}).get(group, {})
            there = (wanted_sections.get(name) or {}).get(group, {})
            for key in sorted(set(list(here.keys()) + list(there.keys()))):
                if key not in there:
                    continue          # the document says nothing about it: leave it alone
                if here.get(key) != there.get(key):
                    plan.append((name + "/" + group, "set", key, "%r -> %r" % (here.get(key), there.get(key))))

    here = live_sections.get("ini", {})
    there = wanted_sections.get("ini", {})
    for key in sorted(there.keys()):
        # Left out, and said by the caller (say_trust_anchors_skipped): the
        # server takes none of them over the REST API.
        if is_trust_anchor(key):
            continue
        if here.get(key) != there.get(key):
            plan.append(("ini", "set", key, "%r -> %r" % (here.get(key), there.get(key))))

    for section in CONFIG_SECTIONS:
        if section["kind"] != "resource":
            continue
        name = section["name"]
        here_rows = {}
        for row in live_sections.get(name, []) or []:
            key = configuration_key(section, row)
            if key:
                here_rows[key] = row
        there_rows = {}
        for row in wanted_sections.get(name, []) or []:
            key = configuration_key(section, row)
            if key:
                there_rows[key] = row

        if name == "domains":
            for key in there_rows:
                here = here_rows.get(key)
                there = there_rows[key]
                owned = (here or {}).get("dkim_rotation_enabled") is True or there.get("dkim_rotation_enabled") is True
                if (not owned and here is not None and in_flight is not None
                        and any(here.get(k) != there.get(k) for k in ROTATION_OWNED)):
                    owned = in_flight(key)
                if owned:
                    there_rows[key] = without_rotation_owned(there, True)
                    if here is not None:
                        here_rows[key] = without_rotation_owned(here, True)

        for key in sorted(there_rows):
            if key not in here_rows:
                plan.append((name, "create", key, json.dumps(there_rows[key], sort_keys=True)))
            elif here_rows[key] != there_rows[key]:
                changed = sorted(k for k in set(list(here_rows[key].keys()) + list(there_rows[key].keys()))
                                 if here_rows[key].get(k) != there_rows[key].get(k))
                plan.append((name, "update", key, ", ".join(changed)))

        for key in sorted(here_rows):
            if key not in there_rows:
                plan.append((name, "delete", key, ""))

    return plan


def render_plan(plan, as_json):
    if as_json:
        render([{"section": s, "verb": v, "key": k, "detail": d} for s, v, k, d in plan], True)
        return

    if not plan:
        print("The server already matches the document.")
        return

    counts = {}
    for section, verb, key, detail in plan:
        counts[verb] = counts.get(verb, 0) + 1
        print("  %-8s %-10s %s%s" % (verb, section, key, ("  (" + detail + ")") if detail else ""))
    print("")
    print(", ".join("%d to %s" % (counts[v], v) for v in sorted(counts)))


def config_export(client, arguments):
    document = read_configuration(client)
    text = json.dumps(document, indent=2, sort_keys=True)
    if not arguments.file or arguments.file == "-":
        print(text)
    else:
        with io.open(arguments.file, "w", encoding="utf-8") as handle:
            handle.write(text + "\n")
        print("Written to %s." % arguments.file)
    return EXIT_OK


def config_changed(client, arguments):
    """Every setting whose value is not the one this version ships with.

    One route answers the whole of it and this prints what the server said: the
    defaults are the server's own, read from the source it was built from, so
    this file holds no copy of them to go stale. The same document the Control
    Deck's page and COM's Settings.GetChangedFromDefault show, which is the
    point - three tools that describe the same server differently are worse
    than two that say nothing.

    A difference is NOT an exit code here, which is the one place this parts
    company with `config diff`. Every real server has changed something, so a
    non-zero exit would be the normal answer and every script would learn to
    ignore it.

    The route answers to the administrator password and to nothing else, as
    `ini list` does: an api key is refused and so is an account holding a role,
    because the settings include the server's secrets and the commands it runs.
    """
    answer = client.request("GET", "/api/v1/settings/changed")
    if arguments.json:
        render(answer, True)
        return EXIT_OK

    rows = answer.get("settings", []) if isinstance(answer, dict) else []
    shown = []
    for row in rows:
        if not isinstance(row, dict):
            continue
        entry = dict(row)
        # A name the server ships no default for: the column would otherwise be
        # empty, which reads as "the default is empty" rather than "there is none".
        if entry.get("known") is False:
            entry["default"] = "(none: this server does not read it)"
        # A value the file's [SettingsOverride] section is forcing over whatever is
        # stored. Said beside the value rather than left out, because it is the one
        # thing here that no page and no configuration export shows, and reading
        # "DnsServer 10.0.0.1" while the stored value is something else is how an
        # afternoon gets lost.
        if entry.get("overridden"):
            entry["value"] = "%s (forced from [SettingsOverride])" % entry.get("value", "")
        # A value the server's environment sets (docs/EnvironmentConfiguration.md):
        # changed from stock by the deployment, stored again at every start, and
        # refused to every interface - so said beside it, with where it came from.
        if entry.get("environment") in ("variable", "file"):
            entry["value"] = "%s (set by the environment%s)" % (
                entry.get("value", ""), ", from a file" if entry.get("environment") == "file" else "")
        entry.pop("known", None)
        entry.pop("secret", None)
        entry.pop("overridden", None)
        entry.pop("environment", None)
        shown.append(entry)

    render(shown, False, ["store", "name", "value", "default"])

    if isinstance(answer, dict):
        print("%d of %d settings are not what this version ships with." %
              (len(rows), int(answer.get("considered") or 0)))
    return EXIT_OK


def config_diff(client, arguments):
    with io.open(arguments.file, encoding="utf-8") as handle:
        wanted = json.load(handle)
    live = read_configuration(client)
    plan = configuration_plan(live, wanted, lambda name: rotation_in_flight(client, name))
    render_plan(plan, arguments.json)
    say_trust_anchors_skipped(wanted, arguments.json)
    # A difference is an exit code, so that a pipeline can gate on it the way it
    # gates on a failing test. A trust key the document carries is not one: it
    # is left out, and the line above says so.
    return EXIT_OK if not plan else EXIT_ERROR


def config_apply(client, arguments):
    with io.open(arguments.file, encoding="utf-8") as handle:
        wanted = json.load(handle)
    live = read_configuration(client)
    plan = configuration_plan(live, wanted, lambda name: rotation_in_flight(client, name))

    deletions = [step for step in plan if step[1] == "delete"]
    if deletions and not arguments.allow_delete:
        plan = [step for step in plan if step[1] != "delete"]

    if not arguments.force:
        render_plan(plan, arguments.json)
        say_trust_anchors_skipped(wanted, arguments.json)
        if deletions and not arguments.allow_delete:
            print("")
            print("%d entr(ies) on the server are not in the document. They are left alone; "
                  "--allow-delete removes them." % len(deletions))
        if plan:
            print("")
            print("Nothing was changed. Add --force to apply this plan.")
        return EXIT_OK

    say_trust_anchors_skipped(wanted, False)

    applied, refused = 0, []
    for section, verb, key, detail in plan:
        try:
            apply_one(client, wanted, section, verb, key)
            applied += 1
            print("  %-8s %-10s %s" % (verb, section, key))
        except ApiError as error:
            refused.append((section, verb, key, error.message))
            print("  ! %-6s %-10s %s: %s" % (verb, section, key, error.message))

    print("")
    print("%d applied, %d refused." % (applied, len(refused)))
    if deletions and not arguments.allow_delete:
        print("%d entr(ies) not in the document were left alone; --allow-delete removes them." % len(deletions))
    return EXIT_ERROR if refused else EXIT_OK


def apply_one(client, wanted, section, verb, key):
    """One step of a plan. Kept small and obvious: the interesting decisions are
    all in configuration_plan, and this only speaks HTTP."""
    sections = wanted.get("sections", {})

    if section.startswith("settings/"):
        group = section.split("/", 1)[1]
        path = "/api/v1/settings" if group == "settings" else "/api/v1/settings/" + group
        client.request("PUT", path, body={key: sections["settings"][group][key]})
        return

    if section == "ini":
        client.request("PUT", "/api/v1/settings/ini/" + urllib.parse.quote(key, safe=""),
                       body={"value": sections["ini"][key]})
        return

    definition = None
    for candidate in CONFIG_SECTIONS:
        if candidate["name"] == section:
            definition = candidate
            break
    if definition is None:
        raise ApiError(0, "no such section %r" % section)

    resource = RESOURCES[definition["resource"]]
    row = None
    for entry in sections.get(section, []) or []:
        if configuration_key(definition, entry) == key:
            row = dict(entry)
            break

    parent = row.pop("domain", None) if row else None

    if verb == "delete":
        path = resource["item"].replace("{id}", urllib.parse.quote(key, safe="@"))
        if "{parent}" in path:
            raise ApiError(0, "a %s is deleted under its parent, which this plan does not carry" % section)
        client.request("DELETE", path)
        return

    if row is None:
        raise ApiError(0, "the document has no %s named %s" % (section, key))

    if section == "domains" and verb == "update":
        # Asked of the server at the moment of the update, not of the document: the
        # schedule may be on there and off here, or a rotation started by hand may
        # be holding the selectors with the schedule off on both.
        row = without_rotation_owned(row, row.get("dkim_rotation_enabled") is True or rotation_in_flight(client, key))

    if verb == "create":
        path = resource["collection"]
        if "{parent}" in path:
            if not parent:
                raise ApiError(0, "the document's %s entry %s carries no domain" % (section, key))
            path = path.replace("{parent}", urllib.parse.quote(parent, safe=""))
        if definition["resource"] == "account" and "password" not in row:
            raise ApiError(0, "an account is not created without a password; add one to the document "
                              "for %s, or make the account first" % key)
        client.request("POST", path, body=row)
        return

    # An update. Some resources have none - a spam trap is an address and nothing
    # else, so there is nothing about one to change and no PUT route to send it
    # to. Said here rather than discovered as a 404, since a plan that asks for
    # one means the two sides disagree about a field that is not configuration.
    if "update" not in resource.get("verbs", ()):
        raise ApiError(0, "a %s is created or removed, never changed; the document and the server differ "
                          "about %s in a way nothing can apply" % (section, key))

    path = resource["item"].replace("{id}", urllib.parse.quote(key, safe="@"))
    if "{parent}" in path:
        if not parent:
            raise ApiError(0, "the document's %s entry %s carries no domain" % (section, key))
        path = path.replace("{parent}", urllib.parse.quote(parent, safe=""))
    client.request("PUT", path, body=row)


def traphits_command(client, arguments):
    """What has addressed a spam trap, and the clearing of that record."""
    if arguments.verb == "clear":
        render(client.request("DELETE", "/api/v1/spam-traps/hits"), arguments.json)
        return EXIT_OK

    if arguments.domain:
        path = "/api/v1/domains/%s/spam-traps/hits" % urllib.parse.quote(arguments.domain, safe="")
    else:
        path = "/api/v1/spam-traps/hits"

    query = {}
    if arguments.limit:
        query["limit"] = arguments.limit

    answer = client.request("GET", path, query=query or None)
    render(collection(answer, "items"), arguments.json,
           ["time", "address", "ip_address", "sender", "banned", "blocked", "note"])
    return EXIT_OK


def sample_domain_command(client, arguments):
    """The throwaway example.test, made and removed in one command.

    Three verbs and no options. There is exactly one sample domain, it is always
    example.test, and what is in it is fixed - a sample with options is a
    configuration screen, which is the thing this exists to let somebody skip.

    Exit 2 for a refusal rather than 1: "it is already there", "there is none"
    and "that example.test is not mine" are answers, not failures, and a script
    that runs create at the start of a demonstration should be able to tell them
    from a server that could not be reached. The server says all three with 409,
    which main() would otherwise map to EXIT_ERROR like everything else, so the
    three calls are made here rather than left to it.
    """
    try:
        if arguments.verb == "create":
            answer = client.request("POST", "/api/v1/setup/sample-domain", body={}) or {}
        elif arguments.verb == "remove":
            answer = client.request("DELETE", "/api/v1/setup/sample-domain") or {}
        else:
            answer = client.request("GET", "/api/v1/setup/sample-domain") or {}
    except ApiError as error:
        if error.status != 409:
            raise
        print("hmctl: %s" % error.message, file=sys.stderr)
        return EXIT_REFUSED

    if arguments.json:
        render(answer, True)
        return EXIT_OK

    if arguments.verb in ("create", "remove"):
        # The message carries the password on a creation, because the server
        # mints one per sample and keeps only its hash: this line is the one
        # time anything says it.
        print(answer.get("message") or "")
        if arguments.verb == "create":
            print("The messages are delivered through the server's own path and arrive in a few seconds.")
            print("Remove the sample - hmctl sample-domain remove - before this server takes real mail.")
        return EXIT_OK

    state = answer.get("state", "")
    print("domain    %s" % answer.get("domain", ""))
    print("state     %s" % state)
    if state == "present":
        print("accounts  %s" % ", ".join(answer.get("accounts") or []))
        print("list      %s" % answer.get("list", ""))
        print("password  (shown once when the sample was made; not stored)")
        print("")
        print("Remove it - hmctl sample-domain remove - before this server takes real mail.")
    elif state == "foreign":
        print("")
        print("A domain of that name is on this server and the sample did not make it,")
        print("so create and remove both refuse. Delete it yourself if it is not wanted.")
    elif state == "unknown":
        print("")
        print("The server could not read its domain table, so it cannot say whether the")
        print("sample is here. create and remove both refuse until it can.")
    else:
        print("")
        print("No sample domain. hmctl sample-domain create makes one.")

    return EXIT_OK


def report_command(client, arguments):
    """The reports: a section of one, for a window and optionally one domain.

    The CSV is the SERVER'S csv, fetched with format=csv rather than written
    here out of the JSON. That is deliberate: two writers of the same table
    drift, and the one an administrator opens in a spreadsheet should be the
    one the route promises. It also means a column the route gains appears in
    the file without a change here.
    """
    if arguments.section == "sections":
        answer = client.request("GET", "/api/v1/reports")
        if arguments.json:
            render(answer, True)
            return EXIT_OK
        render(collection(answer, "sections"), False, ["name", "scope", "source", "summary"])
        print("")
        print("Sources:")
        for name, source in sorted((answer.get("sources") or {}).items()):
            print("  %-16s %-14s retention %s days, oldest %s"
                  % (name, "recording" if source.get("enabled") else "NOT RECORDING",
                     source.get("retention_days"), source.get("oldest") or "-"))
        for line in answer.get("not_answerable") or []:
            print("  cannot answer: %s" % line)
        return EXIT_OK

    query = []
    if arguments.set_from:
        query.append("from=" + urllib.parse.quote(arguments.set_from))
    if arguments.to:
        query.append("to=" + urllib.parse.quote(arguments.to))
    if arguments.domain:
        query.append("domain=" + urllib.parse.quote(arguments.domain))
    query.append("top=%d" % arguments.top)

    path = "/api/v1/reports/" + urllib.parse.quote(arguments.section)

    if arguments.csv:
        query.append("format=csv")
        # request() hands back a string when the body is not JSON, which a CSV
        # never is; anything else means the server answered a document rather
        # than a table and is written out as it came.
        text = client.request("GET", path + "?" + "&".join(query))
        if not isinstance(text, str):
            text = json.dumps(text, indent=2, sort_keys=True)
        if arguments.csv == "-":
            sys.stdout.write(text)
        else:
            with io.open(arguments.csv, "w", encoding="utf-8", newline="") as handle:
                handle.write(text)
            print("%s written to %s." % (arguments.section, arguments.csv))
        return EXIT_OK

    answer = client.request("GET", path + "?" + "&".join(query))
    if arguments.json:
        render(answer, True)
        return EXIT_OK

    if arguments.section == "summary":
        for name in sorted((answer.get("sections") or {}).keys()):
            part = answer["sections"][name]
            print("")
            print("== %s" % name)
            render(part.get("rows") or [], False, part.get("columns"))
        for skipped in answer.get("omitted") or []:
            print("")
            print("== %s: not shown - %s" % (skipped.get("section"), skipped.get("reason")))
        return EXIT_OK

    # The note is the honest half of a report: "the message trace is switched
    # off" is not the same statement as an empty table, and a client that
    # printed only the table would be hiding it.
    if answer.get("note"):
        print(answer["note"])
        print("")
    render(answer.get("rows") or [], False, answer.get("columns"))
    if answer.get("truncated"):
        print("")
        print("This answer was truncated: the window holds more rows than one report reads.")
    return EXIT_OK


def bounces_command(client, arguments):
    """How the server would read a bounce, and the suppression list's sweep.

    classify asks the server rather than holding a copy of the table here: the
    trust rule - a code the remote did not send itself is never a dead mailbox -
    is the part that matters, and a second implementation of it would drift from
    the one that decides.
    """
    if arguments.verb == "classify":
        body = {"status": arguments.status, "diagnostic": arguments.diagnostic or ""}
        answer = client.request("POST", "/api/v1/bounces/classify", body=body)
        if arguments.json:
            render(answer, True)
            return EXIT_OK
        print("%s: %s%s" % (answer.get("status") or arguments.status, answer.get("category"),
                            " - counts towards the suppression list" if answer.get("suppresses") else ""))
        if not answer.get("trusted"):
            print("(not trusted: the code was not the remote's own, so it is read by its words and never as a dead mailbox)")
        return EXIT_OK

    if arguments.verb == "expire":
        answer = client.request("POST", "/api/v1/bounces/expire")
        if arguments.json:
            render(answer, True)
            return EXIT_OK
        print("%d expired entr%s, %d old count%s and %d old report key%s removed."
              % (answer.get("suppressions_expired", 0), "y" if answer.get("suppressions_expired", 0) == 1 else "ies",
                 answer.get("counts_pruned", 0), "" if answer.get("counts_pruned", 0) == 1 else "s",
                 answer.get("report_keys_pruned", 0), "" if answer.get("report_keys_pruned", 0) == 1 else "s"))
        return EXIT_OK

    raise ApiError(0, "bounces takes classify or expire")


def openpgp_command(client, arguments):
    """The OpenPGP public keys this server publishes, and the Web Key Directory.

    A domain's listing shows the keys that are NOT being served beside the ones
    that are, which is the question this is usually run to answer. Only public
    keys are ever stored: a secret key is refused by the server with a sentence
    saying so, whether it arrives here, over COM or from the webmail.
    """
    if arguments.verb == "list":
        answer = client.request("GET", "/api/v1/domains/%s/openpgp" % arguments.domain) or {}
        if arguments.json:
            render(answer, True)
            return EXIT_OK
        if not answer.get("server_enabled"):
            print("The Web Key Directory is off at the server (settings openpgp web_key_directory_enabled).")
        elif not answer.get("domain_enabled"):
            print("%s does not publish keys (domain openpgp_publish)." % arguments.domain)
        render(collection(answer, "keys"), False,
               ["address", "fingerprint", "algorithm_name", "bits", "user_id", "published"])
        return EXIT_OK

    if arguments.verb == "show":
        render(client.request("GET", "/api/v1/accounts/%s/openpgp" % arguments.account), arguments.json)
        return EXIT_OK

    if arguments.verb == "store":
        # From a file, because a key is thousands of characters and a command
        # line is not where it belongs. "-" is standard input, so a key can be
        # piped straight out of gpg --armor --export.
        if arguments.file == "-":
            text = sys.stdin.read()
        else:
            with open(arguments.file, "r", encoding="utf-8", errors="replace") as handle:
                text = handle.read()
        if not text.strip():
            raise ApiError(0, "%s holds no key" % arguments.file)
        body = {"key": text}
        if arguments.allow_address_mismatch:
            body["allow_address_mismatch"] = True
        if arguments.publish:
            body["publish"] = True
        answer = client.request("PUT", "/api/v1/accounts/%s/openpgp" % arguments.account, body=body) or {}
        if arguments.json:
            render(answer, True)
        else:
            print("stored %s for %s%s" % (answer.get("fingerprint", ""), arguments.account,
                                          "; published" if arguments.publish else ""))
            if answer.get("advanced_url"):
                print(answer["advanced_url"])
        return EXIT_OK

    if arguments.verb == "remove":
        client.request("DELETE", "/api/v1/accounts/%s/openpgp/%s" % (arguments.account, arguments.fingerprint))
        print("removed %s from %s" % (arguments.fingerprint, arguments.account))
        return EXIT_OK

    if arguments.verb == "publish":
        body = {"openpgp_publish": arguments.state == "on"}
        answer = client.request("PUT", "/api/v1/accounts/%s" % arguments.account, body=body) or {}
        render(answer if arguments.json else {"address": arguments.account, "openpgp_publish": body["openpgp_publish"]},
               arguments.json)
        return EXIT_OK

    raise ApiError(0, "unknown openpgp verb")



def webhooks_command(client, arguments):
    """The two things an administrator does to a webhook that are not editing it:
    raise one event to see whether it arrives, and make the delivery pass happen
    now rather than within the minute.

    deliveries is here rather than as a resource verb because the queue is not a
    collection anybody edits - it is what the subscriptions have produced, and it
    is read with a filter or not at all.
    """
    if arguments.verb == "deliveries":
        query = []
        if arguments.webhook:
            query.append("webhook=" + urllib.parse.quote(arguments.webhook))
        if arguments.state:
            query.append("state=" + urllib.parse.quote(arguments.state))
        query.append("limit=%d" % arguments.limit)
        answer = client.request("GET", "/api/v1/webhooks/deliveries?" + "&".join(query))
        deliveries = answer.get("deliveries", []) if isinstance(answer, dict) else answer
        if arguments.json:
            render(answer, True)
            return EXIT_OK
        if not deliveries:
            print("Nothing has been queued.")
            return EXIT_OK
        render(deliveries, False, ["id", "webhook", "event", "state", "attempts", "error"])
        return EXIT_OK

    if arguments.verb == "run":
        answer = client.request("POST", "/api/v1/webhooks/run", body={})
        if arguments.json:
            render(answer, True)
            return EXIT_OK
        print("%d delivered, %d removed." % (answer.get("delivered", 0), answer.get("removed", 0)))
        return EXIT_OK

    if arguments.verb == "test":
        body = {}
        if arguments.event:
            body["event"] = arguments.event
        if arguments.domain:
            body["domain"] = arguments.domain
        if arguments.account:
            body["account"] = arguments.account
        answer = client.request("POST", "/api/v1/webhooks/test", body=body)
        if arguments.json:
            render(answer, True)
            return EXIT_OK
        queued = answer.get("queued", 0)
        print("Queued for %d subscription%s." % (queued, "" if queued == 1 else "s"))
        if not queued:
            print("(nothing subscribes to that event, the domain has webhooks off, "
                  "or every match is at its rate ceiling)")
        return EXIT_OK

    raise ApiError(0, "webhooks takes deliveries, run or test")


def complaints_command(client, arguments):
    """Every domain's complaint rate, and the feedback loops' sweep.

    The rate is asked of the server rather than worked out here from the
    listing: the window, the floor below which a rate is not judged, and the
    denominator are the server's, and a second implementation of them would
    drift from the one the alert fires on.
    """
    if arguments.verb == "rates":
        answer = client.request("GET", "/api/v1/complaints/rates")
        if arguments.json:
            render(answer, True)
            return EXIT_OK
        if not answer.get("processing_enabled"):
            print("Complaints are not being read; the rates below are whatever was recorded before.")
        rows = collection(answer, "domains")
        for row in rows:
            if row.get("judged"):
                print("%-40s %8d complaint(s) in %9d message(s)  %6d in a million"
                      % (row.get("domain"), row.get("complaints", 0), row.get("sent", 0), row.get("rate_ppm", 0)))
            else:
                print("%-40s %8d complaint(s) in %9d message(s)  (too little sent to judge)"
                      % (row.get("domain"), row.get("complaints", 0), row.get("sent", 0)))
        if not rows:
            print("No domain has sent or been complained about in the last %d days." % answer.get("window_days", 7))
        return EXIT_OK

    if arguments.verb == "expire":
        answer = client.request("POST", "/api/v1/complaints/expire")
        if arguments.json:
            render(answer, True)
            return EXIT_OK
        pruned = answer.get("complaints_pruned", 0)
        print("%d old complaint%s and tally row%s removed." % (pruned, "" if pruned == 1 else "s", "" if pruned == 1 else "s"))
        return EXIT_OK

    raise ApiError(0, "complaints takes rates or expire")


def dmarc_command(client, arguments):
    """The reports a domain receives, read: who sends as the domain and with
    what result, from the DMARC aggregate reports and the TLS-RPT reports the
    receivers of its mail posted to its report mailbox. The sums are the
    server's - a DMARC pass is an aligned DKIM or an aligned SPF, judged there
    once - and this only prints them.
    """
    if arguments.verb == "expire":
        if arguments.older_than_days is None:
            answer = client.request("POST", "/api/v1/domain-reports/expire")
        else:
            answer = client.request("POST", "/api/v1/domain-reports/expire", body={"older_than_days": arguments.older_than_days})
        if arguments.json:
            render(answer, True)
            return EXIT_OK
        if answer.get("kept_for_ever"):
            print("Nothing removed: domain_report_retention_days is 0, so the reports are kept for ever.")
        else:
            print("%d DMARC report(s) and %d TLS-RPT report(s) read more than %d days ago removed."
                  % (answer.get("dmarc_reports_pruned", 0), answer.get("tls_reports_pruned", 0), answer.get("older_than_days", 0)))
            if not answer.get("complete", True):
                print("More remain: the sweep stopped after its hundred passes of 5,000. Run it again to remove the rest.")
        return EXIT_OK

    base = "/api/v1/domains/%s" % urllib.parse.quote(arguments.domain, safe="")

    if arguments.verb == "summary":
        answer = client.request("GET", base + "/dmarc-reports/summary", query={"days": arguments.days})
        if arguments.json:
            render(answer, True)
            return EXIT_OK
        if not answer.get("mailbox_configured"):
            print("No report mailbox is named for %s, so no report is read: set report_mailbox on the domain and publish it as rua=."
                  % answer.get("domain", arguments.domain))
        print("%s over %d days: %d report(s) from %d reporter(s); %d message(s), %d passed DMARC, %d failed; "
              "%d quarantined, %d rejected by the receivers."
              % (answer.get("domain", arguments.domain), answer.get("days", arguments.days), answer.get("reports", 0),
                 len(collection(answer, "reporters") or []), answer.get("messages", 0), answer.get("passed", 0),
                 answer.get("failed", 0), answer.get("quarantined", 0), answer.get("rejected", 0)))
        sources = collection(answer, "sources")
        if sources:
            print_table(sources, ["ip", "header_from", "messages", "passed", "failed", "dkim_passed", "spf_passed",
                                  "quarantined", "rejected", "reporters"])
        else:
            print("No source has been reported in this window.")
        return EXIT_OK

    if arguments.verb == "reports":
        answer = client.request("GET", base + "/dmarc-reports", query={"limit": arguments.limit, "offset": arguments.offset})
        if arguments.json:
            render(answer, True)
            return EXIT_OK
        render(collection(answer, "items"), False,
               ["id", "org", "report_id", "begin", "end", "p", "sp", "pct", "messages", "passed", "records", "received",
                "message_from", "message_dmarc"])
        return EXIT_OK

    if arguments.verb == "report":
        answer = client.request("GET", base + "/dmarc-reports/%d" % arguments.id)
        if arguments.json:
            render(answer, True)
            return EXIT_OK
        print("Report %s from %s (%s), %s to %s, read %s: p=%s sp=%s adkim=%s aspf=%s pct=%s; %s message(s), %s passed DMARC."
              % (answer.get("report_id"), answer.get("org"), answer.get("email"), answer.get("begin"), answer.get("end"),
                 answer.get("received"), answer.get("p"), answer.get("sp"), answer.get("adkim"), answer.get("aspf"),
                 answer.get("pct"), answer.get("messages"), answer.get("passed")))
        render(collection(answer, "records"), False,
               ["source_ip", "count", "disposition", "dkim", "spf", "header_from", "envelope_from", "dkim_auth", "spf_auth"])
        return EXIT_OK

    if arguments.verb == "tls":
        answer = client.request("GET", base + "/tls-reports",
                                query={"days": arguments.days, "limit": arguments.limit, "offset": arguments.offset})
        if arguments.json:
            render(answer, True)
            return EXIT_OK
        print("%s over %d days: %d session(s) succeeded and %d failed, by what the senders that keep TLS-RPT reported."
              % (answer.get("domain", arguments.domain), answer.get("days", arguments.days),
                 answer.get("sessions_succeeded", 0), answer.get("sessions_failed", 0)))
        render(collection(answer, "items"), False,
               ["id", "org", "policy_type", "begin", "end", "successful", "failed", "received"])
        return EXIT_OK

    raise ApiError(0, "dmarc takes summary, reports, report, tls or expire")


def api_command(client, arguments):
    body = None
    if arguments.body:
        body = json.loads(sys.stdin.read()) if arguments.body == "-" else json.loads(arguments.body)
    answer = client.request(arguments.method.upper(), arguments.path, body=body)
    render(answer, True if arguments.json else False)
    return EXIT_OK


