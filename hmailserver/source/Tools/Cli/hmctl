def device_command(client, arguments):
    """The clients that have signed in to an account, and the one call that ends
    what one of them holds. The list is the account holder's own (GET
    /api/v1/me/devices) read under the account's address by an administrator;
    revoking ends the client's browser session and drops its live IMAP, POP3 and
    SMTP connections, and with --credential deactivates the app password it
    signed in with, which is what stops a stolen phone signing in again."""
    base = "/api/v1/accounts/%s/devices" % urllib.parse.quote(arguments.address, safe="@")
    if arguments.verb == "list":
        render(collection(client.request("GET", base), "devices"), arguments.json,
               ["id", "protocol", "address", "agent", "credential", "credential_name", "last_seen", "sign_ins", "revoked"])
    elif arguments.verb == "revoke":
        query = []
        if getattr(arguments, "credential", False):
            query.append("credential=revoke")
        if getattr(arguments, "forget", False):
            query.append("forget=true")
        path = "%s/%s" % (base, arguments.id)
        if query:
            path += "?" + "&".join(query)
        answer = client.request("DELETE", path)
        render(answer, arguments.json)
        if not arguments.json and isinstance(answer, dict):
            print("%s session(s) ended, %s connection(s) dropped%s." % (
                answer.get("sessions_ended", 0), answer.get("connections_dropped", 0),
                ", the app password it used turned off" if answer.get("credential_disabled") else ""))
    return EXIT_OK


