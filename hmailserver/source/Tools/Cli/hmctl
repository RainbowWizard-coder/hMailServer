def print_reputation(answer):
    """The report as a table - one row per address and list - then the reasons, then
    what was deliberately not looked up, then when the last check was.

    The status column carries the word the API sends rather than a yes or a no,
    because "refused", "lookup_failed" and "list_not_answering" are not "not_listed",
    and a client that folded them together would report as clean a server no list has
    answered about.
    """

    rows = []
    for address in answer.get("addresses") or []:
        for result in address.get("results") or []:
            rows.append({
                "address": address.get("address", ""),
                "list": result.get("list", ""),
                "status": result.get("status", ""),
                "answer": result.get("code", ""),
                "listed since": when(result.get("listed_since")),
                "checked": when(result.get("checked")),
            })

    if rows:
        print_table(rows, ["address", "list", "status", "answer", "listed since", "checked"])
    else:
        print("(no outbound address is configured, so nothing is checked)")

    # A list's reason is a sentence, so it goes under the table rather than into a
    # column of it. A list that simply says no has nothing to explain.
    for address in answer.get("addresses") or []:
        for result in address.get("results") or []:
            if result.get("reason") and result.get("status") != "not_listed":
                print("")
                print("%s on %s: %s" % (address.get("address", ""), result.get("list", ""), result["reason"]))

    for skipped in answer.get("skipped") or []:
        print("")
        print("not looked up: %s (%s) %s" % (skipped.get("address", ""), skipped.get("source", ""),
                                             skipped.get("detail") or skipped.get("reason", "")))

    if answer.get("lists_problem"):
        print("")
        print("the lists: %s" % answer["lists_problem"])

    # The one fact that explains every other line when it is false. Without it a
    # table of "not_checked" reads as a server that is behind on its checks rather
    # than one that was never asked to make any.
    if not answer.get("enabled"):
        print("")
        print("the watch is off: nothing is checked and nothing will be, until")
        print("reputation_watch_enabled is turned on (hmctl settings set --set")
        print("reputation_watch_enabled=true, or the Deck's Settings page). An")
        print("upgraded server starts with it off.")

    print("")
    print("last checked: %s" % (when(answer.get("last_checked")) or "never"))

    run = answer.get("run")
    if isinstance(run, dict):
        print("this check: %s address(es), %s list(s), %s lookup(s)"
              % (run.get("addresses", 0), run.get("lists", 0), run.get("lookups", 0)))


def reputation_command(client, arguments):
    if arguments.verb == "check":
        answer = client.request("POST", "/api/v1/reputation/check", body={}) or {}
    else:
        answer = client.request("GET", "/api/v1/reputation") or {}

    if arguments.json:
        render(answer, True)
    else:
        print_reputation(answer)

    # Exit 1 when an address is listed, when a list could not be asked, and when a
    # pair has never been checked at all: a check nobody answered is not a clean
    # one, and neither is a check nobody has made. A monitoring job reads the exit
    # code rather than the table, so the code has to carry all three.
    #
    # not_checked is reachable for up to a day in ordinary use: an address added to
    # reputation_watch_addresses, or a zone added to reputation_watch_lists, has no
    # stored row until the next daily check, and the daily check is not brought
    # forward by the addition.
    #
    # With the watch OFF, not_checked is not a fault at all - it is every pair,
    # for ever, because nothing is being checked. An upgrade leaves the watch off
    # with the lists seeded, so a server with a delivery bind address would alarm
    # at every invocation with nothing in the table to explain it. A listing or an
    # unanswered list still exits 1 with the watch off, because those are answers
    # an earlier check got and they do not stop being true.
    counts = answer.get("counts") or {}
    if counts.get("listed") or counts.get("unknown"):
        return EXIT_ERROR

    if counts.get("not_checked") and answer.get("enabled"):
        return EXIT_ERROR

    return EXIT_OK


def profiles_command(client, arguments):
    """The setting profiles (docs/Profiles.md): the four, one's diff against this
    server, applying one - with --confirm TOKEN where an entry closes a listener,
    trusts an address range, turns a filter or a check off, or shortens how long
    data is kept, TOKEN being the diff's own, which ties the confirmation to the
    diff that was read - the way back, and keeping the shipped settings. The
    server decides everything; this prints what it said."""
    if arguments.verb == "profiles":
        answer = client.request("GET", "/api/v1/settings/profiles") or {}
        if arguments.json:
            render(answer, True)
            return EXIT_OK
        render(answer.get("profiles", []), False, ["name", "title", "entries", "changes", "confirmations", "skipped"])
        applied = answer.get("applied")
        if isinstance(applied, dict):
            print("")
            if applied.get("state") == "declined":
                print("the settings this version ships with were chosen; no profile is applied")
            else:
                print("last applied: %s (%s)" % (applied.get("profile"), applied.get("state")))
        snapshot = answer.get("snapshot")
        if isinstance(snapshot, dict) and snapshot.get("profile"):
            print("the way back from %s is held: hmctl settings revert-profile puts it back" % snapshot.get("profile"))
        elif isinstance(snapshot, dict):
            print("a way back is held and cannot be read: hmctl settings discard-profile discards it")
        return EXIT_OK

    if arguments.verb == "profile":
        answer = client.request("GET", "/api/v1/settings/profiles/%s" % urllib.parse.quote(arguments.name, safe="")) or {}
        if arguments.json:
            render(answer, True)
            return EXIT_OK
        print("%s - %s" % (answer.get("name"), answer.get("title")))
        rows = []
        for entry in answer.get("entries", []):
            note = []
            if entry.get("confirm"):
                note.append("asks for --confirm: " + str(entry.get("caution", "")).replace("_", " "))
            if entry.get("note"):
                note.append(entry.get("note"))
            if entry.get("environment"):
                note.append("set by the environment (%s)" % entry.get("environment"))
            if entry.get("refused"):
                note.append("refused: " + entry.get("refused"))
            rows.append({"store": entry.get("store"), "name": entry.get("name"), "now": entry.get("current"),
                         "profile": entry.get("value"), "changes": entry.get("changes"), "note": "; ".join(note)})
        render(rows, False, ["store", "name", "now", "profile", "changes", "note"])
        print("")
        print("%s would change, %s unchanged, %s skipped, %s refused" % (
            answer.get("changes"), answer.get("unchanged"), answer.get("skipped"), answer.get("refused")))
        if answer.get("blocked"):
            print(answer.get("blocked"))
        if answer.get("diff_token"):
            print("diff token: %s" % answer.get("diff_token"))
            if answer.get("confirmation_needed"):
                print("to apply it with the confirmation: hmctl settings apply-profile %s --confirm %s" % (answer.get("name"), answer.get("diff_token")))
        return EXIT_OK

    if arguments.verb == "apply-profile":
        # --confirm takes the diff's token, which hmctl settings profile NAME prints:
        # the confirmation is of that diff, and the server refuses it when the
        # settings moved since. --token ties an apply that needs no confirmation to
        # the diff the same way.
        body = {}
        if arguments.confirm:
            body = {"confirm": True, "diff_token": arguments.confirm}
        elif arguments.token:
            body = {"diff_token": arguments.token}
        try:
            answer = client.request("POST", "/api/v1/settings/profiles/%s/apply" % urllib.parse.quote(arguments.name, safe=""), body=body) or {}
        except ApiError as refused:
            detail = refused.body if isinstance(refused.body, dict) else {}
            if refused.status == 409 and detail.get("confirmation"):
                names = ", ".join(str(e.get("name")) for e in detail.get("confirmation_needed", []))
                raise ApiError(409, "%s Entries: %s. Read the diff with hmctl settings profile %s and run it again with --confirm and the diff's token." % (refused.message, names, arguments.name), refused.body)
            if refused.status == 409 and detail.get("stale"):
                raise ApiError(409, "%s Read it again with hmctl settings profile %s." % (refused.message, arguments.name), refused.body)
            raise
        if arguments.json:
            render(answer, True)
        else:
            print(answer.get("message", ""))
        return EXIT_OK if not answer.get("failed") else EXIT_ERROR

    if arguments.verb == "revert-profile":
        answer = client.request("POST", "/api/v1/settings/profiles/revert", body={}) or {}
        if arguments.json:
            render(answer, True)
        else:
            print(answer.get("message", ""))
            for entry in answer.get("entries", []):
                if entry.get("result") != "restored":
                    print("  %s: %s - %s" % (entry.get("name"), entry.get("result"), entry.get("reason") or ""))
        return EXIT_OK if not answer.get("failed") else EXIT_ERROR

    if arguments.verb == "decline-profile":
        answer = client.request("POST", "/api/v1/settings/profiles/decline", body={}) or {}
        render(answer, True) if arguments.json else print(answer.get("message", ""))
        return EXIT_OK

    answer = client.request("POST", "/api/v1/settings/profiles/discard", body={}) or {}
    render(answer, True) if arguments.json else print(answer.get("message", ""))
    return EXIT_OK


