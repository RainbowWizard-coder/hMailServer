def backup_command(client, arguments):
    if arguments.verb == "start":
        render(client.request("POST", "/api/v1/backup", body={}), arguments.json)
    elif arguments.verb == "restore":
        return backup_restore_command(client, arguments)
    elif arguments.verb == "passphrase":
        return backup_passphrase_command(client, arguments)
    elif arguments.verb == "archives":
        return backup_archives_command(client, arguments)
    elif arguments.verb == "mailbox":
        return backup_mailbox_command(client, arguments)
