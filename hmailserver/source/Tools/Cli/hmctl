    path = mailbox_route(arguments.archive, arguments.address)
    if arguments.folder:
        path += "?folder=" + urllib.parse.quote(arguments.folder, safe="")
    answer = client.request("GET", path, headers=headers) or {}
    if arguments.json:
        render(answer, True)
        return EXIT_OK
    print("%s in %s: %s message(s) in %s folder(s)%s" % (
        answer.get("address", arguments.address), answer.get("archive", arguments.archive), answer.get("messages", 0),
        len(answer.get("folders") or []), "" if answer.get("subjects") else "; " + (answer.get("subjects_note") or "subjects not read")))
    for folder in answer.get("folders") or []:
        print("  %s (%d)" % (folder.get("path", ""), len(folder.get("messages") or [])))
        for message in folder.get("messages") or []:
            print("    %-8s %s  %s  %s  %s byte(s)" % (message.get("id", ""), message.get("date", ""), message.get("from", ""),
                                                        message.get("subject", ""), message.get("size", 0)))
    return EXIT_OK


def backup_restore_mailbox_command(client, arguments):
    if arguments.merge and arguments.replace:
        raise ApiError(0, "choose one of --merge and --replace")
    if arguments.folder and not arguments.message:
        raise ApiError(0, "--folder names where one message goes; give --message ID with it")
    if arguments.message and (arguments.merge or arguments.replace):
        raise ApiError(0, "a mode does not apply to a single message: --message puts that one message back as merge "
                          "of it; leave --merge and --replace out")

    body = {}
    if arguments.message:
        body["message"] = arguments.message
        if arguments.folder:
            body["folder"] = arguments.folder
    else:
        body["mode"] = "replace" if arguments.replace else "merge"

    passphrase = read_backup_passphrase(arguments)
    if passphrase is not None:
        body["passphrase"] = passphrase

    answer = client.request("POST", mailbox_route(arguments.archive, arguments.address, "/restore"), body=body) or {}

    if arguments.json:
        render(answer, True)
        return EXIT_OK

    if arguments.message:
        print("restore of message %s of %s from %s started as job %s%s." % (
            arguments.message, arguments.address, arguments.archive, answer.get("job"),
            " into " + arguments.folder if arguments.folder else ""))
    else:
        print("%s of the mailbox of %s from %s started as job %s." % (
            "replace" if arguments.replace else "merge", arguments.address, arguments.archive, answer.get("job")))
    print("It runs in the server; `hmctl backup restore-status %s` says how it went." % answer.get("job"))
    return EXIT_OK


