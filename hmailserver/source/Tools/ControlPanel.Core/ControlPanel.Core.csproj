<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>hMailCP.Core</AssemblyName>
    <RootNamespace>hMailServer.ControlPanel</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The translation lookup. Pure: the English text is the key, the catalogue is
         injected, and the navigation map below marks its titles with Loc.N. It puts
         the fatal-exception filter on its one catch clause, so that filter is here
         too (and only here: the test project reaches it through this reference). -->
    <Compile Include="..\ControlPanel\Services\Loc.cs" />
    <Compile Include="..\ControlPanel\Services\ExceptionPolicy.cs" />
    <Compile Include="..\ControlPanel\Services\PasswordStrength.cs" />
    <Compile Include="..\ControlPanel\Services\NumericField.cs" />
    <Compile Include="..\ControlPanel\Services\PasswordGenerator.cs" />
    <!-- Parser for the server's message-store consistency report. No WPF, so the
         tests can pin the format the server actually writes. -->
    <Compile Include="..\ControlPanel\Services\MessageStoreConsistencyReport.cs" />
    <!-- The suppression list's two JSON documents, read into rows. No WPF, so the
         tests can pin the shape BounceTracker writes. -->
    <Compile Include="..\ControlPanel\Services\SuppressionListReport.cs" />
    <!-- The never-ban list by reverse name's two documents, read into rows and a
         verdict, and the sentence the Auto-ban page says about a verdict. No WPF,
         so the tests can pin the shape NeverBanNameList writes. -->
    <Compile Include="..\ControlPanel\Services\NeverBanNames.cs" />
    <!-- The Quarantine page's grouping, folding, sorting and three-state checks,
         and the Quarantine.Bulk request and answer. No WPF, so the tests hold
         what the page shows and what it sends without a window. -->
    <Compile Include="..\ControlPanel\Services\QuarantineReview.cs" />
    <!-- How long ago something was, in catalogued words: the quarantine's held
         times and the message-store consistency card's scan. -->
    <Compile Include="..\ControlPanel\Services\AgeWords.cs" />
    <!-- What the server-enforced second factor's code box takes, typed or pasted,
         and the code it checks: digits alone. -->
    <Compile Include="..\ControlPanel\Services\VerificationCode.cs" />
    <!-- How much time a chart covers, in words: one of a unit is a sentence of its
         own. No WPF, so the tests hold every count's words. -->
    <Compile Include="..\ControlPanel\Services\ChartWindowWords.cs" />
    <!-- The Discovery page's reading of the REST API: the cases, a case's rows of
         the audit trail (so the audit trail's own reader is here with it), and
         where the listener is. No WPF and no network, so the tests can pin the
         shape RestApiDiscovery writes and the listener's own address rules. -->
    <Compile Include="..\ControlPanel\Services\AuditTrailReport.cs" />
    <Compile Include="..\ControlPanel\Services\DiscoveryReport.cs" />
    <!-- The settings pages' reading of the REST API's settings groups, for the
         settings with no COM property: where the listener is, one group's answer
         and the body of a save. No WPF and no network, so the tests can pin the
         shape RestApiSettings.cpp answers and takes. -->
    <Compile Include="..\ControlPanel\Services\RestSettings.cs" />
    <!-- Settings search index: plain data plus a search function, no WPF, so the
         tests can verify it still matches the settings pages. -->
    <Compile Include="..\ControlPanel\Services\SettingsSearchIndex.cs" />
    <Compile Include="..\ControlPanel\Services\SettingsSearchIndex.g.cs" />
    <!-- Navigation and command palette. The information architecture, the outcome
         phrases and the ranking are all plain data plus pure functions, kept out
         of MainWindow and the palette window precisely so that the structure can
         be tested: every registered page must have exactly one home, no page title
         may change under the documentation, and every outcome phrase must actually
         reach its page. -->
    <Compile Include="..\ControlPanel\Services\SearchTerms.cs" />
    <Compile Include="..\ControlPanel\Services\NavigationMap.cs" />
    <!-- Help where the question is: every page's document and heading, and the
         markdown reading the pane draws from. Both are plain data and pure
         functions - the WPF half is Views/HelpPane.cs and MarkdownFlow.cs - so
         a test can hold the map to the navigation and the parser to a document. -->
    <Compile Include="..\ControlPanel\Services\HelpMap.cs" />
    <Compile Include="..\ControlPanel\Services\MarkdownBlocks.cs" />
    <!-- The program's embedded copy of the documentation, read from the assembly
         HelpPages was compiled into; with the resource group below, this assembly
         carries the same copy the program does, so HelpMapTests can hold it to the
         directory - the names, the two exclusions, the bytes. -->
    <Compile Include="..\ControlPanel\Services\HelpPages.cs" />
    <Compile Include="..\ControlPanel\Services\WelcomeIntents.cs" />
    <Compile Include="..\ControlPanel\Services\IntentIndex.cs" />
    <Compile Include="..\ControlPanel\Services\PaletteUsage.cs" />
    <Compile Include="..\ControlPanel\Services\PaletteSearch.cs" />
    <!-- The tours: the steps themselves, the stepper that decides which one is
         showing, and the record of what this administrator has finished. All
         three are plain data and pure functions - the WPF half is the ring and
         the card, which is in Views/Scaffold/TourOverlay.cs and is not here -
         so a test can hold every step to a page that exists, prove that a step
         whose control is missing is skipped rather than hung on, and prove that
         an abandoned tour is never recorded as finished. PaletteSearch offers
         the tours as rows, which is why they are in this project and not only
         in the application. -->
    <!-- One value, three levels: the settings a domain or an account may hold its
         own value of, and the words for what is in effect and where it came from.
         Plain data, held to the server's table by build/check-setting-levels.py. -->
    <Compile Include="..\ControlPanel\Services\SettingLevels.cs" />
    <Compile Include="..\ControlPanel\Services\Tour.cs" />
    <Compile Include="..\ControlPanel\Services\TourSession.cs" />
    <Compile Include="..\ControlPanel\Services\TourProgress.cs" />
    <!-- Whether a page with unsaved changes may be left, the words that ask, and
         the record of what a page's editors held when they were last read or
         saved: the half of the question every way of leaving a page asks that
         needs no window. -->
    <Compile Include="..\ControlPanel\Services\UnsavedChanges.cs" />
    <!-- What the administrator password dialog asks of the three boxes before it
         asks the server, and the sentences it says. -->
    <Compile Include="..\ControlPanel\Services\AdministratorPasswordChange.cs" />
    <!-- When a save of a new password pepper asks first, and the words. -->
    <Compile Include="..\ControlPanel\Services\PepperChange.cs" />
    <!-- Which roles hand out the whole server, asked about before one is given. -->
    <Compile Include="..\ControlPanel\Services\RoleGrant.cs" />
    <!-- The questions asked before something is deleted, removed, replaced,
         released or sent, and which answer Enter gives. -->
    <Compile Include="..\ControlPanel\Services\Confirmations.cs" />
    <!-- Which accounts a server sendout reaches, matched as the server matches them. -->
    <Compile Include="..\ControlPanel\Services\SendoutAudience.cs" />
    <!-- The order the generated Add and Edit dialog lays its fields out in, and the
         words for a required field left empty. -->
    <Compile Include="..\ControlPanel\Services\FieldDialogRules.cs" />
    <!-- The keys the window answers on every page, the order F6 moves through
         the window's parts in, and the list the palette's Keyboard shortcuts row
         shows: one table, held by KeyboardShortcutsTests. -->
    <Compile Include="..\ControlPanel\Services\KeyboardShortcuts.cs" />
    <!-- What a screen reader says for a list's row: its cells, a bare value with
         its column's name. Held by RowSpeechTests. -->
    <Compile Include="..\ControlPanel\Services\RowSpeech.cs" />
    <!-- What a list page says after an Add, an Edit or a Delete, naming the
         entry, and which row it keeps in view (review finding F208). -->
    <Compile Include="..\ControlPanel\Services\ListOutcome.cs" />
  </ItemGroup>

  <!-- What the forms ask of their fields before they save, and what they ask
       first (T2.4, part 2): a rule's criterion - its header name, its value, and
       the comparisons a number offers (review finding F227); and the question before
       directory authentication is saved switched on with what it needs missing (F130);
       and the range an hMailServer.ini page holds a number to, and the address it
       holds the DNS override to (F220). -->
  <ItemGroup>
    <Compile Include="..\ControlPanel\Services\RuleCriterionInput.cs" />
    <Compile Include="..\ControlPanel\Services\LdapIncompleteSave.cs" />
    <Compile Include="..\ControlPanel\Services\SettingNumberRange.cs" />
  </ItemGroup>

  <!-- The operator documentation, embedded straight from the repository as
       Help.<Name>.md, exactly as ControlPanel.csproj embeds it for the program:
       the same glob, the same two exclusions, the same names. The program does
       not reference this assembly (it compiles Services/*.cs itself), so the
       group is in both; this one is what the tests read through HelpPages. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\docs\*.md" Exclude="..\..\..\docs\README.md;..\..\..\docs\DeckParity.md" LogicalName="Help.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
