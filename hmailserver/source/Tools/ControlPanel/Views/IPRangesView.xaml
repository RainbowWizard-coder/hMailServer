<UserControl
    x:Class="hMailServer.ControlPanel.Views.IPRangesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:hMailServer.ControlPanel.Services"
    xmlns:scaffold="clr-namespace:hMailServer.ControlPanel.Views.Scaffold"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="{StaticResource AppPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <scaffold:PageHeader PageKey="ipranges"
                             Subtitle="{loc:L 'Access control: which addresses may connect and what they are allowed to do. Higher priority wins.'}">
            <!-- The list page pattern (docs/ControlPanelDesign.md, List pages): the
                 count beside the title and Refresh in the header, the list's own
                 verbs in the toolbar above it (review finding F288). -->
            <scaffold:PageHeader.Status>
                <scaffold:StatusPill x:Name="CountPill" Level="Normal" Visibility="Collapsed"
                                     AutomationProperties.AutomationId="list-count"
                                     AutomationProperties.LiveSetting="Polite" />
            </scaffold:PageHeader.Status>
            <scaffold:PageHeader.Actions>
                <ui:Button x:Name="RefreshButton" Content="{loc:L '_Refresh'}" Click="Refresh_Click" />
            </scaffold:PageHeader.Actions>
        </scaffold:PageHeader>

        <!-- The list takes the height the parts under it leave in the window,
             down to a floor of three rows, and below that the page scrolls;
             every other part keeps its own height. Work item 79: in 6.3.4 the
             list was a grid's star row between rows sized to their content, and
             a window shorter than those rows gave it nothing, so no range could
             be seen or selected; in 6.3.5 a fixed 560-pixel floor kept the list
             but cut the add form off in a narrow window, where the permissions
             wrap. FillPanel sizes the page from the parts themselves. -->
        <!-- The bar is drawn over the content, so the right padding (DesignTokens.Space.Md)
             keeps the cards, the notices and the toolbar's last button clear of it. -->
        <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,12,0">
        <scaffold:FillPanel ViewportHeight="{Binding ViewportHeight, ElementName=PageScroll}">

        <scaffold:Toolbar x:Name="SearchBar" SearchPlaceholder="{loc:L 'Search IP ranges'}"
                          SearchTextChanged="Search_TextChanged">
            <!-- The server's bans alone, the ranges it wrote and lifts itself
                 (Services/AutoBanList), among the permanent ranges the list holds
                 (review finding F231). -->
            <scaffold:Toolbar.Filters>
                <CheckBox x:Name="BansOnlyBox" Content="{loc:L '_Show auto-bans only'}" VerticalAlignment="Center"
                          Checked="BansOnly_Changed" Unchecked="BansOnly_Changed"
                          AutomationProperties.AutomationId="ipranges-bans-only" />
            </scaffold:Toolbar.Filters>
            <scaffold:Toolbar.Actions>
                <!-- Wraps, rather than cutting Delete and Restore defaults off the
                     right edge in a narrow window. The gap between wrapped lines
                     is split above and below each button, so that on one line
                     the buttons stay centred on the search box. -->
                <WrapPanel HorizontalAlignment="Right">
                    <ui:Button x:Name="PropertiesButton" Content="{loc:L 'Prop_erties…'}" Click="Edit_Click" Margin="0,2,8,2" />
                    <ui:Button x:Name="DeleteRangeButton" Content="{loc:L 'Delete selected ra_nge'}"
                               Style="{StaticResource DangerTextButton}" Click="Delete_Click" Margin="0,2,8,2" />
                    <ui:Button x:Name="RestoreDefaultsButton" Content="{loc:L 'Restore de_faults'}" Style="{StaticResource DangerTextButton}" Click="RestoreDefaults_Click" Margin="0,2,0,2"
                               ToolTip="{loc:L 'Replaces every range with the standard two: \'My computer\' (127.0.0.1) and \'Internet\' (everything else).'}" />
                </WrapPanel>
            </scaffold:Toolbar.Actions>
        </scaffold:Toolbar>

        <!-- A read that failed: Critical, with Try again, in place of the empty
             state, which would say there are no ranges (Services/ReadFailure). -->
        <scaffold:InlineNotice x:Name="Notice" Visibility="Collapsed" />

        <!-- The floor: the grid's three rows - the column headers, three
             34-pixel rows and the eight pixels a horizontal scroll bar draws over
             the last in a narrow window, 143 - held by the
             FillPanel around the grid, and the card floored at what it holds,
             so that the empty state laid over the grid, its sentence and its
             action, raises the card's floor where it needs more than the rows
             (review finding F207; at a fixed 157 the action was cut off in a
             short window). -->
        <scaffold:Card scaffold:FillPanel.Fill="True" Padding="{StaticResource AppListCardPadding}">
            <Grid>
                <scaffold:FillPanel>
                <DataGrid x:Name="RangeGrid" scaffold:FillPanel.Fill="True" MinHeight="143" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" SelectionChanged="RangeGrid_SelectionChanged"
                          AutomationProperties.Name="{loc:L 'IP ranges'}">
                    <DataGrid.Columns>
                        <!-- A floor under every column, so that a narrow window scrolls
                             the grid sideways rather than squeezing columns: the name,
                             the one column that says which range a row is, went to
                             nothing, and then the upper address was cut short. The
                             addresses and the three permissions are as wide as their
                             words, over floors of their widest, which the code-behind
                             measures at the Windows text size (FloorColumns_): fixed at
                             150 and 70 pixels, larger text cut them short. -->
                        <DataGridTextColumn Header="{loc:L 'Name'}" Binding="{Binding Name}" Width="*" MinWidth="160" ElementStyle="{StaticResource GridTrimmedText}" />
                        <DataGridTextColumn x:Name="LowerColumn" Header="{loc:L 'Lower IP'}" Binding="{Binding LowerIP}" Width="Auto" MinWidth="120" />
                        <DataGridTextColumn x:Name="UpperColumn" Header="{loc:L 'Upper IP'}" Binding="{Binding UpperIP}" Width="Auto" MinWidth="120" />
                        <DataGridTextColumn x:Name="PriorityColumn" Header="{loc:L 'Priority'}" Binding="{Binding Priority}" Width="80" MinWidth="64"
                                            ElementStyle="{StaticResource GridNumberText}" HeaderStyle="{StaticResource GridNumberHeader}" />
                        <DataGridTextColumn x:Name="SmtpColumn" Header="SMTP" Binding="{Binding Smtp}" Width="Auto" MinWidth="70" />
                        <DataGridTextColumn x:Name="ImapColumn" Header="IMAP" Binding="{Binding Imap}" Width="Auto" MinWidth="70" />
                        <DataGridTextColumn x:Name="Pop3Column" Header="POP3" Binding="{Binding Pop3}" Width="Auto" MinWidth="70" />
                        <!-- When a range ends - Never, or "23 min from now" for a ban - and
                             whether it relays, the open relay marked Critical as Server
                             status's check marks it (Services/IpRangeCells; review
                             finding F231): the bans looked like permanent ranges, and
                             relaying was on the card of the one range selected. -->
                        <DataGridTextColumn Header="{loc:L 'Expires'}" Binding="{Binding Expires}" Width="Auto" MinWidth="110" ElementStyle="{StaticResource GridTrimmedText}" />
                        <DataGridTemplateColumn Header="{loc:L 'Relay'}" Width="Auto" MinWidth="104" SortMemberPath="Relay">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock x:Name="RelayText" Text="{Binding Relay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="2,0,0,0" />
                                        <scaffold:StatusPill x:Name="RelayPill" Level="Critical" Text="{Binding Relay}" Visibility="Collapsed"
                                                             HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding OpenRelay}" Value="True">
                                            <Setter TargetName="RelayText" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="RelayPill" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                </scaffold:FillPanel>
                <!-- With no range, every connection is refused: the action puts
                     back the standard two, as Restore defaults above does. -->
                <scaffold:EmptyState x:Name="EmptyStatus" Icon="ShieldLock24" Visibility="Collapsed"
                                     AutomationProperties.LiveSetting="Polite">
                    <scaffold:EmptyState.Action>
                        <ui:Button x:Name="RestoreDefaultsAction" Content="{loc:L 'Restore the default ran_ges'}" Click="RestoreDefaults_Click"
                                   AutomationProperties.AutomationId="ipranges-restore-defaults-empty" />
                    </scaffold:EmptyState.Action>
                </scaffold:EmptyState>
            </Grid>
        </scaffold:Card>

        <!-- The selected range's permissions. The card's title names the range;
             Save is the card's own action, in its footer, with the pill that says
             where the card stands by the settings pages' model (SettingsPageStatus):
             none while the boxes hold what the range has, Unsaved changes from the
             first change, Saved after a save until the next. The pill is a polite
             live region, announced when a save settles it, since the card has no
             notice to say the save as the settings pages' notices do. With no range selected
             the boxes are clear and disabled, so that they never show the
             permissions of a range that is no longer the one selected. -->
        <scaffold:Card x:Name="PermCard" Title="{loc:L 'Permissions (select a range)'}" Margin="0,12,0,0">
            <!-- In the range dialog's words, and each delivery direction on one row with
                 what it asks of a sender: Allow, and Only after SMTP authentication,
                 where the card showed "Deliver remote → remote (relay)" apart from the
                 requirement, which only the dialog held - so that unticking relay on the
                 shipped Internet range stopped roaming users sending mail, and ticking
                 it on a range that asked for no authentication made an open relay,
                 with no word either way; and four names went for the TLS box (review
                 finding F229). The second box of a row counts only while the first is
                 ticked, and follows it. -->
            <StackPanel x:Name="PermGrid">
                <!-- A range just added may connect but send no mail: what to do next,
                     while the card shows it and until its permissions are saved
                     (review finding F230). -->
                <scaffold:InlineNotice x:Name="AddedNotice" Level="Information" Margin="0,0,0,12" Visibility="Collapsed"
                                       AutomationProperties.AutomationId="ip-range-added" />
                <UniformGrid x:Name="ConnectionsGrid" Columns="4" SizeChanged="ConnectionsGrid_SizeChanged">
                    <!-- A caption longer than its quarter of the card wraps under
                         itself. AccessText, not TextBlock, so the Alt key still works. -->
                    <UniformGrid.Resources>
                        <!-- At the top of their cells, so that a caption that wraps
                             leaves its box on the line of its row's others, where every
                             box of the row was centred against the tallest (F294). -->
                        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                            <Setter Property="VerticalAlignment" Value="Top" />
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <AccessText Text="{Binding}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </UniformGrid.Resources>
                    <CheckBox x:Name="PermSmtp" Content="{loc:L 'Allow SM_TP connections'}" Margin="0,0,12,8" />
                    <CheckBox x:Name="PermImap" Content="{loc:L 'Allow _IMAP connections'}" Margin="0,0,12,8" />
                    <CheckBox x:Name="PermPop3" Content="{loc:L 'Allow _POP3 connections'}" Margin="0,0,12,8" />
                    <CheckBox x:Name="PermTlsAuth" Content="{loc:L 'Require TLS _before authentication'}" Margin="0,0,12,8" />
                </UniformGrid>
                <Grid x:Name="DeliveryGrid" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{loc:L 'Allow delivery'}" Style="{StaticResource TextBodyStrong}" Margin="0,0,16,4" />
                    <TextBlock Grid.Column="1" Text="{loc:L 'Only after SMTP authentication'}" Style="{StaticResource TextBodyStrong}" Margin="0,0,0,4" TextWrapping="Wrap" />

                    <CheckBox x:Name="PermLL" Grid.Row="1" Content="{loc:L '_Local to local'}" Margin="0,4,16,4" />
                    <CheckBox x:Name="PermAuthLL" Grid.Row="1" Grid.Column="1" Margin="0,4,0,4" />
                    <CheckBox x:Name="PermLR" Grid.Row="2" Content="{loc:L 'Lo_cal to external'}" Margin="0,4,16,4" />
                    <CheckBox x:Name="PermAuthLR" Grid.Row="2" Grid.Column="1" Margin="0,4,0,4" />
                    <CheckBox x:Name="PermRL" Grid.Row="3" Content="{loc:L 'E_xternal to local'}" Margin="0,4,16,4" />
                    <CheckBox x:Name="PermAuthRL" Grid.Row="3" Grid.Column="1" Margin="0,4,0,4" />
                    <CheckBox x:Name="PermRR" Grid.Row="4" Content="{loc:L 'External to external (rela_y)'}" Margin="0,4,16,4" />
                    <CheckBox x:Name="PermAuthRR" Grid.Row="4" Grid.Column="1" Margin="0,4,0,4" />
                </Grid>

                <!-- A range that lets whoever is in it relay without signing in: critical
                     where that is the Internet, a warning inside a network of its own
                     (Services/RelayExposure); Save asks first for an open relay. -->
                <scaffold:InlineNotice x:Name="RelayNotice" Margin="0,12,0,0" Visibility="Collapsed"
                                       AutomationProperties.AutomationId="ip-range-open-relay" />
            </StackPanel>
            <scaffold:Card.Footer>
                <StackPanel Orientation="Horizontal">
                    <ui:Button x:Name="SavePermsButton" Content="{loc:L 'Sa_ve permissions'}" Appearance="Primary"
                               Click="SavePerms_Click" IsEnabled="False" HorizontalAlignment="Left" />
                    <scaffold:StatusPill x:Name="PermsStatePill" Visibility="Collapsed" Margin="12,0,0,0"
                                         VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"
                                         AutomationProperties.AutomationId="ip-range-permissions-state" />
                </StackPanel>
            </scaffold:Card.Footer>
        </scaffold:Card>

        <scaffold:Card Title="{loc:L 'Add range'}" Margin="0,12,0,0">
            <!-- The captions of the line share one height (FieldRow.LabelGroup) and
                 Add sits under a row of it, so that the boxes line up whatever a
                 caption wraps to and a message under one box moves none of the
                 others, where every field sat on the line's bottom edge. -->
            <Grid x:Name="AddRangeForm" Grid.IsSharedSizeScope="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <!-- Room at the narrowest for a priority's message, "Enter a whole
                         number.", in three short lines, as its neighbours' take. -->
                    <ColumnDefinition Width="*" MinWidth="96" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <scaffold:FieldRow x:Name="NewNameRow" Label="{loc:L 'Na_me'}" Margin="0,0,8,0" LabelGroup="RangeLine">
                    <ui:TextBox x:Name="NewName" />
                </scaffold:FieldRow>
                <scaffold:FieldRow x:Name="NewLowerRow" Grid.Column="1" Label="{loc:L 'Lo_wer IP'}" Margin="0,0,8,0" LabelGroup="RangeLine">
                    <ui:TextBox x:Name="NewLower" />
                </scaffold:FieldRow>
                <scaffold:FieldRow x:Name="NewUpperRow" Grid.Column="2" Label="{loc:L '_Upper IP'}" Margin="0,0,8,0" LabelGroup="RangeLine">
                    <ui:TextBox x:Name="NewUpper" />
                </scaffold:FieldRow>
                <scaffold:FieldRow x:Name="NewPriorityRow" Grid.Column="3" Label="{loc:L 'Pri_ority'}" Margin="0,0,8,0" LabelGroup="RangeLine">
                    <ui:TextBox x:Name="NewPriority" Text="15" />
                </scaffold:FieldRow>
                <Grid Grid.Column="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" SharedSizeGroup="RangeLine" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:Button x:Name="AddRangeButton" Grid.Row="1" Content="{loc:L '_Add'}" Appearance="Primary" Click="Add_Click"
                               VerticalAlignment="Top" Margin="0" />
                </Grid>
            </Grid>
        </scaffold:Card>
        </scaffold:FillPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
