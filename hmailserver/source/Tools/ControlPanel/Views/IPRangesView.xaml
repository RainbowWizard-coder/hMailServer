<UserControl
    x:Class="hMailServer.ControlPanel.Views.IPRangesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:hMailServer.ControlPanel.Services"
    xmlns:scaffold="clr-namespace:hMailServer.ControlPanel.Views.Scaffold"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="{StaticResource AppPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <scaffold:PageHeader Title="{loc:L 'IP ranges'}"
                             Subtitle="{loc:L 'Access control: which addresses may connect and what they are allowed to do. Higher priority wins.'}" />

        <!-- The list takes the height the parts under it leave in the window,
             down to a floor of three rows (the card's padding, the column
             headers and three 34-pixel rows), and below that the page scrolls;
             every other part keeps its own height. Work item 79: in 6.3.4 the
             list was a grid's star row between rows sized to their content, and
             a window shorter than those rows gave it nothing, so no range could
             be seen or selected; in 6.3.5 a fixed 560-pixel floor kept the list
             but cut the add form off in a narrow window, where the permissions
             wrap. FillPanel sizes the page from the parts themselves. -->
        <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <scaffold:FillPanel ViewportHeight="{Binding ViewportHeight, ElementName=PageScroll}">

        <scaffold:Toolbar x:Name="SearchBar" SearchPlaceholder="{loc:L 'Search IP ranges'}"
                          SearchTextChanged="Search_TextChanged">
            <scaffold:Toolbar.Actions>
                <!-- Wraps, rather than cutting Delete and Restore defaults off the
                     right edge in a narrow window. -->
                <WrapPanel HorizontalAlignment="Right">
                    <ui:Button x:Name="PropertiesButton" Content="{loc:L 'Pr_operties…'}" Click="Edit_Click" Margin="0,0,8,4" />
                    <ui:Button x:Name="DeleteRangeButton" Content="{loc:L 'Delete selected ra_nge'}"
                               Style="{StaticResource DangerTextButton}" Click="Delete_Click" Margin="0,0,8,4" />
                    <ui:Button Content="{loc:L 'Restore de_faults'}" Click="RestoreDefaults_Click" Margin="0,0,0,4"
                               ToolTip="{loc:L 'Replaces every range with the standard two: \'My computer\' (127.0.0.1) and \'Internet\' (everything else).'}" />
                </WrapPanel>
            </scaffold:Toolbar.Actions>
        </scaffold:Toolbar>

        <scaffold:Card scaffold:FillPanel.Fill="True" MinHeight="154" Padding="8">
            <Grid>
                <DataGrid x:Name="RangeGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" SelectionChanged="RangeGrid_SelectionChanged"
                          MouseDoubleClick="Edit_Click"
                          AutomationProperties.Name="{loc:L 'IP ranges'}">
                    <DataGrid.Columns>
                        <!-- A floor under every column, so that a narrow window scrolls
                             the grid sideways rather than squeezing columns: the name,
                             the one column that says which range a row is, went to
                             nothing, and then the upper address was cut short. -->
                        <DataGridTextColumn Header="{loc:L 'Name'}" Binding="{Binding Name}" Width="*" MinWidth="160" ElementStyle="{StaticResource GridTrimmedText}" />
                        <DataGridTextColumn Header="{loc:L 'Lower IP'}" Binding="{Binding LowerIP}" Width="150" MinWidth="120" />
                        <DataGridTextColumn Header="{loc:L 'Upper IP'}" Binding="{Binding UpperIP}" Width="150" MinWidth="120" />
                        <DataGridTextColumn Header="{loc:L 'Priority'}" Binding="{Binding Priority}" Width="80" MinWidth="64"
                                            ElementStyle="{StaticResource GridNumberText}" HeaderStyle="{StaticResource GridNumberHeader}" />
                        <DataGridTextColumn Header="SMTP" Binding="{Binding Smtp}" Width="70" MinWidth="56" />
                        <DataGridTextColumn Header="IMAP" Binding="{Binding Imap}" Width="70" MinWidth="56" />
                        <DataGridTextColumn Header="POP3" Binding="{Binding Pop3}" Width="70" MinWidth="56" />
                    </DataGrid.Columns>
                </DataGrid>
                <scaffold:EmptyState x:Name="EmptyStatus" Icon="ShieldLock24" Visibility="Collapsed"
                                     AutomationProperties.LiveSetting="Polite" />
            </Grid>
        </scaffold:Card>

        <!-- The selected range's permissions. The card's title names the range;
             Save is the card's own action, in its footer. With no range selected
             the boxes are clear and disabled, so that they never show the
             permissions of a range that is no longer the one selected. -->
        <scaffold:Card x:Name="PermCard" Title="{loc:L 'Permissions (select a range)'}" Margin="0,12,0,0">
            <UniformGrid x:Name="PermGrid" Columns="4" SizeChanged="PermGrid_SizeChanged">
                <!-- A caption longer than its quarter of the card wraps under
                     itself: "Deliver remote → remote (relay)" was cut at "(rela".
                     AccessText, not TextBlock, so the Alt key still works. -->
                <UniformGrid.Resources>
                    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <AccessText Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </UniformGrid.Resources>
                <CheckBox x:Name="PermSmtp" Content="{loc:L 'Allow _SMTP'}" Margin="0,0,12,8" />
                <CheckBox x:Name="PermImap" Content="{loc:L 'Allow _IMAP'}" Margin="0,0,12,8" />
                <CheckBox x:Name="PermPop3" Content="{loc:L 'Allow _POP3'}" Margin="0,0,12,8" />
                <CheckBox x:Name="PermTlsAuth" Content="{loc:L 'Require _TLS for auth'}" Margin="0,0,12,8" />
                <CheckBox x:Name="PermLL" Content="{loc:L 'Deliver _local → local'}" Margin="0,0,12,0" />
                <CheckBox x:Name="PermLR" Content="{loc:L 'Deliver local → _remote'}" Margin="0,0,12,0" />
                <CheckBox x:Name="PermRL" Content="{loc:L '_Deliver remote → local'}" Margin="0,0,12,0" />
                <CheckBox x:Name="PermRR" Content="{loc:L 'Deliver remote → remote (rela_y)'}" Margin="0,0,12,0" />
            </UniformGrid>
            <scaffold:Card.Footer>
                <ui:Button x:Name="SavePermsButton" Content="{loc:L 'Sa_ve permissions'}" Appearance="Primary"
                           Click="SavePerms_Click" IsEnabled="False" HorizontalAlignment="Left" />
            </scaffold:Card.Footer>
        </scaffold:Card>

        <scaffold:Card Title="{loc:L 'Add range'}" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" MinWidth="80" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <scaffold:FieldRow Label="{loc:L 'Name'}" Margin="0,0,8,0" VerticalAlignment="Bottom">
                    <ui:TextBox x:Name="NewName" />
                </scaffold:FieldRow>
                <scaffold:FieldRow Grid.Column="1" Label="{loc:L 'Lower IP (e.g. 10.0.0.0)'}" Margin="0,0,8,0" VerticalAlignment="Bottom">
                    <ui:TextBox x:Name="NewLower" />
                </scaffold:FieldRow>
                <scaffold:FieldRow Grid.Column="2" Label="{loc:L 'Upper IP (e.g. 10.0.0.255)'}" Margin="0,0,8,0" VerticalAlignment="Bottom">
                    <ui:TextBox x:Name="NewUpper" />
                </scaffold:FieldRow>
                <scaffold:FieldRow Grid.Column="3" Label="{loc:L 'Priority'}" Margin="0,0,8,0" VerticalAlignment="Bottom">
                    <ui:TextBox x:Name="NewPriority" Text="15" />
                </scaffold:FieldRow>
                <ui:Button Grid.Column="4" Content="{loc:L '_Add'}" Appearance="Primary" Click="Add_Click"
                           VerticalAlignment="Bottom" Margin="0" />
            </Grid>
        </scaffold:Card>
        </scaffold:FillPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
