<UserControl
    x:Class="hMailServer.ControlPanel.Views.BackupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:hMailServer.ControlPanel.Services"
    xmlns:scaffold="clr-namespace:hMailServer.ControlPanel.Views.Scaffold"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:hMailServer.ControlPanel.Views"
    local:AccessKeyScope.ByCard="True">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="{StaticResource AppPagePadding}">
        <!-- The form's column, as on every settings page (FormColumnPanel, F295). -->
        <scaffold:FormColumnPanel MaxWidth="{StaticResource AppFormWidth}" HorizontalAlignment="Left">
            <scaffold:PageHeader x:Name="Header" PageKey="backup"
                                 Subtitle="{loc:L 'Back up domains, messages and settings to a folder; restore from a previous backup.'}" />

            <!-- A read that failed (Services/ReadFailure). What an action did is
                 said in its own card, by the buttons that did it: said here, it was
                 a screen or more above the restore cards' buttons (review finding
                 F257). -->
            <scaffold:InlineNotice x:Name="Notice" Visibility="Collapsed" />

            <scaffold:Card x:Name="BackupCard" Title="{loc:L 'Backup'}" Margin="{StaticResource AppCardGap}">
                <StackPanel>
                    <scaffold:FieldRow Label="{loc:L 'Destination _folder (on the server)'}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="DestinationBox" Grid.Column="0" />
                            <ui:Button x:Name="BrowseDestination" Grid.Column="1" Content="{loc:L 'Browse…'}" Margin="8,0,0,0"
                                       VerticalAlignment="Bottom" ToolTip="{loc:L 'Browse for a folder'}" Click="BrowseDestination_Click" />
                        </Grid>
                    </scaffold:FieldRow>
                    <CheckBox x:Name="CheckDomains" Content="{loc:L 'Back up _domains (accounts, aliases, lists)'}" Margin="0,0,0,12" />
                    <CheckBox x:Name="CheckMessages" Content="{loc:L 'Back up _messages'}" Margin="0,0,0,8" />
                    <!-- The two hMailServer.ini switches under it, each with its note
                         as the hint (which is also the editor's help text), their boxes
                         under its caption (AppCheckBoxIndent) and their notes under
                         their own captions, where at 22 pixels in a box stood under
                         neither and its hint aligned with neither box nor caption
                         (review finding F294). -->
                    <StackPanel Margin="{StaticResource AppCheckBoxIndent}">
                        <scaffold:FieldRow x:Name="MessagesDbOnlyRow" Margin="0,0,0,12"
                                           Hint="{loc:L 'The backup then records which messages exist but not their contents, and a restore expects the files to still be in the data folder. Applies to backup and restore.'}">
                            <CheckBox x:Name="CheckMessagesDbOnly" Content="{loc:L 'Message metadata _only - do not copy the message files'}" />
                        </scaffold:FieldRow>
                        <scaffold:FieldRow x:Name="VerifyRestoreRow" Margin="0,0,0,12"
                                           Hint="{loc:L 'On by default. The store exists twice while it runs, so turn it off for a store the temp volume cannot hold.'}">
                            <CheckBox x:Name="CheckVerifyRestore" Content="{loc:L '_Verify each backup by extracting its message store and reconciling it against the rows'}" />
                        </scaffold:FieldRow>
                    </StackPanel>
                    <CheckBox x:Name="CheckSettings" Content="{loc:L 'Back up _settings'}" Margin="0,0,0,12" />
                    <CheckBox x:Name="CheckCompress" Content="{loc:L '_Compress destination files (zip)'}" />

                    <!-- The passphrase the archive is encrypted with. Written
                         through the COM property, which is write-only: nothing
                         reads one back, so the boxes are empty on every visit
                         and leaving them empty keeps whatever is already set.
                         The notice above them says which of the two states the
                         server is in, since the boxes cannot show it. -->
                    <scaffold:SettingsSection Heading="{loc:L 'Encryption'}" Margin="0,16,0,0">
                        <StackPanel>
                            <scaffold:InlineNotice x:Name="EncryptionNotice" Margin="0,0,0,12" />
                            <CheckBox x:Name="CheckEncrypt" Content="{loc:L 'Encr_ypt the archive with a passphrase (AES-256, file names included)'}" Margin="0,0,0,12" />
                            <scaffold:FieldRow Label="{loc:L 'Encryption _passphrase'}"
                                               Hint="{loc:L 'Leave both boxes empty to keep the passphrase already set. The server never gives it back - not to this program and not to anyone else - so keep it somewhere other than beside the backups: a restore asks for it, and nothing in an archive whose passphrase is lost can be recovered by anybody.'}">
                                <local:PasswordField x:Name="PassphraseBox" />
                            </scaffold:FieldRow>
                            <scaffold:FieldRow Label="{loc:L 'The passphrase again, to be sure it _was typed right'}">
                                <local:PasswordField x:Name="PassphraseAgainBox" />
                            </scaffold:FieldRow>
                        </StackPanel>
                    </scaffold:SettingsSection>
                </StackPanel>
                <scaffold:Card.Footer>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="{loc:L 'Save s_ettings'}" Click="SaveSettings_Click" Margin="0,0,8,0" />
                            <ui:Button Content="{loc:L 'Start _backup now'}" Appearance="Primary" Click="StartBackup_Click" />
                        </StackPanel>
                        <!-- What the two buttons did, beside them. -->
                        <scaffold:InlineNotice x:Name="BackupOutcome" Visibility="Collapsed" Margin="0,12,0,0" />
                    </StackPanel>
                </scaffold:Card.Footer>
            </scaffold:Card>

            <scaffold:Card Title="{loc:L 'Scheduled backups'}" Margin="{StaticResource AppCardGap}"
                           AutomationProperties.AutomationId="backup-schedule">
                <StackPanel>
                    <!-- State first: whether a schedule exists and how old the newest archive is.
                         Colour, shape AND word (StatusSemantics), so no channel is load-bearing alone. -->
                    <scaffold:InlineNotice x:Name="ScheduleNotice" />
                    <scaffold:InlineNotice x:Name="LastBackupNotice" Margin="0,0,0,16" />

                    <scaffold:FieldRow x:Name="ScheduleTimeRow" Label="{loc:L 'Daily backup t_ime (24-hour HH:MM; empty = off)'}"
                                       Hint="{loc:L 'At most one backup per calendar day, taken at the first check at or after this time (the server\'s local time). If an interval is also set below, the daily time wins.'}">
                        <ui:TextBox x:Name="ScheduleTimeBox" MaxWidth="200" HorizontalAlignment="Left"
                                    AutomationProperties.Name="{loc:L 'Daily backup time (24-hour HH:MM; empty = off)'}" />
                    </scaffold:FieldRow>

                    <scaffold:FieldRow x:Name="IntervalRow" Label="{loc:L 'Backup interva_l (minutes; 0 = off)'}"
                                       Hint="{loc:L 'Used when no daily time is set. The interval is measured against the newest archive in the destination, so it survives service restarts; if the destination holds no backup at all, the first one is taken about a minute after the service starts.'}">
                        <ui:TextBox x:Name="IntervalBox" MaxWidth="200" HorizontalAlignment="Left"
                                    AutomationProperties.Name="{loc:L 'Backup interval (minutes; 0 = off)'}" />
                    </scaffold:FieldRow>

                    <scaffold:SettingsSection Heading="{loc:L 'Retention'}" Margin="0,4,0,0">
                        <StackPanel>
                            <scaffold:FieldRow x:Name="KeepCountRow" Label="{loc:L 'Archives to kee_p (0 = keep all)'}">
                                <ui:TextBox x:Name="KeepCountBox" MaxWidth="200" HorizontalAlignment="Left"
                                            AutomationProperties.Name="{loc:L 'Archives to keep (0 = keep all)'}" />
                            </scaffold:FieldRow>
                            <scaffold:FieldRow x:Name="MaxAgeRow" Label="{loc:L 'Delete archives older tha_n (days; 0 = keep for ever)'}"
                                               Hint="{loc:L '0 means archives are never deleted. The newest archive is never deleted, the age limit always leaves the two newest alone, and only this server\'s own HMBackup archives are counted - other files in the folder are never touched.'}">
                                <ui:TextBox x:Name="MaxAgeBox" MaxWidth="200" HorizontalAlignment="Left"
                                            AutomationProperties.Name="{loc:L 'Delete archives older than (days; 0 = keep for ever)'}" />
                            </scaffold:FieldRow>
                            <TextBlock Style="{StaticResource TextCaption}" Margin="0,0,0,8"
                                       Text="{loc:L 'Keeping several generations of messages needs compression: without \'Compress destination files (zip)\' every backup writes its message files into the same DataBackup folder, overwriting the previous run\'s, so retention can only keep generations of the small settings-and-domains archives.'}" />
                            <TextBlock Style="{StaticResource TextCaption}"
                                       Text="{loc:L 'The schedule and the retention are stored in hMailServer.ini on the server.'}" />
                        </StackPanel>
                    </scaffold:SettingsSection>
                </StackPanel>
                <scaffold:Card.Footer>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:Button x:Name="SaveScheduleButton" Content="{loc:L 'Save sc_hedule'}" Click="SaveSchedule_Click" Margin="0,0,8,0" />
                            <ui:Button Content="{loc:L 'Re-chec_k status'}" Click="RefreshScheduleStatus_Click"
                                       ToolTip="{loc:L 'Re-read the schedule from hMailServer.ini and look at the destination folder again'}" />
                        </StackPanel>
                        <scaffold:InlineNotice x:Name="ScheduleOutcome" Visibility="Collapsed" Margin="0,12,0,0" />
                    </StackPanel>
                </scaffold:Card.Footer>
            </scaffold:Card>

            <!-- The archives in the destination, which the three restore cards
                 share: choosing one puts its path in the whole restore's box and its
                 name in the mailbox restore's, where both were typed by hand. Read
                 from this machine, as the last-backup line above is, so on the
                 server itself; connected to another machine the card says so. -->
            <scaffold:Card x:Name="ArchivesCard" Title="{loc:L 'Archives in the destination'}" Margin="{StaticResource AppCardGap}"
                           AutomationProperties.AutomationId="backup-archives"
                           Description="{loc:L 'The backups in the destination folder, newest first. Choose one and the restore cards below use it; Re-check status reads the folder again.'}">
                <StackPanel>
                    <scaffold:InlineNotice x:Name="ArchivesNotice" Visibility="Collapsed" />
                    <Grid>
                        <DataGrid x:Name="ArchiveGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  MinHeight="136" MaxHeight="240" SelectionChanged="ArchiveGrid_SelectionChanged"
                                  AutomationProperties.AutomationId="backup-archive-list"
                                  AutomationProperties.Name="{loc:L 'Archives in the destination'}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:L 'Archive'}" Binding="{Binding Name}" Width="*" MinWidth="220" ElementStyle="{StaticResource GridTrimmedText}" />
                                <DataGridTextColumn Header="{loc:L 'Taken (server time)'}" Binding="{Binding TakenText}" Width="Auto" MinWidth="150" />
                                <DataGridTextColumn Header="{loc:L 'Size (MB)'}" Binding="{Binding SizeText}" Width="Auto" MinWidth="90"
                                                    ElementStyle="{StaticResource GridNumberText}" HeaderStyle="{StaticResource GridNumberHeader}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <scaffold:EmptyState x:Name="ArchivesEmpty" Icon="Archive24" Visibility="Collapsed" Padding="12" Margin="0,33,0,0" />
                    </Grid>
                </StackPanel>
            </scaffold:Card>

            <scaffold:Card Title="{loc:L 'Restore'}" Margin="{StaticResource AppCardGap}"
                           AutomationProperties.AutomationId="backup-restore"
                           Description="{loc:L 'Choose an archive in the list above, or give the path of one on the server. What it holds replaces the current data for the categories ticked below.'}">
                <StackPanel>
                    <scaffold:FieldRow Label="{loc:L 'Back_up archive (HMBackup*.7z on the server)'}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="BackupFileBox" Grid.Column="0" />
                            <ui:Button x:Name="BrowseBackupFile" Grid.Column="1" Content="{loc:L 'Browse…'}" Margin="8,0,0,0"
                                       VerticalAlignment="Bottom" ToolTip="{loc:L 'Browse for a file'}" Click="BrowseBackupFile_Click" />
                        </Grid>
                    </scaffold:FieldRow>
                    <CheckBox x:Name="RestoreDomains" Content="{loc:L 'Restore dom_ains'}" Margin="0,0,0,12" />
                    <CheckBox x:Name="RestoreMessages" Content="{loc:L 'Restore messa_ges'}" Margin="0,0,0,12" />
                    <CheckBox x:Name="RestoreSettings" Content="{loc:L 'Res_tore settings'}" />
                    <scaffold:FieldRow Label="{loc:L 'Passphrase, _if the archive is encrypted'}" Margin="0,12,0,0"
                                       Hint="{loc:L 'Only for an archive that was written with a passphrase. Without the right one the archive cannot be opened at all, and the restore is refused before anything on this server is touched.'}">
                        <local:PasswordField x:Name="RestorePassphraseBox" />
                    </scaffold:FieldRow>
                </StackPanel>
                <scaffold:Card.Footer>
                    <StackPanel>
                        <ui:Button Content="{loc:L 'Start _restore'}" Appearance="Danger" Click="StartRestore_Click" HorizontalAlignment="Left" />
                        <scaffold:InlineNotice x:Name="RestoreOutcome" Visibility="Collapsed" Margin="0,12,0,0" />
                    </StackPanel>
                </scaffold:Card.Footer>
            </scaffold:Card>

            <scaffold:Card Title="{loc:L 'Restore a mailbox'}" Margin="{StaticResource AppCardGap}"
                           AutomationProperties.AutomationId="backup-restore-mailbox"
                           Description="{loc:L 'The folders and messages of one account put back from an archive in the backup destination, without touching the settings, rules, contacts or calendars of the account, or any other account. The archive is named as the destination lists it (HMBackup YYYY-MM-DD HHMMSS.7z), or by its path inside the destination.'}">
                <StackPanel>
                    <scaffold:FieldRow Label="{loc:L '_Archive in the backup destination (name or path)'}">
                        <ui:TextBox x:Name="MailboxArchiveBox" TextChanged="MailboxNames_TextChanged" />
                    </scaffold:FieldRow>
                    <scaffold:FieldRow Label="{loc:L 'Account address (_whose mailbox)'}" Margin="0,12,0,0">
                        <ui:TextBox x:Name="MailboxAddressBox" TextChanged="MailboxNames_TextChanged" />
                    </scaffold:FieldRow>
                    <RadioButton x:Name="MailboxModeMerge" GroupName="MailboxMode" IsChecked="True" Margin="0,12,0,8"
                                 Content="{loc:L 'Merge: add the folders and messages of the archive that the mailbox lacks; _nothing already there is removed'}" />
                    <RadioButton x:Name="MailboxModeReplace" GroupName="MailboxMode" Margin="0,0,0,12"
                                 Content="{loc:L 'Rep_lace: empty every folder first, so the mailbox is the one in the archive - mail that arrived since the backup is gone'}" />
                    <scaffold:FieldRow Label="{loc:L 'Passphrase, i_f the archive is encrypted'}"
                                       Hint="{loc:L 'Only for an archive that was written with a passphrase.'}">
                        <local:PasswordField x:Name="MailboxPassphraseBox" />
                    </scaffold:FieldRow>
                </StackPanel>
                <scaffold:Card.Footer>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <!-- Re-read before the act, which is last, as on every
                                 card of the page (review finding F289). -->
                            <ui:Button x:Name="MailboxRestoreStatusButton" Content="{loc:L 'Re-read the o_utcome'}" Click="RefreshMailboxRestore_Click" IsEnabled="False" Margin="0,0,8,0" />
                            <ui:Button Content="{loc:L 'Restore the mailbo_x'}" Appearance="Danger" Click="RestoreMailbox_Click" />
                        </StackPanel>
                        <!-- What became of the job, at its level and in words: the
                             server's state token and its JSON were printed here. -->
                        <scaffold:InlineNotice x:Name="MailboxOutcome" Visibility="Collapsed" Margin="0,12,0,0" />
                    </StackPanel>
                </scaffold:Card.Footer>
            </scaffold:Card>

            <scaffold:Card Title="{loc:L 'Restore one message'}"
                           AutomationProperties.AutomationId="backup-restore-message"
                           Description="{loc:L 'List the messages of an account as the archive above holds them, then put one back - into the folder it was in, or into a named one. A message whose file is still in the mailbox is not added twice. The archive, address and passphrase are the ones in the card above.'}">
                <StackPanel>
                    <!-- The messages as rows to choose from: the one selected is the
                         one put back, where its id was copied by hand out of a
                         monospace listing. -->
                    <Grid Margin="0,0,0,8">
                        <DataGrid x:Name="ArchivedMessageGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  MinHeight="136" MaxHeight="260"
                                  AutomationProperties.AutomationId="backup-archived-messages"
                                  AutomationProperties.Name="{loc:L 'Messages in the archive'}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:L 'Subject'}" Binding="{Binding Subject}" Width="2*" MinWidth="160" ElementStyle="{StaticResource GridTrimmedText}" />
                                <DataGridTextColumn Header="{loc:L 'From'}" Binding="{Binding From}" Width="*" MinWidth="120" ElementStyle="{StaticResource GridTrimmedText}" />
                                <DataGridTextColumn Header="{loc:L 'Folder'}" Binding="{Binding Folder}" Width="Auto" MinWidth="80" ElementStyle="{StaticResource GridTrimmedText}" />
                                <DataGridTextColumn Header="{loc:L 'Date (server time)'}" Binding="{Binding Date}" Width="Auto" MinWidth="130" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <scaffold:EmptyState x:Name="ArchivedMessagesEmpty" Icon="Mail24" Visibility="Collapsed" Padding="12" Margin="0,33,0,0" />
                    </Grid>
                    <TextBlock x:Name="ArchivedMessagesNote" Style="{StaticResource TextCaption}" Visibility="Collapsed" Margin="0,0,0,8" />
                    <scaffold:FieldRow Label="{loc:L 'Into this folder (empt_y = the one it was in)'}" Margin="0,4,0,0">
                        <ui:TextBox x:Name="ArchivedMessageFolderBox" />
                    </scaffold:FieldRow>
                </StackPanel>
                <scaffold:Card.Footer>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="{loc:L 'List the messages _in the archive'}" Click="ListArchivedMessages_Click" Margin="0,0,8,0" />
                            <ui:Button x:Name="PutMessageBackButton" Content="{loc:L '_Put the message back'}" Appearance="Primary" Click="RestoreArchivedMessage_Click" />
                        </StackPanel>
                        <scaffold:InlineNotice x:Name="MessageOutcome" Visibility="Collapsed" Margin="0,12,0,0" />
                    </StackPanel>
                </scaffold:Card.Footer>
            </scaffold:Card>
        </scaffold:FormColumnPanel>
    </ScrollViewer>
</UserControl>
