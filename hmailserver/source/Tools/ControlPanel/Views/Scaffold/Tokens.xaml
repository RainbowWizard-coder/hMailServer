<!-- The design tokens, as resources. The numbers are the ones in
     Services/DesignTokens.cs, which is where they are decided and tested; the
     brushes are declared here with their dark values so that every token exists
     from the first parse, and Services/ThemeTokens.cs republishes each brush on
     the application's own dictionary for the theme in force - light, dark or
     High Contrast - which shadows the declaration below. Every key here is named
     in docs/ControlPanelDesign.md, and a test holds the two lists equal. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- The spacing scale is 4, 8, 12, 16, 24 and 32 (DesignTokens.Space), and XAML
         takes it through the margins and paddings below, a Margin and a Padding being
         Thicknesses: the six steps were declared here as numbers too, which a Margin
         or a Padding cannot take, and nothing took them (review finding F295).
         build/check-spacing.py fails a margin or a padding written off the scale. -->

    <!-- The scale applied: the margins and paddings a page uses by name. A page's
         padding and a card's are the Control Deck's, 24 and 16 by 24, where they were
         on a seventh step, 20 (F295). -->
    <Thickness x:Key="AppPagePadding">24</Thickness>
    <Thickness x:Key="AppCardPadding">24,16</Thickness>
    <!-- The compact inset of a card that holds a list or a grid, whose rows have their own. -->
    <Thickness x:Key="AppListCardPadding">8</Thickness>
    <!-- A dialog's inset round its heading, body and footer (DialogFrame). -->
    <Thickness x:Key="AppDialogPadding">24</Thickness>
    <Thickness x:Key="AppHeaderGap">0,0,0,16</Thickness>
    <Thickness x:Key="AppCardGap">0,0,0,12</Thickness>
    <Thickness x:Key="AppFieldGap">0,0,0,12</Thickness>
    <Thickness x:Key="AppSectionGap">0,0,0,24</Thickness>

    <!-- Corner radii: controls and rows, cards and dialogs, the status pill's box. -->
    <CornerRadius x:Key="AppControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="AppCardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="AppPillCornerRadius">4</CornerRadius>

    <!-- The shell's fixed dimensions. -->
    <sys:Double x:Key="AppCommandBarHeight">48</sys:Double>
    <sys:Double x:Key="AppRailWidth">48</sys:Double>
    <sys:Double x:Key="AppNavRowHeight">34</sys:Double>

    <!-- The widest a form is laid out, whatever the window does. -->
    <sys:Double x:Key="AppFormWidth">760</sys:Double>

    <!-- Under a check box's caption: the box and its gap (DesignTokens.CheckBoxCaptionInset),
         for an option that belongs to the box above it. -->
    <Thickness x:Key="AppCheckBoxIndent">28,0,0,0</Thickness>

    <!-- The widest a page's subtitle runs under its title (DesignTokens.SubtitleWidth). -->
    <sys:Double x:Key="AppSubtitleWidth">840</sys:Double>

    <!-- Icon sizes (DesignTokens.IconSize): a glyph beside text or on a small
         button 16, on a toolbar's or a header's glyph button 20, the rail's 24, an
         empty state's 40. -->
    <sys:Double x:Key="AppIconSizeSm">16</sys:Double>
    <sys:Double x:Key="AppIconSizeMd">20</sys:Double>
    <sys:Double x:Key="AppIconSizeLg">24</sys:Double>
    <sys:Double x:Key="AppIconSizeXl">40</sys:Double>

    <!-- The type ramp (Services/Typography.cs): Caption 12, Body 14, Subtitle 20, Title 28. -->
    <sys:Double x:Key="AppFontSizeCaption">12</sys:Double>
    <sys:Double x:Key="AppFontSizeBody">14</sys:Double>
    <sys:Double x:Key="AppFontSizeSubtitle">20</sys:Double>
    <sys:Double x:Key="AppFontSizeTitle">28</sys:Double>
    <!-- Text in the monospaced face (Typography.MonoFontFamily, Typography.Mono). -->
    <sys:Double x:Key="AppFontSizeMono">13</sys:Double>
    <!-- A size off the ramp that App.xaml's styles wrote as a number: a grid
         cell's text. -->
    <sys:Double x:Key="AppFontSizeGrid">13</sys:Double>
    <!-- A line of Live logs: its 13-pixel text (AppFontSizeMono) in lines of 17,
         one line touching none of its neighbours. A height, not a size, set at the
         Windows text size with the sizes all the same (TextScale.IsTextSizeKey): at a
         line height of 17 the log's text at 150 per cent ran into the next line. -->
    <sys:Double x:Key="AppLineHeightLog">17</sys:Double>
    <!-- Every size above is set at the Windows text size when the Control Panel
         starts (Services/TextScale, review finding F317), so text takes them by
         DynamicResource, never as a number of its own. -->

    <!-- The ramp as keyed TextBlock styles. Keyed, never implicit: an implicit
         TextBlock style reaches into every control template and overrides the
         on-accent text (see the note in App.xaml). -->
    <Style x:Key="TextTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="TextSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeSubtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="TextBodyStrong" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="TextBody" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="TextSecondary" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="TextCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="TextCaptionTertiary" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource AppFontSizeCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- The status palette and the surfaces: dark values here, the theme's
         values from ThemeTokens.Refresh. Reference them with DynamicResource,
         never StaticResource, or the theme change is missed. -->
    <SolidColorBrush x:Key="AppBrandBrush" Color="#4C8DFF" />
    <SolidColorBrush x:Key="AppSuccessBrush" Color="#3FB950" />
    <SolidColorBrush x:Key="AppWarningBrush" Color="#D29922" />
    <SolidColorBrush x:Key="AppDangerBrush" Color="#F85149" />
    <SolidColorBrush x:Key="AppInfoBrush" Color="#A371F7" />
    <SolidColorBrush x:Key="AppNeutralBrush" Color="#9DA7B0" />
    <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="AppCardBorderBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="AppCardHoverBrush" Color="#15FFFFFF" />
    <SolidColorBrush x:Key="AppDividerBrush" Color="#14FFFFFF" />
    <sys:Double x:Key="AppNoticeTintOpacity">0.12</sys:Double>

    <!-- Where the keyboard is (DesignTokens.Focus): the ring round a text field
         that has the keyboard and the glow outside it (FocusGlow), and the
         navigation's border round the row the keyboard is on. Dark values here,
         the theme's from ThemeTokens. -->
    <SolidColorBrush x:Key="AppFocusBrush" Color="#B89CFF" />
    <SolidColorBrush x:Key="AppFocusGlowBrush" Color="#47B89CFF" />

    <!-- A selected row in a grid or a list (DesignTokens.Selection): the brand
         at the notice tint's opacity behind the row, beside the brand pill at
         its left edge, and the outline only High Contrast draws, where the
         fill is nothing. Dark values here, the theme's from ThemeTokens. -->
    <SolidColorBrush x:Key="AppSelectionFillBrush" Color="#1F4C8DFF" />
    <SolidColorBrush x:Key="AppSelectionOutlineBrush" Color="#00000000" />

    <!-- The status pill's box: a fill per level and the colour of the word and
         mark on it (DesignTokens.StatusFill), and the outline only High
         Contrast draws. Dark values here, the theme's from ThemeTokens. -->
    <SolidColorBrush x:Key="AppSuccessFillBrush" Color="#1C4128" />
    <SolidColorBrush x:Key="AppSuccessFillTextBrush" Color="#56D364" />
    <SolidColorBrush x:Key="AppInfoFillBrush" Color="#3A2A63" />
    <SolidColorBrush x:Key="AppInfoFillTextBrush" Color="#C8A2FF" />
    <SolidColorBrush x:Key="AppWarningFillBrush" Color="#45350F" />
    <SolidColorBrush x:Key="AppWarningFillTextBrush" Color="#E3B341" />
    <SolidColorBrush x:Key="AppDangerFillBrush" Color="#522024" />
    <SolidColorBrush x:Key="AppDangerFillTextBrush" Color="#FF9492" />
    <SolidColorBrush x:Key="AppNeutralFillBrush" Color="#3A4048" />
    <SolidColorBrush x:Key="AppNeutralFillTextBrush" Color="#D1D9E0" />
    <Thickness x:Key="AppStatusFillBorderThickness">0</Thickness>

    <!-- The filled destructive button (DesignTokens.DangerSolid), which App.xaml's
         button style gives every Appearance="Danger": the fill at rest, under the
         pointer and pressed, and the words on it. Dark values here, the theme's
         from ThemeTokens. -->
    <SolidColorBrush x:Key="AppDangerSolidBrush" Color="#F85149" />
    <SolidColorBrush x:Key="AppDangerSolidHoverBrush" Color="#FA6B64" />
    <SolidColorBrush x:Key="AppDangerSolidPressedBrush" Color="#E5534B" />
    <SolidColorBrush x:Key="AppOnDangerSolidBrush" Color="#1B1B1B" />

    <!-- A link at rest and under the pointer (DesignTokens.Link), which App.xaml's
         Hyperlink style gives every link. Dark values here, the theme's from
         ThemeTokens. -->
    <SolidColorBrush x:Key="AppLinkBrush" Color="#6CB6FF" />
    <SolidColorBrush x:Key="AppLinkHoverBrush" Color="#9CCFFF" />
</ResourceDictionary>
