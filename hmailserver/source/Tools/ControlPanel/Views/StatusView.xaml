<UserControl
    x:Class="hMailServer.ControlPanel.Views.StatusView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:hMailServer.ControlPanel.Services"
    xmlns:scaffold="clr-namespace:hMailServer.ControlPanel.Views.Scaffold"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="{StaticResource AppPagePadding}">
        <StackPanel>
            <scaffold:PageHeader x:Name="Header" PageKey="status"
                                 Subtitle="{loc:L 'Server, database and health overview.'}">
                <scaffold:PageHeader.Actions>
                    <StackPanel Orientation="Horizontal">
                        <!-- What it pauses, in its words (review finding F019): Live
                             logs' Pause, beside it in the sidebar with the same glyph,
                             freezes a view and nothing else. -->
                        <ui:Button x:Name="PauseButton" Content="{loc:L '_Pause the mail server'}" Click="PauseResume_Click" IsEnabled="False"
                                   Margin="0,0,8,0"
                                   ToolTip="{loc:L 'Stops the mail server engine while the Windows service keeps running: no new connections are accepted and nothing is delivered until it is resumed.'}">
                            <ui:Button.Icon><ui:SymbolIcon x:Name="PauseButtonIcon" Symbol="Pause24" /></ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Content="{loc:L '_Refresh'}" Click="Refresh_Click">
                            <ui:Button.Icon><ui:SymbolIcon Symbol="ArrowClockwise24" /></ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </scaffold:PageHeader.Actions>
            </scaffold:PageHeader>

            <!-- A read that failed, under the header: Critical, with Try again,
                 and every readout says "Not read" rather than a dash that could
                 be a value (Services/ReadFailure). -->
            <scaffold:InlineNotice x:Name="ReadNotice" Visibility="Collapsed"
                                   AutomationProperties.AutomationId="status-read-failure" />

            <!-- A newer release waiting, in one line with the page that installs it
                 (Views/UpdateNotice); nothing while there is none. -->
            <StackPanel x:Name="UpdateNoticeHost" Visibility="Collapsed" />

            <!-- The configuration checks first, under the header: one notice per
                 finding, at its level, with the page that puts it right. They were
                 the last card, below the fold, under the title Warnings. -->
            <scaffold:Card Title="{loc:L 'Configuration checks'}" Margin="{StaticResource AppCardGap}">
                <StackPanel x:Name="WarningsPanel" />
            </scaffold:Card>

            <Grid Margin="{StaticResource AppCardGap}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Server. Checking for, downloading and installing an update are on
                     the Updates page, with the policy that drives them (review finding
                     F272); a release that is waiting is said under the header. -->
                <scaffold:Card Title="{loc:L 'Server'}" Margin="0,0,6,0">
                    <Grid x:Name="ServerGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:L 'Version'}" Style="{StaticResource TextCaption}" Margin="0,0,16,8" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="VersionValue" Style="{StaticResource TextBody}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:L 'State'}" Style="{StaticResource TextCaption}" Margin="0,0,16,8" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="StateValue" Style="{StaticResource TextBody}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:L 'Started'}" Style="{StaticResource TextCaption}" Margin="0,0,16,8" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="StartedValue" Style="{StaticResource TextBody}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:L 'Uptime'}" Style="{StaticResource TextCaption}" Margin="0,0,16,8" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="UptimeValue" Style="{StaticResource TextBody}" />
                    </Grid>
                </scaffold:Card>

                <!-- Database -->
                <scaffold:Card Grid.Column="1" Title="{loc:L 'Database'}" Margin="6,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:L 'Type'}" Style="{StaticResource TextCaption}" Margin="0,0,16,8" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DbTypeValue" Style="{StaticResource TextBody}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:L 'Host'}" Style="{StaticResource TextCaption}" Margin="0,0,16,8" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DbHostValue" Style="{StaticResource TextBody}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:L 'Name'}" Style="{StaticResource TextCaption}" Margin="0,0,16,8" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="DbNameValue" Style="{StaticResource TextBody}" Margin="0,0,0,8" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:L 'Schema'}" Style="{StaticResource TextCaption}" Margin="0,0,16,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DbVersionValue" Style="{StaticResource TextBody}" />
                    </Grid>
                </scaffold:Card>
            </Grid>

            <!-- Statistics: what the service counted since it started, then what is
                 connected now, each under a line that says which (review finding
                 F247). Six figures side by side read as one kind; the counters are
                 named as the Dashboard names them. -->
            <scaffold:Card Title="{loc:L 'Statistics'}" Margin="{StaticResource AppCardGap}">
                <StackPanel>
                <TextBlock x:Name="SinceStartHeading" Text="{loc:L 'Since the service started'}" Style="{StaticResource TextCaption}" FontWeight="SemiBold" Margin="0,0,0,4" />
                <UniformGrid Columns="3" Margin="0,0,0,12">
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="{loc:L 'Messages processed'}" Style="{StaticResource TextCaption}" />
                        <TextBlock x:Name="ProcessedValue" Style="{StaticResource TextSubtitle}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="{loc:L 'Spam detected'}" Style="{StaticResource TextCaption}" />
                        <TextBlock x:Name="SpamValue" Style="{StaticResource TextSubtitle}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="{loc:L 'Viruses removed'}" Style="{StaticResource TextCaption}" />
                        <TextBlock x:Name="VirusValue" Style="{StaticResource TextSubtitle}" />
                    </StackPanel>
                </UniformGrid>
                <TextBlock Text="{loc:L 'Connected now'}" Style="{StaticResource TextCaption}" FontWeight="SemiBold" Margin="0,0,0,4" />
                <UniformGrid Columns="3">
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="{loc:L 'SMTP sessions'}" Style="{StaticResource TextCaption}" />
                        <TextBlock x:Name="SmtpValue" Style="{StaticResource TextSubtitle}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="{loc:L 'IMAP sessions'}" Style="{StaticResource TextCaption}" />
                        <TextBlock x:Name="ImapValue" Style="{StaticResource TextSubtitle}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="{loc:L 'POP3 sessions'}" Style="{StaticResource TextCaption}" />
                        <TextBlock x:Name="Pop3Value" Style="{StaticResource TextSubtitle}" />
                    </StackPanel>
                </UniformGrid>
                <!-- A count, not a warning: it was the one "Information" among
                     the configuration warnings on most servers (review finding
                     F245). Under a line of its own, after the grid of the
                     sessions: it counts neither since the start nor connections,
                     and as a fourth cell of that grid it wrapped to a row under
                     the session counts, under "Connected now". With the page that
                     lists the ranges. -->
                <TextBlock Text="{loc:L 'Banned now'}" Style="{StaticResource TextCaption}" FontWeight="SemiBold" Margin="0,12,0,4" />
                <StackPanel>
                    <TextBlock Text="{loc:L 'Auto-ban IP ranges'}" Style="{StaticResource TextCaption}" />
                    <!-- The link beside the number, not under it, so that the
                         figure reads on one line as the session counts do. -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="AutobanValue" Style="{StaticResource TextSubtitle}" VerticalAlignment="Center" />
                        <ui:Button x:Name="AutobanLink" Content="{loc:L '_Show in IP ranges'}" Click="OpenIpRanges_Click"
                                   FontSize="{StaticResource AppFontSizeCaption}" Padding="8,2,8,2"
                                   Margin="12,0,0,0" VerticalAlignment="Center"
                                   AutomationProperties.AutomationId="status-open-ipranges"
                                   AutomationProperties.HelpText="{loc:L 'Show the auto-ban IP ranges on the IP ranges page'}"
                                   ToolTip="{loc:L 'Show the auto-ban IP ranges on the IP ranges page'}" />
                    </StackPanel>
                </StackPanel>
                </StackPanel>
            </scaffold:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
