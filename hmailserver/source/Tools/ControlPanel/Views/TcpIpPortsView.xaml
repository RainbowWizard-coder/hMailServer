<UserControl
    x:Class="hMailServer.ControlPanel.Views.TcpIpPortsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:hMailServer.ControlPanel.Services"
    xmlns:scaffold="clr-namespace:hMailServer.ControlPanel.Views.Scaffold"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="{StaticResource AppPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <scaffold:PageHeader Title="{loc:L 'TCP/IP ports'}"
                             Subtitle="{loc:L 'The ports each protocol listens on, their bind address and connection security. A change takes effect when the server is reinitialized, which this page offers after each one. The Listening column is read from this machine\'s open ports, not from the configuration, so it shows what is actually happening rather than what was asked for.'}" />

        <!-- The IP ranges shape: the list takes the height the parts under it
             leave in the window, down to a floor of three rows, and below that
             the page scrolls; every other part keeps its own height. The list
             was a grid's star row between rows sized to their content, which in
             the narrowest window (760 by 520) left no grid at all between the
             toolbar and the listener warning. -->
        <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <scaffold:FillPanel ViewportHeight="{Binding ViewportHeight, ElementName=PageScroll}">

        <scaffold:Toolbar x:Name="SearchBar" SearchPlaceholder="{loc:L 'Search ports'}"
                          SearchTextChanged="Search_TextChanged">
            <scaffold:Toolbar.Actions>
                <!-- Wraps, as the IP ranges page's actions do, rather than cutting
                     Restore defaults off the right edge in a narrow window. -->
                <WrapPanel HorizontalAlignment="Right">
                    <ui:Button x:Name="PropertiesButton" Content="{loc:L '_Properties'}" Click="Edit_Click" Margin="0,2,8,2" />
                    <ui:Button x:Name="DeleteButton" Content="{loc:L '_Delete selected'}"
                               Style="{StaticResource DangerTextButton}" Click="Delete_Click" Margin="0,2,8,2" />
                    <ui:Button x:Name="RestoreDefaultsButton" Content="{loc:L '_Restore defaults'}" Click="RestoreDefaults_Click" Margin="0,2,0,2"
                               ToolTip="{loc:L 'Replaces every port with the standard set: SMTP 25 and 587, POP3 110, IMAP 143, all without connection security.'}" />
                </WrapPanel>
            </scaffold:Toolbar.Actions>
        </scaffold:Toolbar>

        <!-- A read that failed: Critical, with Try again, in place of the empty
             state, which would say there are no ports (Services/ReadFailure). -->
        <scaffold:InlineNotice x:Name="Notice" Visibility="Collapsed" />

        <!-- The floor: three rows and the empty state, as the IP ranges page's list card. -->
        <scaffold:Card scaffold:FillPanel.Fill="True" MinHeight="157" Padding="8">
            <Grid>
                <DataGrid x:Name="PortGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          AutomationProperties.AutomationId="ports-grid"
                          SelectionMode="Single" MouseDoubleClick="Edit_Click"
                          AutomationProperties.Name="{loc:L 'TCP/IP ports'}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:L 'Protocol'}" Binding="{Binding Protocol}" Width="120" />
                        <DataGridTextColumn Header="{loc:L 'Address'}" Binding="{Binding Address}" Width="170" />
                        <DataGridTextColumn Header="{loc:L 'Port'}" Binding="{Binding Port}" Width="90"
                                            ElementStyle="{StaticResource GridNumberText}" HeaderStyle="{StaticResource GridNumberHeader}" />
                        <DataGridTextColumn Header="{loc:L 'Security'}" Binding="{Binding Security}" Width="180" />
                        <DataGridTextColumn Header="{loc:L 'SMTP authentication'}" Binding="{Binding Auth}" Width="170" />
                        <!-- A shape as well as a word, so the difference between a live
                             port and a dead one survives greyscale, colour blindness and
                             High Contrast. The mark itself is built in the code-behind by
                             ShapeMarkVisuals.ApplyMark and hosted here: a Path bound
                             straight to Fill would render a stroke-only mark as nothing
                             at all, which is precisely the silent failure that helper
                             exists to prevent. -->
                        <DataGridTemplateColumn Header="{loc:L 'Listening'}" Width="150" SortMemberPath="ListeningWord">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding ListeningTip}">
                                        <ContentPresenter Content="{Binding ListeningMark}"
                                                          VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding ListeningWord}" VerticalAlignment="Center"
                                                   AutomationProperties.Name="{Binding ListeningTip}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- A floor, so that in a narrow window the certificate a listener
                             presents is still there to read rather than squeezed to
                             nothing; the grid scrolls sideways instead. -->
                        <DataGridTextColumn Header="{loc:L 'Certificate'}" Binding="{Binding Certificate}" Width="*" MinWidth="160" ElementStyle="{StaticResource GridTrimmedText}" />
                    </DataGrid.Columns>
                </DataGrid>
                <scaffold:EmptyState x:Name="EmptyStatus" Icon="PlugConnected24" Visibility="Collapsed"
                                     AutomationProperties.LiveSetting="Polite" />
            </Grid>
        </scaffold:Card>

        <!-- The one line under the list: a warning when a configured port is not
             being listened on, information when that cannot be told from here.
             Only as tall as what it has to say, and collapsed entirely when
             every port is up. -->
        <scaffold:InlineNotice x:Name="ListenerSummary" Margin="0,12,0,0" Visibility="Collapsed" />

        <scaffold:Card Title="{loc:L 'Add port'}" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="110" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" MinWidth="80" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <scaffold:FieldRow Label="{loc:L 'Protocol'}" Margin="0,0,8,0">
                    <ComboBox x:Name="NewProtocol" SelectedIndex="0">
                        <ComboBoxItem Content="SMTP" />
                        <ComboBoxItem Content="POP3" />
                        <ComboBoxItem Content="IMAP" />
                    </ComboBox>
                </scaffold:FieldRow>
                <scaffold:FieldRow Grid.Column="1" Label="{loc:L 'Bind address (0.0.0.0)'}" Margin="0,0,8,0">
                    <ui:TextBox x:Name="NewAddress" Text="0.0.0.0" />
                </scaffold:FieldRow>
                <scaffold:FieldRow Grid.Column="2" Label="{loc:L 'Port'}" Margin="0,0,8,0">
                    <ui:TextBox x:Name="NewPort" />
                </scaffold:FieldRow>
                <scaffold:FieldRow Grid.Column="3" Label="{loc:L 'Security'}" Margin="0,0,8,0">
                    <ComboBox x:Name="NewSecurity" SelectedIndex="0">
                        <ComboBoxItem Content="{loc:L 'None'}" />
                        <ComboBoxItem Content="SSL/TLS" />
                        <ComboBoxItem Content="{loc:L 'STARTTLS (optional)'}" />
                        <ComboBoxItem Content="{loc:L 'STARTTLS (required)'}" />
                    </ComboBox>
                </scaffold:FieldRow>
                <ui:Button x:Name="AddPortButton" Grid.Column="4" Content="{loc:L '_Add'}" Appearance="Primary" Click="Add_Click"
                           AutomationProperties.AutomationId="ports-add"
                           VerticalAlignment="Bottom" Margin="0" />
            </Grid>
        </scaffold:Card>
        </scaffold:FillPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
