<UserControl
    x:Class="hMailServer.ControlPanel.Views.TcpIpPortsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:hMailServer.ControlPanel.Services"
    xmlns:scaffold="clr-namespace:hMailServer.ControlPanel.Views.Scaffold"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="{StaticResource AppPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <scaffold:PageHeader PageKey="ports"
                             Subtitle="{loc:L 'The ports each protocol listens on, their bind address and connection security. A change takes effect when the server is reinitialised, which the notice above the list offers until it is.'}">
            <!-- The list page pattern (docs/ControlPanelDesign.md, List pages): the
                 count beside the title and Refresh in the header, the list's own
                 verbs in the toolbar above it (review finding F288). -->
            <scaffold:PageHeader.Status>
                <scaffold:StatusPill x:Name="CountPill" Level="Normal" Visibility="Collapsed"
                                     AutomationProperties.AutomationId="list-count"
                                     AutomationProperties.LiveSetting="Polite" />
            </scaffold:PageHeader.Status>
            <scaffold:PageHeader.Actions>
                <ui:Button x:Name="RefreshButton" Content="{loc:L '_Refresh'}" Click="Refresh_Click" />
            </scaffold:PageHeader.Actions>
        </scaffold:PageHeader>

        <!-- The IP ranges shape: the list takes the height the parts under it
             leave in the window, down to a floor of three rows, and below that
             the page scrolls; every other part keeps its own height. The list
             was a grid's star row between rows sized to their content, which in
             the narrowest window (760 by 520) left no grid at all between the
             toolbar and the listener warning. -->
        <!-- The bar is drawn over the content, so the right padding (AppSpaceMd)
             keeps the cards, the notices and the toolbar's last button clear of it. -->
        <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,12,0">
        <scaffold:FillPanel ViewportHeight="{Binding ViewportHeight, ElementName=PageScroll}">

        <scaffold:Toolbar x:Name="SearchBar" SearchPlaceholder="{loc:L 'Search ports'}"
                          SearchTextChanged="Search_TextChanged">
            <scaffold:Toolbar.Actions>
                <!-- Wraps, as the IP ranges page's actions do, rather than cutting
                     Restore defaults off the right edge in a narrow window. -->
                <WrapPanel HorizontalAlignment="Right">
                    <ui:Button x:Name="PropertiesButton" Content="{loc:L '_Properties'}" Click="Edit_Click" Margin="0,2,8,2" />
                    <ui:Button x:Name="DeleteButton" Content="{loc:L '_Delete selected'}"
                               Style="{StaticResource DangerTextButton}" Click="Delete_Click" Margin="0,2,8,2" />
                    <ui:Button x:Name="RestoreDefaultsButton" Content="{loc:L 'Restore de_faults'}" Style="{StaticResource DangerTextButton}" Click="RestoreDefaults_Click" Margin="0,2,0,2"
                               ToolTip="{loc:L 'Replaces every port with the standard set: SMTP 25 and 587, POP3 110, IMAP 143, all without connection security.'}" />
                </WrapPanel>
            </scaffold:Toolbar.Actions>
        </scaffold:Toolbar>

        <!-- A read that failed: Critical, with Try again, in place of the empty
             state, which would say there are no ports (Services/ReadFailure). -->
        <scaffold:InlineNotice x:Name="Notice" Visibility="Collapsed" />

        <!-- Ports changed in this session and not yet reinitialised: what the server
             listens on until it is, with Reinitialise now, where a question after
             every add, edit and delete asked to reinitialise there and then
             (review finding F222; Services/PortChanges). -->
        <scaffold:InlineNotice x:Name="PortsChangedNotice" Level="Warning" Visibility="Collapsed"
                               AutomationProperties.AutomationId="ports-changed" />

        <!-- The floor: three rows on the grid's own FillPanel and the empty
             state laid over them, as the IP ranges page's list card. -->
        <scaffold:Card scaffold:FillPanel.Fill="True" Padding="8">
            <Grid>
                <scaffold:FillPanel>
                <DataGrid x:Name="PortGrid" scaffold:FillPanel.Fill="True" MinHeight="143" AutoGenerateColumns="False" IsReadOnly="True"
                          AutomationProperties.AutomationId="ports-grid"
                          SelectionMode="Single"
                          AutomationProperties.Name="{loc:L 'TCP/IP ports'}">
                    <DataGrid.Columns>
                        <!-- Each width is the column's share of a window that has room; its
                             floor, set in the code-behind (FloorColumns_), is the widest
                             of its words, so that a narrow window scrolls the grid sideways
                             rather than cutting a word. -->
                        <DataGridTextColumn x:Name="ProtocolColumn" Header="{loc:L 'Protocol'}" Binding="{Binding Protocol}" Width="120" />
                        <DataGridTextColumn x:Name="AddressColumn" Header="{loc:L 'Address'}" Binding="{Binding Address}" Width="170" />
                        <DataGridTextColumn x:Name="PortColumn" Header="{loc:L 'Port'}" Binding="{Binding Port}" Width="90"
                                            ElementStyle="{StaticResource GridNumberText}" HeaderStyle="{StaticResource GridNumberHeader}" />
                        <DataGridTextColumn x:Name="SecurityColumn" Header="{loc:L 'Security'}" Binding="{Binding Security}" Width="180" />
                        <DataGridTextColumn x:Name="AuthColumn" Header="{loc:L 'SMTP authentication'}" Binding="{Binding Auth}" Width="170" />
                        <!-- A shape as well as a word, so the difference between a live
                             port and a dead one survives greyscale, colour blindness and
                             High Contrast. The mark itself is built in the code-behind by
                             ShapeMarkVisuals.ApplyMark and hosted here: a Path bound
                             straight to Fill would render a stroke-only mark as nothing
                             at all, which is precisely the silent failure that helper
                             exists to prevent. -->
                        <DataGridTemplateColumn x:Name="ListeningColumn" Header="{loc:L 'Listening'}" Width="150" SortMemberPath="ListeningWord">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding ListeningTip}">
                                        <ContentPresenter Content="{Binding ListeningMark}"
                                                          VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding ListeningWord}" VerticalAlignment="Center"
                                                   AutomationProperties.Name="{Binding ListeningTip}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- A floor, so that in a narrow window the certificate a listener
                             presents is still there to read rather than squeezed to
                             nothing; the grid scrolls sideways instead. -->
                        <DataGridTextColumn Header="{loc:L 'Certificate'}" Binding="{Binding Certificate}" Width="*" MinWidth="160" ElementStyle="{StaticResource GridTrimmedText}" />
                    </DataGrid.Columns>
                </DataGrid>
                </scaffold:FillPanel>
                <!-- With no port the server listens for nothing: the action puts
                     back the standard set, as Restore defaults above does. -->
                <scaffold:EmptyState x:Name="EmptyStatus" Icon="PlugConnected24" Visibility="Collapsed"
                                     AutomationProperties.LiveSetting="Polite">
                    <scaffold:EmptyState.Action>
                        <ui:Button x:Name="RestoreDefaultsAction" Content="{loc:L 'Restore the default p_orts'}" Click="RestoreDefaults_Click"
                                   AutomationProperties.AutomationId="ports-restore-defaults-empty" />
                    </scaffold:EmptyState.Action>
                </scaffold:EmptyState>
            </Grid>
        </scaffold:Card>

        <!-- The one line under the list: a warning when a configured port is not
             being listened on, information when that cannot be told from here.
             Only as tall as what it has to say, and collapsed entirely when
             every port is up. -->
        <scaffold:InlineNotice x:Name="ListenerSummary" Margin="0,12,0,0" Visibility="Collapsed" />

        <!-- The captions of the line share one height (FieldRow.LabelGroup) and Add
             sits under a row of it, so that a message under one box moves none of
             the others. One line where the card is wide enough for its six parts,
             two in a narrower window (TcpIpPortsView.AddPortForm_SizeChanged). -->
        <scaffold:Card Title="{loc:L 'Add port'}" Margin="0,12,0,0">
            <Grid x:Name="AddPortForm" Grid.IsSharedSizeScope="True" SizeChanged="AddPortForm_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="110" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" MinWidth="80" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <scaffold:FieldRow x:Name="PortProtocolRow" Label="{loc:L 'Proto_col'}" Margin="0,0,8,0" LabelGroup="PortLine">
                    <ComboBox x:Name="NewProtocol" SelectedIndex="0">
                        <ComboBoxItem Content="SMTP" />
                        <ComboBoxItem Content="POP3" />
                        <ComboBoxItem Content="IMAP" />
                    </ComboBox>
                </scaffold:FieldRow>
                <scaffold:FieldRow x:Name="PortAddressRow" Grid.Column="1" Label="{loc:L '_Bind address (0.0.0.0)'}" Margin="0,0,8,0" LabelGroup="PortLine">
                    <ui:TextBox x:Name="NewAddress" Text="0.0.0.0" />
                </scaffold:FieldRow>
                <scaffold:FieldRow x:Name="PortNumberRow" Grid.Column="2" Label="{loc:L 'Por_t'}" Margin="0,0,8,0" LabelGroup="PortLine">
                    <ui:TextBox x:Name="NewPort" />
                </scaffold:FieldRow>
                <scaffold:FieldRow x:Name="PortSecurityRow" Grid.Column="3" Label="{loc:L '_Security'}" Margin="0,0,8,0" LabelGroup="PortLine">
                    <ComboBox x:Name="NewSecurity" SelectedIndex="0" SelectionChanged="NewSecurity_SelectionChanged">
                        <ComboBoxItem Content="{loc:L 'None'}" />
                        <ComboBoxItem Content="SSL/TLS" />
                        <ComboBoxItem Content="{loc:L 'STARTTLS (optional)'}" />
                        <ComboBoxItem Content="{loc:L 'STARTTLS (required)'}" />
                    </ComboBox>
                </scaffold:FieldRow>
                <!-- The certificate a TLS port presents, which the form could not set: a
                     port added with SSL/TLS or STARTTLS and no certificate did not start
                     (review finding F222). Enabled while the security is not None. -->
                <scaffold:FieldRow x:Name="PortCertificateRow" Grid.Column="4" Label="{loc:L 'C_ertificate'}" Margin="0,0,8,0" LabelGroup="PortLine">
                    <ComboBox x:Name="NewCertificate" IsEnabled="False" AutomationProperties.AutomationId="ports-new-certificate" />
                </scaffold:FieldRow>
                <Grid x:Name="AddPortLine" Grid.Column="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" SharedSizeGroup="PortLine" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:Button x:Name="AddPortButton" Grid.Row="1" Content="{loc:L '_Add'}" Appearance="Primary" Click="Add_Click"
                               AutomationProperties.AutomationId="ports-add"
                               VerticalAlignment="Top" Margin="0" />
                </Grid>
            </Grid>
        </scaffold:Card>
        </scaffold:FillPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
