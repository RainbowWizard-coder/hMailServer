<UserControl
    x:Class="hMailServer.ControlPanel.Views.RoutesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:hMailServer.ControlPanel.Services"
    xmlns:scaffold="clr-namespace:hMailServer.ControlPanel.Views.Scaffold"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="{StaticResource AppPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <scaffold:PageHeader Title="{loc:L 'Routes'}"
                             Subtitle="{loc:L 'Deliver mail for specific domains through a designated SMTP host instead of MX lookup.'}" />

        <!-- The IP ranges shape: the list takes the height the add form leaves in
             the window, down to a floor of three rows, and below that the page
             scrolls. The list was a grid's star row between rows sized to their
             content, which in the narrowest window (760 by 520) left it half a
             row. -->
        <!-- The bar is drawn over the content, so the right padding (AppSpaceMd)
             keeps the cards, the notices and the toolbar's last button clear of it. -->
        <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,12,0">
        <scaffold:FillPanel ViewportHeight="{Binding ViewportHeight, ElementName=PageScroll}">

        <scaffold:Toolbar x:Name="SearchBar" SearchPlaceholder="{loc:L 'Search routes'}"
                          SearchTextChanged="Search_TextChanged">
            <scaffold:Toolbar.Actions>
                <WrapPanel HorizontalAlignment="Right">
                    <ui:Button x:Name="PropertiesButton" Content="{loc:L '_Properties'}" Click="Edit_Click" Margin="0,2,8,2" />
                    <ui:Button x:Name="DeleteButton" Content="{loc:L '_Delete selected'}" Style="{StaticResource DangerTextButton}" Click="Delete_Click" Margin="0,2,0,2" />
                </WrapPanel>
            </scaffold:Toolbar.Actions>
        </scaffold:Toolbar>

        <!-- A read that failed: Critical, with Try again, in place of the empty
             state, which would say there are no routes (Services/ReadFailure). -->
        <scaffold:InlineNotice x:Name="Notice" Visibility="Collapsed" />

        <!-- The floor: three rows on the grid's own FillPanel and the empty
             state laid over them, as the IP ranges page's list card. -->
        <scaffold:Card scaffold:FillPanel.Fill="True" Padding="8">
            <Grid>
                <scaffold:FillPanel>
                <DataGrid x:Name="RouteGrid" scaffold:FillPanel.Fill="True" MinHeight="143" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single"
                          AutomationProperties.Name="{loc:L 'Routes'}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:L 'Domain'}" Binding="{Binding DomainName}" Width="*" ElementStyle="{StaticResource GridTrimmedText}" />
                        <DataGridTextColumn Header="{loc:L 'Target host'}" Binding="{Binding TargetHost}" Width="*" ElementStyle="{StaticResource GridTrimmedText}" />
                        <DataGridTextColumn Header="{loc:L 'Port'}" Binding="{Binding TargetPort}" Width="80"
                                            ElementStyle="{StaticResource GridNumberText}" HeaderStyle="{StaticResource GridNumberHeader}" />
                        <DataGridTextColumn Header="{loc:L 'Retries'}" Binding="{Binding Retries}" Width="80"
                                            ElementStyle="{StaticResource GridNumberText}" HeaderStyle="{StaticResource GridNumberHeader}" />
                        <DataGridTextColumn Header="{loc:L 'Auth'}" Binding="{Binding Auth}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
                </scaffold:FillPanel>
                <!-- Not ArrowRouting24: its code point is past U+FFFF, and
                     Wpf.Ui's SymbolIcon draws it as one 16-bit character, so it
                     rendered as a g with a caron (U+01E7). -->
                <!-- The action puts the keyboard in the add form's Domain box
                     below, as the domains page's empty state does. -->
                <scaffold:EmptyState x:Name="EmptyStatus" Icon="ArrowSplit24" Visibility="Collapsed"
                                     AutomationProperties.LiveSetting="Polite">
                    <scaffold:EmptyState.Action>
                        <ui:Button Content="{loc:L 'Add a _route'}" Click="AddRouteAction_Click"
                                   AutomationProperties.AutomationId="routes-add-first" />
                    </scaffold:EmptyState.Action>
                </scaffold:EmptyState>
            </Grid>
        </scaffold:Card>

        <!-- The add form: three fields in a row and the button that adds, on a
             card of its own under the grid so the grid keeps the height. The
             captions share one height (FieldRow.LabelGroup) and Add sits under a
             row of it, so that a message under one box moves none of the others. -->
        <scaffold:Card Title="{loc:L 'Add route'}" Margin="0,12,0,0">
            <Grid x:Name="AddRouteForm" Grid.IsSharedSizeScope="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" MinWidth="80" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <scaffold:FieldRow x:Name="RouteDomainRow" Label="{loc:L 'Do_main (e.g. partner.com)'}" Margin="0,0,8,0" LabelGroup="RouteLine">
                    <ui:TextBox x:Name="NewDomain" />
                </scaffold:FieldRow>
                <scaffold:FieldRow x:Name="RouteHostRow" Grid.Column="1" Label="{loc:L '_Target SMTP host'}" Margin="0,0,8,0" LabelGroup="RouteLine">
                    <ui:TextBox x:Name="NewHost" />
                </scaffold:FieldRow>
                <scaffold:FieldRow x:Name="RoutePortRow" Grid.Column="2" Label="{loc:L 'P_ort'}" Margin="0,0,8,0" LabelGroup="RouteLine">
                    <ui:TextBox x:Name="NewPort" Text="25" />
                </scaffold:FieldRow>
                <Grid Grid.Column="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" SharedSizeGroup="RouteLine" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:Button x:Name="AddRouteButton" Grid.Row="1" Content="{loc:L '_Add'}" Appearance="Primary" Click="Add_Click"
                               VerticalAlignment="Top" Margin="0" />
                </Grid>
            </Grid>
        </scaffold:Card>
        </scaffold:FillPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
