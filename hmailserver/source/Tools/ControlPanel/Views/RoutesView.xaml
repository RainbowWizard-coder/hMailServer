<UserControl
    x:Class="hMailServer.ControlPanel.Views.RoutesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:hMailServer.ControlPanel.Services"
    xmlns:scaffold="clr-namespace:hMailServer.ControlPanel.Views.Scaffold"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="{StaticResource AppPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <scaffold:PageHeader Title="{loc:L 'Routes'}"
                             Subtitle="{loc:L 'Deliver mail for specific domains through a designated SMTP host instead of MX lookup.'}" />

        <scaffold:Toolbar x:Name="SearchBar" Grid.Row="1" SearchPlaceholder="{loc:L 'Search routes'}"
                          SearchTextChanged="Search_TextChanged">
            <scaffold:Toolbar.Actions>
                <StackPanel Orientation="Horizontal">
                    <ui:Button x:Name="PropertiesButton" Content="{loc:L '_Properties'}" Click="Edit_Click" Margin="0,0,8,0" />
                    <ui:Button x:Name="DeleteButton" Content="{loc:L '_Delete selected'}" Style="{StaticResource DangerTextButton}" Click="Delete_Click" />
                </StackPanel>
            </scaffold:Toolbar.Actions>
        </scaffold:Toolbar>

        <!-- A read that failed: Critical, with Try again, in place of the empty
             state, which would say there are no routes (Services/ReadFailure). -->
        <scaffold:InlineNotice x:Name="Notice" Grid.Row="2" Visibility="Collapsed" />

        <scaffold:Card Grid.Row="3" Padding="8">
            <Grid>
                <DataGrid x:Name="RouteGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" MouseDoubleClick="Edit_Click"
                          AutomationProperties.Name="{loc:L 'Routes'}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:L 'Domain'}" Binding="{Binding DomainName}" Width="*" ElementStyle="{StaticResource GridTrimmedText}" />
                        <DataGridTextColumn Header="{loc:L 'Target host'}" Binding="{Binding TargetHost}" Width="*" ElementStyle="{StaticResource GridTrimmedText}" />
                        <DataGridTextColumn Header="{loc:L 'Port'}" Binding="{Binding TargetPort}" Width="80"
                                            ElementStyle="{StaticResource GridNumberText}" HeaderStyle="{StaticResource GridNumberHeader}" />
                        <DataGridTextColumn Header="{loc:L 'Retries'}" Binding="{Binding Retries}" Width="80"
                                            ElementStyle="{StaticResource GridNumberText}" HeaderStyle="{StaticResource GridNumberHeader}" />
                        <DataGridTextColumn Header="{loc:L 'Auth'}" Binding="{Binding Auth}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
                <!-- Not ArrowRouting24: its code point is past U+FFFF, and
                     Wpf.Ui's SymbolIcon draws it as one 16-bit character, so it
                     rendered as a g with a caron (U+01E7). -->
                <scaffold:EmptyState x:Name="EmptyStatus" Icon="ArrowSplit24" Visibility="Collapsed"
                                     AutomationProperties.LiveSetting="Polite" />
            </Grid>
        </scaffold:Card>

        <!-- The add form: three fields in a row and the button that adds, on a
             card of its own under the grid so the grid keeps the height. -->
        <scaffold:Card Grid.Row="4" Title="{loc:L 'Add route'}" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" MinWidth="80" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <scaffold:FieldRow Label="{loc:L 'Domain (e.g. partner.com)'}" Margin="0,0,8,0">
                    <ui:TextBox x:Name="NewDomain" />
                </scaffold:FieldRow>
                <scaffold:FieldRow Grid.Column="1" Label="{loc:L 'Target SMTP host'}" Margin="0,0,8,0">
                    <ui:TextBox x:Name="NewHost" />
                </scaffold:FieldRow>
                <scaffold:FieldRow Grid.Column="2" Label="{loc:L 'Port'}" Margin="0,0,8,0">
                    <ui:TextBox x:Name="NewPort" Text="25" />
                </scaffold:FieldRow>
                <ui:Button x:Name="AddRouteButton" Grid.Column="3" Content="{loc:L '_Add'}" Appearance="Primary" Click="Add_Click"
                           VerticalAlignment="Bottom" Margin="0" />
            </Grid>
        </scaffold:Card>
    </Grid>
</UserControl>
