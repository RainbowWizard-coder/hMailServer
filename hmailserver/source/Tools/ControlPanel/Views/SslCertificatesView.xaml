<UserControl
    x:Class="hMailServer.ControlPanel.Views.SslCertificatesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:hMailServer.ControlPanel.Services"
    xmlns:scaffold="clr-namespace:hMailServer.ControlPanel.Views.Scaffold"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:hMailServer.ControlPanel.Views">

    <UserControl.Resources>
        <!-- The certificates grid's headers wrap at their spaces onto a second line,
             each still whole in its tool tip: six columns in 921 pixels at 1280 by 800
             give the two file columns 113 pixels or so, and their headers were cut in
             twelve languages - "Private Schlüss...", "Archivo de clave pr...", whole in
             German before the file columns were narrowed (the skeptic's review of
             F235 and F236). A header row is one line where every header fits on one,
             and the file columns' floors hold the widest word of their headers in any
             language, Dutch Privésleutelbestand at 106 pixels; a word wider than its
             column still ends in an ellipsis. -->
        <Style x:Key="CertificateGridHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="VerticalContentAlignment" Value="Bottom" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="WrapWithOverflow" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource AppPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <scaffold:PageHeader PageKey="certs"
                             Subtitle="{loc:L 'Certificates available for TLS ports, with what this machine can verify about each: the files, the expiry date, and whether the key belongs to the certificate. With ACME enabled, Let\'s Encrypt certificates appear here automatically.'}">
            <!-- The list page pattern (docs/ControlPanelDesign.md, List pages): the
                 count beside the title and Refresh in the header, the list's own
                 verbs in the toolbar above it (review finding F288). -->
            <scaffold:PageHeader.Status>
                <scaffold:StatusPill x:Name="CountPill" Level="Normal" Visibility="Collapsed"
                                     AutomationProperties.AutomationId="list-count"
                                     AutomationProperties.LiveSetting="Polite" />
            </scaffold:PageHeader.Status>
            <scaffold:PageHeader.Actions>
                <ui:Button x:Name="RefreshButton" Content="{loc:L '_Refresh'}" Click="Refresh_Click" />
            </scaffold:PageHeader.Actions>
        </scaffold:PageHeader>

        <!-- The IP ranges shape: the list takes the height the parts under it
             leave in the window, down to a floor of four rows, and below that
             the page scrolls; every other part keeps its own height. The list
             was a grid's star row between rows sized to their content, so that
             selecting a certificate, which shows the details card under it,
             shrank the list to a strip of six pixels in a 1280 by 800 window:
             the selected row, the other certificates and the column headers all
             vanished while the arrow keys still changed the selection unseen,
             and the only way back to the list was a taller window. -->
        <!-- The bar is drawn over the content, so the right padding (AppSpaceMd)
             keeps the cards, the notices and the toolbar's last button clear of it. -->
        <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,12,0">
        <scaffold:FillPanel ViewportHeight="{Binding ViewportHeight, ElementName=PageScroll}">

        <scaffold:Toolbar x:Name="SearchBar" SearchPlaceholder="{loc:L 'Search certificates'}"
                          SearchTextChanged="Search_TextChanged">
            <scaffold:Toolbar.Actions>
                <!-- Edit... first, the selected row's own verb, then Delete (the list
                     page pattern). Edit keeps the certificate's id, so that every port
                     that presents it keeps it (review finding F235). -->
                <WrapPanel HorizontalAlignment="Right">
                    <ui:Button x:Name="EditButton" Content="{loc:L '_Edit…'}" Click="Edit_Click" Margin="0,2,8,2"
                               AutomationProperties.AutomationId="certs-edit" />
                    <ui:Button x:Name="DeleteButton" Content="{loc:L '_Delete selected'}" Style="{StaticResource DangerTextButton}" Click="Delete_Click" Margin="0,2,0,2"
                               AutomationProperties.HelpText="{loc:L 'Delete the selected certificate'}" ToolTip="{loc:L 'Delete the selected certificate'}" />
                </WrapPanel>
            </scaffold:Toolbar.Actions>
        </scaffold:Toolbar>

        <!-- A load that failed, above the grid rather than in its place. -->
        <scaffold:InlineNotice x:Name="LoadNotice" Visibility="Collapsed" />

        <!-- What the last act did - a certificate saved, deleted - said after the
             list it acted on was read again. -->
        <scaffold:InlineNotice x:Name="OutcomeNotice" Visibility="Collapsed"
                               AutomationProperties.AutomationId="certs-outcome" />

        <!-- The floor: four rows, one more than the IP ranges page's three, so
             that the selected certificate is seen among its neighbours - the
             column headers and four 34-pixel rows and a pixel for layout
             rounding, 170, held by the FillPanel around the grid - and the card
             is floored at what it holds, so that the empty state laid over the
             grid, its sentence and the action that leads to ACME, raises the
             card's floor where it needs more than the rows (review finding
             F207; at a fixed 187 the action was cut off in a short window). -->
        <scaffold:Card scaffold:FillPanel.Fill="True" Padding="8">
            <Grid>
                <!-- Row virtualization is off: the status cells are built in code at
                     Loaded time (the badge needs theme-following brushes a XAML
                     binding cannot express), and container recycling would re-fire
                     Loaded against a different row's data. Certificate lists are a
                     handful of rows, so nothing is lost. Its floor holds four rows
                     under a header of two lines, which the headers wrap to in a
                     language whose file columns' headers are wider than one line
                     (CertificateGridHeader): at 170, the floor of a one-line header,
                     three certificates scrolled in the grid in such a language. -->
                <scaffold:FillPanel>
                <DataGrid x:Name="CertGrid" scaffold:FillPanel.Fill="True" MinHeight="186" AutoGenerateColumns="False" IsReadOnly="True"
                          AutomationProperties.AutomationId="certs-grid"
                          EnableRowVirtualization="False"
                          SelectionMode="Single" SelectionChanged="CertGrid_SelectionChanged" Sorting="CertGrid_Sorting"
                          ColumnHeaderStyle="{StaticResource CertificateGridHeader}"
                          AutomationProperties.Name="{loc:L 'SSL certificates'}">
                    <DataGrid.Columns>
                        <!-- The name takes a share and a floor, and the two path columns the
                             file's name alone, the whole path in its tool tip: the name was
                             cut at 170 pixels while the paths, the same folder on every row,
                             took the rest (review finding F236). Every column is a share of
                             the grid's width with a floor, the name's the largest and the
                             file names', which their tool tips give whole, the smallest: with
                             the two status columns and Used by fixed at 570 pixels, the name
                             was held at its floor at 1280 by 800 and cut there. A narrow window
                             scrolls the grid sideways rather than squeezing the status columns
                             to a word a line and the paths to nothing, as the IP ranges
                             page's floors have it. The file columns' floors hold the widest
                             word of their headers, which wrap, and Used by's the widest word
                             of its header, Ukrainian використовується; Used by takes the least
                             share, the details card saying the selected certificate's ports
                             whole, where a certificate on three ports was "SMTP 587, SMTP 4...".
                             Every column but the name has its floor at 160 times its share, so
                             that all of them reach their floors at one width, and at 1280 by 800
                             they are at their floors and the name takes the rest: the grid gives
                             star columns their floors in one pass and shares out the rest without
                             looking at the floors again, and it takes the 14 pixels its scroll
                             bar needs, when it has more rows than it shows, from its star columns
                             in proportion without passing on what a column at its floor cannot
                             give - with shares that left a column just above its floor, the
                             columns overran the grid by 3 or 4 pixels and it scrolled sideways. -->
                        <DataGridTextColumn Header="{loc:L 'Name'}" Binding="{Binding Name}" Width="1.5*" MinWidth="160" ElementStyle="{StaticResource GridTrimmedText}" />
                        <DataGridTemplateColumn Header="{loc:L 'Certificate file'}" Width="0.8*" MinWidth="128" SortMemberPath="CertificateFile">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CertificateFileName}" ToolTip="{Binding CertificateFile}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Margin="2,0,0,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{loc:L 'Private key file'}" Width="0.8*" MinWidth="128" SortMemberPath="PrivateKeyFile">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding PrivateKeyFileName}" ToolTip="{Binding PrivateKeyFile}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Margin="2,0,0,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- Sorted by how much the certificate asks for attention, then by how
                             soon it expires (CertGrid_Sorting), not by its status word. -->
                        <DataGridTemplateColumn x:Name="CertificateColumn" Header="{loc:L 'Certificate status'}" Width="*" MinWidth="160" SortMemberPath="CertificateState">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentControl Loaded="CertificateBadge_Loaded" IsTabStop="False" Focusable="False" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{loc:L 'Key status'}" Width="*" MinWidth="160" SortMemberPath="PrivateKeyState">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentControl Loaded="KeyBadge_Loaded" IsTabStop="False" Focusable="False" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- The TCP/IP ports that present it, "SMTP 465, IMAP 993" or Not
                             used: the page's purpose is which port uses which, and no
                             column said it (review finding F235). -->
                        <DataGridTextColumn Header="{loc:L 'Used by'}" Binding="{Binding UsedBy}" Width="0.775*" MinWidth="124" ElementStyle="{StaticResource GridTrimmedText}" />
                    </DataGrid.Columns>
                </DataGrid>
                </scaffold:FillPanel>
                <!-- With no certificate, the two ways to get one: the form below,
                     which the sentence names, and ACME, which the action opens. -->
                <scaffold:EmptyState x:Name="EmptyStatus" Icon="Certificate24" Visibility="Collapsed"
                                     AutomationProperties.LiveSetting="Polite">
                    <scaffold:EmptyState.Action>
                        <ui:Button Content="{loc:L '_Set up ACME…'}" Click="SetUpAcme_Click"
                                   AutomationProperties.AutomationId="certs-set-up-acme" />
                    </scaffold:EmptyState.Action>
                </scaffold:EmptyState>
                <!-- Shown while the first inspection runs off the UI thread. -->
                <scaffold:LoadingState x:Name="Loading" Text="{loc:L 'Checking the certificate files…'}" Visibility="Collapsed" />
            </Grid>
        </scaffold:Card>

        <!-- The selected certificate, in full sentences: what was verified, what
             could not be, and the one secret this page can write but will never
             read back - the private key passphrase. The card's title is the
             certificate's name, set from code. -->
        <scaffold:Card x:Name="DetailsCard" Margin="0,12,0,0" Visibility="Collapsed">
            <StackPanel>
                <StackPanel x:Name="DetailsLines" Margin="0,0,0,8" />

                <!-- The editor shows for a key that is or may be encrypted, or has a
                     passphrase stored; for a key the page read as unencrypted with none
                     stored it waits behind Set a passphrase anyway... (review finding
                     F236), where it was offered for a key that needs none. -->
                <ui:Button x:Name="SetPassphraseAnywayButton" Content="{loc:L 'Set a passphrase any_way…'}" Click="SetPassphraseAnyway_Click"
                           Visibility="Collapsed" Margin="0" AutomationProperties.AutomationId="certs-set-passphrase-anyway" />
                <scaffold:FieldRow x:Name="PassphraseRow" Label="{loc:L 'Private _key passphrase'}"
                                   Hint="{loc:L 'Only needed when the key file is encrypted: with an encrypted key and no passphrase, the key does not load (server error 6170) and every TLS port using this certificate does not start - inbound mail on those ports stops. The passphrase is a secret: it is stored protected on the server and never displayed here again, and saving a new one replaces whatever was stored before.'}"
                                   Margin="0">
                    <local:PasswordField x:Name="PassphraseBox" MaxWidth="360" HorizontalAlignment="Left" PlaceholderText="{loc:L 'New passphrase'}" />
                </scaffold:FieldRow>
            </StackPanel>
            <scaffold:Card.Footer>
                <StackPanel x:Name="PassphraseActions" Orientation="Horizontal">
                    <!-- Remove before Save, the Primary, last (review finding F289).
                         Remove can be pressed while a passphrase is stored, or while the
                         page cannot tell, and Save while its box holds one (F236). -->
                    <ui:Button x:Name="ClearPassphraseButton" Content="{loc:L 'Re_move stored passphrase'}" Click="ClearPassphrase_Click" Margin="0,0,8,0"
                               AutomationProperties.HelpText="{loc:L 'Remove the stored private key passphrase from the selected certificate'}" ToolTip="{loc:L 'Remove the stored private key passphrase from the selected certificate'}" />
                    <ui:Button x:Name="SavePassphraseButton" Content="{loc:L 'Save _passphrase'}" Appearance="Primary" Click="SavePassphrase_Click"
                               AutomationProperties.HelpText="{loc:L 'Save the private key passphrase for the selected certificate'}" ToolTip="{loc:L 'Save the private key passphrase for the selected certificate'}" />
                </StackPanel>
            </scaffold:Card.Footer>
        </scaffold:Card>

        <scaffold:Card Title="{loc:L 'Add certificate'}" Margin="0,12,0,0">
            <StackPanel>
                <!-- Two lines of two fields (review finding F236): the name and the
                     passphrase, then the two files, each line's captions as tall as
                     its tallest (FieldRow.LabelGroup), so that the boxes of a line
                     line up whatever a caption wraps to and a message under one box
                     moves none of the others. Five fields shared one line: the
                     passphrase's caption wrapped to two lines in English and three in
                     German, and at 760 pixels the path boxes were 100 pixels wide.
                     Add is the card's own action, in its footer. -->
                <Grid x:Name="AddCertForm" Grid.IsSharedSizeScope="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <scaffold:FieldRow x:Name="NewCertNameRow" Label="{loc:L '_Name'}" Margin="0,0,8,12" LabelGroup="CertNameLine"
                                       Hint="{loc:L 'Filled in from the certificate when you choose its file, while this box is empty.'}">
                        <ui:TextBox x:Name="NewCertName" />
                    </scaffold:FieldRow>
                    <scaffold:FieldRow Grid.Column="1" Label="{loc:L 'Ke_y passphrase (only for an encrypted key)'}" Margin="0,0,0,12" LabelGroup="CertNameLine">
                        <local:PasswordField x:Name="NewKeyPassphrase" />
                    </scaffold:FieldRow>
                    <scaffold:FieldRow x:Name="NewCertFileRow" Grid.Row="1" Label="{loc:L '_Certificate file (PEM)'}" Margin="0,0,8,0" LabelGroup="CertFileLine">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="NewCertFile" />
                            <ui:Button x:Name="BrowseCertButton" Grid.Column="1" Content="{loc:L 'Browse…'}" Click="BrowseCert_Click" Margin="4,0,0,0" />
                        </Grid>
                    </scaffold:FieldRow>
                    <scaffold:FieldRow x:Name="NewKeyFileRow" Grid.Row="1" Grid.Column="1" Label="{loc:L 'Private key _file (PEM)'}" Margin="0" LabelGroup="CertFileLine">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="NewKeyFile" />
                            <ui:Button x:Name="BrowseKeyButton" Grid.Column="1" Content="{loc:L 'Browse…'}" Click="BrowseKey_Click" Margin="4,0,0,0" />
                        </Grid>
                    </scaffold:FieldRow>
                </Grid>
                <!-- What the server reads, and how a .pfx or .p12 is made into it: the
                     search finds this page for "PFX", and the form said nothing of one
                     (review finding F235). The words are the edit dialog's. -->
                <TextBlock x:Name="PemHint" Style="{StaticResource TextCaption}" Margin="0,8,0,0"
                           AutomationProperties.AutomationId="certs-pem-hint" />
                <!-- Filled in by code when the picked key file turns out to be
                     encrypted: that is knowable from the file itself, and saying
                     it now is cheaper than error 6170 after the next restart. -->
                <scaffold:InlineNotice x:Name="AddHint" Margin="0" Visibility="Collapsed" />
            </StackPanel>
            <scaffold:Card.Footer>
                <ui:Button x:Name="AddCertButton" Content="{loc:L '_Add'}" Appearance="Primary" Click="Add_Click" HorizontalAlignment="Left" />
            </scaffold:Card.Footer>
        </scaffold:Card>
        </scaffold:FillPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
