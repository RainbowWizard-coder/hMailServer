<UserControl
    x:Class="hMailServer.ControlPanel.Views.SslCertificatesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:hMailServer.ControlPanel.Services"
    xmlns:scaffold="clr-namespace:hMailServer.ControlPanel.Views.Scaffold"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:hMailServer.ControlPanel.Views">

    <Grid Margin="{StaticResource AppPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <scaffold:PageHeader Title="{loc:L 'SSL certificates'}"
                             Subtitle="{loc:L 'Certificates available for TLS ports, with what this machine can verify about each: the files, the expiry date, and whether the key belongs to the certificate. With ACME enabled, Let\'s Encrypt certificates appear here automatically.'}" />

        <!-- The IP ranges shape: the list takes the height the parts under it
             leave in the window, down to a floor of four rows, and below that
             the page scrolls; every other part keeps its own height. The list
             was a grid's star row between rows sized to their content, so that
             selecting a certificate, which shows the details card under it,
             shrank the list to a strip of six pixels in a 1280 by 800 window:
             the selected row, the other certificates and the column headers all
             vanished while the arrow keys still changed the selection unseen,
             and the only way back to the list was a taller window. -->
        <!-- The bar is drawn over the content, so the right padding (AppSpaceMd)
             keeps the cards, the notices and the toolbar's last button clear of it. -->
        <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,12,0">
        <scaffold:FillPanel ViewportHeight="{Binding ViewportHeight, ElementName=PageScroll}">

        <scaffold:Toolbar x:Name="SearchBar" SearchPlaceholder="{loc:L 'Search certificates'}"
                          SearchTextChanged="Search_TextChanged">
            <scaffold:Toolbar.Actions>
                <ui:Button x:Name="DeleteButton" Content="{loc:L '_Delete selected'}" Style="{StaticResource DangerTextButton}" Click="Delete_Click"
                           AutomationProperties.HelpText="{loc:L 'Delete the selected certificate'}" ToolTip="{loc:L 'Delete the selected certificate'}" />
            </scaffold:Toolbar.Actions>
        </scaffold:Toolbar>

        <!-- A load that failed, above the grid rather than in its place. -->
        <scaffold:InlineNotice x:Name="LoadNotice" Visibility="Collapsed" />

        <!-- The floor: four rows, one more than the IP ranges page's three, so
             that the selected certificate is seen among its neighbours - the
             column headers and four 34-pixel rows and a pixel for layout
             rounding, 170, held by the FillPanel around the grid - and the card
             is floored at what it holds, so that the empty state laid over the
             grid, its sentence and the action that leads to ACME, raises the
             card's floor where it needs more than the rows (review finding
             F207; at a fixed 187 the action was cut off in a short window). -->
        <scaffold:Card scaffold:FillPanel.Fill="True" Padding="8">
            <Grid>
                <!-- Row virtualization is off: the status cells are built in code at
                     Loaded time (the badge needs theme-following brushes a XAML
                     binding cannot express), and container recycling would re-fire
                     Loaded against a different row's data. Certificate lists are a
                     handful of rows, so nothing is lost. -->
                <scaffold:FillPanel>
                <DataGrid x:Name="CertGrid" scaffold:FillPanel.Fill="True" MinHeight="170" AutoGenerateColumns="False" IsReadOnly="True"
                          AutomationProperties.AutomationId="certs-grid"
                          EnableRowVirtualization="False"
                          SelectionMode="Single" SelectionChanged="CertGrid_SelectionChanged"
                          AutomationProperties.Name="{loc:L 'SSL certificates'}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:L 'Name'}" Binding="{Binding Name}" Width="170" ElementStyle="{StaticResource GridTrimmedText}" />
                        <DataGridTextColumn Header="{loc:L 'Certificate file'}" Binding="{Binding CertificateFile}" Width="*" ElementStyle="{StaticResource GridTrimmedText}" />
                        <DataGridTextColumn Header="{loc:L 'Private key file'}" Binding="{Binding PrivateKeyFile}" Width="*" ElementStyle="{StaticResource GridTrimmedText}" />
                        <DataGridTemplateColumn Header="{loc:L 'Certificate'}" Width="210" SortMemberPath="CertificateState">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentControl Loaded="CertificateBadge_Loaded" IsTabStop="False" Focusable="False" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="{loc:L 'Private key'}" Width="210" SortMemberPath="PrivateKeyState">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentControl Loaded="KeyBadge_Loaded" IsTabStop="False" Focusable="False" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                </scaffold:FillPanel>
                <!-- With no certificate, the two ways to get one: the form below,
                     which the sentence names, and ACME, which the action opens. -->
                <scaffold:EmptyState x:Name="EmptyStatus" Icon="Certificate24" Visibility="Collapsed"
                                     AutomationProperties.LiveSetting="Polite">
                    <scaffold:EmptyState.Action>
                        <ui:Button Content="{loc:L '_Set up ACME…'}" Click="SetUpAcme_Click"
                                   AutomationProperties.AutomationId="certs-set-up-acme" />
                    </scaffold:EmptyState.Action>
                </scaffold:EmptyState>
                <!-- Shown while the first inspection runs off the UI thread. -->
                <scaffold:LoadingState x:Name="Loading" Visibility="Collapsed" />
            </Grid>
        </scaffold:Card>

        <!-- The selected certificate, in full sentences: what was verified, what
             could not be, and the one secret this page can write but will never
             read back - the private key passphrase. The card's title is the
             certificate's name, set from code. -->
        <scaffold:Card x:Name="DetailsCard" Margin="0,12,0,0" Visibility="Collapsed">
            <StackPanel>
                <StackPanel x:Name="DetailsLines" Margin="0,0,0,8" />

                <scaffold:FieldRow Label="{loc:L 'Private _key passphrase'}"
                                   Hint="{loc:L 'Only needed when the key file is encrypted: with an encrypted key and no passphrase, the key does not load (server error 6170) and every TLS port using this certificate does not start - inbound mail on those ports stops. The passphrase is a secret: it is stored protected on the server and never displayed here again, and saving a new one replaces whatever was stored before.'}"
                                   Margin="0">
                    <local:PasswordField x:Name="PassphraseBox" MaxWidth="360" HorizontalAlignment="Left" PlaceholderText="{loc:L 'New passphrase'}" />
                </scaffold:FieldRow>
            </StackPanel>
            <scaffold:Card.Footer>
                <StackPanel Orientation="Horizontal">
                    <ui:Button x:Name="SavePassphraseButton" Content="{loc:L 'Save _passphrase'}" Appearance="Primary" Click="SavePassphrase_Click" Margin="0,0,8,0"
                               AutomationProperties.HelpText="{loc:L 'Save the private key passphrase for the selected certificate'}" ToolTip="{loc:L 'Save the private key passphrase for the selected certificate'}" />
                    <ui:Button Content="{loc:L '_Remove stored passphrase'}" Click="ClearPassphrase_Click"
                               AutomationProperties.HelpText="{loc:L 'Remove the stored private key passphrase from the selected certificate'}" ToolTip="{loc:L 'Remove the stored private key passphrase from the selected certificate'}" />
                </StackPanel>
            </scaffold:Card.Footer>
        </scaffold:Card>

        <scaffold:Card Title="{loc:L 'Add certificate'}" Margin="0,12,0,0">
            <StackPanel>
                <Grid x:Name="AddCertForm" Grid.IsSharedSizeScope="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="120" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" MinWidth="160" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Every caption of the line is as tall as the tallest
                         (FieldRow.LabelGroup), and the Add button sits under a row
                         of that height: the passphrase's caption wraps to two lines
                         in a narrow window, and the boxes lined up only while they
                         sat on the line's bottom edge, where a message under one box
                         would lift it above the others and put Add beside the
                         message. -->
                    <scaffold:FieldRow x:Name="NewCertNameRow" Label="{loc:L '_Name'}" Margin="0,0,8,0" LabelGroup="CertLine">
                        <ui:TextBox x:Name="NewCertName" />
                    </scaffold:FieldRow>
                    <scaffold:FieldRow x:Name="NewCertFileRow" Grid.Column="1" Label="{loc:L '_Certificate file (PEM)'}" Margin="0,0,8,0" LabelGroup="CertLine">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="NewCertFile" />
                            <ui:Button Grid.Column="1" Content="…" Click="BrowseCert_Click" Margin="4,0,0,0"
                                       AutomationProperties.Name="{loc:L 'Browse for the certificate file'}" />
                        </Grid>
                    </scaffold:FieldRow>
                    <scaffold:FieldRow x:Name="NewKeyFileRow" Grid.Column="2" Label="{loc:L 'Private key _file (PEM)'}" Margin="0,0,8,0" LabelGroup="CertLine">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="NewKeyFile" />
                            <ui:Button Grid.Column="1" Content="…" Click="BrowseKey_Click" Margin="4,0,0,0"
                                       AutomationProperties.Name="{loc:L 'Browse for the private key file'}" />
                        </Grid>
                    </scaffold:FieldRow>
                    <scaffold:FieldRow Grid.Column="3" Label="{loc:L 'Ke_y passphrase (only for an encrypted key)'}" Margin="0,0,8,0" LabelGroup="CertLine">
                        <local:PasswordField x:Name="NewKeyPassphrase" />
                    </scaffold:FieldRow>
                    <Grid Grid.Column="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" SharedSizeGroup="CertLine" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ui:Button x:Name="AddCertButton" Grid.Row="1" Content="{loc:L '_Add'}" Appearance="Primary" Click="Add_Click"
                                   VerticalAlignment="Top" Margin="0" />
                    </Grid>
                </Grid>
                <!-- Filled in by code when the picked key file turns out to be
                     encrypted: that is knowable from the file itself, and saying
                     it now is cheaper than error 6170 after the next restart. -->
                <scaffold:InlineNotice x:Name="AddHint" Margin="0" Visibility="Collapsed" />
            </StackPanel>
        </scaffold:Card>
        </scaffold:FillPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
