<UserControl
    x:Class="hMailServer.ControlPanel.Views.LogsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:hMailServer.ControlPanel.Services"
    xmlns:scaffold="clr-namespace:hMailServer.ControlPanel.Views.Scaffold"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="{StaticResource AppPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <scaffold:PageHeader x:Name="Header" PageKey="logs"
                             Subtitle="{loc:L 'The server log as it is written, read from the log folder on this computer.'}">
            <!-- How many lines the page holds, and how many of them the filter and
                 the type boxes leave on screen (review finding F250). Not a live
                 region: it changes with every line the server writes. -->
            <scaffold:PageHeader.Status>
                <scaffold:StatusPill x:Name="LineCount" Level="Normal" Visibility="Collapsed"
                                     AutomationProperties.AutomationId="logs-count" />
            </scaffold:PageHeader.Status>
            <scaffold:PageHeader.Actions>
                <StackPanel Orientation="Horizontal">
                    <!-- Which of the server's logs: the day's, its errors, the script
                         events, the backup, and each protocol's own while the server
                         writes them apart (review finding F249). -->
                    <Label Content="{loc:L '_Log'}" Target="{Binding ElementName=LogPicker}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="LogPicker" MinWidth="170" Margin="0,0,8,0" VerticalAlignment="Center"
                              SelectionChanged="LogPicker_SelectionChanged"
                              AutomationProperties.AutomationId="logs-picker" />
                    <!-- Pause view, with a glyph of its own: it freezes the lines shown,
                         where Server status's Pause the mail server, beside it in the
                         sidebar with the same glyph and word, stops the server (review
                         finding F019). -->
                    <ui:Button x:Name="PauseButton" Content="{loc:L '_Pause view'}" Click="Pause_Click" Margin="0,0,8,0">
                        <ui:Button.Icon><ui:SymbolIcon x:Name="PauseButtonIcon" Symbol="PauseCircle24" /></ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Content="{loc:L '_Clear view'}" Click="Clear_Click"
                               ToolTip="{loc:L 'Clears the lines shown here. The log file is not changed.'}">
                        <ui:Button.Icon><ui:SymbolIcon Symbol="Broom24" /></ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </scaffold:PageHeader.Actions>
        </scaffold:PageHeader>

        <!-- The log's severity palette (Log*Brush) is the viewer's own and not a
             design token; each line holds one of ThemeTokens' shared brushes, which
             are recoloured in place on a theme change. Extended selection: lines are
             chosen as a list's rows are (click, Shift+click, Ctrl+click, Ctrl+A) and
             copied with Ctrl+C or the list's menu - see the code-behind. Each line is
             laid out as its time, type, thread, session and text, the file's quotes
             taken off (Services/LiveLogFiles), the columns as wide as their widest
             line in view; a copy is the line as the file has it. What keeps the log
             from being shown - no folder, no file yet, a file the Control Panel may
             not read - is the empty state in the list's place.
             A line is the application's list row (App.xaml), the hover grey, the
             selection fill and pill and the keyboard's ring, made dense: no height
             floor, no gap between lines, its content past the pill as every list
             row's is. The palette is measured on those surfaces (ContrastTokensTests);
             with a style of its own the list took the system's row, whose blue
             selection put the dark lines at 3.8 to 3.9:1, and its grey one, once
             the list lost the keyboard, at 2.9 to 3.0:1. -->
        <!-- The lines narrowed to what is being followed: the words typed in - an
             address, a host, session=42 - and the line types, each box drawn in its
             lines' colour so that the boxes are the colours' legend, and the long
             lines wrapped or scrolled sideways (review finding F250). Only Pause and
             Clear view were here, over a screenful of lines a second. -->
        <!-- The routes page's shape: the log takes the height the toolbar leaves in
             the window, down to a floor of three lines' card, and below that the page
             scrolls, so that in the narrowest window (760 by 520) the toolbar's second
             row does not leave the log and what its empty states say a sliver. The bar
             is drawn over the content; the right padding keeps the toolbar clear of it. -->
        <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,12,0">
        <scaffold:FillPanel ViewportHeight="{Binding ViewportHeight, ElementName=PageScroll}">

        <scaffold:Toolbar x:Name="LineFilter" Margin="{StaticResource AppCardGap}"
                          SearchPlaceholder="{loc:L 'Filter lines: an address, any words, or session=42'}"
                          SearchTextChanged="LineFilter_SearchTextChanged">
            <scaffold:Toolbar.Filters>
                <WrapPanel x:Name="TypeBoxes" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ShowSmtp" MinWidth="0" Content="{loc:L '_SMTP'}" IsChecked="True" Tag="Smtp" Click="TypeBox_Click"
                              Foreground="{DynamicResource LogSmtpBrush}" Margin="0,2,12,2" AutomationProperties.AutomationId="logs-type-smtp" />
                    <CheckBox x:Name="ShowImap" MinWidth="0" Content="{loc:L '_IMAP'}" IsChecked="True" Tag="Imap" Click="TypeBox_Click"
                              Foreground="{DynamicResource LogImapBrush}" Margin="0,2,12,2" AutomationProperties.AutomationId="logs-type-imap" />
                    <CheckBox x:Name="ShowPop3" MinWidth="0" Content="{loc:L 'POP_3'}" IsChecked="True" Tag="Pop3" Click="TypeBox_Click"
                              Foreground="{DynamicResource LogPop3Brush}" Margin="0,2,12,2" AutomationProperties.AutomationId="logs-type-pop3" />
                    <CheckBox x:Name="ShowApplication" MinWidth="0" Content="{loc:L '_Application'}" IsChecked="True" Tag="Application" Click="TypeBox_Click"
                              Foreground="{DynamicResource LogAppBrush}" Margin="0,2,12,2" AutomationProperties.AutomationId="logs-type-application" />
                    <CheckBox x:Name="ShowDebug" MinWidth="0" Content="{loc:L '_Debug'}" IsChecked="True" Tag="Debug" Click="TypeBox_Click"
                              Foreground="{DynamicResource LogDefaultBrush}" Margin="0,2,12,2" AutomationProperties.AutomationId="logs-type-debug" />
                    <CheckBox x:Name="ShowErrors" MinWidth="0" Content="{loc:L 'E_rrors'}" IsChecked="True" Tag="Error" Click="TypeBox_Click"
                              Foreground="{DynamicResource LogErrorBrush}" Margin="0,2,12,2" AutomationProperties.AutomationId="logs-type-errors" />
                </WrapPanel>
            </scaffold:Toolbar.Filters>
            <scaffold:Toolbar.Actions>
                <CheckBox x:Name="WrapLines" Content="{loc:L '_Wrap lines'}" Click="WrapLines_Click" Margin="0,2,0,2"
                          AutomationProperties.AutomationId="logs-wrap" />
            </scaffold:Toolbar.Actions>
        </scaffold:Toolbar>

        <scaffold:Card scaffold:FillPanel.Fill="True" MinHeight="157" Padding="4">
            <Grid>
                <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                         FontFamily="Cascadia Mono, Consolas" FontSize="12"
                         Grid.IsSharedSizeScope="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         AutomationProperties.Name="{loc:L 'Live logs'}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="10,0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LogTime" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LogType" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LogThread" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LogSession" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Time}" Foreground="{Binding Brush}" Margin="0,0,12,0"
                                           LineHeight="17" LineStackingStrategy="BlockLineHeight" />
                                <TextBlock Grid.Column="1" Text="{Binding Type}" Foreground="{Binding Brush}" Margin="0,0,12,0"
                                           LineHeight="17" LineStackingStrategy="BlockLineHeight" />
                                <TextBlock Grid.Column="2" Text="{Binding Thread}" Foreground="{Binding Brush}" Margin="0,0,12,0" TextAlignment="Right"
                                           LineHeight="17" LineStackingStrategy="BlockLineHeight" />
                                <TextBlock Grid.Column="3" Text="{Binding Session}" Foreground="{Binding Brush}" Margin="0,0,12,0" TextAlignment="Right"
                                           LineHeight="17" LineStackingStrategy="BlockLineHeight" />
                                <TextBlock x:Name="MessageText" Grid.Column="4" Text="{Binding Message}" Foreground="{Binding Brush}" TextWrapping="NoWrap"
                                           LineHeight="17" LineStackingStrategy="BlockLineHeight" />
                            </Grid>
                            <!-- Wrap lines: the text folds at the list's width, which the
                                 list then keeps to (LogsView.WrapLines_Click). -->
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="wrap">
                                    <Setter TargetName="MessageText" Property="TextWrapping" Value="Wrap" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <scaffold:EmptyState x:Name="Problem" Icon="DocumentBulletList24" Visibility="Collapsed"
                                     AutomationProperties.AutomationId="logs-problem" />
                <!-- Lines read that the filter and the type boxes all hide: said over
                     the list, which goes on following the log under it. -->
                <scaffold:EmptyState x:Name="NoMatch" Icon="Filter24" Visibility="Collapsed"
                                     AutomationProperties.AutomationId="logs-no-match" />
            </Grid>
        </scaffold:Card>
        </scaffold:FillPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
