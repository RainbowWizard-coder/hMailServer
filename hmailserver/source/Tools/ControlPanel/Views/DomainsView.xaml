<UserControl
    x:Class="hMailServer.ControlPanel.Views.DomainsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:hMailServer.ControlPanel.Services"
    xmlns:scaffold="clr-namespace:hMailServer.ControlPanel.Views.Scaffold"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:hMailServer.ControlPanel.Views">

    <UserControl.Resources>
        <!-- The rows of the four lists carry a four-pixel margin of their own,
             and their heights are what the page's floors are built on, so the
             list row keeps its vertical inset out of them and adds six pixels at
             the sides alone: with the row's own four the content starts where a
             grid cell's does, past the pill, where at nothing the pill touched
             the domain's glyph. The application's row (App.xaml) keeps the full
             inset for a list whose rows are bare, as the incoming relays' are. -->
        <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
            <Setter Property="Padding" Value="6,0" />
        </Style>
        <!-- The three parts of a domain or account row that follow its Active
             flag. An inactive row used to be dimmed whole, at 0.55, with the
             word "inactive" in italics inside the dimmed part: the word was the
             least legible text on the page (2.4:1 in the light theme) and the
             name measured 3.9:1. Now only the glyph dims; the name takes the
             secondary text, which clears 4.5:1; and the word is a Normal
             StatusPill at full opacity, whose neutral box reads on a plain, a
             hovered and a selected row alike. -->
        <Style x:Key="RowGlyphDimsWhenInactive" TargetType="Border">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Active}" Value="False">
                    <Setter Property="Opacity" Value="0.55" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RowInactivePill" TargetType="scaffold:StatusPill" BasedOn="{StaticResource {x:Type scaffold:StatusPill}}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Active}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RowName" TargetType="TextBlock" BasedOn="{StaticResource GridTrimmedText}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Active}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource AppPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <scaffold:PageHeader Title="{loc:L 'Domains &amp; accounts'}"
                             Subtitle="{loc:L 'Manage the domains hosted by this server and their mailboxes.'}" />

        <!-- A read that failed: Critical, with Try again, in place of the empty
             state, which would say there are no domains, or no accounts
             (Services/ReadFailure). At the page's width, not in the card whose
             list it is about: in the domains card, 280 pixels wide, the sentence
             stood beside its button as a column of two words a line. -->
        <StackPanel Grid.Row="1">
            <scaffold:InlineNotice x:Name="DomainNotice" Visibility="Collapsed" />
            <scaffold:InlineNotice x:Name="AccountNotice" Visibility="Collapsed" />
        </StackPanel>

        <!-- Every list takes the height the parts around it leave in the window,
             down to a floor of three rows, and below that the page scrolls; every
             other part keeps its own height. The page held a grid to the window
             over a fixed 640 pixels, which knew nothing of how tall the forms are:
             in the narrowest window the alias form ran past those 640 pixels,
             where scrolling could not reach it, and the alias list had no height
             at all. FillPanel sizes the page from the parts themselves: the
             domains card fills its column, and the accounts card and the row of
             alias and list cards share theirs three to two, as the two rows did.
             Where the window is too narrow for two columns - the domains column
             280 pixels, the other 400 - the domains card goes above the accounts
             card and the three share one column, two, three and two
             (DomainsView.ArrangeColumns). -->
        <!-- The bar is drawn over the content, so the right padding (AppSpaceMd)
             keeps the cards, the notices and the toolbar's last button clear of it. -->
        <ScrollViewer x:Name="PageScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,12,0">
        <Grid x:Name="PageColumns" SizeChanged="PageColumns_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <scaffold:FillPanel x:Name="DomainColumn" ViewportHeight="{Binding ViewportHeight, ElementName=PageScroll}">

            <!-- Domain list -->
            <scaffold:Card x:Name="DomainCard" scaffold:FillPanel.Fill="True" scaffold:FillPanel.Weight="2"
                           Margin="0,0,12,0" Padding="12" AutomationProperties.Name="{loc:L 'Domains'}">
                <scaffold:FillPanel>
                    <scaffold:Toolbar x:Name="DomainSearch" SearchPlaceholder="{loc:L 'Search domains'}"
                                      SearchTextChanged="DomainSearch_TextChanged" Margin="0,0,0,8" />
                    <!-- The add form at the top of the card, under the search, and
                         the list under it - on every card of this page. At the foot
                         of a card that fills the window, the form was the first
                         thing a short window hid: in a 1280 by 800 window the detail
                         column's floors are taller than the page, so the page
                         scrolls, the domains card stretches to the column's height,
                         and its Domain box and Add domain sat in the hidden bottom
                         90 pixels; on an empty server the card said "No domains
                         yet. Add the first one" with nothing to press on screen.
                         At the top, the thing to do is on screen whatever the
                         window's height. -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <scaffold:FieldRow Label="{loc:L 'Do_main'}" Margin="0,0,8,0">
                            <ui:TextBox x:Name="NewDomainBox" PlaceholderText="newdomain.com" />
                        </scaffold:FieldRow>
                        <ui:Button x:Name="AddDomainButton" Grid.Column="1" Content="{loc:L '_Add domain'}" Click="AddDomain_Click"
                                   AutomationProperties.AutomationId="domains-add"
                                   VerticalAlignment="Bottom" Margin="0" />
                    </Grid>
                    <!-- The list's floor is three rows of 40 pixels, the pixel a
                         ListView keeps above and below its rows and one for layout
                         rounding, 123 (at 120 it held two whole rows, and scrolled
                         to its end a blank one), held by the FillPanel around it,
                         so that the empty state laid over it when there are none
                         raises the card's floor where its sentence needs more than
                         the rows. -->
                    <Grid scaffold:FillPanel.Fill="True">
                        <!-- A row is the list's width, never wider: a name longer than
                             the room ends in an ellipsis, whole in its tool tip, and
                             Properties and Delete stay on the row. Scrolled sideways,
                             one long domain name put every row's buttons off the
                             list's right edge, in the narrowest window every row's. -->
                        <scaffold:FillPanel>
                            <ListView x:Name="DomainList" scaffold:FillPanel.Fill="True" MinHeight="123" SelectionChanged="DomainList_SelectionChanged"
                                      AutomationProperties.AutomationId="domains-grid"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                                      AutomationProperties.Name="{loc:L 'Domains'}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <!-- The names take the theme's text colour themselves: left to
                                                 the list item's, they were drawn near-black on the dark
                                                 theme's card, and a domain that was not selected could
                                                 not be read. -->
                                            <!-- An inactive domain dims its glyph AND says so in words: opacity
                                                 alone does not survive High Contrast, a projector, or a
                                                 screen reader, and the word alone is easy to scan past.
                                                 The word is a pill and the name stays legible (the styles
                                                 above). A DockPanel, not a StackPanel, so that the name can
                                                 be cut short while the pill stays right after it. -->
                                            <DockPanel HorizontalAlignment="Left">
                                                <Border DockPanel.Dock="Left" Style="{StaticResource RowGlyphDimsWhenInactive}">
                                                    <ui:SymbolIcon Symbol="Globe24" Foreground="{DynamicResource AppBrandBrush}" />
                                                </Border>
                                                <scaffold:StatusPill DockPanel.Dock="Right" Level="Normal" Text="{loc:L 'Inactive'}" Margin="8,0,0,0"
                                                                     Style="{StaticResource RowInactivePill}" />
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource RowName}" Margin="10,0,0,0" FontSize="14"
                                                           VerticalAlignment="Center" />
                                            </DockPanel>
                                            <ui:Button Grid.Column="1" Content="{loc:L 'Properties'}" FontSize="12" Padding="8,3" Margin="6,0,6,0"
                                                       Tag="{Binding Name}" Click="EditDomain_Click" />
                                            <!-- Every row delete on the page is a DangerTextButton: the
                                                 style's danger fill-text shade clears 4.5:1 on the button
                                                 in both themes and greys when the button is disabled, where
                                                 a local AppDangerBrush measured 3.3:1 in the dark theme and
                                                 outranked the disabled state. -->
                                            <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Delete24}" Padding="6,3"
                                                       Style="{StaticResource DangerTextButton}"
                                                       ToolTip="{loc:L 'Delete domain'}" AutomationProperties.Name="{loc:L 'Delete domain'}"
                                                       Tag="{Binding Name}" Click="DeleteDomain_Click" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </scaffold:FillPanel>
                        <!-- The empty state's action puts the keyboard in the Domain
                             box above, the next thing to do on an empty server. -->
                        <scaffold:EmptyState x:Name="DomainStatus" Icon="Globe24" Visibility="Collapsed"
                                             Padding="12" AutomationProperties.LiveSetting="Polite">
                            <scaffold:EmptyState.Action>
                                <ui:Button Content="{loc:L 'Add a _domain'}" Click="AddDomainAction_Click" />
                            </scaffold:EmptyState.Action>
                        </scaffold:EmptyState>
                    </Grid>
                </scaffold:FillPanel>
            </scaffold:Card>
            </scaffold:FillPanel>

            <scaffold:FillPanel x:Name="DetailColumn" Grid.Column="1" ViewportHeight="{Binding ViewportHeight, ElementName=PageScroll}">

            <!-- Accounts for the selected domain. The card's title names the
                 domain, set from code. -->
            <scaffold:Card x:Name="AccountsCard" scaffold:FillPanel.Fill="True" scaffold:FillPanel.Weight="3"
                           Title="{loc:L 'Select a domain'}" Padding="12">
                <scaffold:FillPanel>
                    <scaffold:Toolbar x:Name="AccountSearch" SearchPlaceholder="{loc:L 'Search accounts'}"
                                      SearchTextChanged="AccountSearch_TextChanged" Margin="0,0,0,8" />

                    <!-- The address has the card's width, on a line of its own:
                         beside the password and both buttons it was squeezed to
                         "user@ex" in a 1000-pixel window, and an address is what a
                         new administrator most needs to see whole. The password
                         keeps Generate and Create account beside it while they fit
                         beside a password box of 120 pixels, and they go on a line
                         of their own under it where they do not
                         (AccountForm_SizeChanged): in the narrowest window Create
                         account ran off the card's right edge. Above the list, as
                         every form on this page is. -->
                    <Grid x:Name="AccountForm" Margin="0,0,0,12" SizeChanged="AccountForm_SizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <scaffold:FieldRow Grid.ColumnSpan="2" Label="{loc:L 'Add_ress'}">
                            <ui:TextBox x:Name="NewAccountBox" PlaceholderText="user@domain" />
                        </scaffold:FieldRow>
                        <scaffold:FieldRow x:Name="PasswordRow" Grid.Row="1" Label="{loc:L '_Password'}" Margin="0,0,8,0">
                            <local:PasswordField x:Name="NewAccountPassword" />
                        </scaffold:FieldRow>
                        <WrapPanel x:Name="AccountButtons" Grid.Row="1" Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                            <ui:Button Content="{loc:L '_Generate'}" Margin="0,0,8,0"
                                       Click="GenerateAccountPassword_Click"
                                       ToolTip="{loc:L 'Generate a strong password (copied to clipboard)'}" />
                            <ui:Button x:Name="AddAccountButton" Content="{loc:L '_Create account'}" Appearance="Primary" Click="AddAccount_Click"
                                       AutomationProperties.AutomationId="domains-accounts" Margin="0" />
                        </WrapPanel>
                    </Grid>

                    <!-- The floor: three rows of 38 pixels, the list's own pixel above and below them, and one for layout rounding. -->
                    <Grid scaffold:FillPanel.Fill="True">
                        <scaffold:FillPanel>
                            <ListView x:Name="AccountList" scaffold:FillPanel.Fill="True" MinHeight="117" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      AutomationProperties.Name="{loc:L 'Accounts'}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <DockPanel HorizontalAlignment="Left">
                                                <Border DockPanel.Dock="Left" Style="{StaticResource RowGlyphDimsWhenInactive}">
                                                    <ui:SymbolIcon Symbol="Person24" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                                <scaffold:StatusPill DockPanel.Dock="Right" Level="Normal" Text="{loc:L 'Inactive'}" Margin="8,0,0,0"
                                                                     Style="{StaticResource RowInactivePill}" />
                                                <TextBlock Text="{Binding Address}" Style="{StaticResource RowName}" Margin="10,0,0,0" FontSize="14"
                                                           VerticalAlignment="Center" />
                                            </DockPanel>
                                            <ui:Button Grid.Column="1" Content="{loc:L 'Edit'}" FontSize="12" Padding="8,3" Margin="6,0,6,0"
                                                       Tag="{Binding Address}" Click="EditAccount_Click" />
                                            <ui:Button Grid.Column="2" Content="{loc:L 'Delete'}" Style="{StaticResource DangerTextButton}" FontSize="12"
                                                       Padding="8,3" Tag="{Binding Address}" Click="DeleteAccount_Click" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </scaffold:FillPanel>
                        <scaffold:EmptyState x:Name="AccountStatus" Icon="Person24" Visibility="Collapsed"
                                             Padding="12" AutomationProperties.LiveSetting="Polite" />
                    </Grid>
                </scaffold:FillPanel>
            </scaffold:Card>

            <!-- Aliases + distribution lists: side by side, or one above the
                 other where the column is narrower than two cards of 280 pixels
                 (DomainsView.ListCards_SizeChanged). Side by side in a 760-pixel
                 window they were 104 and 116 pixels wide, and the list's address
                 box 13. -->
            <UniformGrid x:Name="ListCards" scaffold:FillPanel.Fill="True" scaffold:FillPanel.Weight="2"
                         Columns="2" Margin="0,12,0,0" SizeChanged="ListCards_SizeChanged">

                <scaffold:Card x:Name="AliasCard" Title="{loc:L 'Aliases'}" Padding="12" Margin="0,0,6,0">
                    <scaffold:FillPanel>
                        <!-- Captioned, as the account row above is. The example
                             placeholders were the whole caption of these two boxes,
                             and half a card is too narrow for them: they read
                             "alias@domai" and "target@anyw", and at 1000 pixels
                             "alia" and "targ", with nothing to name either box.
                             One above the other, so that each box has the card's
                             width however narrow the window. Above the list: at
                             the foot of the card the form was below the fold in a
                             1280 by 800 window. -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <scaffold:FieldRow Grid.ColumnSpan="2" Label="{loc:L 'Alias addr_ess'}" Margin="0,0,0,8">
                                <ui:TextBox x:Name="NewAliasName" PlaceholderText="alias@domain" FontSize="12" />
                            </scaffold:FieldRow>
                            <scaffold:FieldRow Grid.Row="1" Label="{loc:L 'Deli_vers to'}" Margin="0,0,6,0">
                                <ui:TextBox x:Name="NewAliasValue" PlaceholderText="target@anywhere" FontSize="12" />
                            </scaffold:FieldRow>
                            <ui:Button x:Name="AddAliasButton" Grid.Row="1" Grid.Column="1" Content="{loc:L 'Add a_lias'}" FontSize="12" Click="AddAlias_Click"
                                       VerticalAlignment="Bottom" Margin="0"
                                       AutomationProperties.Name="{loc:L 'Add alias'}" />
                        </Grid>
                        <!-- The floor: three rows of 34 pixels (a row is its 24-pixel
                             button and the margins around it), the list's own pixel
                             above and below them, and one for layout rounding. -->
                        <Grid scaffold:FillPanel.Fill="True">
                            <scaffold:FillPanel>
                                <ListView x:Name="AliasList" scaffold:FillPanel.Fill="True" MinHeight="105" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          AutomationProperties.Name="{loc:L 'Aliases'}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Display}" Style="{StaticResource GridTrimmedText}" FontSize="12" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <!-- A 24-pixel box at least, as the domain and account rows' buttons are. -->
                                                <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Delete24}" Padding="4" MinWidth="24" MinHeight="24" Margin="6,0,0,0"
                                                           Style="{StaticResource DangerTextButton}"
                                                           ToolTip="{loc:L 'Delete alias'}" AutomationProperties.Name="{loc:L 'Delete alias'}"
                                                           Tag="{Binding Name}" Click="DeleteAlias_Click" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </scaffold:FillPanel>
                            <scaffold:EmptyState x:Name="AliasStatus" Visibility="Collapsed" Padding="12"
                                                 AutomationProperties.LiveSetting="Polite" />
                        </Grid>
                    </scaffold:FillPanel>
                </scaffold:Card>

                <scaffold:Card x:Name="DistCard" Title="{loc:L 'Distribution lists'}" Padding="12" Margin="6,0,0,0">
                    <scaffold:FillPanel>
                        <!-- Above the list, as the alias form is. -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <scaffold:FieldRow Label="{loc:L 'L_ist address'}" Margin="0,0,6,0">
                                <ui:TextBox x:Name="NewDistAddress" PlaceholderText="list@domain" FontSize="12" />
                            </scaffold:FieldRow>
                            <ui:Button x:Name="AddListButton" Grid.Column="1" Content="{loc:L 'Add li_st'}" FontSize="12" Click="AddDistList_Click"
                                       VerticalAlignment="Bottom" Margin="0"
                                       AutomationProperties.HelpText="{loc:L 'Add distribution list'}" ToolTip="{loc:L 'Add distribution list'}" />
                        </Grid>
                        <!-- The floor: three rows of 34 pixels, the list's own pixel
                             above and below them, and one for layout rounding. -->
                        <Grid scaffold:FillPanel.Fill="True">
                            <scaffold:FillPanel>
                                <ListView x:Name="DistList" scaffold:FillPanel.Fill="True" MinHeight="105" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          AutomationProperties.Name="{loc:L 'Distribution lists'}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <!-- The address is the row's one datum, and three
                                                 buttons took most of a half-width card from it:
                                                 beside Properties and Members as words, at 10
                                                 pixels, the rows read "everyone@e..." and
                                                 "board@exa..." in a 1280 by 800 window. The
                                                 three are glyphs in 24-pixel boxes, as the domain
                                                 and account rows' buttons are, each named for its
                                                 row in its tool tip and to a screen reader. -->
                                            <Grid Margin="4,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Address}" Style="{StaticResource GridTrimmedText}" FontSize="12" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <ui:Button Grid.Column="1" Icon="{ui:SymbolIcon Settings24}" Padding="4" MinWidth="24" MinHeight="24" Margin="6,0,4,0"
                                                           ToolTip="{Binding PropertiesName}" AutomationProperties.Name="{Binding PropertiesName}"
                                                           Tag="{Binding Address}" Click="EditDistList_Click" />
                                                <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon People24}" Padding="4" MinWidth="24" MinHeight="24" Margin="0,0,4,0"
                                                           ToolTip="{Binding MembersName}" AutomationProperties.Name="{Binding MembersName}"
                                                           Tag="{Binding Address}" Click="EditRecipients_Click" />
                                                <ui:Button Grid.Column="3" Icon="{ui:SymbolIcon Delete24}" Padding="4" MinWidth="24" MinHeight="24"
                                                           Style="{StaticResource DangerTextButton}"
                                                           ToolTip="{loc:L 'Delete distribution list'}" AutomationProperties.Name="{loc:L 'Delete distribution list'}"
                                                           Tag="{Binding Address}" Click="DeleteDistList_Click" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </scaffold:FillPanel>
                            <scaffold:EmptyState x:Name="DistStatus" Visibility="Collapsed" Padding="12"
                                                 AutomationProperties.LiveSetting="Polite" />
                        </Grid>
                    </scaffold:FillPanel>
                </scaffold:Card>
            </UniformGrid>
            </scaffold:FillPanel>
        </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
