<UserControl
    x:Class="hMailServer.ControlPanel.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:hMailServer.ControlPanel.Services"
    xmlns:scaffold="clr-namespace:hMailServer.ControlPanel.Views.Scaffold"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <UserControl.Resources>
        <!-- A KPI card that opens the page its figure comes from (review finding
             F242): the card's surface, outline and radius, the hover fill of a
             card that can be pointed at (AppCardHoverBrush), and while the
             keyboard is on it a ring in the focus colour drawn over the outline,
             so that nothing moves. The five cards were figures that led nowhere. -->
        <Style x:Key="KpiCardButton" TargetType="Button">
            <Setter Property="Padding" Value="{StaticResource AppCardPadding}" />
            <Setter Property="MinHeight" Value="96" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bd" Background="{DynamicResource AppCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource AppCardBorderBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource AppCardCornerRadius}"
                                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <Border x:Name="Ring" BorderBrush="{DynamicResource AppFocusBrush}" BorderThickness="2"
                                    CornerRadius="{StaticResource AppCardCornerRadius}" Visibility="Collapsed"
                                    IsHitTestVisible="False" SnapsToDevicePixels="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppCardHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- The first page on the scaffold, and the pattern for the rest: the page
         owns its ScrollViewer with AppPagePadding, a PageHeader at the top, Cards
         for the surfaces, a StatusPill where a state is shown. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="{StaticResource AppPagePadding}">
        <StackPanel>
            <scaffold:PageHeader x:Name="Header" PageKey="dashboard"
                                 Subtitle="{loc:L 'Live server statistics, refreshed every 2 seconds.'}" />

            <!-- A read of the statistics that failed, said once, at Critical when
                 the link went - the level the shell's pill gives a lost link - with
                 Try again (Services/ReadFailure). Before, the page put "Connection to
                 the server lost." in its grey subtitle, with no mark, word or colour. -->
            <scaffold:InlineNotice x:Name="ReadNotice" Visibility="Collapsed" Margin="{StaticResource AppCardGap}"
                                   AutomationProperties.AutomationId="dashboard-read-failure" />

            <!-- A newer release waiting, in one line with the page that installs it
                 (Views/UpdateNotice); nothing while there is none. -->
            <StackPanel x:Name="UpdateNoticeHost" Visibility="Collapsed" />

            <!-- "Needs attention" summary. The dashboard is the page an
                 administrator lands on, so the one question the setup checklist
                 can answer - "is this server actually set up, and if not
                 what next?" - is answered here too, or it is only answered for
                 people who already knew where to look. The checks themselves are
                 ExternalSetupChecks, the same code that page runs, so the two can
                 never disagree. State is shown as colour + shape + word (the
                 pill), never colour alone, and each item that needs action is one
                 click from the page that fixes it. The check starts after first
                 paint and its DNS half runs off the UI thread, so this card never
                 delays the dashboard. The Server status page's configuration
                 checks come first, the most severe first, each with the page that
                 puts it right; then the checklist's next step and two more, and
                 one line for the rest, which opens the checklist (review finding
                 F242): the card listed every open step, eleven to fourteen rows
                 on a new server, and the figures and charts went below the fold. -->
            <scaffold:Card Margin="{StaticResource AppCardGap}" AutomationProperties.Name="{loc:L 'Needs attention'}"
                           AutomationProperties.AutomationId="dashboard-verdict">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <scaffold:StatusPill x:Name="AttentionPill" Margin="0,0,12,0" VerticalAlignment="Top"
                                             Visibility="Collapsed" />
                        <TextBlock x:Name="AttentionSummary" Grid.Column="1" Style="{StaticResource TextBodyStrong}"
                                   VerticalAlignment="Center"
                                   Text="{loc:L 'Checking what this server still needs done outside it…'}" />
                        <!-- Names the page it opens and ends in no ellipsis: it asks
                             nothing (review findings F305, F042). -->
                        <ui:Button x:Name="OpenExternalSetupButton" Grid.Column="2" Content="{loc:L 'Open Setup _checklist'}"
                                   Appearance="Transparent" Style="{StaticResource CompactPageLink}"
                                   VerticalAlignment="Top" Click="OpenExternalSetup_Click"
                                   ToolTip="{loc:L 'Open the setup checklist: every item, what is done and what to do next'}"
                                   AutomationProperties.HelpText="{loc:L 'Open the setup checklist: every item, what is done and what to do next'}"
                                   AutomationProperties.AutomationId="dashboard-open-external-setup" />
                    </Grid>
                    <StackPanel x:Name="AttentionItems" Margin="0,4,0,0" />
                    <TextBlock x:Name="AttentionNote" Style="{StaticResource TextCaption}" Margin="0,6,0,0"
                               Visibility="Collapsed" />
                    <!-- Values the server answered without: a Warning, as the setup
                         checklist says it, where it was a grey caption. -->
                    <scaffold:InlineNotice x:Name="AttentionReadNotice" Level="Warning" Visibility="Collapsed"
                                           Margin="0,8,0,0" />
                </StackPanel>
            </scaffold:Card>

            <!-- KPI row: fixed-height cards, value top-aligned, label bottom-anchored,
                 each a button to the page its figure is read on: the uptime and
                 the messages processed to Server status, the queue to the
                 Delivery queue, the spam to the spam overview and the viruses to
                 the virus overview (KpiCardButton, review finding F242). Every
                 value is at KpiValue's 28 pixels - Uptime was 20 beside four at 28
                 (review finding F305) - in a Viewbox that only shrinks it, so that
                 a value wider than its card is drawn smaller and whole, where at
                 760 pixels "128,431" was cut to "128,43".

                 The accessible name of each value is set in code to "label, value"
                 on every refresh. AutomationProperties.LabeledBy looks like the
                 right tool and is not: on a TextBlock it *replaces* the announced
                 name, so a screen reader would read "In queue" and never say the
                 number.

                 Every value starts as a dash, which is what it shows while the
                 statistics cannot be read: a 0 here is a count, and "In queue 0"
                 is a statement the page cannot make before it has asked. -->
            <UniformGrid Columns="5" Margin="{StaticResource AppCardGap}">
                <Button x:Name="KpiUptimeCard" Style="{StaticResource KpiCardButton}" Margin="0,0,12,0" Tag="status" Click="KpiCard_Click"
                        AutomationProperties.AutomationId="dashboard-kpi-uptime">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <TextBlock x:Name="KpiUptime" Text="—" Style="{StaticResource KpiValue}" />
                        </Viewbox>
                        <TextBlock Grid.Row="1" Text="{loc:L 'Uptime'}" Style="{StaticResource KpiLabel}" />
                    </Grid>
                </Button>
                <Button x:Name="KpiProcessedCard" Style="{StaticResource KpiCardButton}" Margin="0,0,12,0" Tag="status" Click="KpiCard_Click"
                        AutomationProperties.AutomationId="dashboard-kpi-processed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <TextBlock x:Name="KpiProcessed" Text="—" Style="{StaticResource KpiValue}" />
                        </Viewbox>
                        <TextBlock Grid.Row="1" Text="{loc:L 'Messages processed'}" Style="{StaticResource KpiLabel}" />
                    </Grid>
                </Button>
                <Button x:Name="KpiQueueCard" Style="{StaticResource KpiCardButton}" Margin="0,0,12,0" Tag="queue" Click="KpiCard_Click"
                        AutomationProperties.AutomationId="dashboard-kpi-queue">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- The queue is the one KPI that changes colour to say
                             something. The colour is never the only carrier of it:
                             the badge underneath adds a shape and the word
                             "Backlog", and the value's accessible name says it in
                             words as well. -->
                        <StackPanel>
                            <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <TextBlock x:Name="KpiQueue" Text="—" Style="{StaticResource KpiValue}" />
                            </Viewbox>
                            <!-- Hidden, not Collapsed, and for the reason ShowQueue_
                                 documents: a collapsed badge gives its space back,
                                 so the KPI row grows taller the first time the queue
                                 crosses the backlog threshold. ShowQueue_ sets
                                 Hidden; the initial value here said Collapsed, so
                                 the row still jumped once - on the first refresh
                                 after the page opened, which is exactly when an
                                 operator is looking at it. -->
                            <StackPanel x:Name="KpiQueueBadge" Orientation="Horizontal" Visibility="Hidden"
                                        Margin="0,4,0,0">
                                <Path x:Name="KpiQueueShape" Width="10" Height="10" Stretch="Fill"
                                      VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock x:Name="KpiQueueBadgeText" FontSize="{DynamicResource AppFontSizeCaption}" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="{loc:L 'In queue'}" Style="{StaticResource KpiLabel}" />
                    </Grid>
                </Button>
                <Button x:Name="KpiSpamCard" Style="{StaticResource KpiCardButton}" Margin="0,0,12,0" Tag="spamoverview" Click="KpiCard_Click"
                        AutomationProperties.AutomationId="dashboard-kpi-spam">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <TextBlock x:Name="KpiSpam" Text="—" Style="{StaticResource KpiValue}" />
                        </Viewbox>
                        <TextBlock Grid.Row="1" Text="{loc:L 'Spam detected'}" Style="{StaticResource KpiLabel}" />
                    </Grid>
                </Button>
                <Button x:Name="KpiVirusesCard" Style="{StaticResource KpiCardButton}" Tag="virusoverview" Click="KpiCard_Click"
                        AutomationProperties.AutomationId="dashboard-kpi-viruses">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <TextBlock x:Name="KpiViruses" Text="—" Style="{StaticResource KpiValue}" />
                        </Viewbox>
                        <TextBlock Grid.Row="1" Text="{loc:L 'Viruses removed'}" Style="{StaticResource KpiLabel}" />
                    </Grid>
                </Button>
            </UniformGrid>

            <!-- Charts. Both cards are built in code from ChartCatalog: an
                 AccessibleChartCard cannot exist without a chart definition, and it
                 builds its table view, legend, accessible description and clipboard
                 export from that same definition, which is what keeps "every chart
                 has a table view" true by construction rather than by review. -->
            <Grid x:Name="ChartsGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
