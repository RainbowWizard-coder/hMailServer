<UserControl
    x:Class="hMailServer.ControlPanel.Views.RulesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:hMailServer.ControlPanel.Services"
    xmlns:scaffold="clr-namespace:hMailServer.ControlPanel.Views.Scaffold"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Margin="{StaticResource AppPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- HeaderPanel is collapsed when the view is embedded in the account
             dialog (ConfigureForRules), where the tab names the page. -->
        <!-- Titled as the navigation map names the page; "Global rules" is one of
             its aliases, and the page shows a domain's rules as well. -->
        <scaffold:PageHeader x:Name="HeaderPanel" PageKey="rules"
                             Subtitle="{loc:L 'Server-wide message rules, evaluated top to bottom.'}">
            <!-- The list page pattern (docs/ControlPanelDesign.md, List pages): the
                 count beside the title and Refresh in the header, the list's own
                 verbs in the toolbar above it (review finding F288). -->
            <scaffold:PageHeader.Status>
                <scaffold:StatusPill x:Name="CountPill" Level="Normal" Visibility="Collapsed"
                                     AutomationProperties.AutomationId="list-count"
                                     AutomationProperties.LiveSetting="Polite" />
            </scaffold:PageHeader.Status>
            <scaffold:PageHeader.Actions>
                <ui:Button x:Name="RefreshButton" Content="{loc:L '_Refresh'}" Click="Refresh_Click" />
            </scaffold:PageHeader.Actions>
        </scaffold:PageHeader>

        <!-- The list of rules and the criteria and actions under it take the
             height the toolbar and the add form leave in the window, one to 1.3
             as the two rows did, each down to a floor of three rows, and below
             that the page scrolls; every other part keeps its own height. The
             page held a grid to the window over a fixed 620 pixels, which knew
             nothing of how tall the parts are: in the narrowest window the
             actions list had no height at all and the criteria list less than a
             row, so a rule's actions could not be seen, and in German, where the
             toolbar wraps to three lines and the actions' buttons to four, Down
             ran past those 620 pixels, where scrolling could not reach it. -->
        <!-- The bar is drawn over the content, so the right padding (DesignTokens.Space.Md)
             keeps the cards, the notices and the toolbar's last button clear of it. -->
        <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,12,0">
        <scaffold:FillPanel ViewportHeight="{Binding ViewportHeight, ElementName=PageScroll}">

        <scaffold:Toolbar x:Name="SearchBar" SearchPlaceholder="{loc:L 'Search rules'}"
                          SearchTextChanged="Search_TextChanged">
            <scaffold:Toolbar.Actions>
                <!-- Wraps, rather than cutting "Enable / disable" and Delete rule
                     off the right edge in a narrow window. The gap between wrapped
                     lines is split above and below each control, so that on one
                     line they stay centred on the search box. -->
                <WrapPanel HorizontalAlignment="Right">
                    <!-- Whose rules the list shows, captioned and wrapping with the
                         actions as one: the list sat uncaptioned among them, reading
                         "The server" between the search box and Move up (review
                         finding F226). In the toolbar's filters slot it left the
                         actions too little room to wrap into at 760 pixels, which cut
                         them. Collapsed where the page is an account's rules. -->
                    <StackPanel x:Name="ScopePanel" Orientation="Horizontal" Margin="0,2,8,2">
                        <Label x:Name="ScopeLabel" Content="{loc:L 'Show rules _for'}" Target="{Binding ElementName=ScopeBox}"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="ScopeBox" MinWidth="200" SelectionChanged="Scope_Changed"
                                  AutomationProperties.LabeledBy="{Binding ElementName=ScopeLabel}"
                                  AutomationProperties.AutomationId="rules-scope" />
                    </StackPanel>
                    <ui:Button x:Name="MoveUpButton" Content="{loc:L 'Move _up'}" Click="MoveUp_Click" Margin="0,2,8,2" />
                    <ui:Button x:Name="MoveDownButton" Content="{loc:L 'Move _down'}" Click="MoveDown_Click" Margin="0,2,8,2" />
                    <!-- Named for what it will do to the selected rule, Enable or Disable
                         (RulesView.ShowToggle_), where "Enable / disable" never said which. -->
                    <ui:Button x:Name="ToggleButton" Content="{loc:L 'Ena_ble'}" Click="Toggle_Click" Margin="0,2,8,2" />
                    <ui:Button x:Name="DeleteRuleButton" Content="{loc:L 'De_lete rule'}" Style="{StaticResource DangerTextButton}" Click="Delete_Click" Margin="0,2,0,2" />
                </WrapPanel>
            </scaffold:Toolbar.Actions>
        </scaffold:Toolbar>

        <!-- A read that failed: Critical, with Try again, in place of the empty
             state, which would say there are no rules (Services/ReadFailure). -->
        <scaffold:InlineNotice x:Name="Notice" Visibility="Collapsed" />

        <!-- The floor: the column headers, three rows and a pixel for layout
             rounding, 136 (at 135 the grid rounded a device pixel short and
             the header one long at 150 and 175 % scaling, and it held two
             whole rows), held by the FillPanel around the grid, so that the
             empty state laid over it raises the card's floor where it needs
             more. The grid keeps its vertical scroll
             bar, so that its two bars cannot take turns: where the rows fitted
             only without a horizontal bar and the columns came out a fraction
             of a pixel wider than the grid, as they can at 125 and 175 %
             scaling, the horizontal bar came, the rows no longer fitted, the
             vertical bar came, the columns narrowed to fit, the horizontal bar
             went, the rows fitted, the vertical bar went, and so on for ever -
             three rules at the reporter's size at 125 %, four in a 1280 by 800
             window at 175 % - and the Control Panel stopped answering. -->
        <scaffold:Card scaffold:FillPanel.Fill="True" Padding="{StaticResource AppListCardPadding}">
            <Grid>
                <scaffold:FillPanel>
                    <DataGrid x:Name="RuleGrid" scaffold:FillPanel.Fill="True" MinHeight="136"
                              ScrollViewer.VerticalScrollBarVisibility="Visible"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" SelectionChanged="RuleGrid_SelectionChanged"
                              AutomationProperties.Name="{loc:L 'Rules'}">
                        <!-- A switched-off rule's row in the secondary text colour, so that
                             it reads apart from the rest at a glance, where "No" in the last
                             column was all that told it; the colour, not a faded row, which
                             made the words the page's least legible (review findings F225
                             and F051). On the cells, which set their own foreground. -->
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <!-- A floor under every column, so that a narrow window scrolls
                                 the grid sideways rather than squeezing the name, the one
                                 column that says which rule a row is, to nothing. -->
                            <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="50" MinWidth="40"
                                                ElementStyle="{StaticResource GridNumberText}" HeaderStyle="{StaticResource GridNumberHeader}" />
                            <DataGridTextColumn Header="{loc:L 'Name'}" Binding="{Binding Name}" Width="*" MinWidth="160" ElementStyle="{StaticResource GridTrimmedText}" />
                            <!-- The rule in one line, its first criterion and its first action,
                                 cut with an ellipsis and whole in the row's speech (review
                                 finding F309: the grid said only the number, the name and
                                 whether the rule was on). -->
                            <DataGridTextColumn Header="{loc:L 'Summary'}" Binding="{Binding Summary}" Width="2*" MinWidth="160" ElementStyle="{StaticResource GridTrimmedText}" />
                            <DataGridTextColumn Header="{loc:L 'Enabled'}" Binding="{Binding Enabled}" Width="100" MinWidth="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </scaffold:FillPanel>
                <scaffold:EmptyState x:Name="EmptyStatus" Icon="TextBulletListSquare24" Visibility="Collapsed"
                                     AutomationProperties.LiveSetting="Polite" />
            </Grid>
        </scaffold:Card>

        <!-- The add form, under the grid so the grid keeps the height. -->
        <scaffold:Card Margin="0,12,0,12" Padding="20,12,20,0">
            <!-- Add rule sits under a row as tall as the caption beside it
                 (FieldRow.LabelGroup), so that it stays beside the box when a
                 message appears under the box. -->
            <Grid x:Name="AddRuleForm" Grid.IsSharedSizeScope="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="360" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <scaffold:FieldRow x:Name="NewRuleNameRow" Label="{loc:L 'Ne_w rule name'}" Margin="0,0,8,12" LabelGroup="RuleLine">
                    <ui:TextBox x:Name="NewRuleName" />
                </scaffold:FieldRow>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" SharedSizeGroup="RuleLine" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ui:Button x:Name="AddRuleButton" Grid.Row="1" Content="{loc:L '_Add rule'}" Appearance="Primary" Click="AddRule_Click"
                               VerticalAlignment="Top" Margin="0" />
                </Grid>
            </Grid>
        </scaffold:Card>

        <!-- What Add rule did, under the form it was pressed in and above the criteria
             and actions it speaks of: the new rule, switched off until it has its
             criteria and actions, with Enable now, which the code-behind puts in it and
             enables once the rule has a criterion and an action (review finding F225).
             The toolbar's Enable is scrolled out of view after Add rule; above the list,
             the notice was cut at its top in a 1280 by 800 window by the scroll that
             shows Add criterion…. -->
        <scaffold:InlineNotice x:Name="OutcomeNotice" Visibility="Collapsed"
                               AutomationProperties.AutomationId="rules-outcome" />

        <!-- The selected rule's criteria and actions: side by side, or one above
             the other where either would be narrower than 340 pixels
             (RulesView.RuleParts_SizeChanged). Side by side in the narrowest
             window they were 250 pixels wide, and the match list ran off the
             right edge of its card. -->
        <UniformGrid x:Name="RuleParts" scaffold:FillPanel.Fill="True" scaffold:FillPanel.Weight="1.3"
                     Columns="2" SizeChanged="RuleParts_SizeChanged">

            <!-- Criteria -->
            <!-- Titled IF as the actions' card is titled THEN, so that the two
                 headings line up, and the match mode is its first row under a
                 caption of its own, where IF was a label beside the list inside
                 the card (review finding F309). -->
            <scaffold:Card x:Name="CriteriaCard" Title="{loc:L 'IF'}" Margin="0,0,6,0">
                <scaffold:FillPanel>
                    <!-- Wraps, the list under its caption where the two do not fit
                         side by side in the card's 340 pixels in a language whose
                         caption is long. -->
                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Label x:Name="MatchModeLabel" Content="{loc:L 'Matc_h'}" Target="{Binding ElementName=MatchMode}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="MatchMode" MinWidth="230"
                                  AutomationProperties.LabeledBy="{Binding ElementName=MatchModeLabel}"
                                  SelectionChanged="MatchMode_SelectionChanged" />
                    </WrapPanel>
                    <!-- The floor: three rows of 34 pixels and a pixel for layout
                         rounding (at 102 the grid held two whole rows at 175 %
                         scaling, rounded a device pixel short). One column, whose text ends
                         in an ellipsis, so no sideways scrolling: a horizontal bar
                         that came and went with the vertical one, as a fraction of
                         a pixel decided, kept the page's layout from ever settling
                         at 175 % in the narrowest window. -->
                    <!-- What an empty list means laid over it: no rule selected, or a rule
                         with no criteria, which matches no message (RuleApplier: with none
                         to meet, a rule's actions never run) - the card was blank either
                         way (review finding F225). -->
                    <Grid scaffold:FillPanel.Fill="True">
                        <scaffold:FillPanel>
                            <DataGrid x:Name="CriteriaGrid" scaffold:FillPanel.Fill="True" MinHeight="103"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="None"
                                      SelectionMode="Single"
                                      AutomationProperties.Name="{loc:L 'IF'}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding Description}" Width="*" MinWidth="160" ElementStyle="{StaticResource GridTrimmedText}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </scaffold:FillPanel>
                        <scaffold:EmptyState x:Name="CriteriaEmpty" Padding="12" Visibility="Collapsed"
                                             AutomationProperties.AutomationId="rules-criteria-empty" />
                    </Grid>
                </scaffold:FillPanel>
                <scaffold:Card.Footer>
                    <WrapPanel Orientation="Horizontal">
                        <!-- The selected criterion's Edit and Remove, then Add, the
                             Primary, last (review finding F289). -->
                        <ui:Button x:Name="EditCriterionButton" Content="{loc:L '_Edit criterion…'}" Click="EditCriterion_Click" Margin="0,0,8,4" />
                        <ui:Button x:Name="RemoveCriterionButton" Content="{loc:L 'Rem_ove criterion'}" Style="{StaticResource DangerTextButton}" Click="RemoveCriterion_Click" Margin="0,0,8,4" />
                        <ui:Button x:Name="AddCriterionButton" Content="{loc:L 'Add _criterion…'}" Appearance="Primary" Click="AddCriterion_Click" Margin="0,0,0,4" />
                    </WrapPanel>
                </scaffold:Card.Footer>
            </scaffold:Card>

            <!-- Actions -->
            <scaffold:Card x:Name="ActionsCard" Title="{loc:L 'THEN'}" Margin="6,0,0,0">
                <scaffold:FillPanel>
                    <!-- The floor: three rows of 34 pixels and a pixel for layout
                         rounding. One column, as the
                         criteria's, so no sideways scrolling either. -->
                    <Grid scaffold:FillPanel.Fill="True">
                        <scaffold:FillPanel>
                            <DataGrid x:Name="ActionsGrid" scaffold:FillPanel.Fill="True" MinHeight="103"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="None"
                                      SelectionMode="Single"
                                      AutomationProperties.Name="{loc:L 'THEN'}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding Description}" Width="*" MinWidth="160" ElementStyle="{StaticResource GridTrimmedText}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </scaffold:FillPanel>
                        <scaffold:EmptyState x:Name="ActionsEmpty" Padding="12" Visibility="Collapsed"
                                             AutomationProperties.AutomationId="rules-actions-empty" />
                    </Grid>
                </scaffold:FillPanel>
                <scaffold:Card.Footer>
                    <!-- The captioned buttons in a WrapPanel, not a StackPanel, which clips
                         the last one rather than wrapping it; Up and Down as a pair of
                         glyphs in the right-hand column, which never wraps apart and never
                         leaves one of them on a line of its own (review finding F178): as
                         words, Up was the one caption on the card never translated, and
                         Down wrapped alone below the rest at 1280. Named for what they
                         move; Alt+Up and Alt+Down in the list do the same. The WrapPanel
                         is the grid's first column. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                    <WrapPanel Orientation="Horizontal">
                        <!-- As the criteria's: Edit and Remove, then Add last. -->
                        <ui:Button x:Name="EditActionButton" Content="{loc:L 'Ed_it action…'}" Click="EditAction_Click" Margin="0,0,8,4" />
                        <ui:Button x:Name="RemoveActionButton" Content="{loc:L 'Re_move action'}" Style="{StaticResource DangerTextButton}" Click="RemoveAction_Click" Margin="0,0,8,4" />
                        <ui:Button x:Name="AddActionButton" Content="{loc:L 'Add ac_tion…'}" Appearance="Primary" Click="AddAction_Click" Margin="0,0,8,4" />
                    </WrapPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="4,0,0,0">
                            <ui:Button x:Name="ActionUpButton" Icon="{ui:SymbolIcon ChevronUp24}" Padding="8,7" MinWidth="34" Click="ActionUp_Click" Margin="0,0,4,4"
                                       ToolTip="{loc:L 'Move the selected action up (Alt+Up)'}" AutomationProperties.Name="{loc:L 'Move action up'}" />
                            <ui:Button x:Name="ActionDownButton" Icon="{ui:SymbolIcon ChevronDown24}" Padding="8,7" MinWidth="34" Click="ActionDown_Click" Margin="0,0,0,4"
                                       ToolTip="{loc:L 'Move the selected action down (Alt+Down)'}" AutomationProperties.Name="{loc:L 'Move action down'}" />
                        </StackPanel>
                    </Grid>
                </scaffold:Card.Footer>
            </scaffold:Card>
        </UniformGrid>
        </scaffold:FillPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
