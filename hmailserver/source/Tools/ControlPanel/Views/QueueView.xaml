<UserControl
    x:Class="hMailServer.ControlPanel.Views.QueueView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:hMailServer.ControlPanel.Services"
    xmlns:scaffold="clr-namespace:hMailServer.ControlPanel.Views.Scaffold"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- A list page on the scaffold (docs/ControlPanelDesign.md, List pages):
         the header with the count and Refresh, the toolbar with the search and
         the selected message's verbs, Deliver now the Primary at the right edge,
         a notice for what the last action said, and the grid filling the rest -
         the grid scrolls itself, so the page has no ScrollViewer of its own and
         takes the page padding as a margin. The verbs were in the header with a
         glyph each, the Primary between them, and the count in the subtitle
         (review findings F288, F289). -->
    <Grid Margin="{StaticResource AppPagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <scaffold:PageHeader x:Name="Header" PageKey="queue"
                             Subtitle="{loc:L 'Messages waiting for delivery.'}">
            <scaffold:PageHeader.Status>
                <scaffold:StatusPill x:Name="CountPill" Level="Normal" Visibility="Collapsed"
                                     AutomationProperties.AutomationId="list-count"
                                     AutomationProperties.LiveSetting="Polite" />
            </scaffold:PageHeader.Status>
            <scaffold:PageHeader.Actions>
                <ui:Button Content="{loc:L '_Refresh'}" Click="Refresh_Click" />
            </scaffold:PageHeader.Actions>
        </scaffold:PageHeader>

        <scaffold:Toolbar x:Name="SearchBar" Grid.Row="1" SearchPlaceholder="{loc:L 'Search the delivery queue'}"
                          SearchTextChanged="Search_TextChanged">
            <scaffold:Toolbar.Actions>
                <WrapPanel HorizontalAlignment="Right">
                    <ui:Button x:Name="ViewButton" Content="{loc:L '_View source'}" Click="View_Click" Margin="0,2,8,2" />
                    <ui:Button x:Name="RemoveButton" Content="{loc:L 'Re_move'}" Style="{StaticResource DangerTextButton}" Click="Remove_Click" Margin="0,2,8,2" />
                    <ui:Button x:Name="RetryButton" Content="{loc:L '_Deliver now'}" Appearance="Primary" Click="Retry_Click" Margin="0,2,0,2" />
                </WrapPanel>
            </scaffold:Toolbar.Actions>
        </scaffold:Toolbar>

        <!-- What the last action said: a retriggered delivery, a removal, a
             failure. Collapsed until there is something to say. -->
        <scaffold:InlineNotice x:Name="Notice" Grid.Row="2" Visibility="Collapsed" />

        <scaffold:Card Grid.Row="3" Padding="8">
            <Grid>
                <DataGrid x:Name="QueueGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          AutomationProperties.Name="{loc:L 'Delivery queue'}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="90"
                                            ElementStyle="{StaticResource GridNumberText}" HeaderStyle="{StaticResource GridNumberHeader}" />
                        <DataGridTextColumn Header="{loc:L 'Created'}" Binding="{Binding Created}" Width="150" />
                        <DataGridTextColumn Header="{loc:L 'From'}" Binding="{Binding From}" Width="*" ElementStyle="{StaticResource GridTrimmedText}" />
                        <DataGridTextColumn Header="{loc:L 'Recipients'}" Binding="{Binding Recipients}" Width="*" ElementStyle="{StaticResource GridTrimmedText}" />
                        <DataGridTextColumn Header="{loc:L 'Next try'}" Binding="{Binding NextTry}" Width="150" />
                        <DataGridTextColumn Header="{loc:L 'Tries'}" Binding="{Binding Tries}" Width="70"
                                            ElementStyle="{StaticResource GridNumberText}" HeaderStyle="{StaticResource GridNumberHeader}" />
                    </DataGrid.Columns>
                </DataGrid>
                <scaffold:EmptyState x:Name="EmptyStatus" Icon="Send24" Visibility="Collapsed"
                                     AutomationProperties.LiveSetting="Polite" />
            </Grid>
        </scaffold:Card>
    </Grid>
</UserControl>
