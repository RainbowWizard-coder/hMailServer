<ui:FluentWindow
    x:Class="hMailServer.ControlPanel.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:hMailServer.ControlPanel.Services"
    xmlns:scaffold="clr-namespace:hMailServer.ControlPanel.Views.Scaffold"
    xmlns:views="clr-namespace:hMailServer.ControlPanel.Views"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    Title="{loc:L 'hMailServer Control Panel'}"
    Width="1280" Height="800"
    MinWidth="760" MinHeight="520"
    WindowBackdropType="Mica"
    ExtendsContentIntoTitleBar="True"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">

    <!-- The shell, top to bottom: the title bar, the command bar, then the
         sidebar beside the content. Every fixed size is a token
         (Views/Scaffold/Tokens.xaml); docs/ControlPanelDesign.md describes the
         frame the pages sit in. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" ShowMaximize="True" ShowMinimize="True">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Mail24" Foreground="{DynamicResource AppBrandBrush}" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Command bar: the sidebar toggle and the brand on the left, the
             search in the middle, the server's state, the theme and the
             administrator's menu on the right. What the sidebar's footer used to
             hold - the connection badge, the language and theme buttons - lives
             here now, where every administration console keeps it. -->
        <Grid Grid.Row="1" x:Name="CommandBar" Height="{StaticResource AppCommandBarHeight}" Margin="8,0,12,0"
              AutomationProperties.AutomationId="command-bar">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- The tool tip and accessible name are owned by UpdateSidebarToggle_
                 in code-behind, which points both at what a click will do. -->
            <ui:Button x:Name="SidebarToggle" Grid.Column="0" Style="{StaticResource SubtleButton}" Padding="8,6"
                       Icon="{ui:SymbolIcon Navigation24}" VerticalAlignment="Center"
                       AutomationProperties.AutomationId="sidebar-toggle"
                       Click="SidebarToggle_Click" />

            <!-- Brand -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
                <Border Width="28" Height="28" CornerRadius="7" Background="{StaticResource BrandGradient}">
                    <TextBlock Text="hM" FontWeight="SemiBold" FontSize="12" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="hMailServer" FontWeight="SemiBold" FontSize="{DynamicResource AppFontSizeBody}" Margin="10,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="{loc:L 'Control Panel'}" FontSize="{DynamicResource AppFontSizeCaption}" Margin="6,1,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>

            <!-- Search. A button drawn as a field, not a text box: what it opens
                 is the palette, which is where the typing happens, and a box that
                 handed its focus to a window as soon as it was clicked would be a
                 box that lies about what it is. It was previously reachable only
                 by knowing that Ctrl+K exists, which is not a discoverable
                 interface; this is a normal tab stop that opens the same palette
                 and names the shortcut while it does so. -->
            <ui:Button x:Name="SearchButton" Grid.Column="2" Margin="24,0,24,0" MaxWidth="560"
                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                       VerticalAlignment="Center" Padding="10,6"
                       Background="{DynamicResource ControlFillColorDefaultBrush}"
                       BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                       CornerRadius="{StaticResource AppControlCornerRadius}"
                       Click="Search_Click"
                       AutomationProperties.AutomationId="nav-search"
                       AutomationProperties.Name="{loc:L 'Search pages, settings and tasks. Keyboard shortcut Control K.'}"
                       ToolTip="{loc:L 'Search pages, settings and tasks (Ctrl+K)'}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Search24" FontSize="{StaticResource AppIconSizeSm}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{loc:L 'Search'}" FontSize="{DynamicResource AppFontSizeBody}" Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="2" Text="Ctrl+K" FontSize="{DynamicResource AppFontSizeCaption}" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </Grid>
            </ui:Button>

            <!-- The server's state, fed by ServerSession.LinkStateChanged and by
                 sign-in: colour, shape and word, never colour alone, and the
                 sentence "Connected to host as user" as its accessible name. -->
            <scaffold:StatusPill x:Name="ServerStatusPill" Grid.Column="3" Margin="0,0,12,0"
                                 AutomationProperties.AutomationId="server-status" />

            <!-- The icon, tool tip and accessible name are owned by
                 UpdateThemeToggle_ in code-behind, which points all three at the
                 state a click will produce (sun while dark, moon while light) and
                 re-points them when the OS flips the theme. The XAML icon is only
                 a placeholder for the instant before ApplySavedTheme runs. -->
            <ui:Button x:Name="ThemeButton" Grid.Column="4" Style="{StaticResource SubtleButton}" Padding="8,6"
                       Icon="{ui:SymbolIcon WeatherMoon24}" VerticalAlignment="Center"
                       AutomationProperties.AutomationId="theme-toggle"
                       Click="Theme_Click" />

            <!-- Help where the question is: the documentation for the page showing,
                 in a pane beside it (Views/HelpPane.cs), which F1 also opens. The
                 words, not just a glyph, in the accessible name and the tool tip. -->
            <ui:Button x:Name="HelpButton" Grid.Column="5" Style="{StaticResource SubtleButton}" Padding="8,6" Margin="4,0,0,0"
                       Icon="{ui:SymbolIcon QuestionCircle24}" VerticalAlignment="Center"
                       AutomationProperties.AutomationId="help-toggle"
                       AutomationProperties.Name="{loc:L 'Help for this page. Keyboard shortcut F1.'}"
                       ToolTip="{loc:L 'Help for this page (F1)'}"
                       Click="Help_Click" />

            <!-- The administrator's menu: who is signed in and where, the server
                 version, the language, the theme, and the About page. -->
            <ui:Button x:Name="AdminButton" Grid.Column="6" Style="{StaticResource SubtleButton}" Padding="8,6" Margin="4,0,0,0"
                       Icon="{ui:SymbolIcon Person24}" VerticalAlignment="Center"
                       AutomationProperties.AutomationId="admin-menu"
                       AutomationProperties.Name="{loc:L 'Administrator menu'}"
                       ToolTip="{loc:L 'Administrator menu'}"
                       Click="Admin_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="AdminName" FontSize="{DynamicResource AppFontSizeBody}" VerticalAlignment="Center" Visibility="Collapsed" />
                    <ui:SymbolIcon Symbol="ChevronDown24" FontSize="12" Margin="6,1,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </ui:Button>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Sized by the longest group name, not by taste.
                     "Monitoring & troubleshooting" did not fit and was cut mid-word.
                     It ellipsizes now rather than clipping, and the full name is
                     always in the tool tip - but an ellipsis on a permanent
                     navigation label is a smaller defect, not the absence of one,
                     so the pane also gets the width to hold it. The share of the
                     window is what binds at ordinary window sizes - 0.32 beside the
                     page's 1, 310 pixels at 1280, in pixels set by ApplySidebar_
                     (Services/ShellGeometry) so that the help pane takes its width
                     from the page and not from the tree; MaxWidth only stops the
                     pane running away on a very wide monitor, and MinWidth is what
                     protects the content area on a narrow one. Collapsed to the
                     rail, all three become AppRailWidth - see ApplySidebar_. -->
                <ColumnDefinition x:Name="SidebarColumn" Width="0.32*" MinWidth="200" MaxWidth="320" />
                <ColumnDefinition Width="*" />
                <!-- The help pane's column: nothing until the pane is opened, then
                     the width the administrator last left it at (OpenHelp_). -->
                <ColumnDefinition x:Name="HelpColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar. Shown while it can be used: not before sign-in
                 (ApplySidebar_). -->
            <Grid x:Name="SidebarPane" Grid.Column="0" Margin="0,4,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Navigation tree. Built from Services/NavigationMap, which is
                     grouped by what an administrator is trying to achieve; the
                     structure is data so that it can be tested. It scrolls by
                     pixels, not by rows, so that a jump to a page can bring its
                     whole group on screen by the rows' measured places
                     (MainWindow.GroupScroll.cs). -->
                <TreeView x:Name="NavTree" Grid.Row="0" Background="Transparent" BorderThickness="0"
                          Margin="8,0" SelectedItemChanged="NavTree_SelectedItemChanged"
                          AutomationProperties.Name="{loc:L 'Main navigation'}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.CanContentScroll="False">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="Padding" Value="6,0" />
                            <Setter Property="Margin" Value="0,1" />
                            <!-- Fluent Body (Typography.Body). The rows sat at 13
                                 through the ramp re-basing, a half-step off both
                                 rungs and the actual size of most of the sidebar. -->
                            <Setter Property="FontSize" Value="{DynamicResource AppFontSizeBody}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TreeViewItem">
                                        <StackPanel>
                                            <!-- One row is AppNavRowHeight; the radius, the
                                                 hover fill and the selection pill are the
                                                 tokens', so a row here and a row in the
                                                 rail read as the same control. -->
                                            <Border x:Name="Bd" CornerRadius="{StaticResource AppControlCornerRadius}" Cursor="Hand"
                                                    MinHeight="{StaticResource AppNavRowHeight}"
                                                    Background="{TemplateBinding Background}" SnapsToDevicePixels="True"
                                                    BorderThickness="2" BorderBrush="Transparent">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="18" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Rectangle x:Name="Pill" Grid.Column="0" Width="3" Height="16"
                                                               RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Left"
                                                               VerticalAlignment="Center"
                                                               Margin="1,0,0,0" Fill="{DynamicResource AppBrandBrush}" Opacity="0" />
                                                    <ToggleButton x:Name="Expander" Grid.Column="0" ClickMode="Press"
                                                                  Style="{StaticResource NavExpanderToggle}"
                                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" />
                                                    <ContentPresenter x:Name="PART_Header" Grid.Column="1" ContentSource="Header"
                                                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                      Margin="{TemplateBinding Padding}" />
                                                </Grid>
                                            </Border>
                                            <!-- Pages sit under their group's label, not under its
                                                 glyph: the indent is the glyph column (16) plus its
                                                 gap (10), so the two text columns line up. -->
                                            <ItemsPresenter x:Name="ItemsHost" Margin="26,0,0,0" />
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsExpanded" Value="False">
                                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                            <Trigger Property="HasItems" Value="False">
                                                <Setter TargetName="Expander" Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                            <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <Setter TargetName="Pill" Property="Opacity" Value="1" />
                                            </Trigger>
                                            <!-- The focus colour, as the rail's: the pill is the selection. -->
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AppFocusBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="HasItems" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>

                <!-- The rail: the sidebar collapsed to one glyph per top-level
                     group, built beside the tree from the same map (BuildNavRail_).
                     Choosing a glyph expands the sidebar on that group. -->
                <StackPanel x:Name="NavRail" Grid.Row="0" Visibility="Collapsed" Margin="0,2,0,0"
                            AutomationProperties.Name="{loc:L 'Main navigation'}"
                            AutomationProperties.AutomationId="nav-rail" />

                <!-- Footer: the server's version, under a hairline. Without the line
                     the tree simply stops wherever the scroll position leaves it and
                     the footer begins on the next line, so a half-scrolled item reads
                     as bleeding into it rather than as a list that continues above. -->
                <Border x:Name="SidebarFooter" Grid.Row="1" BorderThickness="0,1,0,0" Padding="18,8,18,10"
                        BorderBrush="{DynamicResource AppDividerBrush}">
                    <TextBlock x:Name="VersionText" FontSize="{DynamicResource AppFontSizeCaption}" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </Border>
            </Grid>

            <!-- Content. Its rounded corner meets the sidebar; with no sidebar,
                 before sign-in, it is square to the window's edge (ApplySidebar_). -->
            <Border x:Name="ContentSurface" Grid.Column="1" Background="{DynamicResource ApplicationBackgroundBrush}"
                    CornerRadius="8,0,0,0" Margin="0,4,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Breadcrumb and signposts. A palette jump used to replace
                         the page with no indication of where the user had landed,
                         so the palette taught nothing and had to be used again
                         next time. The trail names the group, the group segment
                         reveals it in the tree, and the "Related" links carry the
                         subjects that genuinely span several pages (transport
                         security is one question to the user and five pages to
                         us) without duplicating a page into two branches. -->
                    <Border x:Name="BreadcrumbBar" Grid.Row="0" Visibility="Collapsed"
                            Padding="24,8,20,8" BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource AppDividerBrush}"
                            AutomationProperties.AutomationId="breadcrumb-bar"
                            AutomationProperties.Name="{loc:L 'Location'}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Back and Forward (MainWindow.History.cs): the page opened
                                 before and the one Back left, named in the tool tip and
                                 the accessible name by UpdateHistoryButtons_, which also
                                 disables a button with nothing its way. Alt+Left,
                                 Alt+Right and the mouse's two side buttons do the same. -->
                            <StackPanel x:Name="HistoryButtons" Orientation="Horizontal" VerticalAlignment="Center"
                                        Margin="-8,0,8,0">
                                <ui:Button x:Name="BackButton" Style="{StaticResource SubtleButton}" Padding="6,3" IsEnabled="False"
                                           AutomationProperties.AutomationId="history-back"
                                           AutomationProperties.AcceleratorKey="Alt+Left"
                                           Click="Back_Click">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="{StaticResource AppIconSizeSm}" />
                                    </ui:Button.Icon>
                                </ui:Button>
                                <ui:Button x:Name="ForwardButton" Style="{StaticResource SubtleButton}" Padding="6,3" IsEnabled="False"
                                           AutomationProperties.AutomationId="history-forward"
                                           AutomationProperties.AcceleratorKey="Alt+Right"
                                           Click="Forward_Click">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="ArrowRight24" FontSize="{StaticResource AppIconSizeSm}" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </StackPanel>
                            <!-- One line, never two: the trail's parts from the left and the
                                 page's name last, cut short with an ellipsis where the line
                                 is too short for them, the groups first and the page's name
                                 last, whole in their tool tips (UpdateBreadcrumb,
                                 Views/Scaffold/BreadcrumbTrailPanel). A WrapPanel put
                                 "Certificates (ACME)" on a line of its own in the narrowest
                                 window, and the bar grew by a line; a DockPanel that gave the
                                 page's name what the group left gave it nothing there (review
                                 finding F047). -->
                            <scaffold:BreadcrumbTrailPanel x:Name="BreadcrumbHost" Grid.Column="1"
                                       VerticalAlignment="Center"
                                       AutomationProperties.AutomationId="breadcrumb" />
                            <!-- Twelve pixels (DesignTokens.Space.Md) from the trail, which ran into
                                 "Related:" on Transport security at 760. -->
                            <WrapPanel x:Name="RelatedHost" Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                       AutomationProperties.AutomationId="breadcrumb-related" />
                        </Grid>
                    </Border>

                    <!-- The pages own their padding (AppPagePadding) and their
                         scrolling; the host only holds them. -->
                    <ContentControl x:Name="ContentHost" Grid.Row="1" AutomationProperties.Name="{loc:L 'Page content'}" />

                    <!-- The toasts, over the page and never over the sidebar or the help
                         pane, at most 560 pixels wide so that a long sentence wraps to a
                         few lines: across the outer grid a failure was one 1,160-pixel
                         line over the sidebar and the page (review finding F008). -->
                    <ui:SnackbarPresenter x:Name="RootSnackbar" Grid.Row="0" Grid.RowSpan="2"
                                          VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                          MaxWidth="560" Margin="24,0,24,24" />
                </Grid>
            </Border>

            <!-- Help beside the page: a third column, opened by the ? button or
                 F1, sized by the splitter, following the page as the navigation
                 changes. A pane, not a window and not a dialog: the page stays
                 usable while the text is open. -->
            <GridSplitter x:Name="HelpSplitter" Grid.Column="2" Width="6" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                          Background="Transparent" Visibility="Collapsed" Focusable="False" />
            <views:HelpPane x:Name="HelpPanel" Grid.Column="2" Margin="6,4,0,0" Visibility="Collapsed" />

            <!-- The tour. Last child and spanning every column, so a step can
                 point at a control in the sidebar as readily as at one on the
                 page; it has no background of its own, so every pixel under it
                 - including the control it is pointing at - stays clickable
                 while a tour runs. Collapsed until one does. -->
            <scaffold:TourOverlay x:Name="TourLayer" Grid.Column="0" Grid.ColumnSpan="3"
                                  AutomationProperties.AutomationId="tour-overlay"
                                  AutomationProperties.Name="{loc:L 'Tour'}" />
        </Grid>

        <!-- The pending bar, at the foot of the window: the saved settings the
             server is not running on yet (docs/SettingsApply.md) - a key marked
             reinitialize or restart, saved since what applies it last happened -
             with Apply now, which reinitialises for the ones a reinitialise takes,
             and Restart the service, for the ones only a restart takes, offered
             while the server is the one on this machine. The notice's tool tip
             and help text name the settings. Refreshed on every save through
             IniFeatureStore, every page entered and every connection; collapsed
             while nothing waits. -->
        <Border x:Name="PendingBar" Grid.Row="3" Visibility="Collapsed" Padding="16,6,16,8"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource AppDividerBrush}"
                AutomationProperties.AutomationId="pending-settings-bar">
            <DockPanel LastChildFill="True">
                <!-- The two buttons in one panel, in the order they are drawn, so that
                     Tab and a screen reader meet them left to right: docked right one by
                     one, the first declared was drawn rightmost and reached first. -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button x:Name="RestartServiceButton" Margin="12,0,0,0"
                               Content="{loc:L 'Restart the service…'}" Appearance="Secondary" VerticalAlignment="Center"
                               Visibility="Collapsed"
                               AutomationProperties.AutomationId="restart-service-pending"
                               Click="RestartPending_Click" />
                    <ui:Button x:Name="ApplyPendingButton" Margin="12,0,0,0"
                               Content="{loc:L 'Apply now'}" Appearance="Primary" VerticalAlignment="Center"
                               AutomationProperties.AutomationId="apply-pending-settings"
                               Click="ApplyPending_Click" />
                </StackPanel>
                <scaffold:InlineNotice x:Name="PendingNotice" Level="Warning" VerticalAlignment="Center"
                                       AutomationProperties.AutomationId="pending-settings-notice" />
            </DockPanel>
        </Border>

        <!-- The paused server, at the foot of the window under the pending bar
             (MainWindow.ServerPaused.cs, review finding F019): while the server
             reports Stopped - Server status's Pause, which no connection is accepted
             and nothing delivered through, while the service and this Control
             Panel's link keep running - a Warning that says so under every page,
             with Resume the mail server, in the words of Server status's own
             R_esume the mail server, which does the same. Its button carries no Alt
             key, as the pending bar's do not: it is on screen with every page, that
             Resume among them. -->
        <Border x:Name="PausedBar" Grid.Row="4" Visibility="Collapsed" Padding="16,6,16,8"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource AppDividerBrush}"
                AutomationProperties.AutomationId="server-paused-bar">
            <DockPanel LastChildFill="True">
                <ui:Button x:Name="ResumeServerButton" DockPanel.Dock="Right" Margin="12,0,0,0"
                           Content="{loc:L 'Resume the mail server'}" Appearance="Primary" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="resume-paused-server"
                           Click="ResumePausedServer_Click" />
                <scaffold:InlineNotice x:Name="PausedNotice" Level="Warning" VerticalAlignment="Center"
                                       Text="{loc:L 'The mail server is paused - nothing is accepted or delivered.'}"
                                       AutomationProperties.AutomationId="server-paused-notice" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
