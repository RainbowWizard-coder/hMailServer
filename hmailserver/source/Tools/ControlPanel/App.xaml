<Application
    x:Class="hMailServer.ControlPanel.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:hMailServer.ControlPanel.Services"
    xmlns:svc="clr-namespace:hMailServer.ControlPanel.Services"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <!-- The design system: the tokens (Views/Scaffold/Tokens.xaml,
                     merged inside) and the scaffold components' templates.
                     docs/ControlPanelDesign.md names every token and component. -->
                <ResourceDictionary Source="/hMailCP;component/Views/Scaffold/Scaffold.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- The logo's colours, for the "hM" square in the command bar and on
                 the sign-in card alone. Every other blue is AppBrandBrush, which
                 ThemeTokens republishes for the theme and gives WPF-UI as its accent
                 (review finding F045): a BrandBrush in this blue, which the tab
                 underline and the title bar's glyph drew in both themes, was a third
                 blue beside the brand's and the Windows accent. -->
            <Color x:Key="BrandColor">#2F81F7</Color>
            <Color x:Key="Brand2Color">#A371F7</Color>
            <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource BrandColor}" Offset="0" />
                <GradientStop Color="{StaticResource Brand2Color}" Offset="1" />
            </LinearGradientBrush>

            <!-- There is deliberately NO implicit TextBlock style here. An
                 app-level implicit style reaches into every control template's
                 generated TextBlocks and its Foreground setter outranks the
                 inherited value, so it silently overrode WPF-UI's on-accent
                 button text (near-black on accent blue in the light theme),
                 the TabItem dim/hover states below, and the sidebar
                 TreeViewItem foreground swap. The default text colour comes
                 from property inheritance instead: WPF-UI's FluentWindow style
                 sets Foreground to the theme's WindowForeground, and
                 FluentDialogWindow re-states it explicitly. -->

            <!-- Chevron expander used by the sidebar TreeViewItem template. -->
            <Style x:Key="NavExpanderToggle" TargetType="ToggleButton">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="16" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent" Width="16" Height="16">
                                <Path x:Name="Chevron" Data="M 4 2 L 8 6 L 4 10"
                                      Stroke="{DynamicResource TextFillColorTertiaryBrush}"
                                      StrokeThickness="1.4" StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </Path.RenderTransform>
                                </Path>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Chevron" Property="RenderTransform">
                                        <Setter.Value>
                                            <RotateTransform Angle="90" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A rail item: the sidebar collapsed to icons shows one of these
                 per top-level group, the group's glyph in its Tag, the brand pill on
                 the left when the page on screen lives in that group. -->
            <Style x:Key="NavRailItem" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Margin" Value="4,1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bg" CornerRadius="{DynamicResource AppControlCornerRadius}" Background="Transparent"
                                    BorderThickness="2" BorderBrush="Transparent" SnapsToDevicePixels="True">
                                <Grid>
                                    <Rectangle x:Name="Pill" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5"
                                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0"
                                               Fill="{DynamicResource AppBrandBrush}" Opacity="0" />
                                    <ContentPresenter Content="{TemplateBinding Tag}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Setter TargetName="Pill" Property="Opacity" Value="1" />
                                </Trigger>
                                <!-- The focus colour, not the brand's: the pill says
                                     which group is selected, the border where the
                                     keyboard is, and the two are not one colour. -->
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AppFocusBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A row of the rail's group flyout (MainWindow.NavFlyout.cs): the
                 sidebar's page row by another control - AppNavRowHeight, the
                 control radius, the hover fill, the brand pill on the selected
                 row and the focus colour round the row the keyboard is on - so
                 that a page in the flyout reads as the same row it is in the tree. -->
            <Style x:Key="NavFlyoutItem" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" CornerRadius="{DynamicResource AppControlCornerRadius}"
                                    MinHeight="{DynamicResource AppNavRowHeight}" Background="Transparent"
                                    BorderThickness="2" BorderBrush="Transparent" SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle x:Name="Pill" Grid.Column="0" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5"
                                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0"
                                               Fill="{DynamicResource AppBrandBrush}" Opacity="0" />
                                    <ContentPresenter Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                      Margin="{TemplateBinding Padding}" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Setter TargetName="Pill" Property="Opacity" Value="1" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AppFocusBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Settings card: the plain surface, for the pages not yet on the
                 scaffold's Card component. Same tokens as the component, so the
                 two are one surface. -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AppCardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{DynamicResource AppCardCornerRadius}" />
                <Setter Property="Padding" Value="{DynamicResource AppCardPadding}" />
            </Style>

            <Style x:Key="PageTitle" TargetType="TextBlock">
                <!-- A page title is the page's level-1 heading: screen readers navigate by headings, and without this a page has none. -->
                <Setter Property="AutomationProperties.HeadingLevel" Value="Level1" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <Style x:Key="PageSubtitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="Margin" Value="0,0,0,18" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="KpiValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>

            <Style x:Key="StatusLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="Margin" Value="0,0,16,8" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="StatusValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- A KPI's label at the ramp's Caption size, where it was 11, below
                 the ramp (review finding F305), wrapping onto a second line where
                 its card is narrower than it, as "Verarbeitete Nachrichten" and
                 処理したメッセージ are in a 760-pixel window, where they were cut. -->
            <Style x:Key="KpiLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource AppFontSizeCaption}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
                <Setter Property="Margin" Value="0,10,0,0" />
            </Style>

            <!-- ============================================================
                 Modern tab strip. The stock WPF TabControl wraps its tab
                 headers onto multiple rows and renders them as low-contrast
                 raised buttons. We replace it with a single-row, horizontally
                 scrolling strip of flat "pivot" tabs: a clear accent underline
                 marks the selected tab, hover gives a subtle fill, and the
                 header sits on a 1px divider so the underline reads cleanly.
                 Implicit styles so every TabControl/TabItem picks them up.
                 The selected tab's SemiBold and the strip's 14 px are set on
                 the header's presenter alone, never on the TabItem: FontWeight
                 and FontSize inherit, and a tab's page is the TabItem's logical
                 child, so a setter on the item made every caption, hint and
                 editor value on the open tab as heavy as its card titles, and
                 gave them a size the pages without tabs do not get. -->
            <Style TargetType="TabItem">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <!-- The one focus ring (Services/AccessibleFocus), drawn inside the
                     tab: the theme's own TabItem style names a dotted rectangle of its
                     own, which a focused tab drew where every other control drew the
                     ring, and the strip's scroller cuts what is drawn outside a tab
                     (review finding F296). -->
                <Setter Property="FocusVisualStyle" Value="{DynamicResource AppFocusVisualInset}" />
                <Setter Property="Padding" Value="15,9" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="7,7,0,0"
                                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <Grid>
                                    <ContentPresenter x:Name="Content" ContentSource="Header"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      TextElement.FontSize="14"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                    <Border x:Name="Underline" Height="2.5" CornerRadius="2" Margin="2,0,2,-1"
                                            VerticalAlignment="Bottom" Background="{DynamicResource AppBrandBrush}"
                                            Opacity="0" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Setter TargetName="Content" Property="TextElement.FontWeight" Value="SemiBold" />
                                    <Setter TargetName="Underline" Property="Opacity" Value="1" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A check box or radio button whose Content is a string shows it
                 in an AccessText that wraps, so a long caption folds under
                 itself instead of being cut mid-word at the edge of its card
                 or dialog ("...or shorten how long data is kept on"). An
                 AccessText rather than a TextBlock because the string's
                 underscore is its Alt key, which a TextBlock would print. An
                 implicit data template for strings in the style's resources,
                 not a ContentTemplate, so that a box whose Content is an
                 element of its own (FieldDialog's AccessText, a panel) is
                 presented as before; and the Content stays the string, so the
                 box's automation name is still its caption. The box sits
                 beside the caption's first line: WPF-UI's check box is a
                 BulletDecorator, which aligns its bullet with the first line
                 of an AccessText. Based on WPF-UI's style under its own key,
                 DefaultCheckBoxStyle, so that the template, the colours and
                 the Normal weight are WPF-UI's - never on {x:Type CheckBox}:
                 inside the dictionary that defines the implicit style, a
                 StaticResource for the type key finds the entry being defined
                 and yields null, and a style based on nothing gave every box
                 the classic theme's 13-pixel square with a black tick.
                 The box stands on the text column, where every caption, box and
                 hint of its card or dialog starts: WPF-UI's padding (11,5,11,6)
                 is the bullet's margin, so the square stood eleven pixels right of
                 them, and a hint under it aligned with neither the box nor its
                 caption (review finding F294). The caption starts the box and its
                 gap further in, DesignTokens.CheckBoxCaptionInset (28), which is
                 where the lines under a box go (FieldRow, DialogFields.Note). The
                 content is at the top, beside the box, however tall the box is
                 laid out. -->
            <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
                <Setter Property="Padding" Value="0,5,11,6" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
                <Style.Resources>
                    <DataTemplate DataType="{x:Type sys:String}">
                        <AccessText Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                </Style.Resources>
            </Style>
            <Style TargetType="RadioButton" BasedOn="{StaticResource DefaultRadioButtonStyle}">
                <Style.Resources>
                    <DataTemplate DataType="{x:Type sys:String}">
                        <AccessText Text="{Binding}" TextWrapping="Wrap" />
                    </DataTemplate>
                </Style.Resources>
            </Style>

            <!-- The chevrons that scroll an overflowing tab strip. Sized and
                 spaced to sit inside the strip's own height so adding them does
                 not make every tabbed dialog taller, and kept visually quieter
                 than the tabs themselves - they are a way to reach the content,
                 not part of it. Disabled rather than hidden at each end of the
                 range, so the strip does not reflow as you scroll it. -->
            <Style x:Key="TabStripChevron" TargetType="RepeatButton">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Delay" Value="400" />
                <Setter Property="Interval" Value="120" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="5"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background"
                                            Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.3" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="TabControl">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <Grid KeyboardNavigation.TabNavigation="Local">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <!-- The strip scrolls rather than wrapping, so when the
                                     tabs overflow they have to stay reachable. Without
                                     the chevrons, AccountDialog's eleven tabs ran past
                                     the edge of the dialog and could only be got at with
                                     the arrow keys. They appear only when there is
                                     somewhere to go - see TabStripScrolling. -->
                                <Border Grid.Row="0" BorderThickness="0,0,0,1"
                                        BorderBrush="{DynamicResource ControlElevationBorderBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <RepeatButton x:Name="ScrollLeft" Grid.Column="0"
                                                      Style="{StaticResource TabStripChevron}"
                                                      Visibility="Collapsed"
                                                      AutomationProperties.Name="{loc:L 'Scroll tabs left'}">
                                            <Path Data="M 8 2 L 4 6 L 8 10"
                                                  Stroke="{DynamicResource TextFillColorSecondaryBrush}"
                                                  StrokeThickness="1.4" StrokeEndLineCap="Round"
                                                  StrokeStartLineCap="Round" />
                                        </RepeatButton>

                                        <ScrollViewer x:Name="HeaderScroll" Grid.Column="1"
                                                      HorizontalScrollBarVisibility="Hidden"
                                                      VerticalScrollBarVisibility="Disabled" Focusable="False"
                                                      svc:TabStripScrolling.LeftButton="{Binding ElementName=ScrollLeft}"
                                                      svc:TabStripScrolling.RightButton="{Binding ElementName=ScrollRight}">
                                            <StackPanel x:Name="HeaderPanel" IsItemsHost="True"
                                                        Orientation="Horizontal" KeyboardNavigation.TabIndex="1" />
                                        </ScrollViewer>

                                        <RepeatButton x:Name="ScrollRight" Grid.Column="2"
                                                      Style="{StaticResource TabStripChevron}"
                                                      Visibility="Collapsed"
                                                      AutomationProperties.Name="{loc:L 'Scroll tabs right'}">
                                            <Path Data="M 4 2 L 8 6 L 4 10"
                                                  Stroke="{DynamicResource TextFillColorSecondaryBrush}"
                                                  StrokeThickness="1.4" StrokeEndLineCap="Round"
                                                  StrokeStartLineCap="Round" />
                                        </RepeatButton>
                                    </Grid>
                                </Border>
                                <Border Grid.Row="1" Background="Transparent"
                                        Padding="{TemplateBinding Padding}" KeyboardNavigation.TabIndex="2">
                                    <ContentPresenter x:Name="PART_SelectedContentHost"
                                                      ContentSource="SelectedContent" />
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============================================================
                 Data grids. Replace the flat, hard-to-scan default rows with
                 readable rows: a single-row hairline divider, a hover/selection
                 fill, semibold low-key column headers on a 1px rule, and no
                 cell focus rectangle. Applied implicitly so every DataGrid
                 (ports, IP ranges, certificates, relays, list editors) matches. -->
            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="SeparatorVisibility" Value="Collapsed" />
                <!-- A header wider than its column ends in an ellipsis and says
                     the whole of itself in a tool tip. Left to the default
                     presenter it was cut mid-word with nothing to say so -
                     "Require TLS o", "Simultaneous co", "Requires ar" on the
                     remote domains and greylisting bypass lists. The header's
                     content stays the string, so its accessible name is whole.
                     A selector, not a template: a header that is a control -
                     the Quarantine page's check box and four buttons - is shown
                     as itself, where the words' template printed its type name. -->
                <Setter Property="ContentTemplateSelector">
                    <Setter.Value>
                        <svc:HeaderTemplateSelector>
                            <svc:HeaderTemplateSelector.TextTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
                                </DataTemplate>
                            </svc:HeaderTemplateSelector.TextTemplate>
                        </svc:HeaderTemplateSelector>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="GridLinesVisibility" Value="None" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="RowHeaderWidth" Value="0" />
                <Setter Property="CanUserResizeRows" Value="False" />
                <Setter Property="MinRowHeight" Value="{DynamicResource AppNavRowHeight}" />
                <Setter Property="SelectionUnit" Value="FullRow" />
            </Style>

            <!-- Every WPF-UI button, as WPF-UI draws it, but for the filled Danger
                 appearance - a confirmation's destructive choice, Start restore -
                 which takes its colours from the design tokens: WPF-UI fills it
                 with its own #F44336 in both themes and leaves the theme's primary
                 text on it, white in the dark theme, 3.7:1. AppDangerSolidBrush
                 and its hover and pressed shades carry AppOnDangerSolidBrush at
                 4.5:1 or more (DesignTokens.DangerSolid; ContrastTokensTests).
                 Style triggers, because WPF-UI sets the appearance's colours in
                 its template's triggers, which a style trigger outranks and a
                 style setter does not; and the disabled state again after it,
                 since the same rank lets the Danger trigger's words outrank the
                 template's disabled grey. Implicit, so that a button keeps
                 Appearance="Danger" and nothing else, wherever it is built. -->
            <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource DefaultUiButtonStyle}">
                <Style.Triggers>
                    <Trigger Property="Appearance" Value="Danger">
                        <Setter Property="Background" Value="{DynamicResource AppDangerSolidBrush}" />
                        <Setter Property="MouseOverBackground" Value="{DynamicResource AppDangerSolidHoverBrush}" />
                        <Setter Property="PressedBackground" Value="{DynamicResource AppDangerSolidPressedBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource AppOnDangerSolidBrush}" />
                        <Setter Property="PressedForeground" Value="{DynamicResource AppOnDangerSolidBrush}" />
                    </Trigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="Appearance" Value="Danger" />
                            <Condition Property="IsEnabled" Value="False" />
                        </MultiTrigger.Conditions>
                        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundDisabled}" />
                    </MultiTrigger>
                </Style.Triggers>
            </Style>

            <!-- The date picker drawn with the text field's border: WPF-UI gives
                 it the buttons' elevation border with no bottom edge (1,1,1,0),
                 and its bottom is then only the faint line under the box, 1.1:1
                 on its card. The text fields' border, which ThemeTokens
                 republishes with the theme's strong stroke as its bottom edge
                 (DesignTokens.TextFieldStroke), on all four sides gives it the
                 edge a text box has, 3:1 or more; under High Contrast the key is
                 the theme's own. -->
            <Style TargetType="DatePicker" BasedOn="{StaticResource DefaultDatePickerStyle}">
                <Setter Property="BorderBrush" Value="{DynamicResource TextControlElevationBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <!-- A text box that wraps sets its lines ragged right, as every text
                 in the Control Panel is. WPF-UI's styles stretch a text box's
                 content (HorizontalContentAlignment Stretch), which WPF's text box
                 reads as justified text, so that each wrapped line was spread to
                 the box's width: an account's and a domain's signatures and
                 auto-replies as they were typed ("message  when  I  am  back."), a
                 rule's reply and disclaimer, a list's footer, a server message, an
                 LDAP filter, and the domain's DKIM record, whose "Value: v=DKIM1;
                 k=rsa;" stood in three pieces across the box above the key (review
                 findings F026, F299). Only a box that wraps: a one-line box, and
                 the text boxes inside WPF-UI's own controls, keep WPF-UI's
                 alignment. Each is based on WPF-UI's by its key, as the check box's
                 is (SharedTemplatesTests). RaggedRightTextBoxTests holds both. -->
            <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource DefaultTextBoxStyle}">
                <Style.Triggers>
                    <Trigger Property="TextWrapping" Value="Wrap">
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                    </Trigger>
                    <Trigger Property="TextWrapping" Value="WrapWithOverflow">
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="{x:Type ui:TextBox}" BasedOn="{StaticResource DefaultUiTextBoxStyle}">
                <Style.Triggers>
                    <Trigger Property="TextWrapping" Value="Wrap">
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                    </Trigger>
                    <Trigger Property="TextWrapping" Value="WrapWithOverflow">
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Every Hyperlink - the About page's, the help pane's list of
                 documents, a link inside a help document - in the link colour
                 (DesignTokens.Link), underlined, a shade further from the surface
                 under the pointer, and the disabled text colour when it cannot be
                 followed. WPF's own drew the system's #0066CC, 2.5:1 on the dark
                 card, and turned it red under the pointer, the danger colour. A
                 Hyperlink is not a TextBlock: an implicit style on it reaches the
                 links and nothing in a control template. WPF-UI's link button,
                 the sign-in page's, is not a Hyperlink: it takes the same colours
                 through the theme's own keys, which ThemeTokens republishes. -->
            <Style TargetType="Hyperlink">
                <Setter Property="Foreground" Value="{DynamicResource AppLinkBrush}" />
                <Setter Property="TextDecorations" Value="Underline" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource AppLinkHoverBrush}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="True">
                        <Setter Property="Cursor" Value="Hand" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- A secondary button whose action destroys something - Delete,
                 Delete selected - with its words in the danger colour while it
                 can be pressed. A style setter, not a local Foreground: the
                 button template's disabled trigger outranks a style setter and
                 loses to a local value, so a local red left a disabled Delete
                 looking live beside a greyed Edit. The shade is the danger
                 fill's text colour, which clears 4.5:1 on the button's fill in
                 both themes; the dark theme's danger colour measured 4.1:1. -->
            <Style x:Key="DangerTextButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Appearance" Value="Secondary" />
                <Setter Property="Foreground" Value="{DynamicResource AppDangerFillTextBrush}" />
            </Style>

            <!-- A button inside a card that opens another page - the setup
                 checklist's Open Domains, the Dashboard's Open Setup checklist,
                 DNS records', the overviews' and the directory pages' links: the
                 Caption size, as a card's links are, but 28 pixels tall at the
                 least, where 12-pixel words in a 24-pixel button stood beside the
                 32-pixel buttons of the same card (review finding F042). Its
                 caption names the page and ends in no ellipsis, which Windows
                 keeps for a command that asks for more before it acts (F305).
                 ButtonStyles.CompactPageLink gives it to a button built in code.
                 A caption with an access key - the Dashboard's "Open Setup
                 _checklist" - is shown in an AccessText, which WPF-UI's implicit
                 AccessText style sets to the Body size: a style setter outranks
                 the size the button passes down, so the link was drawn at 14
                 pixels beside the 12 of the links without one. The string's own
                 template, in the style's resources as the check box's is, sets the
                 AccessText to the Caption size; a caption without an access key
                 is a TextBlock that takes the button's size. -->
            <Style x:Key="CompactPageLink" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Style.Resources>
                    <DataTemplate DataType="{x:Type sys:String}">
                        <AccessText Text="{Binding}" FontSize="{StaticResource AppFontSizeCaption}" />
                    </DataTemplate>
                </Style.Resources>
                <Setter Property="FontSize" Value="{StaticResource AppFontSizeCaption}" />
                <Setter Property="Padding" Value="8,4,8,4" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>

            <!-- A button with nothing round it at rest - the breadcrumb's Back,
                 Forward and groups, the Related links, the command bar's glyphs -
                 and the theme's subtle fill under the pointer. WPF-UI's Transparent
                 appearance keeps the control's one-pixel outline, so that the trail
                 and the Related links read as a row of chips (review finding F296).
                 No border at all, in every state, rather than a transparent one: the
                 disabled state draws its own border colour. -->
            <Style x:Key="SubtleButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Appearance" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <!-- A number column's header, right-aligned over its right-aligned
                 cells (GridNumberText, in Scaffold.xaml, is the cells' style). -->
            <Style x:Key="GridNumberHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                <Setter Property="HorizontalContentAlignment" Value="Right" />
            </Style>

            <!-- A selected row is one language across the application's grids
                 and lists: the brand at the notice tint's opacity behind the row
                 (AppSelectionFillBrush), the sidebar's 3 x 16 brand pill at its
                 left edge, and the row's own text, which stays what it was - the
                 fill is so near the card's own that the primary and secondary
                 text clear 4.5:1 on it (DesignTokensTests holds them to it). The
                 sidebar and the rail keep the subtle grey behind the row they
                 mark with the pill (MainWindow.xaml, NavRailItem above), so
                 what the lists share with the shell is the pill; the tint is
                 the lists' own. Hover keeps the theme's subtle grey, so a
                 hovered row and the selected one no longer look the same: the
                 selected row measured 1.08:1 against its neighbours, exactly as
                 hover did, and Edit and Delete acted on one of the two. Under
                 High Contrast the fill is nothing and AppSelectionOutlineBrush
                 draws a one-pixel outline in the highlight, as the pill is.
                 This style is the grid row's; the list item styles after the
                 cell style are the same look for every ListBox and ListView -
                 the palette, the public folders, the dialogs' member lists, the
                 four lists on the domains page - which took WPF-UI's solid
                 accent band (the palette's own text at 1.9 to 3.5:1 on it) or
                 its grey with an outline. -->
            <Style TargetType="DataGridRow">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridRow">
                            <!-- WPF's own row template - the cells, the details under
                                 them, the row header the grids keep hidden, in a
                                 SelectiveScrollingGrid - with the pill and the High
                                 Contrast outline laid over it. Both scroll vertically
                                 only, so they stay at the left edge in view while the
                                 cells scroll sideways. -->
                            <Border x:Name="DGR_Border" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    SnapsToDevicePixels="True">
                                <SelectiveScrollingGrid>
                                    <SelectiveScrollingGrid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </SelectiveScrollingGrid.ColumnDefinitions>
                                    <SelectiveScrollingGrid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </SelectiveScrollingGrid.RowDefinitions>
                                    <DataGridCellsPresenter Grid.Column="1" ItemsPanel="{TemplateBinding ItemsPanel}"
                                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                    <DataGridDetailsPresenter Grid.Column="1" Grid.Row="1" Visibility="{TemplateBinding DetailsVisibility}"
                                                              SelectiveScrollingGrid.SelectiveScrollingOrientation="{Binding AreRowDetailsFrozen, ConverterParameter={x:Static SelectiveScrollingOrientation.Vertical}, Converter={x:Static DataGrid.RowDetailsScrollingConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                                    <DataGridRowHeader Grid.RowSpan="2" SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical"
                                                       Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.Row}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                                    <Rectangle x:Name="Pill" Grid.Column="1" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5"
                                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0"
                                               Fill="{DynamicResource AppBrandBrush}" Opacity="0" IsHitTestVisible="False"
                                               SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical" />
                                    <Rectangle x:Name="Outline" Grid.ColumnSpan="2" Grid.RowSpan="2" StrokeThickness="1"
                                               Stroke="{DynamicResource AppSelectionOutlineBrush}" Visibility="Collapsed"
                                               IsHitTestVisible="False" SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical" />
                                </SelectiveScrollingGrid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Pill" Property="Opacity" Value="1" />
                                    <Setter TargetName="Outline" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    </Trigger>
                    <!-- After the hover trigger, so that it wins where both hold:
                         the selected row keeps its fill under the pointer. -->
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AppSelectionFillBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="DataGridCell">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Background="{TemplateBinding Background}" Padding="10,0"
                                    BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource ControlElevationBorderBrush}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ============================================================
                 List rows. The row of every ListBox and ListView, drawn as the
                 grid row above, with the sidebar's pill: the control radius, the
                 subtle grey under the pointer, the selection fill and the brand
                 pill on the selected row, and a 2-pixel ring in the focus
                 colour round the row the keyboard is on in place of the stock
                 focus visual - the focus ring every control draws, inside the
                 row since its neighbours leave no room outside it (F296) - the pill says which row is selected, the ring
                 where the keyboard is, and the two are not one colour. The
                 content keeps its own text styles: the palette's TextBody and
                 TextCaption, the domains page's names, a public folder's name
                 in the list's own, which is the primary text. The ring and the
                 outline are drawn over the row, not as the border's thickness,
                 so that neither changes a row's height. -->
            <Style TargetType="ListBoxItem">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="MinHeight" Value="{DynamicResource AppNavRowHeight}" />
                <Setter Property="HorizontalContentAlignment" Value="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
                <Setter Property="VerticalContentAlignment" Value="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" CornerRadius="{DynamicResource AppControlCornerRadius}"
                                    Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <Grid>
                                    <ContentPresenter Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                    <Rectangle x:Name="Pill" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5"
                                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,0,0,0"
                                               Fill="{DynamicResource AppBrandBrush}" Opacity="0" IsHitTestVisible="False" />
                                    <Rectangle x:Name="Ring" RadiusX="4" RadiusY="4" Stroke="Transparent" StrokeThickness="2"
                                               IsHitTestVisible="False" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppSelectionFillBrush}" />
                                    <Setter TargetName="Pill" Property="Opacity" Value="1" />
                                    <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AppSelectionOutlineBrush}" />
                                    <Setter TargetName="Ring" Property="StrokeThickness" Value="1" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AppFocusBrush}" />
                                    <Setter TargetName="Ring" Property="StrokeThickness" Value="2" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A list view's row is the same control, inset and all: its content
                 starts where a grid cell's does, ten pixels in and past the pill.
                 A page whose rows carry an inset of their own narrows the row's
                 in its own resources, as the domains page does, and not here:
                 the incoming relays' rows are bare strings, and with the domains
                 page's six pixels here their text began three pixels after the
                 pill. -->
            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListBoxItem}}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
