<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- xUnit.net v3: a test project is an executable that runs its own tests. The mtp-off
         package leaves out the Microsoft Testing Platform, so that dotnet test runs it
         through VSTest and xunit.runner.visualstudio, as build/ci/windows-dotnet.ps1 asks. -->
    <OutputType>Exe</OutputType>
    <!-- ProfileApi (linked below) declares its kernel32 calls with LibraryImport,
         whose generated marshalling is unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>hMailServer.ControlPanel.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ControlPanel.Core\ControlPanel.Core.csproj" />
  </ItemGroup>

  <!-- Live logs' reading of the log and its following of the end, apart from the
       window that draws them: whole lines, a tail begun mid-line, a rotated file, and
       where the view goes as lines arrive and the oldest are dropped. -->
  <ItemGroup>
    <Compile Include="..\ControlPanel\Services\LiveLogTail.cs" />
  </ItemGroup>

  <!-- And which file it reads - today's, by the server's own name, the next day's
       once the server opens it - and the parts a line is shown in. -->
  <ItemGroup>
    <Compile Include="..\ControlPanel\Services\LiveLogFiles.cs" />
  </ItemGroup>

  <!-- The Message trace page's status words - "OK 250", "Deferred 451", "Refused
       550" at their levels - and how long its events are kept. -->
  <ItemGroup>
    <Compile Include="..\ControlPanel\Services\MessageTraceStatus.cs" />
  </ItemGroup>

  <!-- Server status's start time as the server's, and its uptime, worked out only
       where the server's clock is this computer's, in catalogued units. -->
  <ItemGroup>
    <Compile Include="..\ControlPanel\Services\ServerUptimeText.cs" />
  </ItemGroup>

  <!-- The account dialog's last sign-in, in the reader's format as the server's time,
       and Never for the date the server keeps for none (review finding F292). -->
  <ItemGroup>
    <Compile Include="..\ControlPanel\Services\LastSignInText.cs" />
  </ItemGroup>

  <!-- Chart accessibility: the palette, the catalogue, the table view and the
       status vocabulary. These are compiled straight into the test assembly rather
       than routed through ControlPanel.Core, because the app compiles them too (they
       live under ControlPanel\Services) and adding them to Core as well would give
       this project two copies of every type and a CS0436 for each. They carry no WPF
       references for exactly this reason: the theme decisions and the table
       construction are the parts worth testing, and they must be testable without a
       dispatcher, without an Application, and without the build agent having to be
       running a High Contrast theme. -->
  <ItemGroup>
    <Compile Include="..\ControlPanel\Services\AccessibleNames.cs" />
    <Compile Include="..\ControlPanel\Services\MnemonicText.cs" />
    <!-- A control's name starts with its caption: the rule LabelInNameTests holds, and the names of links. -->
    <Compile Include="..\ControlPanel\Services\LabelInName.cs" />
    <!-- Data in the monospaced face inside a sentence: a list that breaks after its
         colons, a path cut in its middle (review findings F135, F304). -->
    <Compile Include="..\ControlPanel\Services\DataText.cs" />
    <Compile Include="..\ControlPanel\Services\SettingClaims.cs" />
    <Compile Include="..\ControlPanel\Services\ChartPalette.cs" />
    <Compile Include="..\ControlPanel\Services\StatusPalette.cs" />
    <Compile Include="..\ControlPanel\Services\ColourVision.cs" />
    <Compile Include="..\ControlPanel\Services\ChartCatalog.cs" />
    <Compile Include="..\ControlPanel\Services\ChartDataTable.cs" />
    <Compile Include="..\ControlPanel\Services\StatusSemantics.cs" />
    <!-- The pill of a list whose entries can be switched off: how many are on, of how
         many, at Warning when none is (review finding F268). -->
    <Compile Include="..\ControlPanel\Services\ActiveEntries.cs" />
    <!-- The setup checklist's tally in words: the one set of sentences the Dashboard's
         setup card and the Setup checklist page count the same states with (review
         finding F034). -->
    <Compile Include="..\ControlPanel\Services\SetupTally.cs" />
    <!-- The design tokens and the server status pill's vocabulary. The numbers,
         the High Contrast derivation and the colour-vision separation of the
         information colour are decided in DesignTokens; the pill's word and
         severity per link state in ConnectionStatus. Both are plain data and
         pure functions, and both are what the page waves code against. -->
    <Compile Include="..\ControlPanel\Services\DesignTokens.cs" />
    <Compile Include="..\ControlPanel\Services\ConnectionStatus.cs" />
    <!-- The same again for the two page waves: the feature-settings pill's word and
         severity per page state, and the arithmetic that sizes a tabbed dialog on
         the frame to its tallest tab within the work area. -->
    <Compile Include="..\ControlPanel\Services\SettingsPageStatus.cs" />
    <Compile Include="..\ControlPanel\Services\DialogLayout.cs" />
    <!-- And the arithmetic of a page whose list fills the window down to a floor,
         below which the page scrolls (Views/Scaffold/FillPanel; work item 79, the
         IP ranges page whose list a short window gave no height). -->
    <Compile Include="..\ControlPanel\Services\PageFill.cs" />
    <!-- And whether parts laid side by side keep their minimum widths, below which
         the domains and rules pages put them one above the other. -->
    <Compile Include="..\ControlPanel\Services\SideBySide.cs" />
    <!-- And the width of a page's column of cards: as wide as it is allowed, whatever
         its cards hold, so that every card of a page ends at one edge (review finding
         F295; Views/Scaffold/FormColumnPanel). -->
    <Compile Include="..\ControlPanel\Services\FormColumn.cs" />
    <!-- And where a setting found by search is scrolled to: a third of the way down,
         with room for its ring and what follows it (Views/SettingReveal). -->
    <Compile Include="..\ControlPanel\Services\RevealOffset.cs" />
    <!-- And where an overflowing tab strip scrolls to, by whole headers, and which of
         its edges cuts a header and so fades (review findings F193 and F107). -->
    <Compile Include="..\ControlPanel\Services\TabStripSnap.cs" />
    <!-- And whether a list page's toolbar puts its actions on a row of their own
         under the search and the filters (review finding F288). -->
    <Compile Include="..\ControlPanel\Services\ToolbarRows.cs" />
    <!-- And what a list page's count and empty state say while its search filters
         the rows it read (review findings F288 and F210). -->
    <Compile Include="..\ControlPanel\Services\ListSearchCount.cs" />
    <!-- And where a page header puts its actions: beside the title while the title
         fits beside them whole, under the subtitle where it does not. -->
    <Compile Include="..\ControlPanel\Services\PageHeaderLayout.cs" />
    <!-- And the server settings page's own, which is a different lifecycle from
         the INI pages' above: read and written over COM, so it is clean, unsaved,
         saving, saved or partly saved, with no service restart in it. -->
    <Compile Include="..\ControlPanel\Services\ServerSettingsPageStatus.cs" />
    <!-- What a settings list offers when the server holds a value that is none of
         its choices: the value itself, so that a save of the page writes back what
         it read rather than the first choice. -->
    <Compile Include="..\ControlPanel\Services\ChoiceOptions.cs" />
    <!-- The setup checklist's judgement of the host name the server announces. -->
    <Compile Include="..\ControlPanel\Services\HostNameVerdict.cs" />
    <Compile Include="..\ControlPanel\Services\Typography.cs" />
    <Compile Include="..\ControlPanel\Services\SpamPipeline.cs" />
    <!-- The spam overview's "Which list do I need?" and "Check a sender": the eight
         lists' words, and each list's matching as the server matches it. -->
    <Compile Include="..\ControlPanel\Services\SenderLists.cs" />
    <!-- Same arrangement, for the same reason: the account comparison and the
         command-line parsing behind the service-account check are pure, and both
         drive a sentence shown to an administrator, so both are worth testing
         without a WPF page around them. -->
    <Compile Include="..\ControlPanel\Services\WindowsServiceInfo.cs" />
    <!-- The fatal-exception filter those linked files put on their catch clauses
         comes from ControlPanel.Core, which compiles it for Loc. -->
    <!-- The REST API key store. Every rule in it - the token's shape, the digest,
         what makes a label, a domain list or a source restriction acceptable - has
         to agree with RestApiServer, and a disagreement produces a key that is
         written successfully and authenticates nothing. That is exactly the class
         of bug a test catches and a green build does not. IniFeatureStore comes
         with it because ApiKeyStore locates the store file through it. -->
    <Compile Include="..\ControlPanel\Services\ApiKeyStore.cs" />
    <Compile Include="..\ControlPanel\Services\IniFeatureStore.cs" />
    <!-- An address read as the server reads one (IPAddress::Parse), which the
         source restriction's addresses are checked with. -->
    <Compile Include="..\ControlPanel\Services\ServerAddressText.cs" />
    <!-- What the forms check of a value before they send it - a whole number, a
         port, an address, a range's two ends, a host - read as the server reads
         them (review findings F129 and F212). -->
    <Compile Include="..\ControlPanel\Services\InlineFormChecks.cs" />
    <!-- The three sets of rights the access-control entry ticks in one press (F205). -->
    <Compile Include="..\ControlPanel\Services\FolderRightPresets.cs" />
    <!-- The room a dialog keeps for its fields' messages, taken again as its body changes (F213, F205). -->
    <Compile Include="..\ControlPanel\Services\FieldMessageRoom.cs" />
    <!-- The quarantine digest settings written as one: the hours checked first, the address put back (F209). -->
    <Compile Include="..\ControlPanel\Services\QuarantineDigestSettingsWrite.cs" />
    <!-- The words for when a saved setting reaches the running server, which
         IniFeatureStore's pending list is read through (docs/SettingsApply.md). -->
    <Compile Include="..\ControlPanel\Services\SettingApplies.cs" />
    <!-- The settings the server's environment sets, which IniFeatureStore reads with
         the marks (docs/EnvironmentConfiguration.md). -->
    <Compile Include="..\ControlPanel\Services\EnvironmentSettings.cs" />
    <Compile Include="..\ControlPanel\Services\ProfileApi.cs" />
    <!-- Matching a configured port row against the machine's open ports. Both ways
         of getting it wrong cost something: a live port reported as down sends
         somebody hunting for a conflict that does not exist, and a dead port
         reported as up hides the commonest cause of "mail stopped arriving". -->
    <Compile Include="..\ControlPanel\Services\ListenerProbe.cs" />
    <!-- The two overview pages' judgement. Both answer a question no editing page
         can - "will an infected message actually be caught here", "is anything
         carrying a password in the clear" - and both do it by deriving consequences
         from settings rather than by displaying them. That derivation is the part
         worth testing, and it is deliberately free of WPF so it can be tested
         without a dispatcher or a live server. Neither pulls in ServerSession: the
         certificate expiry threshold they share with the certificates page lives in
         StatusSemantics above precisely so that it does not. -->
    <Compile Include="..\ControlPanel\Services\VirusPipeline.cs" />
    <Compile Include="..\ControlPanel\Services\TlsPosture.cs" />
    <!-- The count beside the three overviews' titles, which says nothing where a
         value could not be read and no problem was found. -->
    <Compile Include="..\ControlPanel\Services\OverviewProblemCount.cs" />
    <!-- The server's refusals the Control Panel translates where it shows them.
         Linked so a test can hold each sentence to the server source it copies and
         to every complete catalogue: a sentence that drifted from the server would
         otherwise fall back to English with no failure anywhere. -->
    <Compile Include="..\ControlPanel\Services\ServerSentences.cs" />
    <!-- What a failed call to the server was: a lost link, shown at Critical as the
         shell's pill shows it, or a server that answered and could not give a value,
         shown as a Warning. Apart from ServerSession, which asks it, so that a test
         can hold the classification and the level to the codes without a server. -->
    <Compile Include="..\ControlPanel\Services\ComErrorText.cs" />

    <!-- The report a directory synchronisation returns is one tab-separated string.
         Turning it into rows a page can count and sort is the only logic in that
         feature that does not need a directory, a server or a dispatcher, so it lives
         here on its own and is tested here on its own. -->
    <Compile Include="..\ControlPanel\Services\DirectorySyncReport.cs" />

    <!-- Whether the directory synchronisation schedule in the file waits for the
         server to start again: a record of the schedule the running server took,
         WPF- and COM-free, held here to the sequences of reads, saves and starts
         a page goes through. -->
    <Compile Include="..\ControlPanel\Services\DirectorySyncSchedule.cs" />

    <!-- What the notice under an hMailServer.INI settings page's header says: the
         settled sentence, a refusal over it, and the refusal withdrawn once the edits
         it refused are taken back, when nothing was written. -->
    <Compile Include="..\ControlPanel\Services\SaveStateNotice.cs" />

    <!-- The sign-in screen's reachability pre-check, and the host-name rules it
         shares with ServerSession. Connecting used to run three blocking COM
         calls on the UI thread, so an unreachable host froze the first window
         anybody sees for as long as RPC took to give up. The probe answers that
         question off-thread with a timeout we choose; what is worth testing is
         that it honours the timeout and that it still short-circuits a local
         host, because making loopback sign-in slower would be a poor trade.
         LocalHostNames is compiled in alongside it for the same reason it exists
         at all: it is the only thing HostReachability needs from ServerSession,
         and it carries no COM, no service control and no WPF. -->
    <Compile Include="..\ControlPanel\Services\LocalHostNames.cs" />
    <Compile Include="..\ControlPanel\Services\HostReachability.cs" />

    <!-- The DKIM tab's reading of the server's key rotation status: the document's
         field names and the words for each phase, check and waiting reason. The
         server decides all of it, so this is only the saying of it, and a word read
         under the wrong name or missing from the tables is caught here rather than
         by an administrator looking at an empty slot. It uses StatusLevel, which is
         compiled in above, so it is here and not in ControlPanel.Core. -->
    <Compile Include="..\ControlPanel\Services\DkimRotationStatus.cs" />

    <!-- The settings pages' REST session, without the half that ties it to the
         server signed in to (RestSettingsClient.Session.cs, which needs COM). What
         is worth testing is what it does with a listener's answers: a session made
         again after the server ended it, a listener that has gone by then, one that
         takes the connection and says nothing, and a certificate that is the one
         the listener serves - each against a listener the test runs itself. -->
    <Compile Include="..\ControlPanel\Services\RestSettingsClient.cs" />

    <!-- An administrator's install of an update (docs/ServiceAccount.md, "The live
         update"): the decisions, the stage's command line, the words for what the
         stage, the service and the Updater say, the permission rule held to the
         table the elevated stage is held to, the sign-in handoff and its entropy,
         and the Status page's Update row. Plain logic and file I/O, no WPF and no
         COM, so each check is tested here rather than only on a server. -->
    <Compile Include="..\ControlPanel\Services\AdministratorUpdate.cs" />
    <Compile Include="..\ControlPanel\Services\InstallationPermissions.cs" />
    <Compile Include="..\ControlPanel\Services\AfterUpdateHandoff.cs" />
    <Compile Include="..\ControlPanel\Services\UpdateStatusText.cs" />
    <!-- What the Backup & restore page reads and says about archives and restore
         jobs: the archives in the destination, a job's outcome as a level and a
         sentence, an account's messages in an archive as rows (review finding
         F257). Linked here rather than through Core, as the overviews' judgements
         are, because it speaks in StatusLevel. -->
    <Compile Include="..\ControlPanel\Services\BackupRestoreReport.cs" />
    <!-- What the DNS records page says after checking every record of a domain:
         the worst level reached and a line per verdict (review finding F277). -->
    <Compile Include="..\ControlPanel\Services\DnsCheckSummary.cs" />
  </ItemGroup>

  <!-- The Journaling and dual delivery page's words for a rule's state and for what
       adding, switching and removing a rule did (review finding F255). -->
  <ItemGroup>
    <Compile Include="..\ControlPanel\Services\JournalRuleText.cs" />
  </ItemGroup>

  <!-- The Allowed and blocked domains page's words for an entry and the REST API's
       request that changes one in place (review finding F266). -->
  <ItemGroup>
    <Compile Include="..\ControlPanel\Services\DomainPolicyWords.cs" />
  </ItemGroup>

  <!-- What the Dashboard's attention card lists and in what order: the configuration
       warnings it shares with Server status, the setup steps it shows and the rest
       (review finding F242). -->
  <ItemGroup>
    <Compile Include="..\ControlPanel\Services\ConfigurationWarning.cs" />
  <!-- The accounts the group members dialog offers to add, and what it says after an
       add (review finding F203). -->
  <ItemGroup>
    <Compile Include="..\ControlPanel\Services\GroupMemberCandidates.cs" />
  </ItemGroup>

  <!-- The Public folders page's tree, its checks of a new folder's name and its words
       (review finding F206). -->
  <ItemGroup>
    <Compile Include="..\ControlPanel\Services\PublicFolderTree.cs" />
  </ItemGroup>

  <!-- The TCP/IP ports page's changes waiting for a reinitialise, and a TLS port's
       certificate (review finding F222). -->
  <ItemGroup>
    <Compile Include="..\ControlPanel\Services\PortChanges.cs" />
  </ItemGroup>

  <!-- The Rules page's words for its empty IF and THEN cards and for a rule just added
       (review finding F225). -->
  <ItemGroup>
    <Compile Include="..\ControlPanel\Services\RuleCards.cs" />
  </ItemGroup>

  <!-- How far an IP range lets mail be relayed without signing in, and the words for it
       (review finding F229). -->
  <ItemGroup>
    <Compile Include="..\ControlPanel\Services\RelayExposure.cs" />
  <!-- The SSL certificates page's rows: which ports present each certificate and the
       order its Certificate column sorts in (review finding F235). In StatusLevel's
       terms, so here beside StatusSemantics rather than in Core. -->
  <ItemGroup>
    <Compile Include="..\ControlPanel\Services\CertificateRows.cs" />
  </ItemGroup>

  <!-- Server status's state pill and the Updates page's one step at a time (review
       finding F246). -->
  <ItemGroup>
    <Compile Include="..\ControlPanel\Services\ServerStateText.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- WindowsServiceInfo queries Win32_Service; the app gets this through its
         own reference and the test assembly needs its own. -->
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
