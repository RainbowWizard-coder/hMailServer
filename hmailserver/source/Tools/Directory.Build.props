<Project>
  <!--
    Applies to every C# project under source/Tools (the Control Panel, its
    tests, and the setup and migration tools). One property, for one reason:

    EnableWindowsTargeting lets `dotnet restore` succeed on a non-Windows
    machine for a project that targets net10.0-windows. Nothing here can RUN
    off Windows - the tools are WPF and WinForms - but a restore on Linux is
    how Renovate updates the lock files (below), and without this property
    that restore fails with NETSDK1100 on the first Windows-targeting project
    it meets. It was added for GitHub's automatic dependency submission, which
    restored every project on a Linux runner while the project was on GitHub
    and was red on every push without it (measured on the 28 August 2026
    runs). On Windows the property is inert.
  -->
  <PropertyGroup>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!--
      NuGet lock files (packages.lock.json beside each project). A restore
      records the exact package graph - every transitive version and its
      content hash - and CI restores with "dotnet restore ... -locked-mode",
      which fails rather than silently resolving something different from
      what was committed. That is the OpenSSF Scorecard Pinned-Dependencies
      finding for NuGet, and it is real: without a lock file, a floating
      transitive dependency or a re-published package version changes what
      ships without a commit saying so. On a developer machine a plain
      restore updates the lock file when a package reference changes; commit
      it with the change. Renovate updates lock files with its bumps, from a
      restore on Linux, which for a net10.0-windows project lists packages a
      restore on Windows leaves out; its merge request says to restore on
      Windows before merging (docs/ContinuousIntegration.md, "Dependency
      updates").
    -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!--
      A tool's publish and publish-arm64 folders (build-tools.ps1) are output, and
      are kept out of the project's default items. Left in, every DLL there was a
      None item, and ResolveAssemblyReference searches the project's own Content
      and None files ({CandidateAssemblyFiles}) before a reference's HintPath. So
      the wrapper a tool compiled against and shipped depended on which publish
      had run before in the same checkout: after build-tools.ps1 for x64, the ARM64
      publish took publish\Interop.hMailServer.dll, the x64 COM wrapper, in place of
      the one Directory.Build.targets names (five warnings CS8012, "targets a
      different processor"), and after an ARM64 publish the x64 one took the ARM64
      wrapper. Found on 28 September 2026 on the laptop, x64 then ARM64 from clean
      publish folders: check-pe-machine.ps1 -Expect ARM64 over hMailServerARM64.iss
      found five x64 wrappers, in Bin and in the two add-ons' Addons folders, where
      nothing copies the right one over them and .NET does not load them into an
      ARM64 process; with this line, none. A build in a clean checkout, as
      windows-packages.ps1's, has no publish folder to find.
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);publish/**;publish-arm64/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
