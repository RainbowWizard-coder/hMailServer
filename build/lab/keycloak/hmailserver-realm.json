{
  "realm": "hmailserver",
  "displayName": "hMailServer test lab",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "rememberMe": false,
  "verifyEmail": false,
  "bruteForceProtected": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "users": [
    {
      "username": "alice",
      "email": "alice@example.test",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Lab",
      "enabled": true,
      "requiredActions": []
    },
    {
      "username": "bob",
      "email": "bob@example.test",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Lab",
      "enabled": true,
      "requiredActions": []
    }
  ],
  "clients": [
    {
      "clientId": "hmailserver-oidc",
      "name": "hMailServer sign-in (OpenID Connect)",
      "description": "The server's OpenID Connect sign-in (docs/PasskeysAndSingleSignOn.md): authorization code, public, PKCE S256. Redirect URIs: the lab bench's REST listener, http://127.0.0.1:8045.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "http://127.0.0.1:8045/portal/oidc/callback",
        "http://localhost:8045/portal/oidc/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      }
    },
    {
      "clientId": "hmailserver-token",
      "name": "hMailServer lab tokens (OAuth 2.0)",
      "description": "Tokens for the OAUTHBEARER and XOAUTH2 fixtures and for introspection: password and client-credentials grants, audience hmailserver. Its secret is set from ~/hmlab/secrets.env, not kept here.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "frontchannelLogout": false,
      "protocolMappers": [
        {
          "name": "audience hmailserver",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "hmailserver",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience hmailserver-token",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "hmailserver-token",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "http://127.0.0.1:8045/saml",
      "name": "hMailServer sign-in (SAML)",
      "description": "The server's SAML sign-in: client id = SP entity ID <base>/saml, HTTP-POST to <base>/portal/saml/acs, Response and Assertion signed RSA-SHA256 (exclusive c14n), request unsigned, no encryption, NameID = email.",
      "enabled": true,
      "protocol": "saml",
      "frontchannelLogout": false,
      "redirectUris": [
        "http://127.0.0.1:8045/portal/saml/acs",
        "http://localhost:8045/portal/saml/acs"
      ],
      "attributes": {
        "saml.assertion.signature": "true",
        "saml.server.signature": "true",
        "saml.server.signature.keyinfo.ext": "false",
        "saml.signature.algorithm": "RSA_SHA256",
        "saml_signature_canonicalization_method": "http://www.w3.org/2001/10/xml-exc-c14n#",
        "saml.client.signature": "false",
        "saml.encrypt": "false",
        "saml.force.post.binding": "true",
        "saml.authnstatement": "true",
        "saml.onetimeuse.condition": "false",
        "saml_force_name_id_format": "true",
        "saml_name_id_format": "email",
        "saml_assertion_consumer_url_post": "http://127.0.0.1:8045/portal/saml/acs"
      },
      "protocolMappers": [
        {
          "name": "email address",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "attribute.name": "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress",
            "attribute.nameformat": "URI Reference",
            "friendly.name": "email"
          }
        }
      ]
    }
  ]
}
